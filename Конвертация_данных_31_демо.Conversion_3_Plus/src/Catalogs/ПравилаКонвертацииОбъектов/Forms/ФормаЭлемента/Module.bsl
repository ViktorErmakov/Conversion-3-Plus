// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Конвертация данных не передана на текущую форму'");
	КонвертацияПередана = ЗначениеЗаполнено(Параметры.Конвертация);
	ОбщегоНазначенияКлиентСервер.Проверить(КонвертацияПередана, ТекстСообщения);
	
	Если ЭтоКонвертацияXDTO Тогда
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ПриОтправке";
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмПриОтправкеДанных, Опции);
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ПриКонвертацииДанныхXDTO";
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмПередПолучениемДанных, Опции);
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ПередЗаписьюПолученныхДанных";
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмПриПолученииДанных, Опции);
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ПослеЗагрузкиВсехДанных";
		Опции.ПоказыватьНаправление = Ложь;
		Опции.ТолькоПросмотр = Истина;
		Опции.СкрытьПанельКоманд = Истина;
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмПослеЗагрузкиВсехДанныхТекст, Опции);
		
		Расш1_КонсольКода.СоздатьХостКонсоли(
			ЭтотОбъект, Элементы.Страница_ОбработчикиXDTO, "ОбработчикиXDTO", Неопределено, Истина);
		
	Иначе
		
		Отправка = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		Получение = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередВыгрузкойОбъекта, "Страница_ПередВыгрузкой", Отправка);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПриВыгрузкеОбъекта, "Страница_ПриВыгрузке", Отправка);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеВыгрузкиОбъекта, "Страница_ПослеВыгрузки", Отправка);
		Расш1_ЗарегистрироватьАлгоритмXML(
			Элементы.АлгоритмПослеВыгрузкиОбъектаВФайлОбмена, "Страница_ПослеВыгрузкиВФайл", Отправка);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПоследовательностьПолейПоиска,
			"Страница_ПоляПоиска", Получение);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередЗагрузкойОбъекта, "Страница_ПередЗагрузкой", Получение);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПриЗагрузкеОбъекта, "Страница_ПриЗагрузке", Получение);
		Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеЗагрузкиОбъекта, "Страница_ПослеЗагрузки", Получение);
		
		Расш1_КонсольКода.СоздатьХостКонсоли(
			ЭтотОбъект, Элементы.Страница_ОбработчикиXML, "ОбработчикиXML", Неопределено, Истина);
		
	КонецЕсли;
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаКонвертации, "СправочникСсылка.Конвертации");
	ЭтотОбъект[ИмяРеквизитаКонвертации] = Параметры.Конвертация;
	
	Элементы.Страницы.УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыПриСменеСтраницы");
	
	ИмяГруппыОбработчиков = ?(ЭтоКонвертацияXDTO, "ОбработчикиXDTO", "ОбработчикиXML");
	Элементы[ИмяГруппыОбработчиков].УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_ОбработчикиПриСменеСтраницы");
	
	Расш1_ИзменитьУсловноеОформление();
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Расш1_ОбновитьКонсольПриОткрытии();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия) Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик смены основной страницы формы.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ЭтоКонвертацияXDTO Тогда
		
		Если ТекущаяСтраница.Имя = "Страница_ОбработчикиXDTO" Тогда
			ВидимаяСтраница = Расш1_ВидимаяСтраницаОбработчиковXDTO();
			Расш1_ПослеФормированияКонсолей(ВидимаяСтраница);
		КонецЕсли;
		
	ИначеЕсли ТекущаяСтраница.Имя = "Страница_ОбработчикиXML" Тогда
		Расш1_ПослеФормированияКонсолей();
	Иначе
		// Другая страница: консоль не открывается.
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены страницы обработчиков.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ОбработчикиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Расш1_ПослеФормированияКонсолей(ТекущаяСтраница.Имя);
	
КонецПроцедуры

// Обработчик события ДокументСформирован поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

// Обработчик команд консоли.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Если Расш1_КонсольКодаКлиент.ЭтоКомандаНаправления(Команда) Тогда
		Расш1_ПриИзмененииНаправления(Команда);
	Иначе
		Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	КонецЕсли;
	
КонецПроцедуры

// Подменю командной панели к этому моменту уже закрыто.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

// После смены объекта формата обновляет консоль.
//
// Параметры:
//  Элемент - ПолеФормы - поле объекта формата.
//
&После("ОбъектФорматаПриИзменении")
&НаКлиенте
Процедура Расш1_ОбъектФорматаПриИзменении(Элемент)
	
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

#Область ЭтоКонвертацияXDTO

&ИзменениеИКонтроль("АлгоритмПослеЗагрузкиВсехДанныхОткрытие")
&НаКлиенте
Процедура Расш1_АлгоритмПослеЗагрузкиВсехДанныхОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НЕ ЗначениеЗаполнено(Объект.АлгоритмПослеЗагрузкиВсехДанных) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаАлгоритм = СсылкаНаАлгоритмПоИмени(Объект.АлгоритмПослеЗагрузкиВсехДанных, СписокКонвертаций, СовместнаяРабота);
	Если СсылкаНаАлгоритм = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Ключ");
	ПараметрыФормы.Ключ = СсылкаНаАлгоритм;
	ИмяФормыАлгоритм = "Справочник.Алгоритмы.ФормаОбъекта";
	#Вставка
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаОбъектаФормата = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	ПараметрыФормы.Вставить(ИмяРеквизитаКонвертации, ЭтотОбъект[ИмяРеквизитаКонвертации]);
	ПараметрыФормы.Вставить(ИмяРеквизитаОбъектаФормата, Объект.ОбъектФормата);
	#КонецВставки
	ОткрытьФорму(ИмяФормыАлгоритм, ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

// После смены области применения обновляет направление и консоль.
//
// Параметры:
//  Элемент - ПолеФормы - тумблер области применения.
//
&После("Тумблер_ОбластьПримененияПриИзменении")
&НаКлиенте
Процедура Расш1_Тумблер_ОбластьПримененияПриИзмененииПосле(Элемент)
	
	Расш1_ИзменитьУсловноеОформление();
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "Страница_ОбработчикиXDTO" Тогда
		ИмяСтраницы = Элементы.ОбработчикиXDTO.ТекущаяСтраница.Имя;
		Расш1_ПрименитьНаправлениеКонсоли(ИмяСтраницы);
	КонецЕсли;
	
	Расш1_ОбновитьКонсольПриОткрытии();
	
КонецПроцедуры

// После выбора алгоритма переносит его текст в консоль.
//
// Параметры:
//  Элемент - ПолеФормы - поле алгоритма.
//
&После("АлгоритмПослеЗагрузкиВсехДанныхПриИзменении")
&НаКлиенте
Процедура Расш1_АлгоритмПослеЗагрузкиВсехДанныхПриИзмененииПосле(Элемент)
	
	Если Элементы.ОбработчикиXDTO.ТекущаяСтраница.Имя <> "Страница_ПослеЗагрузкиВсехДанных" Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстХоста = ЭтотОбъект[ИмяХоста]; // Строка
	Если Не ПустаяСтрока(ТекстХоста) Тогда
		Расш1_КонсольКодаКлиент.УстановитьТекст(ЭтотОбъект, ИмяХоста, АлгоритмПослеЗагрузкиВсехДанныхТекст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура Расш1_ОбновитьКонсольПриОткрытии()
	
	Если ЭтоКонвертацияXDTO Тогда
		Расш1_СтраницыОбработчиковКлиент.АктивироватьЕдинственныйЗаполненныйОбработчик(
			Элементы.ОбработчикиXDTO, Объект, "АлгоритмПослеЗагрузкиВсехДанныхТекст");
	Иначе
		Расш1_СтраницыОбработчиковКлиент.АктивироватьЕдинственныйЗаполненныйОбработчик(
			Элементы.ОбработчикиXML, Объект);
	КонецЕсли;
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_НазначитьКонсольТекущейСтраницы();
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект[ИмяРеквизитаКонвертации]);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ЗарегистрироватьАлгоритмXML(ЭлементАлгоритма, ИмяСтраницы, Направление)
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = ИмяСтраницы;
	Опции.ПоказыватьНаправление = Ложь;
	Опции.АвтоНаправление = Направление;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, ЭлементАлгоритма, Опции);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ИзменитьУсловноеОформление()
	
	Если ЭтоКонвертацияXDTO Тогда
		
		ИмяГруппыНаправления = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
		ГруппаНаправления = Элементы.Найти(ИмяГруппыНаправления);
		Если ГруппаНаправления <> Неопределено Тогда
			ГруппаНаправления.Видимость = Истина;
			ГруппаНаправления.Доступность =
				Объект.ИспользоватьДляОтправки И Объект.ИспользоватьДляПолучения;
		КонецЕсли;
		
		Элементы.ПоказатьТекстАлгоритмаПослеЗагрузкиВсехДанных.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает направление по заголовку кнопки команды.
//
// Параметры:
//  Команда - КомандаФормы - команда направления.
//
&НаКлиенте
Процедура Расш1_ПриИзмененииНаправления(Команда)
	
	ИмяКоманды = Команда.Имя;
	КнопкаКоманды = Элементы[ИмяКоманды]; // КнопкаФормы
	ЗаголовокКоманды = КнопкаКоманды.Заголовок;
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, ЗаголовокКоманды);
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеФормированияКонсолей(ИмяСтраницы = "")
	
	Если ЭтоКонвертацияXDTO Тогда
		
		Если Элементы.Страницы.ТекущаяСтраница.Имя <> "Страница_ОбработчикиXDTO" Тогда
			Возврат;
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяСтраницы) Тогда
			ИмяСтраницы = Расш1_ВидимаяСтраницаОбработчиковXDTO();
		КонецЕсли;
		
	Иначе
		
		Если Элементы.Страницы.ТекущаяСтраница.Имя <> "Страница_ОбработчикиXML" Тогда
			Возврат;
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяСтраницы) Тогда
			ИмяСтраницы = Элементы.ОбработчикиXML.ТекущаяСтраница.Имя;
		КонецЕсли;
		
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, ИмяСтраницы);
	Если ЭтоКонвертацияXDTO Тогда
		Расш1_ПрименитьНаправлениеКонсоли(ИмяСтраницы);
	КонецЕсли;
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	Направление = ЭтотОбъект[ИмяРеквизитаНаправления]; // Строка
	ОписаниеПользовательскихОбъектовJSON =
		Расш1_ПолучитьОписаниеПараметровJSON(
			Конвертация,
			Объект.ОбъектКонфигурации,
			Направление,
			ИмяСтраницы,
			ЭтоКонвертацияXDTO,
			Объект.ОбъектКонфигурацииКорреспондент,
			Объект.ОбъектФормата);
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(ЭтотОбъект, ИмяХоста, ОписаниеПользовательскихОбъектовJSON);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПрименитьНаправлениеКонсоли(ИмяСтраницы)
	
	Если ИмяСтраницы = "Страница_ПослеЗагрузкиВсехДанных" Тогда
		Возврат;
	КонецЕсли;
	
	ИмяГруппыНаправления = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
	ГруппаНаправления = Элементы.Найти(ИмяГруппыНаправления);
	Если ГруппаНаправления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаНаправления.Видимость = Истина;
	
	ОбаНаправления = Объект.ИспользоватьДляОтправки И Объект.ИспользоватьДляПолучения;
	ГруппаНаправления.Доступность = ОбаНаправления;
	
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	ТекущееНаправление = ЭтотОбъект[ИмяРеквизитаНаправления]; // Строка
	
	Если Объект.ИспользоватьДляОтправки И Не Объект.ИспользоватьДляПолучения Тогда
		Отправка = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, Отправка);
	ИначеЕсли Объект.ИспользоватьДляПолучения И Не Объект.ИспользоватьДляОтправки Тогда
		Получение = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
		Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, Получение);
	ИначеЕсли ОбаНаправления И Не ПустаяСтрока(ТекущееНаправление) Тогда
		Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, ТекущееНаправление);
	Иначе
		// Оба направления, направление ещё не выбрано.
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Текущая страница может быть скрыта по ОбластьПрименения, тогда платформа показывает первую видимую.
// 
// Возвращаемое значение:
//  Строка - Расш1 видимая страница обработчиков XDTO
//
&НаКлиенте
Функция Расш1_ВидимаяСтраницаОбработчиковXDTO()
	
	ТекущаяСтраница = Элементы.ОбработчикиXDTO.ТекущаяСтраница;
	Если ТекущаяСтраница <> Неопределено И ТекущаяСтраница.Видимость Тогда
		Возврат ТекущаяСтраница.Имя;
	КонецЕсли;
	
	Для Каждого Страница Из Элементы.ОбработчикиXDTO.ПодчиненныеЭлементы Цикл
		Если Страница.Видимость Тогда
			Возврат Страница.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура Расш1_НазначитьКонсольТекущейСтраницы()
	
	Если ЭтоКонвертацияXDTO Тогда
		Если Элементы.Страницы.ТекущаяСтраница.Имя = "Страница_ОбработчикиXDTO" Тогда
			Расш1_ПослеФормированияКонсолей();
		КонецЕсли;
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница.Имя = "Страница_ОбработчикиXML" Тогда
		Расш1_ПослеФормированияКонсолей();
	Иначе
		// Другая страница: консоль не назначается.
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Описание параметров страницы обработчика ПКО для подсказок консоли.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - текущая конвертация.
//  ОбъектКонфигурации - СправочникСсылка.Объекты - объект конфигурации правила.
//  Направление - Строка - Отправка, Получение или пустая строка.
//  ИмяСтраницы - Строка - имя страницы обработчика.
//  ЭтоКонвертацияXDTO - Булево - признак конвертации XDTO.
//  ОбъектКонфигурацииКорреспондент - СправочникСсылка.Объекты, Строка - объект корреспондента.
//  ИмяОбъектаФормата - Строка - объект формата правила.
//
// Возвращаемое значение:
//  Строка - JSON для updateMetadata.
//
&НаСервереБезКонтекста
Функция Расш1_ПолучитьОписаниеПараметровJSON(
		Знач Конвертация,
		Знач ОбъектКонфигурации,
		Знач Направление,
		Знач ИмяСтраницы,
		Знач ЭтоКонвертацияXDTO,
		Знач ОбъектКонфигурацииКорреспондент = "",
		Знач ИмяОбъектаФормата = "")
	
	Если ЭтоКонвертацияXDTO Тогда
		Возврат Расш1_ОписаниеПараметровXDTOJSON(
			Конвертация, ОбъектКонфигурации, Направление, ИмяСтраницы, ИмяОбъектаФормата);
	КонецЕсли;
	
	ОбъектСтраницы = ОбъектКонфигурации;
	ПрефиксПолучение = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Если Направление = ПрефиксПолучение Тогда
		ОбъектСтраницы = ОбъектКонфигурацииКорреспондент;
	КонецЕсли;
	ОписаниеОбъекта = Расш1_КоллекцияМетаданных.Расш1_ОписаниеВидаОбъектаКонфигурации(ОбъектСтраницы);
	ИменаПараметров = Расш1_ИменаПараметровПКО(ИмяСтраницы);
	ИменаОбъекта = Расш1_ИменаОбъектаПКО(ИмяСтраницы);
	Возврат Расш1_КоллекцияМетаданных.ОписаниеПараметровСтраницыJSON(
		ИменаПараметров, Конвертация, ОписаниеОбъекта, ИменаОбъекта);
	
КонецФункции

// Описание параметров страницы обработчика ПКО XDTO.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - текущая конвертация.
//  ОбъектКонфигурации - СправочникСсылка.Объекты - объект конфигурации правила.
//  Направление - Строка - Отправка, Получение или пустая строка.
//  ИмяСтраницы - Строка - имя страницы обработчика.
//  ИмяОбъектаФормата - Строка - объект формата правила.
//
// Возвращаемое значение:
//  Строка - JSON для updateMetadata или пустая строка.
//
&НаСервереБезКонтекста
Функция Расш1_ОписаниеПараметровXDTOJSON(Конвертация, ОбъектКонфигурации, Направление, ИмяСтраницы, ИмяОбъектаФормата)
	
	ЭтоСтраницаОтправки = ИмяСтраницы = "Страница_ПриОтправке";
	ЭтоСтраницаКонвертации = ИмяСтраницы = "Страница_ПриКонвертацииДанныхXDTO";
	ЭтоСтраницаПередЗаписью = ИмяСтраницы = "Страница_ПередЗаписьюПолученныхДанных";
	Если Не ЭтоСтраницаОтправки И Не ЭтоСтраницаКонвертации И Не ЭтоСтраницаПередЗаписью Тогда
		Возврат "";
	КонецЕсли;
	
	ПользовательскиеОбъекты = Новый Структура;
	
	НаправлениеКомпонент = Направление;
	Если ПустаяСтрока(НаправлениеКомпонент) И ЭтоСтраницаОтправки Тогда
		НаправлениеКомпонент = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	КонецЕсли;
	Если ПустаяСтрока(НаправлениеКомпонент) Тогда
		НаправлениеКомпонент = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	КонецЕсли;
	КомпонентыОбмена = Расш1_КоллекцияМетаданных.ПолучитьОписаниеКомпонентыОбмена(НаправлениеКомпонент);
	ПользовательскиеОбъекты.Вставить("КомпонентыОбмена", КомпонентыОбмена);
	
	ВидОбъекта = Расш1_КоллекцияМетаданных.Расш1_ОписаниеВидаОбъектаКонфигурации(ОбъектКонфигурации);
	Если Не ПустаяСтрока(ВидОбъекта) Тогда
		ДанныеИБ = Расш1_КоллекцияМетаданных.ПолучитьОписаниеДанныеИБ(ВидОбъекта);
		ПользовательскиеОбъекты.Вставить("ДанныеИБ", ДанныеИБ);
	КонецЕсли;
	
	ОписаниеДанныеXDTO = "";
	НужныДанныеXDTO = ЭтоСтраницаОтправки Или ЭтоСтраницаКонвертации;
	Если Не ПустаяСтрока(ИмяОбъектаФормата) И НужныДанныеXDTO Тогда
		ОписаниеДанныеXDTO = Расш1_КоллекцияМетаданных.ПолучитьОписаниеДанныеXDTO(Конвертация, ИмяОбъектаФормата);
	КонецЕсли;
	
	Если ЭтоСтраницаОтправки Тогда
		ПараметрыКонвертации = Расш1_КоллекцияМетаданных.ПолучитьОписаниеПараметрыКонвертации(Конвертация);
		ПользовательскиеОбъекты.Вставить("ПараметрыКонвертации", ПараметрыКонвертации);
		ПользовательскиеОбъекты.Вставить("ДанныеXDTO", ОписаниеДанныеXDTO);
		ПользовательскиеОбъекты.Вставить("СтекВыгрузки", "");
	КонецЕсли;
	Если ЭтоСтраницаКонвертации Тогда
		ПользовательскиеОбъекты.Вставить("ДанныеXDTO", ОписаниеДанныеXDTO);
		ПользовательскиеОбъекты.Вставить("ПолученныеДанные", "");
	КонецЕсли;
	Если ЭтоСтраницаПередЗаписью Тогда
		ПользовательскиеОбъекты.Вставить("КонвертацияСвойств", "");
		ПользовательскиеОбъекты.Вставить("ПолученныеДанные", "");
	КонецЕсли;
	
	ОписаниеПользовательскихОбъектов = Новый Структура;
	ОписаниеПользовательскихОбъектов.Вставить("customObjects", ПользовательскиеОбъекты);
	
	ОписаниеПользовательскихОбъектовJSON =
		Расш1_КоллекцияМетаданных.ПолучитьОписаниеМетаданныхJSON(ОписаниеПользовательскихОбъектов);
	
	Возврат ОписаниеПользовательскихОбъектовJSON;
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаПараметровПКО(ИмяСтраницы)
	
	ПараметрыВыгрузки = "Источник,ВходящиеДанные,ИсходящиеДанные,ИмяПКО,ПКО,ВыгруженныеОбъекты";
	
	ИменаПередВыгрузкой = Новый Массив; // Массив из Строка
	ИменаПередВыгрузкой.Добавить("Параметры,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные");
	ИменаПередВыгрузкой.Добавить("ИмяПКО,ПКО,ВыгруженныеОбъекты,Отказ,КлючВыгружаемыхДанных");
	ИменаПередВыгрузкой.Добавить("ЗапоминатьВыгруженные,НеЗапоминатьВыгруженные,НеЗамещатьОбъектПриЗагрузке");
	ИменаПередВыгрузкой.Добавить("НеСоздаватьЕслиНеНайден,ВсеОбъектыВыгружены,ТолькоПолучитьУзелСсылки");
	ИменаПередВыгрузкой.Добавить("РегистрироватьОбъектНаУзлеОтправителе,РежимЗаписи,РежимПроведения");
	
	ШаблонСписка = "%1,%2";
	ИменаПриВыгрузке = СтрШаблон(ШаблонСписка, ПараметрыВыгрузки,
		"КлючВыгружаемыхДанных,Отказ,СтандартнаяОбработка,Приемник,УзелСсылки");
	ИменаПослеВыгрузки = СтрШаблон(ШаблонСписка, ПараметрыВыгрузки,
		"КлючВыгружаемыхДанных,Отказ,Приемник,УзелСсылки");
	ИменаПослеВыгрузкиВФайл = СтрШаблон(ШаблонСписка, ПараметрыВыгрузки, "Приемник,УзелСсылки");
	ИменаПолейПоиска = СтрШаблон(ШаблонСписка,
		"НомерВариантаПоиска,СвойстваПоиска,ПараметрыОбъекта,ПрекратитьПоиск,СсылкаНаОбъект",
		"УстанавливатьУОбъектаВсеСвойстваПоиска,НастройкаПоиска,СтрокаИменСвойствПоиска");
	ИменаПередЗагрузкой = СтрШаблон(ШаблонСписка,
		"Отказ,Нпп,Источник,ИмяПравила,Правило,ГенерироватьНовыйНомерИлиКодЕслиНеУказан",
		"ТипОбъектаСтрокой,ТипОбъекта,НеЗамещатьОбъект,РежимЗаписи,РежимПроведения");
	
	Страницы = Новый Соответствие;
	ИменаПередВыгрузкойСтрокой = СтрСоединить(ИменаПередВыгрузкой, ",");
	Страницы.Вставить("Страница_ПередВыгрузкой", ИменаПередВыгрузкойСтрокой);
	Страницы.Вставить("Страница_ПриВыгрузке", ИменаПриВыгрузке);
	Страницы.Вставить("Страница_ПослеВыгрузки", ИменаПослеВыгрузки);
	Страницы.Вставить("Страница_ПослеВыгрузкиВФайл", ИменаПослеВыгрузкиВФайл);
	Страницы.Вставить("Страница_ПоляПоиска", ИменаПолейПоиска);
	Страницы.Вставить("Страница_ПередЗагрузкой", ИменаПередЗагрузкой);
	Страницы.Вставить("Страница_ПриЗагрузке", "ОбъектНайден,Объект,НеЗамещатьОбъект,ОбъектМодифицирован");
	Страницы.Вставить("Страница_ПослеЗагрузки",
		"Отказ,Объект,Ссылка,ОбъектНайден,ПараметрыОбъекта,ОбъектМодифицирован,ИмяТипаОбъекта,НаборЗаписей");
	
	Имена = Страницы.Получить(ИмяСтраницы);
	Если Имена = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Имена;
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаОбъектаПКО(ИмяСтраницы)
	
	СтраницыИсточника = СтрРазделить(
		"Страница_ПередВыгрузкой,Страница_ПриВыгрузке,Страница_ПослеВыгрузки,Страница_ПослеВыгрузкиВФайл",
		",");
	Если СтраницыИсточника.Найти(ИмяСтраницы) <> Неопределено Тогда
		Возврат "Источник";
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПриЗагрузке" Тогда
		Возврат "Объект";
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПослеЗагрузки" Тогда
		Возврат "Объект,Ссылка";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
