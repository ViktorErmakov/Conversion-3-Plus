#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ТекстСообщения = НСтр("ru = 'Конвертация данных не передана на текущую форму'");
	ОбщегоНазначенияКлиентСервер.Проверить(ЗначениеЗаполнено(Параметры.Конвертация), ТекстСообщения);
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = "Алгоритм";
	Если Не ЭтоКонвертацияXDTO Тогда
		Опции.ПоказыватьНаправление = Ложь;
		Если Объект.ИспользуетсяПриЗагрузке Тогда
			Опции.АвтоНаправление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
		Иначе
			Опции.АвтоНаправление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		КонецЕсли;
		Элементы.ИспользуетсяПриЗагрузке.УстановитьДействие(
			"ПриИзменении", "Расш1_Подключаемый_ИспользуетсяПриЗагрузкеПриИзменении");
	КонецЕсли;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.Алгоритм, Опции);
	Расш1_КонсольКода.СоздатьХостКонсоли(ЭтотОбъект, ЭтотОбъект, "", Элементы.Алгоритм);
	
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, "Конвертация", "СправочникСсылка.Конвертации");
	ЭтотОбъект["Конвертация"] = Параметры.Конвертация;
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, "Направление", "Строка");
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
	Если ЭтоКонвертацияXDTO Тогда
		ИмяРеквизита = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
		ИмяРеквизитаОткрытия = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФорматаОткрытия();
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизита, "Строка");
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаОткрытия, "Строка");
		ОбъектФормата = "";
		Если Параметры.Свойство(ИмяРеквизита, ОбъектФормата) Тогда
			ОбъектФормата = СокрЛП(ОбъектФормата);
			ЭтотОбъект[ИмяРеквизита] = ОбъектФормата;
			ЭтотОбъект[ИмяРеквизитаОткрытия] = ОбъектФормата;
		КонецЕсли;
		Элементы.Код.УстановитьДействие("ПриИзменении", "Расш1_Подключаемый_КодПриИзменении");
		Элементы.Параметры.УстановитьДействие("ПриИзменении", "Расш1_Подключаемый_ПараметрыПриИзменении");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, "Алгоритм");
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект["Конвертация"]);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия);
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Расш1_Подключаемый_ИспользуетсяПриЗагрузкеПриИзменении(Элемент)
	
	Если Объект.ИспользуетсяПриЗагрузке Тогда
		НаправлениеАлгоритма = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Иначе
		НаправлениеАлгоритма = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	КонецЕсли;
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, НаправлениеАлгоритма);
	ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_КодПриИзменении(Элемент)
	
	ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_ПараметрыПриИзменении(Элемент)
	
	ПослеФормированияКонсолей();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Если Расш1_КонсольКодаКлиент.ЭтоКомандаНаправления(Команда) Тогда
		ПриИзмененииНаправления(Команда);
	ИначеЕсли СтрНачинаетсяС(Команда.Имя, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОбъектаФормата()) Тогда
		Расш1_ВыбратьОбъектФормата(Команда);
	Иначе
		Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриИзмененииНаправления(Команда)
	
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, Элементы[Команда.Имя].Заголовок);
	ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ВыбратьОбъектФормата(Команда)
	
	ИмяРеквизита = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	ЭтотОбъект[ИмяРеквизита] = Элементы[Команда.Имя].Заголовок;
	Группа = Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяГруппыОбъектаФорматаХоста());
	Если Группа <> Неопределено Тогда
		Группа.Заголовок = ЭтотОбъект[ИмяРеквизита];
	КонецЕсли;
	ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеФормированияКонсолей()
	
	Если ЭтоКонвертацияXDTO Тогда
		Расш1_ОбновитьМенюОбъектовФормата();
	КонецЕсли;
	
	ИмяОбъектаФормата = "";
	Если ЭтоКонвертацияXDTO Тогда
		ИмяОбъектаФормата = ЭтотОбъект[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата()];
	КонецЕсли;
	
	ОписаниеПользовательскихОбъектовJSON = ПолучитьОписаниеПараметровJSON(
		ЭтотОбъект["Направление"],
		ЭтотОбъект["Конвертация"],
		Объект.Параметры,
		ЭтоКонвертацияXDTO,
		ИмяОбъектаФормата);
	Если ПустаяСтрока(ОписаниеПользовательскихОбъектовJSON) Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(
		ЭтотОбъект,
		Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли(),
		ОписаниеПользовательскихОбъектовJSON);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ОбновитьМенюОбъектовФормата()
	
	Если Не ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	Имена = Расш1_КоллекцияМетаданных.Расш1_ОбъектыФорматаВызововАлгоритма(
		ЭтотОбъект["Конвертация"], Объект.Код);
	ИмяОткрытия = СокрЛП(ЭтотОбъект[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФорматаОткрытия()]);
	Если Не ПустаяСтрока(ИмяОткрытия) И Расш1_ИндексИмени(Имена, ИмяОткрытия) = Неопределено Тогда
		Имена.Добавить(ИмяОткрытия);
	КонецЕсли;
	
	Выбранный = СокрЛП(ЭтотОбъект[ИмяРеквизита]);
	ИндексВыбранного = Расш1_ИндексИмени(Имена, Выбранный);
	Если ПустаяСтрока(Выбранный) Или ИндексВыбранного = Неопределено Тогда
		Если Имена.Количество() = 1 Тогда
			Выбранный = Имена[0];
		Иначе
			Выбранный = "";
		КонецЕсли;
	Иначе
		Выбранный = Имена[ИндексВыбранного];
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизита] = Выбранный;
	
	Группа = Расш1_ГруппаОбъектаФормата();
	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Расш1_ОчиститьМенюОбъектовФормата(Группа);
	Группа.Видимость = Имена.Количество() > 1;
	Если ПустаяСтрока(Выбранный) Тогда
		Группа.Заголовок = НСтр("ru = 'Объект XDTO'");
	Иначе
		Группа.Заголовок = Выбранный;
	КонецЕсли;
	
	Номер = 0;
	Для Каждого ИмяОбъекта Из Имена Цикл
		Номер = Номер + 1;
		ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОбъектаФормата() + Формат(Номер, "ЧГ=0");
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = Расш1_КонсольКодаКлиентСервер.ИмяОбработчикаКомандыКонсоли();
		Команда.Заголовок = ИмяОбъекта;
		Кнопка = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Группа);
		Кнопка.ИмяКоманды = ИмяКоманды;
		Кнопка.Заголовок = ИмяОбъекта;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция Расш1_ГруппаОбъектаФормата()
	
	ИмяГруппы = Расш1_КонсольКодаКлиентСервер.ИмяГруппыОбъектаФорматаХоста();
	Группа = Элементы.Найти(ИмяГруппы);
	Если Группа <> Неопределено Тогда
		Возврат Группа;
	КонецЕсли;
	
	Панель = Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяПанелиКомандХоста());
	Если Панель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭлементПеред = Неопределено;
	Если Панель.ПодчиненныеЭлементы.Количество() > 0 Тогда
		ЭлементПеред = Панель.ПодчиненныеЭлементы[0];
	КонецЕсли;
	Группа = Элементы.Вставить(ИмяГруппы, Тип("ГруппаФормы"), Панель, ЭлементПеред);
	Группа.Вид = ВидГруппыФормы.Подменю;
	Группа.Заголовок = НСтр("ru = 'Объект XDTO'");
	Группа.Фигура = ФигураКнопки.Овал;
	Группа.Видимость = Ложь;
	
	Возврат Группа;
	
КонецФункции

&НаСервере
Процедура Расш1_ОчиститьМенюОбъектовФормата(Группа)
	
	Удаляемые = Новый Массив;
	Для Каждого Элемент Из Группа.ПодчиненныеЭлементы Цикл
		Удаляемые.Добавить(Элемент);
	КонецЦикла;
	
	Для Каждого Элемент Из Удаляемые Цикл
		ИмяКоманды = Элемент.ИмяКоманды;
		Элементы.Удалить(Элемент);
		Команда = Команды.Найти(ИмяКоманды);
		Если Команда <> Неопределено Тогда
			Команды.Удалить(Команда);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ИндексИмени(Имена, Имя)
	
	ИмяНижнее = НРег(Имя);
	Индекс = 0;
	Для Каждого ИмяОбъекта Из Имена Цикл
		Если НРег(ИмяОбъекта) = ИмяНижнее Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОписаниеПараметровJSON(
		Знач Направление, Знач Конвертация, Параметры, Знач ЭтоКонвертацияXDTO, Знач ИмяОбъектаФормата)
	
	ПользовательскиеОбъекты = Новый Структура;
	
	Если ЭтоКонвертацияXDTO И Не ПустаяСтрока(Направление) Тогда
		КомпонентыОбмена = Расш1_КоллекцияМетаданных.ПолучитьОписаниеКомпонентыОбмена(Направление);
		ПользовательскиеОбъекты.Вставить("КомпонентыОбмена", КомпонентыОбмена);
	КонецЕсли;
	
	ОписаниеДанныеXDTO = "";
	Если ЭтоКонвертацияXDTO И Не ПустаяСтрока(ИмяОбъектаФормата) Тогда
		ОписаниеДанныеXDTO = Расш1_КоллекцияМетаданных.ПолучитьОписаниеДанныеXDTO(Конвертация, ИмяОбъектаФормата);
	КонецЕсли;
	
	ПараметрыАлгоритма = Параметры;
	Если Не ПустаяСтрока(ПараметрыАлгоритма) Тогда
		СписокПараметров = СтрРазделить(ПараметрыАлгоритма, ",", Ложь);
		Для Каждого Параметр Из СписокПараметров Цикл
			ПозицияЗнакаРавно = СтрНайти(Параметр, "=");
			Если ПозицияЗнакаРавно = 0 Тогда
				ИмяПараметра = СокрЛП(Параметр);
			Иначе
				ИмяПараметра = СокрЛП(Лев(Параметр, ПозицияЗнакаРавно - 1));
			КонецЕсли;
			Если НРег(ИмяПараметра) = "данныеxdto" Тогда
				ПользовательскиеОбъекты.Вставить(ИмяПараметра, ОписаниеДанныеXDTO);
			ИначеЕсли Не ПользовательскиеОбъекты.Свойство(ИмяПараметра) Тогда
				ПользовательскиеОбъекты.Вставить(ИмяПараметра, "");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОписаниеПользовательскихОбъектов = Новый Структура;
	ОписаниеПользовательскихОбъектов.Вставить("customObjects", ПользовательскиеОбъекты);
	
	Возврат Расш1_КоллекцияМетаданных.ПолучитьОписаниеМетаданныхJSON(ОписаниеПользовательскихОбъектов);
	
КонецФункции

#КонецОбласти
