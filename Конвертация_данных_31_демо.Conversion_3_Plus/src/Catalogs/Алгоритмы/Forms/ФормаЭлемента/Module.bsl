// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ТекстСообщения = НСтр("ru = 'Конвертация данных не передана на текущую форму'");
	КонвертацияЗаполнена = ЗначениеЗаполнено(Параметры.Конвертация);
	ОбщегоНазначенияКлиентСервер.Проверить(КонвертацияЗаполнена, ТекстСообщения);
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = "ПриИзменении";
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = "Алгоритм";
	ТипРеквизитаСтрока = "Строка";
	Если Не ЭтоКонвертацияXDTO Тогда
		Опции.ПоказыватьНаправление = Ложь;
		Если Объект.ИспользуетсяПриЗагрузке Тогда
			Опции.АвтоНаправление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
		Иначе
			Опции.АвтоНаправление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		КонецЕсли;
		Элементы.ИспользуетсяПриЗагрузке.УстановитьДействие(
			ИмяСобытия, "Расш1_Подключаемый_ИспользуетсяПриЗагрузкеПриИзменении");
	КонецЕсли;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.Алгоритм, Опции);
	Расш1_КонсольКода.СоздатьХостКонсоли(ЭтотОбъект, ЭтотОбъект, "", Элементы.Алгоритм);
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаКонвертации, "СправочникСсылка.Конвертации");
	ЭтотОбъект[ИмяРеквизитаКонвертации] = Параметры.Конвертация;
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаНаправления, ТипРеквизитаСтрока);
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
	Если ЭтоКонвертацияXDTO Тогда
		ИмяРеквизитаФормата = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
		ИмяРеквизитаОткрытия = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФорматаОткрытия();
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаФормата, ТипРеквизитаСтрока);
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаОткрытия, ТипРеквизитаСтрока);
		ОбъектФормата = "";
		Если Параметры.Свойство(ИмяРеквизитаФормата, ОбъектФормата) Тогда
			ОбъектФормата = СокрЛП(ОбъектФормата);
			ЭтотОбъект[ИмяРеквизитаФормата] = ОбъектФормата;
			ЭтотОбъект[ИмяРеквизитаОткрытия] = ОбъектФормата;
		КонецЕсли;
		Элементы.Код.УстановитьДействие(ИмяСобытия, "Расш1_Подключаемый_КодПриИзменении");
		Элементы.Параметры.УстановитьДействие(ИмяСобытия, "Расш1_Подключаемый_ПараметрыПриИзменении");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, "Алгоритм");
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект[ИмяРеквизитаКонвертации]);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия) Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик изменения флажка «Используется при загрузке».
//
// Параметры:
//  Элемент - ПолеФормы - флажок формы.
//
&НаКлиенте
Процедура Расш1_Подключаемый_ИспользуетсяПриЗагрузкеПриИзменении(Элемент)
	
	Если Объект.ИспользуетсяПриЗагрузке Тогда
		НаправлениеАлгоритма = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Иначе
		НаправлениеАлгоритма = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	КонецЕсли;
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, НаправлениеАлгоритма);
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// Обработчик события ДокументСформирован поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

// Обработчик изменения кода алгоритма.
//
// Параметры:
//  Элемент - ПолеФормы - поле кода.
//
&НаКлиенте
Процедура Расш1_Подключаемый_КодПриИзменении(Элемент)
	
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// Обработчик изменения параметров алгоритма.
//
// Параметры:
//  Элемент - ПолеФормы - поле параметров.
//
&НаКлиенте
Процедура Расш1_Подключаемый_ПараметрыПриИзменении(Элемент)
	
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// Обработчик команд консоли.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	ПрефиксОбъектаФормата = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОбъектаФормата();
	Если Расш1_КонсольКодаКлиент.ЭтоКомандаНаправления(Команда) Тогда
		Расш1_ПриИзмененииНаправления(Команда);
	ИначеЕсли СтрНачинаетсяС(Команда.Имя, ПрефиксОбъектаФормата) Тогда
		Расш1_ВыбратьОбъектФормата(Команда);
	Иначе
		Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	КонецЕсли;
	
КонецПроцедуры

// Подменю командной панели к этому моменту уже закрыто.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

// Устанавливает направление по заголовку кнопки команды.
//
// Параметры:
//  Команда - КомандаФормы - команда направления.
//
&НаКлиенте
Процедура Расш1_ПриИзмененииНаправления(Команда)
	
	ИмяКоманды = Команда.Имя;
	КнопкаКоманды = Элементы[ИмяКоманды]; // КнопкаФормы
	ЗаголовокКоманды = КнопкаКоманды.Заголовок;
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, ЗаголовокКоманды);
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// Выбирает объект формата по заголовку кнопки подменю.
//
// Параметры:
//  Команда - КомандаФормы - команда выбора объекта формата.
//
&НаКлиенте
Процедура Расш1_ВыбратьОбъектФормата(Команда)
	
	ИмяРеквизитаФормата = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	ИмяКоманды = Команда.Имя;
	КнопкаКоманды = Элементы[ИмяКоманды]; // КнопкаФормы
	ИмяОбъектаФормата = КнопкаКоманды.Заголовок;
	ЭтотОбъект[ИмяРеквизитаФормата] = ИмяОбъектаФормата;
	ИмяГруппы = Расш1_КонсольКодаКлиентСервер.ИмяГруппыОбъектаФорматаХоста();
	Группа = Элементы.Найти(ИмяГруппы);
	Если Группа <> Неопределено Тогда
		ЗаголовокГруппы = ЭтотОбъект[ИмяРеквизитаФормата]; // Строка
		Группа.Заголовок = ЗаголовокГруппы;
	КонецЕсли;
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеФормированияКонсолей()
	
	ИмяОбъектаФормата = "";
	Если ЭтоКонвертацияXDTO Тогда
		Расш1_ОбновитьМенюОбъектовФормата();
		ИмяРеквизитаОбъекта = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
		ИмяОбъектаФормата = ЭтотОбъект[ИмяРеквизитаОбъекта]; // Строка
	КонецЕсли;
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Направление = ЭтотОбъект[ИмяРеквизитаНаправления]; // Строка
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	ОписаниеПользовательскихОбъектовJSON = Расш1_ПолучитьОписаниеПараметровJSON(
		Направление,
		Конвертация,
		Объект.Параметры,
		ЭтоКонвертацияXDTO,
		ИмяОбъектаФормата);
	Если ПустаяСтрока(ОписаниеПользовательскихОбъектовJSON) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(ЭтотОбъект, ИмяХоста, ОписаниеПользовательскихОбъектовJSON);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ОбновитьМенюОбъектовФормата()
	
	Если Не ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаФормата = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	ИмяРеквизитаОткрытия = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФорматаОткрытия();
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	Имена = Расш1_КоллекцияМетаданных.Расш1_ОбъектыФорматаВызововАлгоритма(Конвертация, Объект.Код);
	ЗначениеОткрытия = ЭтотОбъект[ИмяРеквизитаОткрытия]; // Строка
	ИмяОткрытия = СокрЛП(ЗначениеОткрытия);
	Если Не ПустаяСтрока(ИмяОткрытия) И Расш1_ИндексИмени(Имена, ИмяОткрытия) = Неопределено Тогда
		Имена.Добавить(ИмяОткрытия);
	КонецЕсли;
	
	ЗначениеВыбранного = ЭтотОбъект[ИмяРеквизитаФормата]; // Строка
	Выбранный = СокрЛП(ЗначениеВыбранного);
	ИндексВыбранного = Расш1_ИндексИмени(Имена, Выбранный);
	Если ПустаяСтрока(Выбранный) Или ИндексВыбранного = Неопределено Тогда
		Если Имена.Количество() = 1 Тогда
			Выбранный = Имена[0];
		Иначе
			Выбранный = "";
		КонецЕсли;
	Иначе
		Выбранный = Имена[ИндексВыбранного];
	КонецЕсли;
	ЭтотОбъект[ИмяРеквизитаФормата] = Выбранный;
	
	Группа = Расш1_ГруппаОбъектаФормата();
	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Расш1_ОчиститьМенюОбъектовФормата(Группа);
	Группа.Видимость = Имена.Количество() > 1;
	Если ПустаяСтрока(Выбранный) Тогда
		Группа.Заголовок = НСтр("ru = 'Объект XDTO'");
	Иначе
		Группа.Заголовок = Выбранный;
	КонецЕсли;
	
	ПрефиксКоманды = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОбъектаФормата();
	ИмяОбработчика = Расш1_КонсольКодаКлиентСервер.ИмяОбработчикаКомандыКонсоли();
	ТипКнопки = Тип("КнопкаФормы");
	Номер = 0;
	Для Каждого ИмяОбъекта Из Имена Цикл
		Номер = Номер + 1;
		НомерСтрокой = Формат(Номер, "ЧГ=0");
		ИмяКоманды = СтрШаблон("%1%2", ПрефиксКоманды, НомерСтрокой);
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяОбработчика;
		Команда.Заголовок = ИмяОбъекта;
		Кнопка = Элементы.Добавить(ИмяКоманды, ТипКнопки, Группа);
		Кнопка.ИмяКоманды = ИмяКоманды;
		Кнопка.Заголовок = ИмяОбъекта;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция Расш1_ГруппаОбъектаФормата()
	
	ИмяГруппы = Расш1_КонсольКодаКлиентСервер.ИмяГруппыОбъектаФорматаХоста();
	Группа = Элементы.Найти(ИмяГруппы);
	Если Группа <> Неопределено Тогда
		Возврат Группа;
	КонецЕсли;
	
	ИмяПанели = Расш1_КонсольКодаКлиентСервер.ИмяПанелиКомандХоста();
	Панель = Элементы.Найти(ИмяПанели);
	Если Панель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭлементПеред = Неопределено;
	Если Панель.ПодчиненныеЭлементы.Количество() > 0 Тогда
		ЭлементПеред = Панель.ПодчиненныеЭлементы[0];
	КонецЕсли;
	ТипГруппы = Тип("ГруппаФормы");
	Группа = Элементы.Вставить(ИмяГруппы, ТипГруппы, Панель, ЭлементПеред);
	Группа.Вид = ВидГруппыФормы.Подменю;
	Группа.Заголовок = НСтр("ru = 'Объект XDTO'");
	Группа.Фигура = ФигураКнопки.Овал;
	Группа.Видимость = Ложь;
	
	Возврат Группа;
	
КонецФункции

&НаСервере
Процедура Расш1_ОчиститьМенюОбъектовФормата(Группа)
	
	Удаляемые = Новый Массив; // Массив из КнопкаФормы
	Для Каждого Элемент Из Группа.ПодчиненныеЭлементы Цикл
		Кнопка = Элемент; // КнопкаФормы
		Удаляемые.Добавить(Кнопка);
	КонецЦикла;
	
	Для Каждого УдаляемаяКнопка Из Удаляемые Цикл
		ИмяКоманды = УдаляемаяКнопка.ИмяКоманды;
		Элементы.Удалить(УдаляемаяКнопка);
		Команда = Команды.Найти(ИмяКоманды);
		Если Команда <> Неопределено Тогда
			Команды.Удалить(Команда);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ИндексИмени(Имена, Имя)
	
	ИмяНижнее = НРег(Имя);
	Индекс = 0;
	Для Каждого ИмяОбъекта Из Имена Цикл
		Если НРег(ИмяОбъекта) = ИмяНижнее Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Описание параметров алгоритма для подсказок консоли.
//
// Параметры:
//  Направление - Строка - Отправка, Получение или пустая строка.
//  Конвертация - СправочникСсылка.Конвертации - текущая конвертация.
//  Параметры - Строка - параметры алгоритма через запятую.
//  ЭтоКонвертацияXDTO - Булево - признак конвертации XDTO.
//  ИмяОбъектаФормата - Строка - выбранный объект формата.
//
// Возвращаемое значение:
//  Строка - JSON для updateMetadata.
//
&НаСервереБезКонтекста
Функция Расш1_ПолучитьОписаниеПараметровJSON(
		Знач Направление, Знач Конвертация, Знач Параметры, Знач ЭтоКонвертацияXDTO, Знач ИмяОбъектаФормата)
	
	ПользовательскиеОбъекты = Новый Структура;
	
	Если ЭтоКонвертацияXDTO Тогда
		НаправлениеКомпонент = Направление;
		Если ПустаяСтрока(НаправлениеКомпонент) Тогда
			НаправлениеКомпонент = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		КонецЕсли;
		КомпонентыОбмена = Расш1_КоллекцияМетаданных.ПолучитьОписаниеКомпонентыОбмена(НаправлениеКомпонент);
		ПользовательскиеОбъекты.Вставить("КомпонентыОбмена", КомпонентыОбмена);
	КонецЕсли;
	
	ОписаниеДанныеXDTO = "";
	Если ЭтоКонвертацияXDTO И Не ПустаяСтрока(ИмяОбъектаФормата) Тогда
		ОписаниеДанныеXDTO = Расш1_КоллекцияМетаданных.ПолучитьОписаниеДанныеXDTO(Конвертация, ИмяОбъектаФормата);
	КонецЕсли;
	
	Расш1_ДобавитьПараметрыАлгоритма(ПользовательскиеОбъекты, Параметры, ОписаниеДанныеXDTO);
	
	ОписаниеПользовательскихОбъектов = Новый Структура;
	ОписаниеПользовательскихОбъектов.Вставить("customObjects", ПользовательскиеОбъекты);
	
	Возврат Расш1_КоллекцияМетаданных.ПолучитьОписаниеМетаданныхJSON(ОписаниеПользовательскихОбъектов);
	
КонецФункции

&НаСервереБезКонтекста
Процедура Расш1_ДобавитьПараметрыАлгоритма(ПользовательскиеОбъекты, Параметры, ОписаниеДанныеXDTO)
	
	СписокПараметров = СтрРазделить(Параметры, ",", Ложь);
	Для Каждого Параметр Из СписокПараметров Цикл
		ЧастиПараметра = СтрРазделить(Параметр, "=");
		ИмяПараметра = СокрЛП(ЧастиПараметра[0]);
		Если НРег(ИмяПараметра) = "данныеxdto" Тогда
			ПользовательскиеОбъекты.Вставить(ИмяПараметра, ОписаниеДанныеXDTO);
			Продолжить;
		КонецЕсли;
		Если Не ПользовательскиеОбъекты.Свойство(ИмяПараметра) Тогда
			ПользовательскиеОбъекты.Вставить(ИмяПараметра, "");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
