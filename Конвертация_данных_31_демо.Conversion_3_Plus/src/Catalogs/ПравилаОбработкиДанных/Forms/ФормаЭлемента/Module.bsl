// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ТекстСообщения = НСтр("ru = 'Конвертация данных не передана на текущую форму'");
	КонвертацияПередана = ЗначениеЗаполнено(Параметры.Конвертация);
	ОбщегоНазначенияКлиентСервер.Проверить(КонвертацияПередана, ТекстСообщения);
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	
	Если КонвертацияXDTO Тогда
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ПриОбработке";
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмПриОбработке, Опции);
		
		Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
		Опции.ИмяСтраницы = "Страница_ВыборкаДанных";
		Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.АлгоритмВыборкаДанных, Опции);
		
		Расш1_КонсольКода.СоздатьХостКонсоли(
			ЭтотОбъект, Элементы.ОбработчикиСобытийXDTO, "СтраницыОбработчикиXDTO", Неопределено, Истина);
		
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаКонвертации, "СправочникСсылка.Конвертации");
		ЭтотОбъект[ИмяРеквизитаКонвертации] = Параметры.Конвертация;
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаНаправления, "Строка");
		
		Элементы.Страницы.УстановитьДействие(
			"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыПриСменеСтраницы");
		Элементы.СтраницыОбработчикиXDTO.УстановитьДействие(
			"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыОбработчикиXDTOПриСменеСтраницы");
		
	Иначе
		
		Отправка = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
		Расш1_ЗарегистрироватьАлгоритмСтраницы(Элементы.АлгоритмПередОбработкойПравила, "ПередОбработкой", Отправка);
		Расш1_ЗарегистрироватьАлгоритмСтраницы(Элементы.АлгоритмПередВыгрузкойОбъекта, "ПередВыгрузкой", Отправка);
		Расш1_ЗарегистрироватьАлгоритмСтраницы(Элементы.АлгоритмПослеВыгрузкиОбъекта, "ПослеВыгрузки", Отправка);
		Расш1_ЗарегистрироватьАлгоритмСтраницы(Элементы.АлгоритмПослеОбработкиПравила, "ПослеОбработки", Отправка);
		
		Расш1_КонсольКода.СоздатьХостКонсоли(
			ЭтотОбъект, Элементы.ОбработчикиСобытийXML, "СтраницыОбработчикиXML", Неопределено, Истина);
		
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаКонвертации, "СправочникСсылка.Конвертации");
		ЭтотОбъект[ИмяРеквизитаКонвертации] = Параметры.Конвертация;
		Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаНаправления, "Строка");
		
		Элементы.Страницы.УстановитьДействие(
			"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыПриСменеСтраницы");
		Элементы.СтраницыОбработчикиXML.УстановитьДействие(
			"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыОбработчикиXMLПриСменеСтраницы");
		
	КонецЕсли;
	
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Если КонвертацияXDTO Тогда
		Расш1_СтраницыОбработчиковКлиент.АктивироватьЕдинственныйЗаполненныйОбработчик(
			Элементы.СтраницыОбработчикиXDTO, Объект);
	Иначе
		Расш1_СтраницыОбработчиковКлиент.АктивироватьЕдинственныйЗаполненныйОбработчик(
			Элементы.СтраницыОбработчикиXML, Объект);
	КонецЕсли;
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект[ИмяРеквизитаКонвертации]);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия) Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик смены основной страницы формы.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ОбработчикиСобытийXDTO" Тогда
		Расш1_ПослеФормированияКонсолей("Страница_ПриОбработке");
	ИначеЕсли ТекущаяСтраница.Имя = "ОбработчикиСобытийXML" Тогда
		Расш1_ПослеФормированияКонсолей("ПередОбработкой");
	Иначе
		// Другая страница: консоль не открывается.
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены страницы обработчиков XML.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_СтраницыОбработчикиXMLПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Расш1_ПослеФормированияКонсолей(ТекущаяСтраница.Имя);
	
КонецПроцедуры

// Обработчик смены страницы обработчиков XDTO.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_СтраницыОбработчикиXDTOПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Расш1_ПослеФормированияКонсолей(ТекущаяСтраница.Имя);
	
КонецПроцедуры

// Обработчик события ДокументСформирован поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

// После смены направления правила обновляет консоль.
//
// Параметры:
//  Элемент - ПолеФормы - поле направления.
//
&После("ИспользоватьДляОтправкиПриИзменении")
&НаКлиенте
Процедура Расш1_ИспользоватьДляОтправкиПриИзмененииПосле(Элемент)
	
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// После смены объекта выборки обновляет консоль.
//
// Параметры:
//  Элемент - ПолеФормы - поле объекта выборки.
//
&После("ОбъектВыборкиПриИзменении")
&НаКлиенте
Процедура Расш1_ОбъектВыборкиПриИзмененииПосле(Элемент)
	
	Расш1_ПослеФормированияКонсолей();
	
КонецПроцедуры

// Обработчик команд консоли.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Если Расш1_КонсольКодаКлиент.ЭтоКомандаНаправления(Команда) Тогда
		ИмяКоманды = Команда.Имя;
		КнопкаКоманды = Элементы[ИмяКоманды]; // КнопкаФормы
		ЗаголовокКоманды = КнопкаКоманды.Заголовок;
		Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, ЗаголовокКоманды);
		Расш1_ПослеФормированияКонсолей();
	Иначе
		Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	КонецЕсли;
	
КонецПроцедуры

// Подменю командной панели к этому моменту уже закрыто.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеФормированияКонсолей(ИмяСтраницы = "")
	
	Если Не КонвертацияXDTO Тогда
		Расш1_ПоказатьКонсольXML(ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя <> "ОбработчикиСобытийXDTO" Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСтраницы) Тогда
		ИмяСтраницы = Элементы.СтраницыОбработчикиXDTO.ТекущаяСтраница.Имя;
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ВыборкаДанных" И Не Объект.ИспользоватьДляОтправки Тогда
		Возврат;
	КонецЕсли;
	
	Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Если Объект.ИспользоватьДляОтправки Тогда
		Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	КонецЕсли;
	Расш1_КонсольКодаКлиент.УстановитьНаправление(ЭтотОбъект, Направление);
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, ИмяСтраницы);
	
	ИмяГруппыНаправления = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
	ГруппаНаправления = Элементы.Найти(ИмяГруппыНаправления);
	Если ГруппаНаправления <> Неопределено Тогда
		ГруппаНаправления.Доступность = Ложь;
	КонецЕсли;
	
	ИспользованиеПКО = Расш1_ЗаполнитьПараметрИспользованиеПКО();
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	ОписаниеПользовательскихОбъектовJSON =
		Расш1_ПолучитьОписаниеПараметровJSON(
			Конвертация, Объект.ОбъектВыборки, Объект.ИспользоватьДляОтправки,
			ИспользованиеПКО);
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(ЭтотОбъект, ИмяХоста, ОписаниеПользовательскихОбъектовJSON);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ПолучитьОписаниеПараметровJSON(
		Знач Конвертация, Знач ОбъектКонфигурации, Знач ИспользоватьДляОтправки, Знач ИспользованиеПКО)
	
	ПользовательскиеОбъекты = Новый Структура;
	
	Если ИспользоватьДляОтправки Тогда
		Направление = "Отправка";
	Иначе
		Направление = "Получение";
	КонецЕсли;
	
	КомпонентыОбмена = Расш1_КоллекцияМетаданных.ПолучитьОписаниеКомпонентыОбмена(Направление);
	ПользовательскиеОбъекты.Вставить("КомпонентыОбмена", КомпонентыОбмена);
	
	Если Не ПустаяСтрока(ОбъектКонфигурации) И ИспользоватьДляОтправки Тогда
		ДанныеИБ = Расш1_КоллекцияМетаданных.ПолучитьОписаниеДанныеИБ(ОбъектКонфигурации);
		ПользовательскиеОбъекты.Вставить("ДанныеИБ", ДанныеИБ);
	КонецЕсли;
	
	Если ИспользованиеПКО.Количество() > 0 Тогда
		ИспользованиеПКОJson = Расш1_КоллекцияМетаданных.ПолучитьОписаниеИспользованиеПКО(ИспользованиеПКО);
		ПользовательскиеОбъекты.Вставить("ИспользованиеПКО", ИспользованиеПКОJson);
	КонецЕсли;
	
	ОписаниеПользовательскихОбъектов = Новый Структура;
	ОписаниеПользовательскихОбъектов.Вставить("customObjects", ПользовательскиеОбъекты);
	
	ОписаниеПользовательскихОбъектовJSON =
		Расш1_КоллекцияМетаданных.ПолучитьОписаниеМетаданныхJSON(ОписаниеПользовательскихОбъектов);
	
	Возврат ОписаниеПользовательскихОбъектовJSON;
	
КонецФункции

&НаКлиенте
Функция Расш1_ЗаполнитьПараметрИспользованиеПКО()
	
	ИспользованиеПКО = Новый Структура;
	
	Если Элементы.СтраницыОбработчикиXDTO.ТекущаяСтраница.Имя <> "Страница_ПриОбработке" Тогда
		Возврат ИспользованиеПКО;
	КонецЕсли;
	
	Если ИспользоватьНесколькоПравилКонвертации Тогда
		Для Каждого СтрокаПравил Из Объект.ПравилаКонвертацииОбъектов Цикл
			Если Не ПустаяСтрока(СтрокаПравил.ПравилоКонвертацииОбъекта) Тогда
				ИспользованиеПКО.Вставить(СтрокаПравил.ПравилоКонвертацииОбъекта, Истина);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Не ПустаяСтрока(Объект.ПравилоКонвертацииОбъекта) Тогда
		ИспользованиеПКО.Вставить(Объект.ПравилоКонвертацииОбъекта, Истина);
	КонецЕсли;
	
	Возврат ИспользованиеПКО;
	
КонецФункции

&НаСервере
Процедура Расш1_ЗарегистрироватьАлгоритмСтраницы(ЭлементАлгоритма, ИмяСтраницы, Направление)
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = ИмяСтраницы;
	Опции.ПоказыватьНаправление = Ложь;
	Опции.АвтоНаправление = Направление;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, ЭлементАлгоритма, Опции);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПоказатьКонсольXML(ИмяСтраницы)
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя <> "ОбработчикиСобытийXML" Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСтраницы) Тогда
		ИмяСтраницы = Элементы.СтраницыОбработчикиXML.ТекущаяСтраница.Имя;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, ИмяСтраницы);
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Направление = ЭтотОбъект[ИмяРеквизитаНаправления]; // Строка
	Если ПустаяСтрока(Направление) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	ОписаниеПользовательскихОбъектовJSON = Расш1_ОписаниеПараметровСтраницыXML(
		Конвертация, ИмяСтраницы, Объект.ОбъектВыборки);
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(ЭтотОбъект, ИмяХоста, ОписаниеПользовательскихОбъектовJSON);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ОписаниеПараметровСтраницыXML(Знач Конвертация, Знач ИмяСтраницы, Знач ОбъектВыборки)
	
	ИменаПараметров = Расш1_ИменаПараметровСтраницыXML(ИмяСтраницы);
	Возврат Расш1_КоллекцияМетаданных.ОписаниеПараметровСтраницыJSON(
		ИменаПараметров, Конвертация, ОбъектВыборки, "Объект");
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаПараметровСтраницыXML(ИмяСтраницы)
	
	Страницы = Новый Соответствие;
	Страницы.Вставить("ПередОбработкой", "Отказ,Параметры,ИмяПКО,Правило,ИсходящиеДанные,ВыборкаДанных");
	Страницы.Вставить("ПередВыгрузкой", "Отказ,Параметры,ИмяПКО,Правило,ВходящиеДанные,ИсходящиеДанные,Объект");
	Страницы.Вставить("ПослеВыгрузки", "Параметры,Объект,ИмяПКО,ВходящиеДанные,ИсходящиеДанные,УзелСсылки");
	Страницы.Вставить("ПослеОбработки", "Параметры,ИмяПКО,Правило,ИсходящиеДанные");
	
	Имена = Страницы.Получить(ИмяСтраницы);
	Если Имена = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Имена;
	
КонецФункции

#КонецОбласти
