// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Дерево метаданных релиза из справочника Объекты: ключ группы (справочники, документы) → структура объектов.
// Один запрос на релиз группы - менеджеры, подчинённые элементы объекты метаданных.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя группы в нижнем регистре без пробелов
//   * Значение - Структура - имя объекта → Структура с ключом name (синоним)
//
Функция Расш1_ОписаниеОбъектовРелизаПоГруппам(Релиз) Экспорт
	
	ОписаниеПоГруппам = Новый Соответствие;
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат ОписаниеПоГруппам;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Группы.Имя КАК ИмяГруппы,
	|	Группы.Наименование КАК НаименованиеГруппы,
	|	Объекты.Имя КАК Имя,
	|	Объекты.Синоним КАК Синоним
	|ИЗ
	|	Справочник.Объекты КАК Объекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Группы
	|		ПО Объекты.Родитель = Группы.Ссылка
	|ГДЕ
	|	Объекты.Владелец = &Релиз
	|	И Группы.Владелец = &Релиз
	|	И Группы.ЭтоГруппа
	|	И НЕ Объекты.ЭтоГруппа
	|	И НЕ Объекты.ПометкаУдаления
	|	И НЕ Группы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Релиз", Релиз);
	
	СтрокаВыборки = Новый Структура;
	СтрокаВыборки.Вставить("ИмяГруппы", "");
	СтрокаВыборки.Вставить("НаименованиеГруппы", "");
	СтрокаВыборки.Вставить("Имя", "");
	СтрокаВыборки.Вставить("Синоним", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаВыборки, Выборка);
		ИмяОбъекта = СтрокаВыборки.Имя;
		Если ПустаяСтрока(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяГруппы = СтрокаВыборки.ИмяГруппы;
		НаименованиеГруппы = СтрокаВыборки.НаименованиеГруппы;
		КлючГруппы = Расш1_КлючГруппыДляПодсказки(ИмяГруппы, НаименованиеГруппы);
		Если ПустаяСтрока(КлючГруппы) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеКоллекции = ОписаниеПоГруппам.Получить(КлючГруппы); // Структура, Неопределено
		Если ОписаниеКоллекции = Неопределено Тогда
			ОписаниеКоллекции = Новый Структура;
			ОписаниеПоГруппам.Вставить(КлючГруппы, ОписаниеКоллекции);
		КонецЕсли;
		
		Если ОписаниеКоллекции.Свойство(ИмяОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		
		Синоним = СтрокаВыборки.Синоним;
		Если ПустаяСтрока(Синоним) Тогда
			Синоним = ИмяОбъекта;
		КонецЕсли;
		
		ОписаниеЭлемента = Новый Структура;
		ОписаниеЭлемента.Вставить("name", Синоним);
		ОписаниеКоллекции.Вставить(ИмяОбъекта, ОписаниеЭлемента);
		
	КонецЦикла;
	
	Возврат ОписаниеПоГруппам;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//  ИмяГруппы - Строка - имя группы объектов.
//  НаименованиеГруппы - Строка - наименование группы, если имя не заполнено.
//
// Возвращаемое значение:
//  Строка - имя группы в нижнем регистре без пробелов и дефисов.
//
Функция Расш1_КлючГруппыДляПодсказки(ИмяГруппы, НаименованиеГруппы)
	
	Источник = СокрЛП(ИмяГруппы);
	Если ПустаяСтрока(Источник) Тогда
		Источник = СокрЛП(НаименованиеГруппы);
	КонецЕсли;
	
	Источник = СтрЗаменить(Источник, " ", "");
	Источник = СтрЗаменить(Источник, "-", "");
	
	Возврат НРег(Источник);
	
КонецФункции

#КонецОбласти

#КонецЕсли
