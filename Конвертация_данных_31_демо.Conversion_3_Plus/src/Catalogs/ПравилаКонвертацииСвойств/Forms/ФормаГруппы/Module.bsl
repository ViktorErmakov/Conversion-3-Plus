#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Или ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	Отправка = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередОбработкойВыгрузки, "ПередОбработкой", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередВыгрузкойСвойства, "ПередВыгрузкой", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПриВыгрузкеСвойства, "ПриВыгрузке", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеВыгрузкиСвойства, "ПослеВыгрузки", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеОбработкиВыгрузки, "ПослеОбработки", Отправка);
	
	Расш1_КонсольКода.СоздатьХостКонсоли(
		ЭтотОбъект, Элементы.Обработчики, "СтраницыОбработчики", Неопределено, Истина);
	
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, "Конвертация", "СправочникСсылка.Конвертации");
	ЭтотОбъект["Конвертация"] = Расш1_КонсольКода.Расш1_КонвертацияЭлементаСостава(
		Объект.Владелец, Параметры.Конвертация);
	
	Элементы.ГруппаXML.УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_ГруппаXMLПриСменеСтраницы");
	Элементы.СтраницыОбработчики.УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_ОбработчикиПриСменеСтраницы");
	
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Или ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_НазначитьКонсольТекущейСтраницы();
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект["Конвертация"]);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Или ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия);
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Или ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Расш1_Подключаемый_ГруппаXMLПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "Обработчики" Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_ОбработчикиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Расш1_ПослеФормированияКонсолей(ТекущаяСтраница.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подменю командной панели к этому моменту уже закрыто.
//
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ЗарегистрироватьАлгоритмXML(ЭлементАлгоритма, ИмяСтраницы, Направление)
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = ИмяСтраницы;
	Опции.ПоказыватьНаправление = Ложь;
	Опции.АвтоНаправление = Направление;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, ЭлементАлгоритма, Опции);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_НазначитьКонсольТекущейСтраницы()
	
	Если Элементы.ГруппаXML.ТекущаяСтраница.Имя = "Обработчики" Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеФормированияКонсолей(ИмяСтраницы = "")
	
	Если Элементы.ГруппаXML.ТекущаяСтраница.Имя <> "Обработчики" Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСтраницы) Тогда
		ИмяСтраницы = Элементы.СтраницыОбработчики.ТекущаяСтраница.Имя;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, ИмяСтраницы);
	ОписаниеJSON = Расш1_ОписаниеПараметровJSON(
		ЭтотОбъект["Конвертация"],
		ИмяСтраницы,
		Объект.Владелец);
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(
		ЭтотОбъект,
		Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли(),
		ОписаниеJSON);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция Расш1_ОписаниеПараметровJSON(Знач Конвертация, Знач ИмяСтраницы, Знач Владелец)
	
	ОбъектКонфигурации = Неопределено;
	Если ЗначениеЗаполнено(Владелец) Тогда
		ОбъектКонфигурации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "ОбъектКонфигурации");
	КонецЕсли;
	
	Возврат Расш1_КоллекцияМетаданных.ОписаниеПараметровСтраницыJSON(
		Расш1_ИменаПараметровСтраницы(ИмяСтраницы),
		Конвертация,
		Расш1_КоллекцияМетаданных.Расш1_ОписаниеВидаОбъектаКонфигурации(ОбъектКонфигурации),
		"Источник");
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаПараметровСтраницы(ИмяСтраницы)
	
	Если ИмяСтраницы = "ПередОбработкой" Тогда
		Возврат "ФайлОбмена,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные,ПКО,ПКГС,Отказ,"
			+ "КоллекцияОбъектов,НеЗамещать,УзелКоллекцииСвойств,НеОчищать";
	КонецЕсли;
	
	Если ИмяСтраницы = "ПередВыгрузкой" Тогда
		Возврат "ФайлОбмена,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные,ПКО,ПКГС,Отказ,"
			+ "ОбъектКоллекции,УзелКоллекцииСвойств,УзелКоллекцииОбъектов";
	КонецЕсли;
	
	Если ИмяСтраницы = "ПриВыгрузке" Тогда
		Возврат "ФайлОбмена,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные,ПКО,ПКГС,ОбъектКоллекции,"
			+ "УзелКоллекцииОбъектов,УзелОбъектаКоллекции,УзелКоллекцииСвойств,СтандартнаяОбработка";
	КонецЕсли;
	
	Если ИмяСтраницы = "ПослеВыгрузки" Тогда
		Возврат "ФайлОбмена,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные,ПКО,ПКГС,Отказ,"
			+ "ОбъектКоллекции,УзелКоллекцииОбъектов,УзелКоллекцииСвойств,УзелОбъектаКоллекции";
	КонецЕсли;
	
	Если ИмяСтраницы = "ПослеОбработки" Тогда
		Возврат "ФайлОбмена,Источник,Приемник,ВходящиеДанные,ИсходящиеДанные,ПКО,ПКГС,Отказ,"
			+ "УзелКоллекцииСвойств,УзелКоллекцииОбъектов";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
