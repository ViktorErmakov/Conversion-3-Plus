// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Отправка = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	Получение = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередВыгрузкойОбъекта, "Страница_ПередВыгрузкой", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПриВыгрузкеОбъекта, "Страница_ПриВыгрузке", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеВыгрузкиОбъекта, "Страница_ПослеВыгрузки", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(
		Элементы.АлгоритмПослеВыгрузкиОбъектаВФайлОбмена, "Страница_ПослеВыгрузкиВФайл", Отправка);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПередЗагрузкойОбъекта, "Страница_ПередЗагрузкой", Получение);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПриЗагрузкеОбъекта, "Страница_ПриЗагрузке", Получение);
	Расш1_ЗарегистрироватьАлгоритмXML(Элементы.АлгоритмПослеЗагрузкиОбъекта, "Страница_ПослеЗагрузки", Получение);
	
	Расш1_КонсольКода.СоздатьХостКонсоли(
		ЭтотОбъект, Элементы.ОбработчикиСобытий, "ОбработчикиXML", Неопределено, Истина);
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКода.СоздатьРеквизит(ЭтотОбъект, ИмяРеквизитаКонвертации, "СправочникСсылка.Конвертации");
	ЭтотОбъект[ИмяРеквизитаКонвертации] = Расш1_КонсольКода.Расш1_КонвертацияЭлементаСостава(
		Объект.Ссылка, Параметры.Конвертация);
	
	Элементы.Страницы.УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_СтраницыПриСменеСтраницы");
	Элементы.ОбработчикиXML.УстановитьДействие(
		"ПриСменеСтраницы", "Расш1_Подключаемый_ОбработчикиПриСменеСтраницы");
	
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		Параметры.Расш1_ИмяПоляПоиска,
		Параметры.Расш1_НомерСтрокиПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_НазначитьКонсольТекущейСтраницы();
	Расш1_КонсольКодаКлиент.ПерейтиКВхождению(ЭтотОбъект);
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Расш1_КонсольКодаКлиент.ПроверитьОписаниеМетаданныхПриОткрытии(ЭтотОбъект[ИмяРеквизитаКонвертации]);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если Расш1_КонсольКодаКлиент.ОбработкаОповещенияНастроек(ЭтотОбъект, ИмяСобытия) Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению() Тогда
		Расш1_КонсольКодаКлиент.ЗаписатьПараметрыПоискаИзОповещения(ЭтотОбъект, Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ЗаписатьТекстыКонсолейВОбъект(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик смены основной страницы формы.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ОбработчикиСобытий" Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	
КонецПроцедуры

// Обработчик смены страницы обработчиков.
//
// Параметры:
//  Элемент - ГруппаФормы - группа страниц.
//  ТекущаяСтраница - ГруппаФормы - выбранная страница.
//
&НаКлиенте
Процедура Расш1_Подключаемый_ОбработчикиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Расш1_ПослеФормированияКонсолей(ТекущаяСтраница.Имя);
	
КонецПроцедуры

// Обработчик события ДокументСформирован поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_ПослеФормированияКонсолей();
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

// Обработчик команд консоли.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	
КонецПроцедуры

// Подменю командной панели к этому моменту уже закрыто.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура Расш1_ЗарегистрироватьАлгоритмXML(ЭлементАлгоритма, ИмяСтраницы, Направление)
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = ИмяСтраницы;
	Опции.ПоказыватьНаправление = Ложь;
	Опции.АвтоНаправление = Направление;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, ЭлементАлгоритма, Опции);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_НазначитьКонсольТекущейСтраницы()
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "ОбработчикиСобытий" Тогда
		Расш1_ПослеФормированияКонсолей();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПослеФормированияКонсолей(ИмяСтраницы = "")
	
	Если Элементы.Страницы.ТекущаяСтраница.Имя <> "ОбработчикиСобытий" Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяСтраницы) Тогда
		ИмяСтраницы = Элементы.ОбработчикиXML.ТекущаяСтраница.Имя;
	КонецЕсли;
	
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, ИмяСтраницы);
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Конвертация = ЭтотОбъект[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	Направление = ЭтотОбъект[ИмяРеквизитаНаправления]; // Строка
	ОписаниеJSON = Расш1_ОписаниеПараметровJSON(
		Конвертация,
		Направление,
		ИмяСтраницы,
		Объект.ОбъектКонфигурации,
		Объект.ОбъектКонфигурацииКорреспондент);
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Расш1_КонсольКодаКлиент.ОбновитьМетаданные(ЭтотОбъект, ИмяХоста, ОписаниеJSON);
	
КонецПроцедуры

// Описание параметров страницы обработчика для подсказок консоли.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - текущая конвертация.
//  Направление - Строка - Отправка или Получение.
//  ИмяСтраницы - Строка - имя страницы обработчика.
//  ОбъектКонфигурации - СправочникСсылка.Объекты - объект источника.
//  ОбъектКонфигурацииКорреспондент - СправочникСсылка.Объекты - объект корреспондента.
//
// Возвращаемое значение:
//  Строка - JSON для updateMetadata.
//
&НаСервереБезКонтекста
Функция Расш1_ОписаниеПараметровJSON(
		Знач Конвертация,
		Знач Направление,
		Знач ИмяСтраницы,
		Знач ОбъектКонфигурации,
		Знач ОбъектКонфигурацииКорреспондент)
	
	ОбъектСтраницы = ОбъектКонфигурации;
	Получение = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Если Направление = Получение
		И ЗначениеЗаполнено(ОбъектКонфигурацииКорреспондент) Тогда
		ОбъектСтраницы = ОбъектКонфигурацииКорреспондент;
	КонецЕсли;
	
	ИменаПараметров = Расш1_ИменаПараметровСтраницы(ИмяСтраницы);
	ВидОбъекта = Расш1_КоллекцияМетаданных.Расш1_ОписаниеВидаОбъектаКонфигурации(ОбъектСтраницы);
	ИменаОбъекта = Расш1_ИменаОбъектаСтраницы(ИмяСтраницы);
	Возврат Расш1_КоллекцияМетаданных.ОписаниеПараметровСтраницыJSON(
		ИменаПараметров, Конвертация, ВидОбъекта, ИменаОбъекта);
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаПараметровСтраницы(ИмяСтраницы)
	
	Имена = Новый Массив; // Массив из Строка
	ПараметрыВыгрузки = "ФайлОбмена,Источник,ВходящиеДанные,ИсходящиеДанные,ИмяПКО,ПКО,ВыгруженныеОбъекты";
	
	Если ИмяСтраницы = "Страница_ПередВыгрузкой" Тогда
		Имена.Добавить(ПараметрыВыгрузки);
		Имена.Добавить("Отказ,КлючВыгружаемыхДанных,ЗапоминатьВыгруженные,НеЗамещатьОбъектПриЗагрузке");
		Имена.Добавить("ВсеОбъектыВыгружены,ТолькоПолучитьУзелСсылки,Приемник");
		Имена.Добавить("РежимЗаписи,РежимПроведения,НеСоздаватьЕслиНеНайден");
		Возврат СтрСоединить(Имена, ",");
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПриВыгрузке" Тогда
		Имена.Добавить(ПараметрыВыгрузки);
		Имена.Добавить("КлючВыгружаемыхДанных,Отказ,СтандартнаяОбработка,Приемник,УзелСсылки");
		Возврат СтрСоединить(Имена, ",");
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПослеВыгрузки" Тогда
		Имена.Добавить(ПараметрыВыгрузки);
		Имена.Добавить("КлючВыгружаемыхДанных,Отказ,Приемник,УзелСсылки");
		Возврат СтрСоединить(Имена, ",");
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПослеВыгрузкиВФайл" Тогда
		Имена.Добавить(ПараметрыВыгрузки);
		Имена.Добавить("Приемник,УзелСсылки");
		Возврат СтрСоединить(Имена, ",");
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПередЗагрузкой" Тогда
		Имена.Добавить("ФайлОбмена,Отказ,Нпп,Источник,ИмяПравила,Правило");
		Имена.Добавить("ГенерироватьНовыйНомерИлиКодЕслиНеУказан,ТипОбъектаСтрокой,ТипОбъекта");
		Имена.Добавить("НеЗамещатьОбъект,РежимЗаписи,РежимПроведения");
		Возврат СтрСоединить(Имена, ",");
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПриЗагрузке" Тогда
		Возврат "ФайлОбмена,ОбъектНайден,Объект,НеЗамещатьОбъект,ОбъектМодифицирован";
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПослеЗагрузки" Тогда
		Возврат "ФайлОбмена,Отказ,Ссылка,Объект,ПараметрыОбъекта,ОбъектМодифицирован,ИмяТипаОбъекта,ОбъектНайден";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция Расш1_ИменаОбъектаСтраницы(ИмяСтраницы)
	
	СтраницыИсточника = СтрРазделить(
		"Страница_ПередВыгрузкой,Страница_ПриВыгрузке,Страница_ПослеВыгрузки,Страница_ПослеВыгрузкиВФайл",
		",");
	СтраницыИсточника.Добавить("Страница_ПередЗагрузкой");
	Если СтраницыИсточника.Найти(ИмяСтраницы) <> Неопределено Тогда
		Возврат "Источник";
	КонецЕсли;
	
	Если ИмяСтраницы = "Страница_ПриЗагрузке"
		Или ИмяСтраницы = "Страница_ПослеЗагрузки" Тогда
		Возврат "Объект";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
