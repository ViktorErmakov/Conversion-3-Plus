
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСпискиВыбора();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Расш1_КонсольКодаВызовСервера.ПрочитатьНастройкиРедактора());
	
	КонвертацияПараметр = Неопределено;
	Если Параметры.Свойство("Конвертация", КонвертацияПараметр)
		И ЗначениеЗаполнено(КонвертацияПараметр) Тогда
		Релиз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонвертацияПараметр, "Конфигурация");
	КонецЕсли;
	
	ОбновитьСтатусОписанияМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РелизПриИзменении(Элемент)
	
	ОбновитьСтатусОписанияМетаданных();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьНастройкиИОповестить();
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройки(Команда)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора());
	СохранитьНастройкиИОповестить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтруктуруКонфигурации(Команда)
	
	Расш1_КонсольКодаКлиент.ОткрытьЗагрузкуСтруктурыКонфигурации(Релиз);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	СохранитьНастройкиИОповестить();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиИОповестить()
	
	ЗаписатьНастройкиНаСервере(НастройкиРедактораСФормы());
	Оповестить(Расш1_КонсольКодаКлиентСервер.ИмяСобытияНастройкиИзменены());
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	СписокТем = Элементы.Тема.СписокВыбора;
	СписокТем.Очистить();
	СписокТем.Добавить("bsl-white", НСтр("ru = 'Светлая'"));
	СписокТем.Добавить("bsl-dark", НСтр("ru = 'Темная'"));
	СписокТем.Добавить("bsl-edt-white", НСтр("ru = 'EDT светлая'"));
	СписокТем.Добавить("bsl-edt-dark", НСтр("ru = 'EDT темная'"));
	
	СписокРазмеров = Элементы.РазмерШрифта.СписокВыбора;
	СписокРазмеров.Очистить();
	СписокРазмеров.Добавить(0, НСтр("ru = 'По умолчанию'"));
	РазмерыШрифта = СтрРазделить("8,9,10,11,12,13,14,16,18,20,22,24", ",");
	Для Каждого РазмерСтрокой Из РазмерыШрифта Цикл
		Размер = Число(РазмерСтрокой);
		СписокРазмеров.Добавить(Размер, Формат(Размер, "ЧГ="));
	КонецЦикла;
	
	СписокШрифтов = Элементы.СемействоШрифтов.СписокВыбора;
	СписокШрифтов.Очистить();
	СписокШрифтов.Добавить("", НСтр("ru = 'По умолчанию'"));
	СписокШрифтов.Добавить("Consolas", "Consolas");
	СписокШрифтов.Добавить("Courier New", "Courier New");
	СписокШрифтов.Добавить("Lucida Console", "Lucida Console");
	СписокШрифтов.Добавить("Cascadia Mono", "Cascadia Mono");
	СписокШрифтов.Добавить("Fira Code", "Fira Code");
	СписокШрифтов.Добавить("JetBrains Mono", "JetBrains Mono");
	
	СписокНасыщенности = Элементы.НасыщенностьШрифта.СписокВыбора;
	СписокНасыщенности.Очистить();
	СписокНасыщенности.Добавить("", НСтр("ru = 'По умолчанию'"));
	СписокНасыщенности.Добавить("normal", НСтр("ru = 'Обычный'"));
	СписокНасыщенности.Добавить("bold", НСтр("ru = 'Полужирный'"));
	
	СписокВысоты = Элементы.ВысотаСтроки.СписокВыбора;
	СписокВысоты.Очистить();
	СписокВысоты.Добавить(0, НСтр("ru = 'По умолчанию'"));
	ВысотыСтроки = СтрРазделить("16,18,20,22,24,28", ",");
	Для Каждого ВысотаСтрокой Из ВысотыСтроки Цикл
		Высота = Число(ВысотаСтрокой);
		СписокВысоты.Добавить(Высота, Формат(Высота, "ЧГ="));
	КонецЦикла;
	
	СписокЯзыков = Элементы.ЯзыкПодсказок.СписокВыбора;
	СписокЯзыков.Очистить();
	СписокЯзыков.Добавить("ru", НСтр("ru = 'Русский'"));
	СписокЯзыков.Добавить("en", НСтр("ru = 'Английский'"));
	
	СписокКонтекста = Элементы.КонтекстРедактора.СписокВыбора;
	СписокКонтекста.Очистить();
	СписокКонтекста.Добавить("", НСтр("ru = 'Все подсказки'"));
	СписокКонтекста.Добавить("Server", НСтр("ru = 'Сервер'"));
	СписокКонтекста.Добавить("Client", НСтр("ru = 'Тонкий клиент'"));
	
КонецПроцедуры

&НаКлиенте
Функция НастройкиРедактораСФормы()
	
	Настройки = Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	Возврат Настройки;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьНастройкиНаСервере(Знач Настройки)
	
	Расш1_КонсольКодаВызовСервера.СохранитьНастройкиРедактора(Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусОписанияМетаданных()
	
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		СтатусОписанияМетаданных = НСтр("ru = 'Релиз берётся из формы редактора, с которой открыты настройки.'");
	ИначеЕсли Расш1_КоллекцияМетаданных.ЕстьОписаниеМетаданных(Релиз) Тогда
		СтатусОписанияМетаданных = НСтр("ru = 'В справочнике Объекты есть данные для подсказок.'");
	Иначе
		СтатусОписанияМетаданных = НСтр("ru = 'Структура конфигурации не загружена. Откройте загрузку из XML/EDT.'");
	КонецЕсли;
	
	Элементы.ПояснениеМетаданных.Заголовок = СтатусОписанияМетаданных;
	
КонецПроцедуры

#КонецОбласти
