
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСпискиВыбора();
	НастроитьЭлементыФормы();
	ЗаполнитьНастройкиНаФорме(Расш1_КонсольКодаВызовСервера.ПрочитатьНастройкиРедактора());
	ИспользоватьКонсольКодаСохраненное = ИспользоватьКонсольКода;
	
	КонвертацияПараметр = Неопределено;
	Если Параметры.Свойство("Конвертация", КонвертацияПараметр)
		И ЗначениеЗаполнено(КонвертацияПараметр) Тогда
		Релиз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонвертацияПараметр, "Конфигурация");
	КонецЕсли;
	
	ОбновитьСтатусОписанияМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РелизПриИзменении(Элемент)
	
	ОбновитьСтатусОписанияМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьКонсольКодаПриИзменении(Элемент)
	
	Если ИспользоватьКонсольКода = ИспользоватьКонсольКодаСохраненное Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Изменение вступит в силу после повторного открытия формы.
						|Закрыть форму и открыть её снова?'");
	Оповещение = Новый ОписаниеОповещения("ИспользоватьКонсольКодаПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьНастройкиИОповестить();
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройки(Команда)
	
	ЗаполнитьНастройкиНаФорме(Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора());
	СохранитьНастройкиИОповестить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтруктуруКонфигурации(Команда)
	
	Расш1_КонсольКодаКлиент.ОткрытьЗагрузкуСтруктурыКонфигурации(Релиз);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьШрифт(Команда)
	
#Если ВебКлиент Тогда
	Возврат;
#Иначе
	Диалог = Новый ДиалогВыбораШрифта;
	
	ИмяШрифта = СемействоШрифтов;
	Размер = 0;
	Если РазмерШрифта > 0 Тогда
		Размер = РазмерШрифта;
	КонецЕсли;
	Полужирный = (НасыщенностьШрифта = "bold");
	
	Диалог.Шрифт = Новый Шрифт(ИмяШрифта, Размер, Полужирный, Ложь, Ложь, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ВыбратьШрифтЗавершение", ЭтотОбъект);
	Диалог.Показать(Оповещение);
#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИспользоватьКонсольКодаПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиИОповестить();
	ПереоткрытьФормыПослеСменыФлага();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереоткрытьФормыПослеСменыФлага()
	
	ПараметрыНастроек = Новый Структура;
	КонвертацияПараметр = Неопределено;
	Если Параметры.Свойство("Конвертация", КонвертацияПараметр) Тогда
		ПараметрыНастроек.Вставить("Конвертация", КонвертацияПараметр);
	КонецЕсли;
	
	ФормаРедактора = ВладелецФормы;
	Если ФормаРедактора = Неопределено Тогда
		Закрыть();
		ОткрытьФорму(Расш1_КонсольКодаКлиентСервер.ИмяФормыНастроекКонсоли(), ПараметрыНастроек);
		Возврат;
	КонецЕсли;
	
	КлючФормы = Неопределено;
	ФормаРедактора.Параметры.Свойство("Ключ", КлючФормы);
	Если Не ЗначениеЗаполнено(КлючФормы) Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ИмяФормыРедактора = ФормаРедактора.ИмяФормы;
	ПараметрыРедактора = Новый Структура("Ключ", КлючФормы);
	Если ЗначениеЗаполнено(КонвертацияПараметр) Тогда
		ПараметрыРедактора.Вставить("Конвертация", КонвертацияПараметр);
	КонецЕсли;
	
	Закрыть();
	Если ФормаРедактора.Открыта() Тогда
		ФормаРедактора.Закрыть();
	КонецЕсли;
	ОткрытьФорму(ИмяФормыРедактора, ПараметрыРедактора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	СохранитьНастройкиИОповестить();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкиИОповестить()
	
	ЗаписатьНастройкиНаСервере(НастройкиРедактораСФормы());
	ИспользоватьКонсольКодаСохраненное = ИспользоватьКонсольКода;
	Оповестить(Расш1_КонсольКодаКлиентСервер.ИмяСобытияНастройкиИзменены());
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиНаФорме(Настройки)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	Тема = Расш1_КонсольКодаКлиентСервер.ИмяТемыAPI(Настройки.Тема);
	НасыщенностьШрифта = Расш1_КонсольКодаКлиентСервер.ИмяНасыщенностиAPI(Настройки.НасыщенностьШрифта);
	ОбновитьПредставлениеШрифта();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	СписокТем = Элементы.Тема.СписокВыбора;
	СписокТем.Очистить();
	СписокТем.Добавить("bsl-white", НСтр("ru = 'Светлая'"));
	СписокТем.Добавить("bsl-white-query", НСтр("ru = 'Светлая запрос'"));
	СписокТем.Добавить("bsl-dark", НСтр("ru = 'Темная'"));
	СписокТем.Добавить("bsl-dark-query", НСтр("ru = 'Темная запрос'"));
	СписокТем.Добавить("bsl-edt-white", НСтр("ru = 'EDT светлая'"));
	СписокТем.Добавить("bsl-edt-dark", НСтр("ru = 'EDT темная'"));
	
	СписокНасыщенности = Элементы.НасыщенностьШрифта.СписокВыбора;
	СписокНасыщенности.Очистить();
	СписокНасыщенности.Добавить("", НСтр("ru = 'По умолчанию'"));
	СписокНасыщенности.Добавить("normal", НСтр("ru = 'Обычный'"));
	СписокНасыщенности.Добавить("bold", НСтр("ru = 'Полужирный'"));
	СписокНасыщенности.Добавить("lighter", НСтр("ru = 'Светлее'"));
	СписокНасыщенности.Добавить("bolder", НСтр("ru = 'Темнее'"));
	
	СписокШрифтов = Элементы.СемействоШрифтов.СписокВыбора;
	СписокШрифтов.Очистить();
	СписокШрифтов.Добавить("", НСтр("ru = 'По умолчанию'"));
	СписокШрифтов.Добавить("Consolas", "Consolas");
	СписокШрифтов.Добавить("Courier New", "Courier New");
	СписокШрифтов.Добавить("Lucida Console", "Lucida Console");
	СписокШрифтов.Добавить("Cascadia Mono", "Cascadia Mono");
	СписокШрифтов.Добавить("Fira Code", "Fira Code");
	СписокШрифтов.Добавить("JetBrains Mono", "JetBrains Mono");
	
	СписокЯзыков = Элементы.ЯзыкПодсказок.СписокВыбора;
	СписокЯзыков.Очистить();
	Для Каждого ЯзыкМетаданных Из Метаданные.Языки Цикл
		КодЯзыка = ЯзыкМетаданных.КодЯзыка;
		Если КодЯзыка <> "ru" И КодЯзыка <> "en" Тогда
			Продолжить;
		КонецЕсли;
		СписокЯзыков.Добавить(КодЯзыка, Строка(ЯзыкМетаданных));
	КонецЦикла;
	
	Если СписокЯзыков.Количество() = 0 Тогда
		СписокЯзыков.Добавить("ru", НСтр("ru = 'Русский'"));
		СписокЯзыков.Добавить("en", НСтр("ru = 'Английский'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	Элементы.КонтекстРедактора.Видимость = Ложь;
	Элементы.ЯзыкПодсказок.Видимость = Элементы.ЯзыкПодсказок.СписокВыбора.Количество() > 1;
	
	Элементы.РазмерШрифта.ПодсказкаВвода = НСтр("ru = 'обычно 8–24, 0 — по умолчанию'");
	Элементы.РазмерШрифта.РедактированиеТекста = Истина;
	Элементы.РазмерШрифта.РежимВыбораИзСписка = Ложь;
	
	Элементы.ВысотаСтроки.ПодсказкаВвода = НСтр("ru = 'обычно 16–32, 0 — по умолчанию'");
	Элементы.ВысотаСтроки.РедактированиеТекста = Истина;
	Элементы.ВысотаСтроки.РежимВыбораИзСписка = Ложь;
	
	ЭтоВебКлиент = ОбщегоНазначения.ЭтоВебКлиент();
	
	Элементы.РазмерШрифта.Видимость = ЭтоВебКлиент;
	Элементы.НасыщенностьШрифта.Видимость = ЭтоВебКлиент;
	Элементы.СемействоШрифтов.Видимость = ЭтоВебКлиент;
	
	ГруппаРазмера = Элементы.Найти("Группа1");
	Если ГруппаРазмера <> Неопределено Тогда
		ГруппаРазмера.Видимость = ЭтоВебКлиент;
	КонецЕсли;
	
	КнопкаШрифта = Элементы.Найти("ВыбратьШрифт");
	Если КнопкаШрифта <> Неопределено Тогда
		КнопкаШрифта.Видимость = Не ЭтоВебКлиент;
	КонецЕсли;
	
	ДекорацияШрифта = Элементы.Найти("ПредставлениеШрифта");
	Если ДекорацияШрифта <> Неопределено Тогда
		ДекорацияШрифта.Видимость = Не ЭтоВебКлиент;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьШрифтЗавершение(ВыбранныйШрифт, ДополнительныеПараметры) Экспорт
	
#Если Не ВебКлиент Тогда
	Если ВыбранныйШрифт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СемействоШрифтов = ВыбранныйШрифт.Имя;
	Если ВыбранныйШрифт.Размер > 0 Тогда
		РазмерШрифта = ВыбранныйШрифт.Размер;
	КонецЕсли;
	
	Если ВыбранныйШрифт.Полужирный Тогда
		НасыщенностьШрифта = "bold";
	Иначе
		НасыщенностьШрифта = "normal";
	КонецЕсли;
	
	Если ВыбранныйШрифт.Наклонный = Истина
		Или ВыбранныйШрифт.Подчеркивание = Истина
		Или ВыбранныйШрифт.Зачеркивание = Истина Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Наклонный, подчёркнутый и зачёркнутый шрифт консоль не поддерживает. Сохранены только семейство, размер и полужирный.'"));
	КонецЕсли;
	
	ОбновитьПредставлениеШрифта();
	Модифицированность = Истина;
#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Функция НастройкиРедактораСФормы()
	
	Настройки = Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	Возврат Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьНастройкиНаСервере(Знач Настройки)
	
	Расш1_КонсольКодаВызовСервера.СохранитьНастройкиРедактора(Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусОписанияМетаданных()
	
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		СтатусОписанияМетаданных = НСтр("ru = 'Релиз берётся из формы редактора, с которой открыты настройки.'");
	ИначеЕсли Расш1_КоллекцияМетаданных.ЕстьОписаниеМетаданных(Релиз) Тогда
		СтатусОписанияМетаданных = НСтр("ru = 'В справочнике Объекты есть данные для подсказок.'");
	Иначе
		СтатусОписанияМетаданных = НСтр("ru = 'Структура конфигурации не загружена. Откройте загрузку из XML/EDT.'");
	КонецЕсли;
	
	Элементы.ПояснениеМетаданных.Заголовок = СтатусОписанияМетаданных;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеШрифта()
	
	ДекорацияШрифта = Элементы.Найти("ПредставлениеШрифта");
	Если ДекорацияШрифта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДекорацияШрифта.Заголовок = ПредставлениеТекущегоШрифта(СемействоШрифтов, РазмерШрифта, НасыщенностьШрифта);
	
КонецПроцедуры

// Краткое представление выбранного шрифта для декорации рядом с кнопкой.
//
// Параметры:
//  СемействоШрифтов - Строка
//  РазмерШрифта - Число
//  НасыщенностьШрифта - Строка - имя API (bold, normal).
//
// Возвращаемое значение:
//  Строка
//
&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеТекущегоШрифта(СемействоШрифтов, РазмерШрифта, НасыщенностьШрифта)
	
	Части = Новый Массив;
	Если Не ПустаяСтрока(СемействоШрифтов) Тогда
		Части.Добавить(СемействоШрифтов);
	КонецЕсли;
	Если РазмерШрифта > 0 Тогда
		Части.Добавить(Формат(РазмерШрифта, "ЧГ="));
	КонецЕсли;
	Если НасыщенностьШрифта = "bold" Тогда
		Части.Добавить(НСтр("ru = 'полужирный'"));
	КонецЕсли;
	
	Если Части.Количество() = 0 Тогда
		Возврат НСтр("ru = 'по умолчанию'");
	КонецЕсли;
	
	Возврат СтрСоединить(Части, ", ");
	
КонецФункции

#КонецОбласти
