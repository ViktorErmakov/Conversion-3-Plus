// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Параметры.Релиз) Или ПустаяСтрока(Параметры.Ключ) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Текст = ТекстМодуля(Параметры.Релиз, Параметры.Вид, Параметры.Ключ);
	АвтоЗаголовок = Ложь;
	Заголовок = Параметры.Ключ;
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Опции = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	Опции.ИмяСтраницы = "Текст";
	Опции.ТолькоПросмотр = Истина;
	Опции.ПоказыватьНаправление = Ложь;
	Опции.СкрытьПанельКоманд = Истина;
	Расш1_КонсольКода.ЗарегистрироватьАлгоритм(ЭтотОбъект, Элементы.Текст, Опции);
	Расш1_КонсольКода.СоздатьХостКонсоли(ЭтотОбъект, ЭтотОбъект, "", Элементы.Текст);
	Расш1_КонсольКода.ЗаполнитьРеквизитыПоиска(
		ЭтотОбъект,
		Параметры.Расш1_ФразаПоиска,
		"Текст",
		Параметры.Расш1_НомерСтрокиПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Расш1_КонсольКодаКлиент.ПоказатьАлгоритм(ЭтотОбъект, "Текст");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик события ДокументСформирован поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольДокументСформирован(Элемент)
	
	Расш1_КонсольКодаКлиент.ИнициализироватьКонсоль(ЭтотОбъект, Элемент);
	Расш1_КонсольКодаКлиент.ВыделитьФразуПоиска(ЭтотОбъект);
	
КонецПроцедуры

// Обработчик события ПриНажатии поля HTML консоли.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML консоли.
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КонсольПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Расш1_КонсольКодаКлиент.ПриНажатии(ЭтотОбъект, ДанныеСобытия, Элемент);
	
КонецПроцедуры

// Обработчик команд консоли.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_КомандаКонсоли(Команда)
	
	Расш1_КонсольКодаКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда);
	
КонецПроцедуры

// Подменю командной панели к этому моменту уже закрыто.
//
// @skip-check module-unused-method
&НаКлиенте
Процедура Расш1_Подключаемый_ПоказатьЗакладки()
	
	Расш1_КонсольКодаКлиент.ПоказатьСписокЗакладокСейчас(ЭтотОбъект);
	
КонецПроцедуры

// Текст модуля релиза из регистра Расш1_ТекстыМодулей.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы - релиз конфигурации.
//  Вид - ПеречислениеСсылка.Расш1_ВидыМодулей - вид модуля.
//  Ключ - Строка - ключ модуля.
//
// Возвращаемое значение:
//  Строка - текст модуля или пустая строка.
//
&НаСервереБезКонтекста
Функция ТекстМодуля(Релиз, Вид, Ключ)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Релиз", Релиз);
	Отбор.Вставить("Вид", Вид);
	Отбор.Вставить("Ключ", Ключ);
	Запись = РегистрыСведений.Расш1_ТекстыМодулей.Получить(Отбор);
	Поля = Новый Структура("Текст", "");
	ЗаполнитьЗначенияСвойств(Поля, Запись);
	Возврат Поля.Текст;
	
КонецФункции

#КонецОбласти
