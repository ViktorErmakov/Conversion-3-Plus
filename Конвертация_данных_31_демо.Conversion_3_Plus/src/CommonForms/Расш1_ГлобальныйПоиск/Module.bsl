// @strict-types

#Область ОписаниеПеременных

// Идентификатор фонового задания поиска. Неопределено, пока поиск не запущен.
&НаКлиенте
Перем Расш1_ИдентификаторЗадания; // УникальныйИдентификатор, Неопределено

// Адрес временного хранилища с результатом фонового задания.
&НаКлиенте
Перем Расш1_АдресРезультата; // Строка, Неопределено

// Номер текущего поиска. Результат устаревшего поиска отбрасывается.
&НаКлиенте
Перем Расш1_НомерПоиска; // Число, Неопределено

// Параметры поиска, который запускается после отмены текущего задания.
&НаКлиенте
Перем Расш1_ПараметрыОжидающегоПоиска; // Структура, Неопределено

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Конвертация = Параметры.Конвертация;
	СтрокаПоиска = Параметры.СтрокаПоиска;
	ИсключитьСсылку = Параметры.ИсключитьСсылку;
	МинимальнаяДлинаАвтопоиска = 2;
	СокращеннаяСтрока = СокрЛП(СтрокаПоиска);
	НачатьПриОткрытии = СтрДлина(СокращеннаяСтрока) >= МинимальнаяДлинаАвтопоиска
		И ЗначениеЗаполнено(Конвертация);
	ИскатьВПравилах = Истина;
	ИскатьВМодулях = Истина;
	Элементы.ПояснениеОбрезки.Видимость = Ложь;
	Элементы.ПояснениеРезультатаПоиска.Видимость = Ложь;
	Элементы.ГруппаОжиданиеПоиска.Видимость = Ложь;
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НачатьПриОткрытии Тогда
		ЗапуститьПоиск();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КонвертацияПриИзменении(Элемент)
	
	ОчиститьРезультатыПоиска();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультаты

&НаКлиенте
Процедура РезультатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЭтоМодуль Тогда
		ОткрытьПросмотрМодуля(ТекущиеДанные);
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.Ссылка);
	Если ТипЗнч(ТекущиеДанные.Ссылка) = Тип("СправочникСсылка.Конвертации") Тогда
		ПараметрыОткрытия.Вставить("Конвертация", ТекущиеДанные.Ссылка);
	Иначе
		ПараметрыОткрытия.Вставить("Конвертация", Конвертация);
	КонецЕсли;
	
	ФразаПоиска = СокрЛП(СтрокаПоиска);
	Если Расш1_КонсольКодаКлиентСервер.ФормаПринимаетПараметрыПоиска(ТекущиеДанные.ИмяФормы) Тогда
		ПараметрыОткрытия.Вставить("Расш1_ФразаПоиска", ФразаПоиска);
		ПараметрыОткрытия.Вставить("Расш1_ИмяПоляПоиска", ТекущиеДанные.ИмяПоля);
		ПараметрыОткрытия.Вставить("Расш1_НомерСтрокиПоиска", ТекущиеДанные.НомерСтроки);
	КонецЕсли;
	
	ПараметрыПерехода = Новый Структура;
	ПараметрыПерехода.Вставить("Ссылка", ТекущиеДанные.Ссылка);
	ПараметрыПерехода.Вставить("ФразаПоиска", ФразаПоиска);
	ПараметрыПерехода.Вставить("ИмяПоляПоиска", ТекущиеДанные.ИмяПоля);
	ПараметрыПерехода.Вставить("НомерСтрокиПоиска", ТекущиеДанные.НомерСтроки);
	
	ОткрытьФорму(ТекущиеДанные.ИмяФормы, ПараметрыОткрытия);
	Оповестить(Расш1_КонсольКодаКлиентСервер.ИмяСобытияПереходаКВхождению(), ПараметрыПерехода);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиВхождения(Команда)
	
	ОчиститьСообщения();
	Если ПроверитьЗаполнение() Тогда
		ЗапуститьПоиск();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьПоиск()
	
	МинимальнаяДлинаСтроки = 3;
	СокращеннаяСтрока = СокрЛП(СтрокаПоиска);
	Если СтрДлина(СокращеннаяСтрока) < МинимальнаяДлинаСтроки Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Введите не меньше трех символов.'"), , "СтрокаПоиска");
		Возврат;
	КонецЕсли;
	Если Не ИскатьВПравилах И Не ИскатьВМодулях Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Отметьте, где искать.'"), , "ИскатьВПравилах");
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Расш1_НомерПоиска) <> Тип("Число") Тогда
		Расш1_НомерПоиска = 0;
	КонецЕсли;
	Расш1_НомерПоиска = Расш1_НомерПоиска + 1;
	
	ОчиститьРезультатыПоиска();
	ПараметрыПоиска = НовыеПараметрыПоиска();
	ПараметрыПоиска.Конвертация = Конвертация;
	ПараметрыПоиска.СтрокаПоиска = СокращеннаяСтрока;
	ПараметрыПоиска.ИсключитьСсылку = ИсключитьСсылку;
	ПараметрыПоиска.ИскатьВМодулях = ИскатьВМодулях;
	ПараметрыПоиска.ИскатьВПравилах = ИскатьВПравилах;
	ПараметрыПоиска.НомерПоиска = Расш1_НомерПоиска;
	Расш1_ПараметрыОжидающегоПоиска = ПараметрыПоиска;
	ПоказатьАнимациюПоиска();
	
	Если ЗначениеЗаполнено(Расш1_ИдентификаторЗадания) Тогда
		ОтменитьЗаданиеПоискаНаСервере(Расш1_ИдентификаторЗадания, Расш1_АдресРезультата);
		Если ЗаданиеПоискаАктивно(Расш1_ИдентификаторЗадания) Тогда
			ПодключитьОбработчикОжидания("Подключаемый_ПродолжитьПоискПослеОтмены", 1);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ПродолжитьПоискПослеОтмены");
	Расш1_ИдентификаторЗадания = Неопределено;
	Расш1_АдресРезультата = "";
	НачатьНовоеЗадание();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьПоискПослеОтмены() Экспорт
	
	Если Расш1_ПараметрыОжидающегоПоиска = Неопределено Тогда
		ОтключитьОбработчикОжидания("Подключаемый_ПродолжитьПоискПослеОтмены");
		СкрытьАнимациюПоиска();
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Расш1_ИдентификаторЗадания)
		И ЗаданиеПоискаАктивно(Расш1_ИдентификаторЗадания) Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("Подключаемый_ПродолжитьПоискПослеОтмены");
	Расш1_ИдентификаторЗадания = Неопределено;
	Расш1_АдресРезультата = "";
	НачатьНовоеЗадание();
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура - параметры запуска фонового поиска:
//   * Конвертация - СправочникСсылка.Конвертации - конвертация поиска.
//   * СтрокаПоиска - Строка - искомая строка без крайних пробелов.
//   * ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//   * ИскатьВМодулях - Булево - искать в текстах модулей.
//   * ИскатьВПравилах - Булево - искать в правилах.
//   * НомерПоиска - Число - номер запуска поиска.
//
&НаКлиенте
Функция НовыеПараметрыПоиска()
	
	ПустаяКонвертация = ПредопределенноеЗначение("Справочник.Конвертации.ПустаяСсылка");
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Конвертация", ПустаяКонвертация);
	ПараметрыПоиска.Вставить("СтрокаПоиска", "");
	ПараметрыПоиска.Вставить("ИсключитьСсылку", Неопределено);
	ПараметрыПоиска.Вставить("ИскатьВМодулях", Ложь);
	ПараметрыПоиска.Вставить("ИскатьВПравилах", Ложь);
	ПараметрыПоиска.Вставить("НомерПоиска", 0);
	
	Возврат ПараметрыПоиска;
	
КонецФункции

&НаКлиенте
Процедура НачатьНовоеЗадание()
	
	ПараметрыПоиска = Расш1_ПараметрыОжидающегоПоиска; // см. НовыеПараметрыПоиска
	Если ПараметрыПоиска = Неопределено
		Или ПараметрыПоиска.НомерПоиска <> Расш1_НомерПоиска Тогда
		СкрытьАнимациюПоиска();
		Возврат;
	КонецЕсли;
	Расш1_ПараметрыОжидающегоПоиска = Неопределено;
	
	ДлительнаяОперация = НачатьПоискНаСервере(
		ПараметрыПоиска.Конвертация,
		ПараметрыПоиска.СтрокаПоиска,
		ПараметрыПоиска.ИсключитьСсылку,
		ПараметрыПоиска.ИскатьВМодулях,
		ПараметрыПоиска.ИскатьВПравилах,
		УникальныйИдентификатор);
	Расш1_ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	Расш1_АдресРезультата = "";
	Если ДлительнаяОперация.Свойство("АдресРезультата") Тогда
		Расш1_АдресРезультата = ДлительнаяОперация.АдресРезультата;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПоискЗавершен", ЭтотОбъект, ПараметрыПоиска.НомерПоиска);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	ОповещениеПользователя = ПараметрыОжидания.ОповещениеПользователя;
	ОповещениеПользователя.Показать = Истина;
	ОповещениеПользователя.Текст = НСтр("ru = 'Поиск завершен'");
	Если Окно <> Неопределено Тогда
		ОповещениеПользователя.НавигационнаяСсылка = Окно.ПолучитьНавигационнуюСсылку();
		ОповещениеПользователя.Пояснение = Окно.Заголовок;
	КонецЕсли;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - конвертация поиска.
//  СтрокаПоиска - Строка - искомая строка.
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//  ИскатьВМодулях - Булево - искать в текстах модулей.
//  ИскатьВПравилах - Булево - искать в правилах.
//  ИдентификаторФормы - УникальныйИдентификатор - идентификатор формы.
//
// Возвращаемое значение:
//  см. ДлительныеОперации.ВыполнитьФункцию
//
&НаСервереБезКонтекста
Функция НачатьПоискНаСервере(Знач Конвертация, Знач СтрокаПоиска, Знач ИсключитьСсылку,
	Знач ИскатьВМодулях, Знач ИскатьВПравилах, Знач ИдентификаторФормы)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторФормы);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Расш1_ГлобальныйПоиск.НайтиВхождения",
		Конвертация,
		СтрокаПоиска,
		ИсключитьСсылку,
		ИскатьВМодулях,
		ИскатьВПравилах);
	
КонецФункции

// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор, Неопределено - фоновое задание поиска.
//  АдресРезультата - Строка - адрес результата во временном хранилище.
//
&НаСервереБезКонтекста
Процедура ОтменитьЗаданиеПоискаНаСервере(Знач ИдентификаторЗадания, Знач АдресРезультата)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	Если ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		УдалитьИзВременногоХранилища(АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеПоискаАктивно(Знач ИдентификаторЗадания)
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;
	Результат = ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);
	Возврат Результат.Статус = "Выполняется";
	
КонецФункции

// Параметры:
//  Результат - Структура, Неопределено - результат ДлительныеОперацииКлиент.ОжидатьЗавершение:
//   * Статус - Строка - Выполнено или Ошибка.
//   * АдресРезультата - Строка - адрес результата поиска.
//   * КраткоеПредставлениеОшибки - Строка - текст ошибки.
//  НомерПоиска - Число - номер завершённого поиска.
//
&НаКлиенте
Процедура ПоискЗавершен(Результат, НомерПоиска) Экспорт
	
	Если НомерПоиска <> Расш1_НомерПоиска Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_ИдентификаторЗадания = Неопределено;
	Расш1_АдресРезультата = "";
	СкрытьАнимациюПоиска();
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьРезультаты(Результат.АдресРезультата);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультатыПоиска()
	
	Результаты.Очистить();
	Обрезано = Ложь;
	Элементы.ПояснениеОбрезки.Видимость = Ложь;
	Элементы.ПояснениеРезультатаПоиска.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьАнимациюПоиска()
	
	Элементы.ГруппаОжиданиеПоиска.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьАнимациюПоиска()
	
	Элементы.ГруппаОжиданиеПоиска.Видимость = Ложь;
	
КонецПроцедуры

// Параметры:
//  АдресРезультата - Строка - адрес результата поиска во временном хранилище.
//
&НаСервере
Процедура ЗаполнитьРезультаты(Знач АдресРезультата)
	
	РезультатПоиска = ПолучитьИзВременногоХранилища(АдресРезультата); // см. Расш1_ГлобальныйПоиск.НайтиВхождения
	УдалитьИзВременногоХранилища(АдресРезультата);
	Результаты.Очистить();
	Обрезано = Ложь;
	Если ТипЗнч(РезультатПоиска) <> Тип("Структура") Тогда
		Элементы.ПояснениеОбрезки.Видимость = Ложь;
		ПоказатьИтогПоиска(0);
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаРезультата Из РезультатПоиска.Строки Цикл
		НоваяСтрока = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
	КонецЦикла;
	
	КолонкиИсточника = "ЭтоМодуль, Представление, НомерСтроки, Ссылка, Вид, ИмяПоля, СинонимПоля";
	КолонкиВхождения = "Фрагмент, ИмяФормы, Источник, Релиз, ВидМодуля, Ключ";
	ПорядокКолонок = СтрШаблон("%1, %2", КолонкиИсточника, КолонкиВхождения);
	Результаты.Сортировать(ПорядокКолонок);
	
	ПорядковыйНомер = 0;
	Для Каждого СтрокаТаблицы Из Результаты Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		СтрокаТаблицы.НомерПоПорядку = ПорядковыйНомер;
	КонецЦикла;
	
	Обрезано = РезультатПоиска.Обрезано;
	Элементы.ПояснениеОбрезки.Видимость = Обрезано;
	ПоказатьИтогПоиска(Результаты.Количество());
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьИтогПоиска(КоличествоРезультатов)
	
	Если ПустаяСтрока(Расш1_ШаблонИтогаПоиска) Тогда
		Расш1_ШаблонИтогаПоиска = ОбщегоНазначения.ЗначениеВСтрокуXML(
			Элементы.ПояснениеРезультатаПоиска.Заголовок);
	КонецЕсли;
	
	КоличествоСтрокой = Строка(КоличествоРезультатов);
	ТекстШаблона = СтрЗаменить(Расш1_ШаблонИтогаПоиска, "%1", КоличествоСтрокой);
	ЗаголовокИтога = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстШаблона); // ФорматированнаяСтрока, Строка
	Элементы.ПояснениеРезультатаПоиска.Заголовок = ЗаголовокИтога;
	Элементы.ПояснениеРезультатаПоиска.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПросмотрМодуля(ТекущиеДанные)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Релиз", ТекущиеДанные.Релиз);
	ПараметрыОткрытия.Вставить("Вид", ТекущиеДанные.ВидМодуля);
	ПараметрыОткрытия.Вставить("Ключ", ТекущиеДанные.Ключ);
	ПараметрыОткрытия.Вставить("Расш1_ФразаПоиска", СокрЛП(СтрокаПоиска));
	ПараметрыОткрытия.Вставить("Расш1_ИмяПоляПоиска", ТекущиеДанные.ИмяПоля);
	ПараметрыОткрытия.Вставить("Расш1_НомерСтрокиПоиска", ТекущиеДанные.НомерСтроки);
	ОткрытьФорму("ОбщаяФорма.Расш1_ПросмотрТекстаМодуля", ПараметрыОткрытия);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыИсточник);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыВид);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыПредставление);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыСинонимПоля);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыНомерПоПорядку);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыНомерСтроки);
	ДобавитьПолеОформления(Элемент, Элементы.РезультатыФрагмент);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Результаты.ЭтоМодуль");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Голубой);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеОформления(ЭлементОформления, ПолеФормы)
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
	
КонецПроцедуры

#КонецОбласти
