// @strict-types

#Область ПрограммныйИнтерфейс

// Делает текущей страницу обработчика, если среди видимых страниц заполнен ровно один обработчик.
// Если не заполнен ни один или заполнено несколько, текущая страница не меняется.
//
// Параметры:
//  ГруппаСтраниц - ГруппаФормы - группа страниц обработчиков.
//  ОбъектФормы - ДанныеФормыСтруктура - объект формы с полями "Алгоритм...".
//  ПоляИсключения - Строка - имена полей "Алгоритм...", которые не учитываются.
//
Процедура АктивироватьЕдинственныйЗаполненныйОбработчик(ГруппаСтраниц, ОбъектФормы, ПоляИсключения = "") Экспорт
	
	ЗаполненнаяСтраница = Неопределено;
	Для Каждого СтраницаОбработчика Из ГруппаСтраниц.ПодчиненныеЭлементы Цикл
		Если Не СтраницаОбработчика.Видимость
			Или Не ОбработчикЗаполнен(СтраницаОбработчика, ОбъектФормы, ПоляИсключения) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаполненнаяСтраница <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗаполненнаяСтраница = СтраницаОбработчика;
	КонецЦикла;
	
	Если ЗаполненнаяСтраница <> Неопределено Тогда
		// Тип свойства ТекущаяСтраница в описании платформы не задан.
		// @skip-check property-return-type
		ГруппаСтраниц.ТекущаяСтраница = ЗаполненнаяСтраница;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбработчикЗаполнен(Группа, ОбъектФормы, ПоляИсключения)
	
	Для Каждого Элемент Из Группа.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			Если ОбработчикЗаполнен(Элемент, ОбъектФормы, ПоляИсключения) Тогда
				Возврат Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ИмяЭлемента = НРег(Элемент.Имя);
		Если Не СтрНачинаетсяС(ИмяЭлемента, "алгоритм") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(ПоляИсключения) И СтрНайти(Элемент.Имя, ПоляИсключения) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ОбъектФормы.Свойство(Элемент.Имя) И ЗначениеЗаполнено(ОбъектФормы[Элемент.Имя]) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
