// Описание алгоритма в реестре хоста.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяСтраницы - Строка
//   * ПутьКДанным - Строка
//   * ПоказыватьНаправление - Булево
//   * ТолькоПросмотр - Булево
//   * АвтоНаправление - Строка
//   * СкрытьПанельКоманд - Булево
//
Функция НовыйОписаниеАлгоритма() Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("ИмяСтраницы", "");
	Описание.Вставить("ПутьКДанным", "");
	Описание.Вставить("ПоказыватьНаправление", Истина);
	Описание.Вставить("ТолькоПросмотр", Ложь);
	Описание.Вставить("АвтоНаправление", "");
	Описание.Вставить("СкрытьПанельКоманд", Ложь);
	
	Возврат Описание;
	
КонецФункции

// Добавить описание алгоритма в строку реестра.
//
// Параметры:
//  Реестр - Строка
//  Описание - см. НовыйОписаниеАлгоритма
//
// Возвращаемое значение:
//  Строка
//
Функция ДобавитьОписаниеВРеестр(Реестр, Описание) Экспорт
	
	Если Не ПустаяСтрока(НайтиОписаниеАлгоритма(Реестр, Описание.ИмяСтраницы).ИмяСтраницы) Тогда
		Возврат Реестр;
	КонецЕсли;
	
	Запись = СтрокаРеестраИзОписания(Описание);
	Если ПустаяСтрока(Реестр) Тогда
		Возврат Запись;
	КонецЕсли;
	
	Возврат Реестр + ";" + Запись;
	
КонецФункции

// Найти описание алгоритма по имени страницы.
//
// Параметры:
//  Реестр - Строка
//  ИмяСтраницы - Строка
//
// Возвращаемое значение:
//  см. НовыйОписаниеАлгоритма
//
Функция НайтиОписаниеАлгоритма(Реестр, ИмяСтраницы) Экспорт
	
	Для Каждого Описание Из РазобратьРеестр(Реестр) Цикл
		Если Описание.ИмяСтраницы = ИмяСтраницы Тогда
			Результат = НовыйОписаниеАлгоритма();
			ЗаполнитьЗначенияСвойств(Результат, Описание);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыйОписаниеАлгоритма();
	
КонецФункции

// Разобрать строку реестра в массив описаний.
//
// Параметры:
//  Реестр - Строка
//
// Возвращаемое значение:
//  Массив из см. НовыйОписаниеАлгоритма
//
Функция РазобратьРеестр(Реестр) Экспорт
	
	Результат = Новый Массив;
	Если ПустаяСтрока(Реестр) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Запись Из СтрРазделить(Реестр, ";", Ложь) Цикл
		Описание = ОписаниеИзСтрокиРеестра(Запись);
		Если Описание <> Неопределено Тогда
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разобрать путь к данным алгоритма.
//
// Параметры:
//  Путь - Строка - «Объект.Имя» или имя реквизита формы.
//
// Возвращаемое значение:
//  Структура:
//   * ЭтоРеквизитОбъекта - Булево
//   * ИмяРеквизита - Строка
//
Функция ЧастиПутиДанных(Путь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЭтоРеквизитОбъекта", Ложь);
	Результат.Вставить("ИмяРеквизита", Путь);
	
	ПрефиксОбъекта = "Объект.";
	Если СтрНачинаетсяС(Путь, ПрефиксОбъекта) Тогда
		Результат.ЭтоРеквизитОбъекта = Истина;
		Результат.ИмяРеквизита = Сред(Путь, СтрДлина(ПрефиксОбъекта) + 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавить имя в список через запятую, если его ещё нет.
//
// Параметры:
//  Список - Строка
//  Имя - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ДобавитьИмяВСписок(Список, Имя) Экспорт
	
	Если ПустаяСтрока(Имя) Или ИмяЕстьВСписке(Список, Имя) Тогда
		Возврат Список;
	КонецЕсли;
	
	Если ПустаяСтрока(Список) Тогда
		Возврат Имя;
	КонецЕсли;
	
	Возврат Список + "," + Имя;
	
КонецФункции

// Признак наличия имени в списке через запятую.
//
// Параметры:
//  Список - Строка
//  Имя - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ИмяЕстьВСписке(Список, Имя) Экспорт
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрНайти("," + Список + ",", "," + Имя + ",") > 0;
	
КонецФункции

// Нужно ли сбрасывать текст редактора в реквизит алгоритма.
//
// Параметры:
//  ХостСформирован - Булево
//  СтраницаОткрывалась - Булево
//
// Возвращаемое значение:
//  Булево
//
Функция НужноЗаписатьТекстАлгоритма(ХостСформирован, СтраницаОткрывалась) Экспорт
	
	Возврат ХостСформирован И СтраницаОткрывалась;
	
КонецФункции

// Признак: в реестре есть алгоритм с видимым направлением.
//
// Параметры:
//  Реестр - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьАлгоритмСНаправлением(Реестр) Экспорт
	
	Для Каждого Описание Из РазобратьРеестр(Реестр) Цикл
		Если Описание.ПоказыватьНаправление Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаРеестраИзОписания(Описание)
	
	Части = Новый Массив;
	Части.Добавить(Описание.ИмяСтраницы);
	Части.Добавить(Описание.ПутьКДанным);
	Части.Добавить(ФлагИзБулево(Описание.ПоказыватьНаправление));
	Части.Добавить(ФлагИзБулево(Описание.ТолькоПросмотр));
	Части.Добавить(Описание.АвтоНаправление);
	Части.Добавить(ФлагИзБулево(Описание.СкрытьПанельКоманд));
	
	Возврат СтрСоединить(Части, "|");
	
КонецФункции

Функция ОписаниеИзСтрокиРеестра(Запись)
	
	Части = СтрРазделить(Запись, "|");
	Если Части.Количество() < 6 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = НовыйОписаниеАлгоритма();
	Описание.ИмяСтраницы = Части[0];
	Описание.ПутьКДанным = Части[1];
	Описание.ПоказыватьНаправление = БулевоИзФлага(Части[2]);
	Описание.ТолькоПросмотр = БулевоИзФлага(Части[3]);
	Описание.АвтоНаправление = Части[4];
	Описание.СкрытьПанельКоманд = БулевоИзФлага(Части[5]);
	
	Возврат Описание;
	
КонецФункции

Функция ФлагИзБулево(Значение)
	
	Возврат ?(Значение, "1", "0");
	
КонецФункции

Функция БулевоИзФлага(Флаг)
	
	Возврат Флаг = "1";
	
КонецФункции

Функция ТемаИзСохраненногоЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("ПеречислениеСсылка.Расш1_ТемыКонсолиКода") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.White");
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.White");
	КонецЕсли;
	
	Если Значение = "bsl-white-query" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.WhiteQuery");
	ИначеЕсли Значение = "bsl-dark" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.Dark");
	ИначеЕсли Значение = "bsl-dark-query" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.DarkQuery");
	ИначеЕсли Значение = "bsl-edt-white" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.EDTWhite");
	ИначеЕсли Значение = "bsl-edt-dark" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.EDTDark");
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.White");
	
КонецФункции

Функция НасыщенностьИзСохраненногоЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("ПеречислениеСсылка.Расш1_НасыщенностьШрифтаКонсоли") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Значение = "normal" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Normal");
	ИначеЕсли Значение = "bold" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Bold");
	ИначеЕсли Значение = "lighter" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Lighter");
	ИначеЕсли Значение = "bolder" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Bolder");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
