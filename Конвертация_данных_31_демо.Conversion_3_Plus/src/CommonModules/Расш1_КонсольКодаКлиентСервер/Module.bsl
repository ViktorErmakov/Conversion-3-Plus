// Настройки редактора по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Тема - Строка
//   * РазмерШрифта - Число
//   * СемействоШрифтов - Строка
//   * НасыщенностьШрифта - Строка
//   * ВысотаСтроки - Число
//   * КартаКода - Булево
//   * ПереносСтрок - Булево
//   * НомераСтрок - Булево
//   * СтрокаСостояния - Булево
//   * ОтображатьПробелы - Булево
//   * Сворачивание - Булево
//   * ПодсветкаКавычек - Булево
//   * БыстрыеПодсказки - Булево
//   * ЯзыкПодсказок - Строка
//   * КонтекстРедактора - Строка
//   * АвтоРазмер - Булево
//
Функция НовыеНастройкиРедактора() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Тема", "bsl-white");
	Настройки.Вставить("РазмерШрифта", 0);
	Настройки.Вставить("СемействоШрифтов", "");
	Настройки.Вставить("НасыщенностьШрифта", "");
	Настройки.Вставить("ВысотаСтроки", 0);
	Настройки.Вставить("КартаКода", Ложь);
	Настройки.Вставить("ПереносСтрок", Ложь);
	Настройки.Вставить("НомераСтрок", Истина);
	Настройки.Вставить("СтрокаСостояния", Ложь);
	Настройки.Вставить("ОтображатьПробелы", Ложь);
	Настройки.Вставить("Сворачивание", Истина);
	Настройки.Вставить("ПодсветкаКавычек", Ложь);
	Настройки.Вставить("БыстрыеПодсказки", Истина);
	Настройки.Вставить("ЯзыкПодсказок", "ru");
	Настройки.Вставить("КонтекстРедактора", "");
	Настройки.Вставить("АвтоРазмер", Истина);
	
	Возврат Настройки;
	
КонецФункции

// Дополнить загруженные настройки ключами по умолчанию.
//
// Параметры:
//  Настройки - Структура, Неопределено - сохраненные настройки или отсутствие.
//
// Возвращаемое значение:
//  См. НовыеНастройкиРедактора
//
Функция ДополнитьНастройкиРедактора(Настройки) Экспорт
	
	Результат = НовыеНастройкиРедактора();
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Результат Цикл
		Если Настройки.Свойство(КлючИЗначение.Ключ) Тогда
			Результат[КлючИЗначение.Ключ] = Настройки[КлючИЗначение.Ключ];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

