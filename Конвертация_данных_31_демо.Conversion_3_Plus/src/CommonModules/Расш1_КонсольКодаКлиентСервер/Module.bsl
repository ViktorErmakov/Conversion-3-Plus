// Настройки редактора по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * ИспользоватьКонсольКода - Булево
//   * Тема - ПеречислениеСсылка.Расш1_ТемыКонсолиКода
//   * РазмерШрифта - Число
//   * СемействоШрифтов - Строка
//   * НасыщенностьШрифта - ПеречислениеСсылка.Расш1_НасыщенностьШрифтаКонсоли, Неопределено - пусто, если setFontWeight не вызывать.
//   * ВысотаСтроки - Число
//   * КартаКода - Булево
//   * ПереносСтрок - Булево
//   * НомераСтрок - Булево
//   * СтрокаСостояния - Булево
//   * ОтображатьПробелы - Булево
//   * Сворачивание - Булево
//   * ПодсветкаКавычек - Булево
//   * БыстрыеПодсказки - Булево
//   * ЯзыкПодсказок - Строка
//   * АвтоРазмер - Булево
//
Функция НовыеНастройкиРедактора() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("ИспользоватьКонсольКода", Истина);
	Настройки.Вставить("Тема", ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.White"));
	Настройки.Вставить("РазмерШрифта", 0);
	Настройки.Вставить("СемействоШрифтов", "");
	Настройки.Вставить("НасыщенностьШрифта", Неопределено);
	Настройки.Вставить("ВысотаСтроки", 0);
	Настройки.Вставить("КартаКода", Ложь);
	Настройки.Вставить("ПереносСтрок", Ложь);
	Настройки.Вставить("НомераСтрок", Истина);
	Настройки.Вставить("СтрокаСостояния", Ложь);
	Настройки.Вставить("ОтображатьПробелы", Ложь);
	Настройки.Вставить("Сворачивание", Истина);
	Настройки.Вставить("ПодсветкаКавычек", Ложь);
	Настройки.Вставить("БыстрыеПодсказки", Истина);
	Настройки.Вставить("ЯзыкПодсказок", "ru");
	Настройки.Вставить("АвтоРазмер", Истина);
	
	Возврат Настройки;
	
КонецФункции

// Дополнить загруженные настройки ключами по умолчанию.
//
// Параметры:
//  Настройки - Структура, Неопределено - сохраненные настройки или отсутствие.
//
// Возвращаемое значение:
//  См. НовыеНастройкиРедактора
//
Функция ДополнитьНастройкиРедактора(Настройки) Экспорт
	
	Результат = НовыеНастройкиРедактора();
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Результат Цикл
		Если Не Настройки.Свойство(КлючИЗначение.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Значение = Настройки[КлючИЗначение.Ключ];
		Если КлючИЗначение.Ключ = "Тема" Тогда
			Результат.Тема = ТемаИзСохраненногоЗначения(Значение);
		ИначеЕсли КлючИЗначение.Ключ = "НасыщенностьШрифта" Тогда
			Результат.НасыщенностьШрифта = НасыщенностьИзСохраненногоЗначения(Значение);
		Иначе
			Результат[КлючИЗначение.Ключ] = Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Признак, что на формах правил нужно создавать HTML-хост вместо типового поля.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки редактора; если Неопределено, считается включённой.
//
// Возвращаемое значение:
//  Булево
//
Функция КонсольВключена(Настройки = Неопределено) Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Настройки.Свойство("ИспользоватьКонсольКода", Значение) Тогда
		Возврат Значение <> Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Имя темы для setTheme по значению перечисления.
//
// Параметры:
//  Тема - ПеречислениеСсылка.Расш1_ТемыКонсолиКода, Строка - значение настройки или имя API.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяТемыAPI(Тема) Экспорт
	
	Если ТипЗнч(Тема) = Тип("Строка") Тогда
		Если Не ПустаяСтрока(Тема) Тогда
			Возврат Тема;
		КонецЕсли;
		Возврат "bsl-white";
	КонецЕсли;
	
	Если Тема = ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.WhiteQuery") Тогда
		Возврат "bsl-white-query";
	ИначеЕсли Тема = ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.Dark") Тогда
		Возврат "bsl-dark";
	ИначеЕсли Тема = ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.DarkQuery") Тогда
		Возврат "bsl-dark-query";
	ИначеЕсли Тема = ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.EDTWhite") Тогда
		Возврат "bsl-edt-white";
	ИначеЕсли Тема = ПредопределенноеЗначение("Перечисление.Расш1_ТемыКонсолиКода.EDTDark") Тогда
		Возврат "bsl-edt-dark";
	КонецЕсли;
	
	Возврат "bsl-white";
	
КонецФункции

// Имя насыщенности для setFontWeight. Пустая строка — не вызывать API.
//
// Параметры:
//  Насыщенность - ПеречислениеСсылка.Расш1_НасыщенностьШрифтаКонсоли, Строка, Неопределено - значение настройки или имя API.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяНасыщенностиAPI(Насыщенность) Экспорт
	
	Если ТипЗнч(Насыщенность) = Тип("Строка") Тогда
		Возврат Насыщенность;
	КонецЕсли;
	
	Если Насыщенность = ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Normal") Тогда
		Возврат "normal";
	ИначеЕсли Насыщенность = ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Bold") Тогда
		Возврат "bold";
	ИначеЕсли Насыщенность = ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Lighter") Тогда
		Возврат "lighter";
	ИначеЕсли Насыщенность = ПредопределенноеЗначение("Перечисление.Расш1_НасыщенностьШрифтаКонсоли.Bolder") Тогда
		Возврат "bolder";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Нормализовать перевод строки к Windows CRLF при записи из хоста в реквизит.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстСПереносамиWindows(Текст) Экспорт
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Нормализованный = СтрЗаменить(Текст, Символы.ВК, "");
	Возврат СтрЗаменить(Нормализованный, Символы.ПС, Символы.ВК + Символы.ПС);
	
КонецФункции

