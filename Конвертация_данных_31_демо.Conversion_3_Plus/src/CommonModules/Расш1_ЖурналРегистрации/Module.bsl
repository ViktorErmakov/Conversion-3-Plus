
#Область ПрограммныйИнтерфейс

// Расширение глобального контекста по добавлению записи в журнал регистрации.
//
// Параметры:
//  ИмяСобытия	 - Строка
//  Уровень		 - УровеньЖурналаРегистрации
//  Комментарий	 - Строка
//
Процедура ДобавитьЗапись(ИмяСобытия, Уровень, Комментарий = "") Экспорт
	
	УровеньЗаписи = Вычислить(СтрШаблон("УровеньЖурналаРегистрации.%1", Уровень));
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЗаписи, , ,Комментарий);
	
КонецПроцедуры

#КонецОбласти

