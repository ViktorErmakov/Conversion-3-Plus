// @strict-types

#Область ПрограммныйИнтерфейс

// Текст HTML-макета консоли кода (single-file bsl_console).
// 
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекстHTMLКонсоли() Экспорт
	
	Макет = ПолучитьОбщийМакет("bsl_console");
	Возврат Макет.ПолучитьТекст();
	
КонецФункции

// JSON описания объекта или списка объектов метаданных для подсказок консоли.
//
// Параметры:
//  ПараметрыЗапроса - Строка - имя коллекции или полный путь объекта.
//  АдресОбновления - Строка - исходящий path для updateMetadata (catalogs.items).
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы - конвертация или релиз конфигурации.
//  Направление - Строка - Отправка, Получение или пустая строка.
//
// Возвращаемое значение:
//  Структура:
//   * ОписаниеJSON - Строка
//   * АдресОбновления - Строка
//
Функция ПолучитьОписаниеОбъектаМетаданныхJSON(Знач ПараметрыЗапроса, АдресОбновления, Знач Конвертация,
		Знач Направление = "") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеJSON", "");
	Результат.Вставить("АдресОбновления", "");
	
	Если ПустаяСтрока(ПараметрыЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Релизы = РелизыКонвертацииДляМетаданных(Конвертация, Направление);
	ЧастиПути = СтрРазделить(ПараметрыЗапроса, ".");
	ИмяКоллекции = ЧастиПути[0];
	ИмяОбъекта = "";
	Если ЧастиПути.Количество() > 1 Тогда
		ИмяОбъекта = СокрЛП(ЧастиПути[1]);
	КонецЕсли;
	
	Для Каждого Релиз Из Релизы Цикл
		
		Если Не ПустаяСтрока(ИмяОбъекта) Тогда
			Результат.ОписаниеJSON = Расш1_КоллекцияМетаданных.ПолучитьОписаниеОбъектаМетаданных(
				ПараметрыЗапроса, АдресОбновления, Релиз);
			Если ЗначениеЗаполнено(Результат.ОписаниеJSON) Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Результат.ОписаниеJSON = Расш1_КоллекцияМетаданных.ПолучитьСписокОбъектовМетаданных(
			ИмяКоллекции, АдресОбновления, Релиз);
		Если ЗначениеЗаполнено(Результат.ОписаниеJSON) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.АдресОбновления = АдресОбновления;
	Возврат Результат;
	
КонецФункции

// Прочитать настройки редактора из хранилища общих настроек.
//
// Возвращаемое значение:
//  См. Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора
//
Функция ПрочитатьНастройкиРедактора() Экспорт
	
	Настройки = ХранилищеОбщихНастроек.Загрузить(
		Расш1_КонсольКодаКлиентСервер.КлючОбъектаНастроек(),
		Расш1_КонсольКодаКлиентСервер.КлючНастройкиРедактора());
	
	Возврат Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки);
	
КонецФункции

// Признак, что на формах правил нужно создавать HTML-хост.
//
// Возвращаемое значение:
//  Булево
//
Функция КонсольВключена() Экспорт
	
	Возврат Расш1_КонсольКодаКлиентСервер.КонсольВключена(ПрочитатьНастройкиРедактора());
	
КонецФункции

// Релиз конвертации, если в справочнике Объекты нет загруженной структуры.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  СправочникСсылка.Релизы - релиз без загруженной структуры; Неопределено, если описание есть.
//
Функция РелизКонвертацииЕслиНетОписания(Знач Конвертация) Экспорт
	
	Возврат Расш1_КоллекцияМетаданных.РелизКонвертацииЕслиНетОписания(Конвертация);
	
КонецФункции

// Сохранить настройки редактора в хранилище общих настроек.
//
// Параметры:
//  Настройки - См. Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора
//
Процедура СохранитьНастройкиРедактора(Знач Настройки) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить(
		Расш1_КонсольКодаКлиентСервер.КлючОбъектаНастроек(),
		Расш1_КонсольКодаКлиентСервер.КлючНастройкиРедактора(),
		Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки));
	
КонецПроцедуры

// Текст модуля конфигурации для parseCommonModule / parseMetadataModule.
//
// Параметры:
//  ПутьМетаданных - Строка - путь события EVENT_GET_METADATA, например module.Имя.
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы - конвертация или релиз конфигурации.
//  Направление - Строка - Отправка, Получение или пустая строка.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка
//   * Глобальный - Булево
//   * ИмяМодуля - Строка
//   * АдресОбновления - Строка
//   * ЭтоОбщийМодуль - Булево
//
Функция ПолучитьТекстМодуля(Знач ПутьМетаданных, Знач Конвертация, Знач Направление = "") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", "");
	Результат.Вставить("Глобальный", Ложь);
	Результат.Вставить("ИмяМодуля", "");
	Результат.Вставить("АдресОбновления", "");
	Результат.Вставить("ЭтоОбщийМодуль", Ложь);
	
	ОписаниеЗапроса = ОписаниеЗапросаМодуля(ПутьМетаданных);
	Если ОписаниеЗапроса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЭтоОбщийМодуль = ОписаниеЗапроса.ЭтоОбщийМодуль;
	Релизы = РелизыКонвертацииДляМетаданных(Конвертация, Направление);
	ТекстыРелизов = ТекстыМодуляРелизов(Релизы, ОписаниеЗапроса.Вид, ОписаниеЗапроса.Ключ);
	Для Каждого Релиз Из Релизы Цикл
		
		ЗаписьМодуля = ТекстыРелизов.Получить(Релиз);
		Если ЗаписьМодуля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Текст = ЗаписьМодуля.Текст;
		Результат.Глобальный = ЗаписьМодуля.Глобальный;
		Результат.ИмяМодуля = ЗаписьМодуля.Ключ;
		Если ОписаниеЗапроса.ЭтоОбщийМодуль Тогда
			Прервать;
		КонецЕсли;
		
		ИмяОбъекта = Расш1_КоллекцияМетаданных.ИмяОбъектаМетаданных(
			Релиз, ОписаниеЗапроса.ИмяКоллекции, ОписаниеЗапроса.ИмяОбъекта);
		ИменаКоллекцийJSON = Расш1_КоллекцииМетаданныхПовтИсп.НовыеИменаКоллекцииМетаданныхJSON();
		ИмяКоллекцииJSON = ИменаКоллекцийJSON[ОписаниеЗапроса.ИмяКоллекции];
		Если ПустаяСтрока(ИмяОбъекта) Или ИмяКоллекцииJSON = Неопределено Тогда
			Результат.Текст = "";
			Продолжить;
		КонецЕсли;
		
		Результат.АдресОбновления = СтрШаблон("%1.items.%2.%3", ИмяКоллекцииJSON, ИмяОбъекта, ОписаниеЗапроса.Суффикс);
		Прервать;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// JSON имен общих модулей релиза для updateMetadata, path commonModules.items.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы - конвертация или релиз конфигурации.
//  Направление - Строка - Отправка, Получение или пустая строка.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьИменаОбщихМодулейJSON(Знач Конвертация, Знач Направление = "") Экспорт
	
	Релизы = РелизыКонвертацииДляМетаданных(Конвертация, Направление);
	Если Релизы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	// Общие модули: ключ без точки. Вид не фильтруем - записи могли остаться
	// с устаревшей ссылкой перечисления после обновления расширения.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТекстыМодулей.Ключ КАК Ключ
	|ИЗ
	|	РегистрСведений.Расш1_ТекстыМодулей КАК ТекстыМодулей
	|ГДЕ
	|	ТекстыМодулей.Релиз В (&Релизы)
	|	И НЕ ТекстыМодулей.Ключ ПОДОБНО ""%.%""";
	Запрос.УстановитьПараметр("Релизы", Релизы);
	
	ИменаМодулей = Новый Соответствие;
	ПоляВыборки = Новый Структура("Ключ", "");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПоляВыборки, Выборка);
		Если ПустаяСтрока(ПоляВыборки.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		ИменаМодулей.Вставить(ПоляВыборки.Ключ, Новый Структура);
	КонецЦикла;
	
	Если ИменаМодулей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Расш1_КоллекцияМетаданных.ПолучитьОписаниеМетаданныхJSON(ИменаМодулей);
	
КонецФункции

// JSON контекста обработчика: customObjects, пользовательские функции и сигнатуры.
//
// Параметры:
//  ОписаниеМетаданныхJSON - Строка - JSON customObjects страницы.
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  Структура:
//   * ОписаниеJSON - Строка
//   * ФункцииJSON - Строка
//   * СигнатурыJSON - Строка
//
Функция Расш1_ДополнитьКонтекстОбработчика(Знач ОписаниеМетаданныхJSON, Знач Конвертация) Экспорт
	
	Возврат Расш1_КоллекцияМетаданных.Расш1_ДополнитьКонтекстОбработчика(
		ОписаниеМетаданныхJSON, Конвертация);
	
КонецФункции

// Ссылка алгоритма или запроса текущей конвертации по коду из текста обработчика.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  ЭтоЗапрос - Булево - Истина, если искать элемент справочника Запросы
//  Имя - Строка - код элемента
//
// Возвращаемое значение:
//  СправочникСсылка.Алгоритмы, СправочникСсылка.Запросы, Неопределено -
//  ссылка найденного элемента или Неопределено, если элемента нет
//
Функция СсылкаАлгоритмаИлиЗапроса(Знач Конвертация, Знач ЭтоЗапрос, Знач Имя) Экспорт
	
	Если Не ЗначениеЗаполнено(Конвертация) Или ПустаяСтрока(СокрЛП(Имя)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЭлементаСостава(ЭтоЗапрос);
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("Шаблон", ШаблонКодаЭлемента(Имя));
	
	ИмяБезПробелов = СокрЛП(Имя);
	ИмяНормализованное = НРег(ИмяБезПробелов);
	ПоляВыборки = Новый Структура("Код, Ссылка", "", Неопределено);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПоляВыборки, Выборка);
		КодЭлемента = СокрП(ПоляВыборки.Код);
		Если НРег(КодЭлемента) = ИмяНормализованное Тогда
			Возврат ПоляВыборки.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаЭлементаСостава(ЭтоЗапрос)
	
	Если ЭтоЗапрос Тогда
		Возврат
		"ВЫБРАТЬ
		|	Элемент.Ссылка КАК Ссылка,
		|	Элемент.Код КАК Код
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК Состав
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Запросы КАК Элемент
		|		ПО Состав.ЭлементКонвертации = Элемент.Ссылка
		|ГДЕ
		|	Состав.Владелец = &Конвертация
		|	И НЕ Состав.ПометкаУдаления
		|	И НЕ Элемент.ПометкаУдаления
		|	И Элемент.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""
		|	И НЕ Элемент.ЭтоГруппа";
	КонецЕсли;
	
	Возврат
	"ВЫБРАТЬ
	|	Элемент.Ссылка КАК Ссылка,
	|	Элемент.Код КАК Код
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК Состав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Алгоритмы КАК Элемент
	|		ПО Состав.ЭлементКонвертации = Элемент.Ссылка
	|ГДЕ
	|	Состав.Владелец = &Конвертация
	|	И НЕ Состав.ПометкаУдаления
	|	И НЕ Элемент.ПометкаУдаления
	|	И Элемент.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""";
	
КонецФункции

Функция ШаблонКодаЭлемента(Имя)
	
	ЭкранированноеИмя = СтрЗаменить(СокрЛП(Имя), "\", "\\");
	ЭкранированноеИмя = СтрЗаменить(ЭкранированноеИмя, "%", "\%");
	ЭкранированноеИмя = СтрЗаменить(ЭкранированноеИмя, "_", "\_");
	Возврат СтрШаблон("%1%%", ЭкранированноеИмя);
	
КонецФункции

// Релизы конвертации для подсказок метаданных.
// XDTO: всегда Конфигурация (направление влияет только на customObjects).
// XML: Отправка - Конфигурация, Получение - КонфигурацияКорреспондент.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы - конвертация или релиз конфигурации.
//  Направление - Строка - Отправка или Получение. Для XDTO не используется; для XML пустая строка - без релизов.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Релизы
//
Функция РелизыКонвертацииДляМетаданных(Конвертация, Направление = "")
	
	Релизы = Новый Массив; // Массив из СправочникСсылка.Релизы
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Релизы;
	КонецЕсли;
	
	Если ТипЗнч(Конвертация) = Тип("СправочникСсылка.Релизы") Тогда
		Релизы.Добавить(Конвертация);
		Возврат Релизы;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Конвертация, "ТипКонвертации, Конфигурация, КонфигурацияКорреспондент");
	
	Если ЗначенияРеквизитов.ТипКонвертации <> Перечисления.ТипыКонвертаций.XML Тогда
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.Конфигурация) Тогда
			Релизы.Добавить(ЗначенияРеквизитов.Конфигурация);
		КонецЕсли;
		Возврат Релизы;
		
	КонецЕсли;
	
	Если Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение() Тогда
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.КонфигурацияКорреспондент) Тогда
			Релизы.Добавить(ЗначенияРеквизитов.КонфигурацияКорреспондент);
			Возврат Релизы;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.Конфигурация) Тогда
			Релизы.Добавить(ЗначенияРеквизитов.Конфигурация);
		КонецЕсли;
		Возврат Релизы;
	КонецЕсли;
	
	Если Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка() Тогда
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.Конфигурация) Тогда
			Релизы.Добавить(ЗначенияРеквизитов.Конфигурация);
		КонецЕсли;
		Возврат Релизы;
	КонецЕсли;
	
	Возврат Релизы;
	
КонецФункции

Функция ОписаниеЗапросаМодуля(ПутьМетаданных)
	
	ПутьМетаданныхНРег = НРег(ПутьМетаданных);
	ЧастиПути = СтрРазделить(ПутьМетаданныхНРег, ".", Ложь);
	ЧастейОбщегоМодуля = 2;
	ЧастейМодуляОбъекта = 4;
	Если ЧастиПути.Количество() < ЧастейОбщегоМодуля Или ЧастиПути[0] <> "module" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("ЭтоОбщийМодуль", Ложь);
	Описание.Вставить("Вид", Перечисления.Расш1_ВидыМодулей.ПустаяСсылка());
	Описание.Вставить("Ключ", "");
	Описание.Вставить("ИмяКоллекции", "");
	Описание.Вставить("ИмяОбъекта", "");
	Описание.Вставить("Суффикс", "");
	
	Если ЧастиПути.Количество() = ЧастейОбщегоМодуля Тогда
		Описание.ЭтоОбщийМодуль = Истина;
		Описание.Вид = Перечисления.Расш1_ВидыМодулей.ОбщийМодуль;
		Описание.Ключ = ЧастиПути[1];
		Возврат Описание;
	КонецЕсли;
	
	Если ЧастиПути.Количество() <> ЧастейМодуляОбъекта Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЧастиПути[1] = "manager" Тогда
		Описание.Вид = Перечисления.Расш1_ВидыМодулей.МодульМенеджера;
		Описание.Суффикс = "manager";
	ИначеЕсли ЧастиПути[1] = "object" Тогда
		Описание.Вид = Перечисления.Расш1_ВидыМодулей.МодульОбъекта;
		Описание.Суффикс = "object";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяКоллекции = Расш1_КоллекцииМетаданныхПовтИсп.НовыеИменаКоллекцииМетаданных()[ЧастиПути[2]];
	Если ИмяКоллекции = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Описание.ИмяКоллекции = ИмяКоллекции;
	Описание.ИмяОбъекта = ЧастиПути[3];
	Описание.Ключ = СтрШаблон("%1.%2", ИмяКоллекции, ЧастиПути[3]);
	Возврат Описание;
	
КонецФункции

// Параметры:
//  Релизы - Массив из СправочникСсылка.Релизы
//  Вид - ПеречислениеСсылка.Расш1_ВидыМодулей
//  Ключ - Строка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - СправочникСсылка.Релизы
//   * Значение - см. НоваяЗаписьМодуля
//
Функция ТекстыМодуляРелизов(Релизы, Вид, Ключ)
	
	ТекстыРелизов = Новый Соответствие;
	Если Релизы.Количество() = 0 Или ПустаяСтрока(Ключ) Тогда
		Возврат ТекстыРелизов;
	КонецЕсли;
	
	// Ключ ищем без учёта регистра; Вид не фильтруем - ключ уникален в разрезе релиза
	// (общий модуль без точки, модуль объекта/менеджера - с точкой).
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТекстыМодулей.Релиз КАК Релиз,
	|	ТекстыМодулей.Ключ КАК Ключ,
	|	ТекстыМодулей.Текст КАК Текст,
	|	ТекстыМодулей.Глобальный КАК Глобальный,
	|	ТекстыМодулей.Вид КАК Вид
	|ИЗ
	|	РегистрСведений.Расш1_ТекстыМодулей КАК ТекстыМодулей
	|ГДЕ
	|	ТекстыМодулей.Релиз В (&Релизы)
	|	И ВРЕГ(ТекстыМодулей.Ключ) = ВРЕГ(&Ключ)";
	Запрос.УстановитьПараметр("Релизы", Релизы);
	Запрос.УстановитьПараметр("Ключ", Ключ);
	
	ПоляВыборки = Новый Структура;
	ПоляВыборки.Вставить("Релиз", Справочники.Релизы.ПустаяСсылка());
	ПоляВыборки.Вставить("Вид", Перечисления.Расш1_ВидыМодулей.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ПоляВыборки, Выборка);
		Если ЗначениеЗаполнено(Вид) И ЗначениеЗаполнено(ПоляВыборки.Вид) И ПоляВыборки.Вид <> Вид Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписьМодуля = НоваяЗаписьМодуля();
		ЗаполнитьЗначенияСвойств(ЗаписьМодуля, Выборка);
		ТекстыРелизов.Вставить(ПоляВыборки.Релиз, ЗаписьМодуля);
		
	КонецЦикла;
	
	Возврат ТекстыРелизов;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка
//   * Текст - Строка
//   * Глобальный - Булево
//
Функция НоваяЗаписьМодуля()
	
	ЗаписьМодуля = Новый Структура;
	ЗаписьМодуля.Вставить("Ключ", "");
	ЗаписьМодуля.Вставить("Текст", "");
	ЗаписьМодуля.Вставить("Глобальный", Ложь);
	Возврат ЗаписьМодуля;
	
КонецФункции

#КонецОбласти
