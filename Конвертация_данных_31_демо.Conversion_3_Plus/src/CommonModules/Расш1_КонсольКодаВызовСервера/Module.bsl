#Область ПрограммныйИнтерфейс

// Текст HTML-макета консоли кода (single-file bsl_console).
// 
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекстHTMLКонсоли() Экспорт
	
	Макет = ПолучитьОбщийМакет("bsl_console");
	Возврат Макет.ПолучитьТекст();
	
КонецФункции

// JSON описания объекта или списка объектов метаданных для подсказок консоли.
//
// Параметры:
//  ПараметрыЗапроса - Строка - имя коллекции или полный путь объекта.
//  АдресОбновления - Строка - исходящий path для updateMetadata (catalogs.items).
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Структура:
//   * ОписаниеJSON - Строка
//   * АдресОбновления - Строка
//
Функция ПолучитьОписаниеОбъектаМетаданныхJSON(Знач ПараметрыЗапроса, АдресОбновления, Знач Конвертация) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеJSON", "");
	Результат.Вставить("АдресОбновления", "");
	
	Если ПустаяСтрока(ПараметрыЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Релизы = РелизыКонвертацииДляМетаданных(Конвертация);
	ЧастиПути = СтрРазделить(ПараметрыЗапроса, ".");
	ИмяКоллекции = ЧастиПути[0];
	ИмяОбъекта = "";
	Если ЧастиПути.Количество() > 1 Тогда
		ИмяОбъекта = СокрЛП(ЧастиПути[1]);
	КонецЕсли;
	
	Для Каждого Релиз Из Релизы Цикл
		
		Если Не ПустаяСтрока(ИмяОбъекта) Тогда
			Результат.ОписаниеJSON = Расш1_КоллекцияМетаданных.ПолучитьОписаниеОбъектаМетаданных(
				ПараметрыЗапроса, АдресОбновления, Релиз);
			Если ЗначениеЗаполнено(Результат.ОписаниеJSON) Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Результат.ОписаниеJSON = Расш1_КоллекцияМетаданных.ПолучитьСписокОбъектовМетаданных(
			ИмяКоллекции, АдресОбновления, Релиз);
		Если ЗначениеЗаполнено(Результат.ОписаниеJSON) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.АдресОбновления = АдресОбновления;
	Возврат Результат;
	
КонецФункции

// Прочитать настройки редактора из хранилища общих настроек.
//
// Возвращаемое значение:
//  См. Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора
//
Функция ПрочитатьНастройкиРедактора() Экспорт
	
	Настройки = ХранилищеОбщихНастроек.Загрузить(
		Расш1_КонсольКодаКлиентСервер.КлючОбъектаНастроек(),
		Расш1_КонсольКодаКлиентСервер.КлючНастройкиРедактора());
	
	Возврат Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки);
	
КонецФункции

// Признак, что на формах правил нужно создавать HTML-хост.
//
// Возвращаемое значение:
//  Булево
//
Функция КонсольВключена() Экспорт
	
	Возврат Расш1_КонсольКодаКлиентСервер.КонсольВключена(ПрочитатьНастройкиРедактора());
	
КонецФункции

// Релиз конвертации, если в справочнике Объекты нет загруженной структуры.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  СправочникСсылка.Релизы - релиз без загруженной структуры; Неопределено, если описание есть.
//
Функция РелизКонвертацииЕслиНетОписания(Знач Конвертация) Экспорт
	
	Возврат Расш1_КоллекцияМетаданных.РелизКонвертацииЕслиНетОписания(Конвертация);
	
КонецФункции

// Сохранить настройки редактора в хранилище общих настроек.
//
// Параметры:
//  Настройки - См. Расш1_КонсольКодаКлиентСервер.НовыеНастройкиРедактора
//
Процедура СохранитьНастройкиРедактора(Знач Настройки) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить(
		Расш1_КонсольКодаКлиентСервер.КлючОбъектаНастроек(),
		Расш1_КонсольКодаКлиентСервер.КлючНастройкиРедактора(),
		Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Релизы конвертации для подсказок: сначала конфигурация, затем корреспондент.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации, СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Релизы
//
Функция РелизыКонвертацииДляМетаданных(Конвертация)
	
	Релизы = Новый Массив;
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Релизы;
	КонецЕсли;
	
	Если ТипЗнч(Конвертация) = Тип("СправочникСсылка.Релизы") Тогда
		Релизы.Добавить(Конвертация);
		Возврат Релизы;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Конвертация, "Конфигурация, КонфигурацияКорреспондент");
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.Конфигурация) Тогда
		Релизы.Добавить(ЗначенияРеквизитов.Конфигурация);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.КонфигурацияКорреспондент)
		И Релизы.Найти(ЗначенияРеквизитов.КонфигурацияКорреспондент) = Неопределено Тогда
		Релизы.Добавить(ЗначенияРеквизитов.КонфигурацияКорреспондент);
	КонецЕсли;
	
	Возврат Релизы;
	
КонецФункции

#КонецОбласти
