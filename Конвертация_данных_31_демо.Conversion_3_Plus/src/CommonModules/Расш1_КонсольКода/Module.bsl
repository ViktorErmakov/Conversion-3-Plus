#Область ПрограммныйИнтерфейс

// Записать типовое поле алгоритма в реестр хоста.
// Типовое текстовое поле скрывается один раз на сервере: его заменяет HTML-хост.
// Консоль не переключается через Видимость: до подстановки текста она в setReadOnly.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ЭлементАлгоритма - ПолеФормы
//  Опции - см. Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма
//
Процедура ЗарегистрироватьАлгоритм(Форма, ЭлементАлгоритма, Опции) Экспорт
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементАлгоритма.Видимость = Ложь;
	ОбеспечитьРеквизитыХоста(Форма);
	
	Описание = Расш1_КонсольКодаКлиентСервер.НовыйОписаниеАлгоритма();
	ЗаполнитьЗначенияСвойств(Описание, Опции);
	Описание.ПутьКДанным = ЭлементАлгоритма.ПутьКДанным;
	
	ИмяРеестра = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов();
	Форма[ИмяРеестра] = Расш1_КонсольКодаКлиентСервер.ДобавитьОписаниеВРеестр(Форма[ИмяРеестра], Описание);
	
КонецПроцедуры

// Создать одно поле HTML и панель команд на устойчивом родителе.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Родитель - ГруппаФормы, ФормаКлиентскогоПриложения - родитель поля HTML
//  ИмяГруппыСтраниц - Строка - группа страниц обработчиков; вертикальное растягивание отключается.
//  ЭлементПеред - ГруппаФормы, ПолеФормы, Неопределено - вставить хост перед этим элементом.
//  ЗакладкиСверху - Булево - горизонтальные закладки группы обработчиков, чтобы консоль заняла высоту.
//
Процедура СоздатьХостКонсоли(Форма, Родитель, ИмяГруппыСтраниц = "", ЭлементПеред = Неопределено, ЗакладкиСверху = Ложь) Экспорт
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Форма.Элементы.Найти(ИмяХоста) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбеспечитьРеквизитыХоста(Форма);
	СоздатьРеквизит(Форма, ИмяХоста, "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста), "Булево");
	
	ДобавитьИмяКонсоли(Форма, ИмяХоста);
	
	СоздатьЭлементHTML(ИмяХоста, Родитель, Форма, ЭлементПеред);
	СоздатьКоманднуюПанель(ИмяХоста, Форма, Родитель, Форма.Элементы[ИмяХоста]);
	
	Если Не Расш1_КонсольКодаКлиентСервер.ЕстьАлгоритмСНаправлением(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()]) Тогда
		Форма.Элементы[Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста()].Видимость = Ложь;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяГруппыСтраниц) Тогда
		ГруппаСтраниц = Форма.Элементы.Найти(ИмяГруппыСтраниц);
		Если ГруппаСтраниц <> Неопределено Тогда
			ГруппаСтраниц.РастягиватьПоВертикали = Ложь;
			Если ЗакладкиСверху Тогда
				ГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Создать реквизит формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяРеквизита - Строка
//  Тип - Строка - имя типа, например "Строка".
//
Процедура СоздатьРеквизит(Форма, ИмяРеквизита, Тип) Экспорт
	
	Для Каждого РеквизитФормы Из Форма.ПолучитьРеквизиты() Цикл
		Если РеквизитФормы.Имя = ИмяРеквизита Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если Тип = "Строка" Тогда
		ТипРеквизита = Новый ОписаниеТипов("Строка");
	Иначе
		ТипРеквизита = Новый ОписаниеТипов(Тип);
	КонецЕсли;
	
	Реквизит = Новый РеквизитФормы(ИмяРеквизита, ТипРеквизита);
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Реквизит);
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	
КонецПроцедуры

// Записать параметры глобального поиска в реквизиты формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ФразаПоиска - Строка
//  ИмяПоляПоиска - Строка
//  НомерСтрокиПоиска - Число
//
Процедура ЗаполнитьРеквизитыПоиска(Форма, ФразаПоиска, ИмяПоляПоиска, НомерСтрокиПоиска) Экспорт
	
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаФразыПоиска()] = ФразаПоиска;
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска()] = ИмяПоляПоиска;
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНомераСтрокиПоиска()] = НомерСтрокиПоиска;
	
КонецПроцедуры

// Конвертация элемента состава.
// Если параметр заполнен, возвращает его. Иначе первую непомеченную на удаление конвертацию состава.
// Пустой элемент возвращает пустую ссылку, без исключения.
//
// Параметры:
//  ЭлементКонвертации - ЛюбаяСсылка - элемент справочника состава или владелец правила свойства.
//  КонвертацияПараметра - СправочникСсылка.Конвертации - конвертация, переданная при открытии формы.
//
// Возвращаемое значение:
//  СправочникСсылка.Конвертации
//
Функция Расш1_КонвертацияЭлементаСостава(ЭлементКонвертации, КонвертацияПараметра) Экспорт
	
	Если ЗначениеЗаполнено(КонвертацияПараметра) Тогда
		Возврат КонвертацияПараметра;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭлементКонвертации) Тогда
		Возврат Справочники.Конвертации.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Составы.Владелец КАК Конвертация
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК Составы
	|ГДЕ
	|	Составы.ЭлементКонвертации = &ЭлементКонвертации
	|	И НЕ Составы.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЭлементКонвертации", ЭлементКонвертации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Конвертация;
	КонецЕсли;
	
	Возврат Справочники.Конвертации.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьРеквизитыХоста(Форма)
	
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИменКонсолей(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКартыКонсолей(), "Строка");
	СоздатьРеквизит(Форма, "Направление", "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаФразыПоиска(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска(), "Строка");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНомераСтрокиПоиска(), "Число");
	СоздатьРеквизит(Форма, Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаПропускаВыделенияПоиска(), "Булево");
	
КонецПроцедуры

Процедура ДобавитьИмяКонсоли(Форма, ИмяЭлементаHTML)
	
	ИмяРеквизита = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИменКонсолей();
	Форма[ИмяРеквизита] = Расш1_КонсольКодаКлиентСервер.ДобавитьИмяВСписок(Форма[ИмяРеквизита], ИмяЭлементаHTML);
	
КонецПроцедуры

Процедура СоздатьЭлементHTML(ИмяЭлемента, Родитель, Форма, ЭлементПеред)
	
	Если ЭлементПеред = Неопределено Тогда
		НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
	Иначе
		НовыйЭлемент = Форма.Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), Родитель, ЭлементПеред);
	КонецЕсли;
	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	НовыйЭлемент.ПутьКДанным = ИмяЭлемента;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.РастягиватьПоВертикали = Истина;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	НовыйЭлемент.УстановитьДействие(
		"ДокументСформирован",
		Расш1_КонсольКодаКлиентСервер.ИмяОбработчикаДокументСформирован());
	НовыйЭлемент.УстановитьДействие(
		"ПриНажатии",
		Расш1_КонсольКодаКлиентСервер.ИмяОбработчикаПриНажатии());
	НовыйЭлемент.КонтекстноеМеню.Видимость = Ложь;
	
КонецПроцедуры

Процедура СоздатьКоманднуюПанель(ЭлементАлгоритмаHTML, Форма, Родитель, ЭлементПеред)
	
	ЭлементыФормы = Форма.Элементы;
	КоманднаяПанель = ЭлементыФормы.Вставить(
		Расш1_КонсольКодаКлиентСервер.ИмяПанелиКомандХоста(),
		Тип("ГруппаФормы"),
		Родитель,
		ЭлементПеред);
	
	СоздатьГруппуНаправление(Форма, ЭлементАлгоритмаHTML, КоманднаяПанель);
	
	Имя = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыЗаменитьВхождения() + ЭлементАлгоритмаHTML;
	СоздатьКоманду(Форма, Имя, НСтр("ru = 'Заменить'"), БиблиотекаКартинок.Расш1_Заменить);
	ЭлементЗаменитьВхождения = ЭлементыФормы.Вставить(Имя, Тип("КнопкаФормы"), КоманднаяПанель);
	ЭлементЗаменитьВхождения.Заголовок = НСтр("ru = 'Заменить'");
	ЭлементЗаменитьВхождения.ИмяКоманды = Имя;
	ЭлементЗаменитьВхождения.Фигура = ФигураКнопки.Овал;
	
	Имя = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПоиска() + ЭлементАлгоритмаHTML;
	СоздатьКоманду(Форма, Имя, НСтр("ru = 'Поиск'"), БиблиотекаКартинок.Найти);
	ЭлементПоиск = ЭлементыФормы.Вставить(Имя, Тип("КнопкаФормы"), КоманднаяПанель);
	ЭлементПоиск.Заголовок = НСтр("ru = 'Поиск'");
	ЭлементПоиск.ИмяКоманды = Имя;
	ЭлементПоиск.Фигура = ФигураКнопки.Овал;
	ЭлементПоиск.Видимость = КонвертацияДляПоискаЗаполнена(Форма);
	
	Имя = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыНастроек() + ЭлементАлгоритмаHTML;
	СоздатьКоманду(Форма, Имя, НСтр("ru = 'Настройки'"));
	ЭлементНастройки = ЭлементыФормы.Вставить(Имя, Тип("КнопкаФормы"), КоманднаяПанель);
	ЭлементНастройки.Заголовок = НСтр("ru = 'Настройки консоли'");
	ЭлементНастройки.ИмяКоманды = Имя;
	ЭлементНастройки.Картинка = БиблиотекаКартинок.ПрочиеПользовательскиеНастройки;
	ЭлементНастройки.Отображение = ОтображениеКнопки.Картинка;
	ЭлементНастройки.Фигура = ФигураКнопки.Овал;
	
КонецПроцедуры

Процедура СоздатьГруппуНаправление(Форма, ЭлементАлгоритмаHTML, КоманднаяПанель)
	
	ЭлементыФормы = Форма.Элементы;
	
	Имя = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
	ЭлементГруппаКомандНаправление = ЭлементыФормы.Вставить(Имя, Тип("ГруппаФормы"), КоманднаяПанель);
	ЭлементГруппаКомандНаправление.Вид = ВидГруппыФормы.Подменю;
	ЭлементГруппаКомандНаправление.Заголовок = НСтр("ru = 'Выберите направление'");
	ЭлементГруппаКомандНаправление.Подсказка = НСтр("ru = 'Направление обмена'");
	ЭлементГруппаКомандНаправление.Фигура = ФигураКнопки.Овал;
	
	Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка();
	Имя = Направление + ЭлементАлгоритмаHTML;
	СоздатьКоманду(Форма, Имя, Направление);
	
	ЭлементНаправлениеОтправка = ЭлементыФормы.Вставить(Имя, Тип("КнопкаФормы"), ЭлементГруппаКомандНаправление);
	ЭлементНаправлениеОтправка.Заголовок = Направление;
	ЭлементНаправлениеОтправка.ИмяКоманды = Имя;
	ЭлементНаправлениеОтправка.Картинка = БиблиотекаКартинок.Расш1_Отправка;
	
	Направление = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение();
	Имя = Направление + ЭлементАлгоритмаHTML;
	СоздатьКоманду(Форма, Имя, Направление);
	
	ЭлементНаправлениеПолучение = ЭлементыФормы.Вставить(Имя, Тип("КнопкаФормы"), ЭлементГруппаКомандНаправление);
	ЭлементНаправлениеПолучение.Заголовок = Направление;
	ЭлементНаправлениеПолучение.ИмяКоманды = Имя;
	ЭлементНаправлениеПолучение.Картинка = БиблиотекаКартинок.Расш1_Получение;
	
КонецПроцедуры

Процедура СоздатьКоманду(Форма, Имя, Направление = "", Картинка = Неопределено)
	
	Если Форма.Команды.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяКоманда = Форма.Команды.Добавить(Имя);
	НоваяКоманда.Действие = Расш1_КонсольКодаКлиентСервер.ИмяОбработчикаКомандыКонсоли();
	
	Если Не ПустаяСтрока(Направление) Тогда
		НоваяКоманда.Заголовок = Направление;
	КонецЕсли;
	
	Если Картинка <> Неопределено Тогда
		НоваяКоманда.Картинка = Картинка;
	КонецЕсли;
	НоваяКоманда.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

Функция КонвертацияДляПоискаЗаполнена(Форма)
	
	Если РеквизитФормыСуществует(Форма, "Конвертация") Тогда
		Возврат ЗначениеЗаполнено(Форма.Конвертация);
	КонецЕсли;
	
	Конвертация = Неопределено;
	Если Форма.Параметры.Свойство("Конвертация", Конвертация) И ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Форма.ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаКонвертации() Тогда
		Возврат ЗначениеЗаполнено(Форма.Объект.Ссылка);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РеквизитФормыСуществует(Форма, ИмяРеквизита)
	
	Для Каждого Реквизит Из Форма.ПолучитьРеквизиты() Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
