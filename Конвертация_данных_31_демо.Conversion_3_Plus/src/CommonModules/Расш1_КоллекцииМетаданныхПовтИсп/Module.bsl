// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

// Имена коллекций метаданных в JSON описания для консоли кода.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - русское или английское имя коллекции в нижнем регистре.
//   * Значение - Строка - имя коллекции в JSON описания метаданных.
//
Функция НовыеИменаКоллекцииМетаданныхJSON() Экспорт
	
	Возврат ИменаКоллекцийПоПолю("ИмяJSON");
	
КонецФункции

// Русские имена коллекций метаданных в нижнем регистре.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - русское или английское имя коллекции в нижнем регистре.
//   * Значение - Строка - русское имя коллекции в нижнем регистре.
//
Функция НовыеИменаКоллекцииМетаданных() Экспорт
	
	Возврат ИменаКоллекцийПоПолю("ИмяКоллекции");
	
КонецФункции

// Имя группы в справочнике Объекты для запроса коллекции.
//
// Параметры:
//  ИмяКоллекции - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяГруппыОбъектовДляЗапроса(ИмяКоллекции) Экспорт
	
	ИменаГрупп = ИменаКоллекцийПоПолю("ИмяГруппы");
	ИмяБезПробелов = СокрЛП(ИмяКоллекции);
	Ключ = НРег(ИмяБезПробелов);
	ИмяГруппы = ИменаГрупп[Ключ];
	Если ИмяГруппы = Неопределено Тогда
		Возврат ИмяБезПробелов;
	КонецЕсли;
	
	Возврат ИмяГруппы;
	
КонецФункции

// Возвращает признак что объект метаданных имеет табличную часть.
//
// Параметры:
//  ИмяКоллекции - Строка - имя коллекции.
//
// Возвращаемое значение:
//  Булево
//
Функция ОбъектМетаданныхИмеетТЧ(ИмяКоллекции) Экспорт
	
	ТипыСсылок = ТипыСсылокКоллекций();
	ТипСсылки = ТипыСсылок[ИмяКоллекции];
	
	Возврат ЗначениеЗаполнено(ТипСсылки);
	
КонецФункции

// Типы ссылок объектов по имени коллекции метаданных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - русское или английское имя коллекции в нижнем регистре.
//   * Значение - Строка - имя типа ссылки (СправочникСсылка и т.п.), для нессылочных - пустая строка.
//
Функция ТипыСсылокКоллекций() Экспорт
	
	Возврат ИменаКоллекцийПоПолю("ТипСсылки");
	
КонецФункции

// Имена коллекций в JSON описания по имени типа ссылки.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя типа ссылки, например СправочникСсылка.
//   * Значение - Строка - имя коллекции в JSON описания, например catalogs.
//
Функция ИменаКоллекцийJSONПоТипуСсылки() Экспорт
	
	Имена = Новый Соответствие; // Соответствие из КлючИЗначение: Строка, Строка
	Коллекции = ОписаниеКоллекций();
	Для Каждого Коллекция Из Коллекции Цикл
		Если ПустаяСтрока(Коллекция.ТипСсылки) Тогда
			Продолжить;
		КонецЕсли;
		Имена.Вставить(Коллекция.ТипСсылки, Коллекция.ИмяJSON);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Дерево метаданных релиза из справочника Объекты (кэш сеанса).
// Ключ - имя группы-менеджера (справочники, документы), значение - структура объектов группы.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя группы в нижнем регистре без пробелов.
//   * Значение - Структура - имя объекта и структура с ключом name.
//
Функция ОписаниеОбъектовРелизаПоГруппам(Релиз) Экспорт
	
	Возврат Справочники.Объекты.Расш1_ОписаниеОбъектовРелизаПоГруппам(Релиз);
	
КонецФункции

// Список имен объектов коллекции метаданных релиза (кэш сеанса).
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//  ИмяКоллекции - Строка
//
// Возвращаемое значение:
//  Структура - имя объекта и структура с ключом name; пустая, если коллекции нет.
//
Функция ОписаниеКоллекцииМетаданных(Релиз, ИмяКоллекции) Экспорт
	
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат ПустоеОписаниеКоллекции();
	КонецЕсли;
	
	ОписаниеПоГруппам = ОписаниеОбъектовРелизаПоГруппам(Релиз);
	ИмяБезПробелов = СокрЛП(ИмяКоллекции);
	Ключ = НРег(ИмяБезПробелов);
	ОписаниеКоллекции = ОписаниеГруппы(ОписаниеПоГруппам, Ключ);
	Если ОписаниеКоллекции.Количество() = 0 Тогда
		ИмяГруппы = ИмяГруппыОбъектовДляЗапроса(ИмяКоллекции);
		КлючГруппы = НРег(ИмяГруппы);
		ОписаниеКоллекции = ОписаниеГруппы(ОписаниеПоГруппам, КлючГруппы);
	КонецЕсли;
	
	Возврат ОписаниеКоллекции;
	
КонецФункции

// Возвращает признак что объект метаданных имеет измерения.
//
// Параметры:
//  ИмяКоллекции - Строка - имя коллекции.
//
// Возвращаемое значение:
//  Булево
//
Функция ОбъектМетаданныхИмеетИзмерения(ИмяКоллекции) Экспорт
	
	Объекты = Новый Массив; // Массив из Строка
	Объекты.Добавить("регистрысведений");
	Объекты.Добавить("регистрынакопления");
	Объекты.Добавить("регистрыбухгалтерии");
	Объекты.Добавить("регистрырасчета");
	
	Возврат Объекты.Найти(ИмяКоллекции) <> Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустое описание коллекции метаданных.
//
// Возвращаемое значение:
//  Структура
//
Функция ПустоеОписаниеКоллекции()
	
	Возврат Новый Структура;
	
КонецФункции

// Объекты одной группы из дерева метаданных релиза.
//
// Параметры:
//  ОписаниеПоГруппам - Соответствие из КлючИЗначение - дерево метаданных релиза:
//   * Ключ - Строка - имя группы в нижнем регистре.
//   * Значение - Структура - объекты группы.
//  Ключ - Строка - имя группы в нижнем регистре.
//
// Возвращаемое значение:
//  Структура - объекты группы; пустая, если группы нет.
//
Функция ОписаниеГруппы(ОписаниеПоГруппам, Ключ)
	
	Описание = ОписаниеПоГруппам.Получить(Ключ);
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		ОписаниеСтруктура = Описание; // Структура
		Возврат ОписаниеСтруктура;
	КонецЕсли;
	
	Возврат ПустоеОписаниеКоллекции();
	
КонецФункции

// Имена коллекций по выбранному полю описания.
//
// Параметры:
//  ИмяПоля - Строка - ИмяКоллекции, ИмяГруппы или ИмяJSON.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - русское или английское имя коллекции в нижнем регистре.
//   * Значение - Строка - значение поля.
//
Функция ИменаКоллекцийПоПолю(ИмяПоля)
	
	Имена = Новый Соответствие; // Соответствие из КлючИЗначение: Строка, Строка
	Коллекции = ОписаниеКоллекций();
	Для Каждого Коллекция Из Коллекции Цикл
		Значение = Коллекция[ИмяПоля]; // Строка
		Имена.Вставить(Коллекция.ИмяКоллекции, Значение);
		Имена.Вставить(Коллекция.ИмяАнглийское, Значение);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Описание коллекций метаданных, которые понимает консоль кода.
//
// Возвращаемое значение:
//  Массив из см. НовоеОписаниеКоллекции
//
Функция ОписаниеКоллекций()
	
	Коллекции = Новый Массив; // Массив из см. НовоеОписаниеКоллекции
	ДобавитьКоллекцию(Коллекции, "Справочники", "Catalogs", "catalogs", "СправочникСсылка");
	ДобавитьКоллекцию(Коллекции, "Документы", "Documents", "documents", "ДокументСсылка");
	ДобавитьКоллекцию(Коллекции, "РегистрыСведений", "InformationRegisters", "infoRegs");
	ДобавитьКоллекцию(Коллекции, "РегистрыНакопления", "AccumulationRegisters", "accumRegs");
	ДобавитьКоллекцию(Коллекции, "РегистрыБухгалтерии", "AccountingRegisters", "accountRegs");
	ДобавитьКоллекцию(Коллекции, "РегистрыРасчета", "CalculationRegisters", "calcRegs");
	ДобавитьКоллекцию(Коллекции, "Обработки", "DataProcessors", "dataProc");
	ДобавитьКоллекцию(Коллекции, "Отчеты", "Reports", "reports");
	ДобавитьКоллекцию(Коллекции, "Перечисления", "Enums", "enums");
	// Первая буква ключа - кириллическая "с": так ключ записан в bsl_console (bslMetadata.js).
	ДобавитьКоллекцию(Коллекции, "ПланыСчетов", "ChartsOfAccounts", "сhartsOfAccounts", "ПланСчетовСсылка");
	ДобавитьКоллекцию(Коллекции, "БизнесПроцессы", "BusinessProcesses", "businessProcesses", "БизнесПроцессСсылка");
	ДобавитьКоллекцию(Коллекции, "Задачи", "Tasks", "tasks", "ЗадачаСсылка");
	ДобавитьКоллекцию(Коллекции, "ПланыОбмена", "ExchangePlans", "exchangePlans", "ПланОбменаСсылка");
	ДобавитьКоллекцию(Коллекции, "ПланыВидовХарактеристик",
		"ChartsOfCharacteristicTypes", "chartsOfCharacteristicTypes", "ПланВидовХарактеристикСсылка");
	ДобавитьКоллекцию(Коллекции, "ПланыВидовРасчета",
		"ChartsOfCalculationTypes", "chartsOfCalculationTypes", "ПланВидовРасчетаСсылка");
	ДобавитьКоллекцию(Коллекции, "Константы", "Constants", "constants");
	
	Возврат Коллекции;
	
КонецФункции

// Описание одной коллекции метаданных.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы в справочнике Объекты.
//  ИмяМенеджера - Строка - английское имя коллекции.
//  ИмяJSON - Строка - имя коллекции в JSON описания.
//  ТипСсылки - Строка - имя типа ссылки объекта коллекции, для нессылочных - пустая строка.
//
// Возвращаемое значение:
//  Структура:
//   * ИмяКоллекции - Строка - русское имя в нижнем регистре.
//   * ИмяАнглийское - Строка - английское имя в нижнем регистре.
//   * ИмяГруппы - Строка - имя группы в справочнике Объекты.
//   * ИмяJSON - Строка - имя коллекции в JSON описания.
//   * ТипСсылки - Строка - имя типа ссылки или пустая строка.
//
Функция НовоеОписаниеКоллекции(ИмяГруппы, ИмяМенеджера, ИмяJSON, ТипСсылки)
	
	ИмяКоллекции = НРег(ИмяГруппы);
	ИмяАнглийское = НРег(ИмяМенеджера);
	
	Описание = Новый Структура;
	Описание.Вставить("ИмяКоллекции", ИмяКоллекции);
	Описание.Вставить("ИмяАнглийское", ИмяАнглийское);
	Описание.Вставить("ИмяГруппы", ИмяГруппы);
	Описание.Вставить("ИмяJSON", ИмяJSON);
	Описание.Вставить("ТипСсылки", ТипСсылки);
	
	Возврат Описание;
	
КонецФункции

// Добавляет описание коллекции в список.
//
// Параметры:
//  Коллекции - Массив из см. НовоеОписаниеКоллекции
//  ИмяГруппы - Строка - имя группы в справочнике Объекты.
//  ИмяМенеджера - Строка - английское имя коллекции.
//  ИмяJSON - Строка - имя коллекции в JSON описания.
//  ТипСсылки - Строка - имя типа ссылки объекта коллекции, для нессылочных - пустая строка.
//
Процедура ДобавитьКоллекцию(Коллекции, ИмяГруппы, ИмяМенеджера, ИмяJSON, ТипСсылки = "")
	
	Описание = НовоеОписаниеКоллекции(ИмяГруппы, ИмяМенеджера, ИмяJSON, ТипСсылки);
	Коллекции.Добавить(Описание);
	
КонецПроцедуры

#КонецОбласти
