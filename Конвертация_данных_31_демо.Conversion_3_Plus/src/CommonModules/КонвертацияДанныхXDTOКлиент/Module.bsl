// @strict-types

#Область СлужебныеПроцедурыИФункции

&ИзменениеИКонтроль("ОбновитьИндикациюСтраницОбработчиков")
Процедура Расш1_ОбновитьИндикациюСтраницОбработчиков(КоллекцияСтраниц, ОбъектФормы, ПоляИсключения = "")
	Для Каждого СтраницаОбработчика Из КоллекцияСтраниц.ПодчиненныеЭлементы Цикл
		Если НЕ СтраницаОбработчика.Видимость Тогда
			Продолжить;
		КонецЕсли;
		ОтображатьФлажок = Ложь; 
		ГруппыФормы = Новый Массив;
		Для Каждого ПолеОбработчика Из СтраницаОбработчика.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ПолеОбработчика) = Тип("ГруппаФормы") Тогда
				ГруппыФормы.Добавить(ПолеОбработчика);
				Продолжить;
			ИначеЕсли НРег(Лев(ПолеОбработчика.Имя, 8)) <> "алгоритм" Тогда
				Продолжить;
			ИначеЕсли НЕ ПустаяСтрока(ПоляИсключения) И СтрНайти(ПолеОбработчика.Имя, ПоляИсключения) > 0 Тогда
				Продолжить;
			КонецЕсли;
			#Удаление
			ОтображатьФлажок = ЗначениеЗаполнено(ОбъектФормы[ПолеОбработчика.Имя]);
			#КонецУдаления
			#Вставка
			ОтображатьФлажок = Расш1_ЗначениеПоляЗаполнено(ОбъектФормы, ПолеОбработчика);
			#КонецВставки
			Если ОтображатьФлажок Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла; 
		Если ГруппыФормы.Количество() > 0 И НЕ ОтображатьФлажок Тогда
			Для Каждого ГруппаФормы Из ГруппыФормы Цикл
				Для Каждого ПолеОбработчика Из ГруппаФормы.ПодчиненныеЭлементы Цикл
					Если НРег(Лев(ПолеОбработчика.Имя, 8)) <> "алгоритм" Тогда
						Продолжить;
					ИначеЕсли НЕ ПустаяСтрока(ПоляИсключения) И СтрНайти(ПолеОбработчика.Имя, ПоляИсключения) > 0 Тогда
						Продолжить; 
					КонецЕсли;
					#Удаление
					ОтображатьФлажок = ЗначениеЗаполнено(ОбъектФормы[ПолеОбработчика.Имя]);
					#КонецУдаления
					#Вставка
					// Элементы группы из нетипизированного массива типового кода.
					// @skip-check invocation-parameter-type-intersect
					ОтображатьФлажок = Расш1_ЗначениеПоляЗаполнено(ОбъектФормы, ПолеОбработчика);
					#КонецВставки
					Если ОтображатьФлажок Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ОтображатьФлажок Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ОтображатьФлажок Тогда 
			СтраницаОбработчика.Картинка = БиблиотекаКартинок.Успешно;
		Иначе
			СтраницаОбработчика.Картинка = Новый Картинка();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Реквизита с именем поля может не быть у объекта: поля консоли кода связаны с реквизитами формы.
//
// Параметры:
//  ОбъектФормы - Произвольный - объект формы.
//  ЭлементФормы - ПолеФормы, ГруппаФормы, ДекорацияФормы, КнопкаФормы, ТаблицаФормы - поле обработчика.
//
// Возвращаемое значение:
//  Булево
//
Функция Расш1_ЗначениеПоляЗаполнено(ОбъектФормы, ЭлементФормы)
	
	ИмяПоля = ЭлементФормы.Имя;
	ЗначенияПолей = Новый Структура(ИмяПоля);
	ЗаполнитьЗначенияСвойств(ЗначенияПолей, ОбъектФормы);
	ЗначениеПоля = ЗначенияПолей[ИмяПоля]; // Произвольный
	
	Возврат ЗначениеЗаполнено(ЗначениеПоля);
	
КонецФункции

#КонецОбласти
