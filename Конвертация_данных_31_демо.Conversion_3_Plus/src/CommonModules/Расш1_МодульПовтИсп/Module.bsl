// Возвращает признак что объект метаданных имеет табличную часть.
//
// Параметры:
//  ИмяКоллекции - Стока - имя коллекции.
// 
// Возвращаемое значение:
//   - Булево
//
Функция ОбъектМетаданныхИмеетТЧ(ИмяКоллекции) Экспорт
	
	Объекты = Новый Массив();
	Объекты.Добавить("справочники");
	Объекты.Добавить("catalogs");
	Объекты.Добавить("документы");
	Объекты.Добавить("documents");
	Объекты.Добавить("бизнеспроцессы");
	Объекты.Добавить("планывидоврасчета");
	Объекты.Добавить("задачи");
	Объекты.Добавить("планывидовхарактеристик");
	
	Возврат Объекты.Найти(ИмяКоллекции) <> Неопределено;
	
КонецФункции

// Дерево метаданных релиза из справочника Объекты (кэш сеанса).
// Ключ — имя группы-менеджера (справочники, документы), значение — структура объектов группы.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Соответствие
//
Функция ОписаниеОбъектовРелизаПоГруппам(Релиз) Экспорт
	
	Возврат Справочники.Объекты.Расш1_ОписаниеОбъектовРелизаПоГруппам(Релиз);
	
КонецФункции

// Список имен объектов коллекции метаданных релиза (кэш сеанса).
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//  ИмяКоллекции - Строка
//
// Возвращаемое значение:
//  Структура
//
Функция ОписаниеКоллекцииМетаданных(Релиз, ИмяКоллекции) Экспорт
	
	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеПоГруппам = ОписаниеОбъектовРелизаПоГруппам(Релиз);
	Ключ = НРег(СокрЛП(ИмяКоллекции));
	ОписаниеКоллекции = ОписаниеПоГруппам.Получить(Ключ);
	Если ОписаниеКоллекции = Неопределено Тогда
		ОписаниеКоллекции = ОписаниеПоГруппам.Получить(НРег(ИмяГруппыОбъектовДляЗапроса(ИмяКоллекции)));
	КонецЕсли;
	Если ОписаниеКоллекции = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Возврат ОписаниеКоллекции;
	
КонецФункции

// Возвращает признак что объект метаданных имеет измерения.
//
// Параметры:
//  ИмяКоллекции - Строка - имя коллекции.
//
// Возвращаемое значение:
//  Булево
//
Функция ОбъектМетаданныхИмеетИзмерения(ИмяКоллекции) Экспорт
	
	Объекты = Новый Массив();
	Объекты.Добавить("регистрысведений");
	Объекты.Добавить("регистрынакопления");
	Объекты.Добавить("регистрыбухгалтерии");
	Объекты.Добавить("регистрырасчета");
	
	Возврат Объекты.Найти(ИмяКоллекции) <> Неопределено;
	
КонецФункции

#КонецОбласти
