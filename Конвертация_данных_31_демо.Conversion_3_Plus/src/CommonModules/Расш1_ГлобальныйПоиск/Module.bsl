// @strict-types

#Область ПрограммныйИнтерфейс

// Найти вхождения строки в текстах правил, алгоритмов, запросов и модулей конфигурации.
// Места поиска зависят от типа конвертации. Поиск без учета регистра.
// Пустая конвертация и строка короче двух символов дают пустой результат.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  СтрокаПоиска - Строка
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат
//  ИскатьВМодулях - Булево - искать в текстах модулей релизов конвертации
//  ИскатьВПравилах - Булево - искать в коде правил, алгоритмов и запросов конвертации
//
// Возвращаемое значение:
//  Структура:
//   * Строки - ТаблицаЗначений - колонки Ссылка, Вид, Представление, ИмяПоля, СинонимПоля,
//       НомерСтроки, Фрагмент, ИмяФормы, Источник, ЭтоМодуль, Релиз, ВидМодуля, Ключ
//   * Обрезано - Булево - Истина, если строк больше предела
//
Функция НайтиВхождения(Конвертация, СтрокаПоиска, ИсключитьСсылку = Неопределено,
		ИскатьВМодулях = Истина, ИскатьВПравилах = Истина) Экспорт
	
	Результат = НовыйРезультатПоиска();
	СтрокаДляПоиска = СокрЛП(СтрокаПоиска);
	МинимальнаяДлинаСтроки = 2;
	Если Не ЗначениеЗаполнено(Конвертация) Или СтрДлина(СтрокаДляПоиска) < МинимальнаяДлинаСтроки Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ИскатьВПравилах И Не ИскатьВМодулях Тогда
		Возврат Результат;
	КонецЕсли;
	
	Шаблон = ШаблонПодобия(СтрокаДляПоиска);
	Если ИскатьВПравилах Тогда
		ТипКонвертации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Конвертация, "ТипКонвертации");
		КонвертацияXDTO = (ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO);
		Источники = ИсточникиПоиска(КонвертацияXDTO);
		Для Каждого Источник Из Источники Цикл
			// @skip-check query-in-loop
			ДополнитьИсточник(Результат, Источник, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
		КонецЦикла;
	КонецЕсли;
	Если ИскатьВМодулях Тогда
		ДополнитьМодулиКонфигурации(Результат, Конвертация, СтрокаДляПоиска, Шаблон);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПределСтрокРезультата()
	
	Возврат 500;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
//   * Строки - ТаблицаЗначений - найденные вхождения:
//     ** Ссылка - ЛюбаяСсылка, Неопределено - элемент с вхождением.
//     ** Вид - Строка
//     ** Представление - Строка
//     ** ИмяПоля - Строка
//     ** СинонимПоля - Строка
//     ** НомерСтроки - Число
//     ** Фрагмент - Строка
//     ** ИмяФормы - Строка
//     ** Источник - Строка
//     ** ЭтоМодуль - Булево
//     ** Релиз - СправочникСсылка.Релизы
//     ** ВидМодуля - ПеречислениеСсылка.Расш1_ВидыМодулей
//     ** Ключ - Строка
//   * Обрезано - Булево - Истина, если строк больше предела.
//
Функция НовыйРезультатПоиска()
	
	ДлинаВида = 100;
	ДлинаИмени = 150;
	ДлинаФрагмента = 300;
	ДлинаИмениФормы = 200;
	ДлинаИсточника = 30;
	РазрядностьНомераСтроки = 6;
	
	ТипВида = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаВида);
	ТипИмени = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаИмени);
	ТипФрагмента = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаФрагмента);
	ТипИмениФормы = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаИмениФормы);
	ТипИсточника = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаИсточника);
	ТипНомераСтроки = ОбщегоНазначения.ОписаниеТипаЧисло(РазрядностьНомераСтроки, 0, ДопустимыйЗнак.Неотрицательный);
	
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Ссылка");
	Строки.Колонки.Добавить("Вид", ТипВида);
	Строки.Колонки.Добавить("Представление", ТипИмени);
	Строки.Колонки.Добавить("ИмяПоля", ТипИмени);
	Строки.Колонки.Добавить("СинонимПоля", ТипИмени);
	Строки.Колонки.Добавить("НомерСтроки", ТипНомераСтроки);
	Строки.Колонки.Добавить("Фрагмент", ТипФрагмента);
	Строки.Колонки.Добавить("ИмяФормы", ТипИмениФормы);
	Строки.Колонки.Добавить("Источник", ТипИсточника);
	Строки.Колонки.Добавить("ЭтоМодуль", Новый ОписаниеТипов("Булево"));
	Строки.Колонки.Добавить("Релиз", Новый ОписаниеТипов("СправочникСсылка.Релизы"));
	Строки.Колонки.Добавить("ВидМодуля", Новый ОписаниеТипов("ПеречислениеСсылка.Расш1_ВидыМодулей"));
	Строки.Колонки.Добавить("Ключ", ТипИмени);
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Обрезано", Ложь);
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Результат - см. НовыйРезультатПоиска
//  Источник - см. ИсточникСостава
//  Конвертация - СправочникСсылка.Конвертации
//  СтрокаПоиска - Строка
//  Шаблон - Строка - шаблон ПОДОБНО.
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//
Процедура ДополнитьИсточник(Результат, Источник, Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку)
	
	Если Результат.Строки.Количество() >= ПределСтрокРезультата() Тогда
		Результат.Обрезано = Истина;
		Возврат;
	КонецЕсли;
	ДополнитьРезультатИсточника(Результат, Источник, Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку);
	
КонецПроцедуры

// Параметры:
//  Результат - см. НовыйРезультатПоиска
//  Источник - см. ИсточникСостава
//  Конвертация - СправочникСсылка.Конвертации
//  СтрокаПоиска - Строка
//  Шаблон - Строка - шаблон ПОДОБНО.
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//
Процедура ДополнитьРезультатИсточника(Результат, Источник, Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку)
	
	СсылкаИсключения = Неопределено;
	Если ЗначениеЗаполнено(ИсключитьСсылку)
		И ТипЗнч(ИсключитьСсылку) = ТипСсылкиСправочника(Источник.ИмяСправочника) Тогда
		СсылкаИсключения = ИсключитьСсылку;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаИсточника(
		Источник,
		СсылкаИсключения,
		ПределСтрокРезультата() - Результат.Строки.Количество() + 1);
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Если ЗначениеЗаполнено(СсылкаИсключения) Тогда
		Запрос.УстановитьПараметр("ИсключитьСсылку", СсылкаИсключения);
	КонецЕсли;
	
	ПоляВыборки = Новый Структура;
	ПоляВыборки.Вставить("Текст", "");
	ПоляВыборки.Вставить("ТипКонвертации", Перечисления.ТипыКонвертаций.ПустаяСсылка());
	ПоляВыборки.Вставить("ЭтоГруппа", Ложь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Строки.Количество() >= ПределСтрокРезультата() Тогда
			Результат.Обрезано = Истина;
			Прервать;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ПоляВыборки, Выборка);
		ФрагментСтроки = ФрагментВхождения(ПоляВыборки.Текст, СтрокаПоиска);
		СтрокаРезультата = Результат.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, Выборка, "Ссылка, Представление, ИмяПоля, СинонимПоля");
		СтрокаРезультата.Вид = Источник.Вид;
		СтрокаРезультата.НомерСтроки = ФрагментСтроки.НомерСтроки;
		СтрокаРезультата.Фрагмент = ФрагментСтроки.Фрагмент;
		СтрокаРезультата.Источник = ПредставлениеИсточникаПравил();
		СтрокаРезультата.ЭтоМодуль = Ложь;
		Если Источник.ЧитатьТипКонвертации Тогда
			СтрокаРезультата.ИмяФормы = ИмяФормыПредопределенных(ПоляВыборки.ТипКонвертации);
		ИначеЕсли Источник.ЧитатьЭтоГруппа И ПоляВыборки.ЭтоГруппа Тогда
			СтрокаРезультата.ИмяФормы = Источник.ИмяФормыГруппы;
		Иначе
			СтрокаРезультата.ИмяФормы = Источник.ИмяФормы;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  Источник - см. ИсточникСостава
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//  ЛимитСтрок - Число
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстЗапросаИсточника(Источник, ИсключитьСсылку, ЛимитСтрок)
	
	СхемаЗапроса = Новый СхемаЗапроса;
	ЗапросВыбора = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	ПервыйОператор = Истина;
	
	Для Каждого Поле Из Источник.Поля Цикл
		Если ПервыйОператор Тогда
			Оператор = ЗапросВыбора.Операторы[0];
			Оператор.КоличествоПолучаемыхЗаписей = ЛимитСтрок;
		Иначе
			Оператор = ЗапросВыбора.Операторы.Добавить();
			Оператор.ТипОбъединения = ТипОбъединенияСхемыЗапроса.ОбъединитьВсе;
		КонецЕсли;
		Расш1_ЗаполнитьОператорПоиска(Оператор, ЗапросВыбора, Источник, Поле, ИсключитьСсылку, ПервыйОператор);
		ПервыйОператор = Ложь;
	КонецЦикла;
	
	Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции

// Параметры:
//  Оператор - ОператорВыбратьСхемыЗапроса
//  ЗапросВыбора - ЗапросВыбораСхемыЗапроса
//  Источник - см. ИсточникСостава
//  Поле - Структура:
//   * Имя - Строка
//   * Синоним - Строка
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//  ПервыйОператор - Булево
//
Процедура Расш1_ЗаполнитьОператорПоиска(Оператор, ЗапросВыбора, Источник, Поле, ИсключитьСсылку, ПервыйОператор)
	
	Расш1_ДобавитьИсточникиПоиска(Оператор, Источник);
	
	ИндексКолонки = 0;
	Расш1_ДобавитьКолонкуПоиска(
		Оператор, ЗапросВыбора, "Элемент.Ссылка", "Ссылка", ПервыйОператор, ИндексКолонки);
	ИндексКолонки = ИндексКолонки + 1;
	Расш1_ДобавитьКолонкуПоиска(
		Оператор, ЗапросВыбора, "ПРЕДСТАВЛЕНИЕ(Элемент.Ссылка)", "Представление", ПервыйОператор, ИндексКолонки);
	ИндексКолонки = ИндексКолонки + 1;
	Расш1_ДобавитьКолонкуПоиска(
		Оператор,
		ЗапросВыбора,
		Расш1_ЛитералСтрокиЗапроса(Поле.Имя),
		"ИмяПоля",
		ПервыйОператор,
		ИндексКолонки);
	ИндексКолонки = ИндексКолонки + 1;
	Расш1_ДобавитьКолонкуПоиска(
		Оператор,
		ЗапросВыбора,
		Расш1_ЛитералСтрокиЗапроса(Поле.Синоним),
		"СинонимПоля",
		ПервыйОператор,
		ИндексКолонки);
	ИндексКолонки = ИндексКолонки + 1;
	Расш1_ДобавитьКолонкуПоиска(
		Оператор,
		ЗапросВыбора,
		СтрШаблон("Элемент.%1", Поле.Имя),
		"Текст",
		ПервыйОператор,
		ИндексКолонки);
	
	Если Источник.ЧитатьТипКонвертации Тогда
		ИндексКолонки = ИндексКолонки + 1;
		Расш1_ДобавитьКолонкуПоиска(
			Оператор, ЗапросВыбора, "Элемент.ТипКонвертации", "ТипКонвертации", ПервыйОператор, ИндексКолонки);
	КонецЕсли;
	Если Источник.ЧитатьЭтоГруппа Тогда
		ИндексКолонки = ИндексКолонки + 1;
		Расш1_ДобавитьКолонкуПоиска(
			Оператор, ЗапросВыбора, "Элемент.ЭтоГруппа", "ЭтоГруппа", ПервыйОператор, ИндексКолонки);
	КонецЕсли;
	
	Расш1_ДобавитьОтборПоиска(Оператор, Источник, Поле.Имя, ИсключитьСсылку);
	
КонецПроцедуры

// Параметры:
//  Оператор - ОператорВыбратьСхемыЗапроса
//  Источник - см. ИсточникСостава
//
Процедура Расш1_ДобавитьИсточникиПоиска(Оператор, Источник)
	
	Если Источник.ЭтоКонвертация Тогда
		Оператор.Источники.Добавить("Справочник.Конвертации", "Элемент");
		Возврат;
	КонецЕсли;
	
	ИсточникСостава = Оператор.Источники.Добавить("Справочник.СоставыКонвертаций", "Состав");
	ИсточникЭлемента = Оператор.Источники.Добавить(
		СтрШаблон("Справочник.%1", Источник.ИмяСправочника), "Элемент");
	Если Источник.ЧерезВладельцаПравила Тогда
		УсловиеСоединения = "Элемент.Владелец = Состав.ЭлементКонвертации";
	Иначе
		УсловиеСоединения = "Состав.ЭлементКонвертации = Элемент.Ссылка";
	КонецЕсли;
	ИсточникСостава.Соединения.Добавить(ИсточникЭлемента, УсловиеСоединения);
	Соединение = ИсточникСостава.Соединения[ИсточникСостава.Соединения.Количество() - 1];
	Соединение.ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;
	
КонецПроцедуры

// Параметры:
//  Оператор - ОператорВыбратьСхемыЗапроса
//  Источник - см. ИсточникСостава
//  ИмяПоля - Строка
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат.
//
Процедура Расш1_ДобавитьОтборПоиска(Оператор, Источник, ИмяПоля, ИсключитьСсылку)
	
	Если Источник.ЭтоКонвертация Тогда
		Оператор.Отбор.Добавить("Элемент.Ссылка = &Конвертация");
	Иначе
		Оператор.Отбор.Добавить("Состав.Владелец = &Конвертация");
		Если Источник.ЧерезВладельцаПравила Тогда
			Оператор.Отбор.Добавить(
				"ТИПЗНАЧЕНИЯ(Состав.ЭлементКонвертации) = ТИП(Справочник.ПравилаКонвертацииОбъектов)");
		КонецЕсли;
		Оператор.Отбор.Добавить("НЕ Состав.ПометкаУдаления");
		Оператор.Отбор.Добавить("НЕ Элемент.ПометкаУдаления");
		Если Источник.ПропускатьГруппы Тогда
			Оператор.Отбор.Добавить("НЕ Элемент.ЭтоГруппа");
		КонецЕсли;
	КонецЕсли;
	
	Оператор.Отбор.Добавить(СтрШаблон("Элемент.%1 ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""", ИмяПоля));
	Если ЗначениеЗаполнено(ИсключитьСсылку) Тогда
		Оператор.Отбор.Добавить("Элемент.Ссылка <> &ИсключитьСсылку");
	КонецЕсли;
	
КонецПроцедуры

Процедура Расш1_ДобавитьКолонкуПоиска(Оператор, ЗапросВыбора, Выражение, Псевдоним, ПервыйОператор, ИндексКолонки)
	
	Если ПервыйОператор Тогда
		Оператор.ВыбираемыеПоля.Добавить(Выражение);
		ЗапросВыбора.Колонки[ИндексКолонки].Псевдоним = Псевдоним;
	Иначе
		Оператор.ВыбираемыеПоля.Добавить(Выражение, ИндексКолонки);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка - строковый литерал языка запросов с удвоенными кавычками.
//
Функция Расш1_ЛитералСтрокиЗапроса(Значение)
	
	ЭкранированноеЗначение = СтрЗаменить(Значение, """", """""");
	Возврат СтрШаблон("""%1""", ЭкранированноеЗначение);
	
КонецФункции

// Параметры:
//  ИмяСправочника - Строка
//
// Возвращаемое значение:
//  Тип
//
Функция ТипСсылкиСправочника(ИмяСправочника)
	
	ПустаяСсылка = Справочники[ИмяСправочника].ПустаяСсылка();
	Возврат ТипЗнч(ПустаяСсылка);
	
КонецФункции

Функция ШаблонПодобия(СтрокаПоиска)
	
	Экранированная = СтрЗаменить(СтрокаПоиска, "\", "\\");
	Экранированная = СтрЗаменить(Экранированная, "%", "\%");
	Экранированная = СтрЗаменить(Экранированная, "_", "\_");
	Возврат СтрШаблон("%%%1%%", Экранированная);
	
КонецФункции

// Параметры:
//  Текст - Строка
//  СтрокаПоиска - Строка
//
// Возвращаемое значение:
//  Структура:
//   * НомерСтроки - Число
//   * Фрагмент - Строка
//
Функция ФрагментВхождения(Текст, СтрокаПоиска)
	
	ТекстВхождения = СтрЗаменить(Текст, Символы.ВК, "");
	Позиция = СтрНайти(НРег(ТекстВхождения), НРег(СтрокаПоиска));
	Если Позиция = 0 Тогда
		Возврат Новый Структура("НомерСтроки, Фрагмент", 0, "");
	КонецЕсли;
	
	ЛеваяЧасть = Лев(ТекстВхождения, Позиция - 1);
	НомерСтроки = СтрЧислоВхождений(ЛеваяЧасть, Символы.ПС) + 1;
	ПозицияРазрыва = СтрНайти(ЛеваяЧасть, Символы.ПС, НаправлениеПоиска.СКонца);
	НачалоСтроки = ?(ПозицияРазрыва = 0, 1, ПозицияРазрыва + 1);
	КонецСтроки = СтрНайти(ТекстВхождения, Символы.ПС, , Позиция);
	Если КонецСтроки = 0 Тогда
		Фрагмент = Сред(ТекстВхождения, НачалоСтроки);
	Иначе
		Фрагмент = Сред(ТекстВхождения, НачалоСтроки, КонецСтроки - НачалоСтроки);
	КонецЕсли;
	Фрагмент = СокрЛП(Фрагмент);
	МаксимальнаяДлинаФрагмента = 300;
	СимволовДоВхождения = 80;
	Если СтрДлина(Фрагмент) > МаксимальнаяДлинаФрагмента Тогда
		Смещение = Позиция - НачалоСтроки + 1;
		ЛеваяГраница = Макс(Смещение - СимволовДоВхождения, 1);
		Фрагмент = Сред(Фрагмент, ЛеваяГраница, МаксимальнаяДлинаФрагмента);
	КонецЕсли;
	
	Возврат Новый Структура("НомерСтроки, Фрагмент", НомерСтроки, Фрагмент);
	
КонецФункции

// Параметры:
//  ТипКонвертации - ПеречислениеСсылка.ТипыКонвертаций
//
// Возвращаемое значение:
