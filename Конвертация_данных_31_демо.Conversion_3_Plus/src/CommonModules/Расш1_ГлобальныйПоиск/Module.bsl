Процедура ДополнитьМодулиКонфигурации(Результат, Конвертация, СтрокаПоиска, Шаблон)
	
	Если Результат.Обрезано Тогда
		Возврат;
	КонецЕсли;
	
	Релизы = РелизыКонвертации(Конвертация);
	Если Релизы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЛимитСтрок = ПределСтрокРезультата() - Результат.Строки.Количество() + 1;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(ЛимитСтрок, "ЧГ=0") + "
	|	Тексты.Релиз КАК Релиз,
	|	Тексты.Вид КАК Вид,
	|	Тексты.Ключ КАК Ключ,
	|	Тексты.Текст КАК Текст,
	|	ПРЕДСТАВЛЕНИЕ(Тексты.Релиз) КАК ПредставлениеРелиза,
	|	ПРЕДСТАВЛЕНИЕ(Тексты.Вид) КАК ПредставлениеВида
	|ИЗ
	|	РегистрСведений.Расш1_ТекстыМодулей КАК Тексты
	|ГДЕ
	|	Тексты.Релиз В (&Релизы)
	|	И Тексты.Текст ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""";
	Запрос.УстановитьПараметр("Релизы", Релизы);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Строки.Количество() >= ПределСтрокРезультата() Тогда
			Результат.Обрезано = Истина;
			Прервать;
		КонецЕсли;
		ФрагментСтроки = ФрагментВхождения(Выборка.Текст, СтрокаПоиска);
		СтрокаРезультата = Результат.Строки.Добавить();
		СтрокаРезультата.ЭтоМодуль = Истина;
		СтрокаРезультата.Источник = ПредставлениеИсточникаМодуля();
		СтрокаРезультата.Вид = Выборка.ПредставлениеВида;
		СтрокаРезультата.Представление = Выборка.Ключ;
		СтрокаРезультата.СинонимПоля = Выборка.ПредставлениеРелиза;
		СтрокаРезультата.Релиз = Выборка.Релиз;
		СтрокаРезультата.ВидМодуля = Выборка.Вид;
		СтрокаРезультата.Ключ = Выборка.Ключ;
		СтрокаРезультата.ИмяПоля = "Текст";
		СтрокаРезультата.НомерСтроки = ФрагментСтроки.НомерСтроки;
		СтрокаРезультата.Фрагмент = ФрагментСтроки.Фрагмент;
		СтрокаРезультата.ИмяФормы = ИмяФормыПросмотраМодуля();
	КонецЦикла;
	
КонецПроцедуры

Функция РелизыКонвертации(Конвертация)
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Конвертация, "Конфигурация, КонфигурацияКорреспондент");
	Релизы = Новый Массив;
	Если ЗначениеЗаполнено(Реквизиты.Конфигурация) Тогда
		Релизы.Добавить(Реквизиты.Конфигурация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.КонфигурацияКорреспондент)
		И Релизы.Найти(Реквизиты.КонфигурацияКорреспондент) = Неопределено Тогда
		Релизы.Добавить(Реквизиты.КонфигурацияКорреспондент);
	КонецЕсли;
	Возврат Релизы;
	
КонецФункции

