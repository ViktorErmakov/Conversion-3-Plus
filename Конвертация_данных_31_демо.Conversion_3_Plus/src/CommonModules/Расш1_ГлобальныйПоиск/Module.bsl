#Область ПрограммныйИнтерфейс

// Найти вхождения строки в текстах правил, алгоритмов и запросов конвертации.
// Поиск без учета регистра. Пустая конвертация и строка короче двух символов дают пустой результат.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  СтрокаПоиска - Строка
//  ИсключитьСсылку - ЛюбаяСсылка, Неопределено - элемент, который не включать в результат
//
// Возвращаемое значение:
//  Структура:
//   * Строки - ТаблицаЗначений - колонки Ссылка, Вид, Представление, ИмяПоля, СинонимПоля, НомерСтроки, Фрагмент, ИмяФормы
//   * Обрезано - Булево - Истина, если строк больше предела
//
Функция НайтиВхождения(Конвертация, СтрокаПоиска, ИсключитьСсылку = Неопределено) Экспорт
	
	Результат = НовыйРезультатПоиска();
	СтрокаДляПоиска = СокрЛП(СтрокаПоиска);
	Если Не ЗначениеЗаполнено(Конвертация) Или СтрДлина(СтрокаДляПоиска) < 2 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Шаблон = ШаблонПодобия(СтрокаДляПоиска);
	Источники = ИсточникиПоиска();
	ДополнитьИсточникПоИндексу(Результат, Источники, 0, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 1, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 2, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 3, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 4, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 5, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	ДополнитьИсточникПоИндексу(Результат, Источники, 6, Конвертация, СтрокаДляПоиска, Шаблон, ИсключитьСсылку);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПределСтрокРезультата()
	
	Возврат 500;
	
КонецФункции

Функция НовыйРезультатПоиска()
	
	Строки = Новый ТаблицаЗначений;
	Строки.Колонки.Добавить("Ссылка");
	Строки.Колонки.Добавить("Вид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Строки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Строки.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Строки.Колонки.Добавить("СинонимПоля", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Строки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный)));
	Строки.Колонки.Добавить("Фрагмент", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(300)));
	Строки.Колонки.Добавить("ИмяФормы", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	
	Результат = Новый Структура;
	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Обрезано", Ложь);
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьИсточникПоИндексу(Результат, Источники, Индекс, Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку)
	
	Если Результат.Строки.Количество() >= ПределСтрокРезультата() Тогда
		Результат.Обрезано = Истина;
		Возврат;
	КонецЕсли;
	ДополнитьРезультатИсточника(Результат, Источники[Индекс], Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку);
	
КонецПроцедуры

Процедура ДополнитьРезультатИсточника(Результат, Источник, Конвертация, СтрокаПоиска, Шаблон, ИсключитьСсылку)
	
	СсылкаИсключения = Неопределено;
	Если ЗначениеЗаполнено(ИсключитьСсылку)
		И ТипЗнч(ИсключитьСсылку) = ТипСсылкиСправочника(Источник.ИмяСправочника) Тогда
		СсылкаИсключения = ИсключитьСсылку;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаИсточника(Источник, СсылкаИсключения);
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("Шаблон", Шаблон);
	Если ЗначениеЗаполнено(СсылкаИсключения) Тогда
		Запрос.УстановитьПараметр("ИсключитьСсылку", СсылкаИсключения);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Строки.Количество() >= ПределСтрокРезультата() Тогда
			Результат.Обрезано = Истина;
			Прервать;
		КонецЕсли;
		ФрагментСтроки = ФрагментВхождения(Выборка.Текст, СтрокаПоиска);
		СтрокаРезультата = Результат.Строки.Добавить();
		СтрокаРезультата.Ссылка = Выборка.Ссылка;
		СтрокаРезультата.Вид = Источник.Вид;
		СтрокаРезультата.Представление = Выборка.Представление;
		СтрокаРезультата.ИмяПоля = Выборка.ИмяПоля;
		СтрокаРезультата.СинонимПоля = Выборка.СинонимПоля;
		СтрокаРезультата.НомерСтроки = ФрагментСтроки.НомерСтроки;
		СтрокаРезультата.Фрагмент = ФрагментСтроки.Фрагмент;
		Если Источник.ЧитатьТипКонвертации Тогда
			СтрокаРезультата.ИмяФормы = ИмяФормыПредопределенных(Выборка.ТипКонвертации);
		Иначе
			СтрокаРезультата.ИмяФормы = Источник.ИмяФормы;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаИсточника(Источник, ИсключитьСсылку)
	
	Части = Новый Массив;
	Для Каждого Поле Из Источник.Поля Цикл
		Части.Добавить(ТекстВыборкиПоля(Источник, Поле, ИсключитьСсылку));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
КонецФункции

Функция ТекстВыборкиПоля(Источник, Поле, ИсключитьСсылку)
	
	Текст = 
	"ВЫБРАТЬ
	|	Элемент.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Элемент.Ссылка) КАК Представление,
	|	""" + Поле.Имя + """ КАК ИмяПоля,
	|	""" + Поле.Синоним + """ КАК СинонимПоля,
	|	Элемент." + Поле.Имя + " КАК Текст";
	Если Источник.ЧитатьТипКонвертации Тогда
		Текст = Текст + ",
	|	Элемент.ТипКонвертации КАК ТипКонвертации";
	КонецЕсли;
	Текст = Текст + Символы.ПС + ТекстИсточникаИОтбора(Источник, Поле.Имя, ИсключитьСсылку);
	Возврат Текст;
	
КонецФункции

Функция ТекстИсточникаИОтбора(Источник, ИмяПоля, ИсключитьСсылку)
	
	Если Источник.ЭтоКонвертация Тогда
		Текст = 
		"ИЗ
		|	Справочник.Конвертации КАК Элемент
		|ГДЕ
		|	Элемент.Ссылка = &Конвертация";
	ИначеЕсли Источник.ЧерезВладельцаПравила Тогда
		Текст = 
		"ИЗ
		|	Справочник.СоставыКонвертаций КАК Состав
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник." + Источник.ИмяСправочника + " КАК Элемент
		|		ПО Элемент.Владелец = Состав.ЭлементКонвертации
		|ГДЕ
		|	Состав.Владелец = &Конвертация
		|	И ТИПЗНАЧЕНИЯ(Состав.ЭлементКонвертации) = ТИП(Справочник.ПравилаКонвертацииОбъектов)
		|	И НЕ Состав.ПометкаУдаления
		|	И НЕ Элемент.ПометкаУдаления
		|	И НЕ Элемент.ЭтоГруппа";
	Иначе
		Текст = 
		"ИЗ
		|	Справочник.СоставыКонвертаций КАК Состав
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник." + Источник.ИмяСправочника + " КАК Элемент
		|		ПО Состав.ЭлементКонвертации = Элемент.Ссылка
		|ГДЕ
		|	Состав.Владелец = &Конвертация
		|	И НЕ Состав.ПометкаУдаления
		|	И НЕ Элемент.ПометкаУдаления";
		Если Источник.ПропускатьГруппы Тогда
			Текст = Текст + "
		|	И НЕ Элемент.ЭтоГруппа";
		КонецЕсли;
	КонецЕсли;
	
	Текст = Текст + "
	|	И Элемент." + ИмяПоля + " ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""\""";
	Если ЗначениеЗаполнено(ИсключитьСсылку) Тогда
		Текст = Текст + "
	|	И Элемент.Ссылка <> &ИсключитьСсылку";
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

Функция ТипСсылкиСправочника(ИмяСправочника)
	
	Возврат ТипЗнч(Справочники[ИмяСправочника].ПустаяСсылка());
	
КонецФункции

Функция ШаблонПодобия(СтрокаПоиска)
	
	Экранированная = СтрЗаменить(СтрокаПоиска, "\", "\\");
	Экранированная = СтрЗаменить(Экранированная, "%", "\%");
	Экранированная = СтрЗаменить(Экранированная, "_", "\_");
	Возврат "%" + Экранированная + "%";
	
КонецФункции

Функция ФрагментВхождения(Текст, СтрокаПоиска)
	
	ТекстВхождения = СтрЗаменить(Текст, Символы.ВК, "");
	Позиция = СтрНайти(НРег(ТекстВхождения), НРег(СтрокаПоиска));
	Если Позиция = 0 Тогда
		Возврат Новый Структура("НомерСтроки, Фрагмент", 0, "");
	КонецЕсли;
	
	НомерСтроки = СтрЧислоВхождений(Лев(ТекстВхождения, Позиция - 1), Символы.ПС) + 1;
	НачалоСтроки = 1;
	ПозицияРазрыва = СтрНайти(ТекстВхождения, Символы.ПС, НаправлениеПоиска.СКонца, Позиция);
	Если ПозицияРазрыва > 0 Тогда
		НачалоСтроки = ПозицияРазрыва + 1;
	КонецЕсли;
	КонецСтроки = СтрНайти(ТекстВхождения, Символы.ПС, , Позиция);
	Если КонецСтроки = 0 Тогда
		Фрагмент = Сред(ТекстВхождения, НачалоСтроки);
	Иначе
		Фрагмент = Сред(ТекстВхождения, НачалоСтроки, КонецСтроки - НачалоСтроки);
	КонецЕсли;
	Фрагмент = СокрЛП(Фрагмент);
	Если СтрДлина(Фрагмент) > 300 Тогда
		Смещение = Позиция - НачалоСтроки + 1;
		ЛеваяГраница = Смещение - 80;
		Если ЛеваяГраница < 1 Тогда
			ЛеваяГраница = 1;
		КонецЕсли;
		Фрагмент = Сред(Фрагмент, ЛеваяГраница, 300);
	КонецЕсли;
	
	Возврат Новый Структура("НомерСтроки, Фрагмент", НомерСтроки, Фрагмент);
	
КонецФункции

Функция ИмяФормыПредопределенных(ТипКонвертации)
	
	Если ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO Тогда
		Возврат "Справочник.ПравилаКонвертацииПредопределенныхДанных.Форма.ФормаЭлементаXDTO";
	КонецЕсли;
	Возврат "Справочник.ПравилаКонвертацииПредопределенныхДанных.Форма.ФормаЭлементаXML";
	
КонецФункции

Функция ИсточникиПоиска()
	
	Источники = Новый Массив;
	Источники.Добавить(ИсточникКонвертации());
	Источники.Добавить(ИсточникСостава(
		"ПравилаКонвертацииОбъектов",
		"Правило конвертации объектов",
		"Справочник.ПравилаКонвертацииОбъектов.Форма.ФормаЭлемента",
		ПоляПравилКонвертацииОбъектов()));
	Источники.Добавить(ИсточникСостава(
		"ПравилаОбработкиДанных",
		"Правило обработки данных",
		"Справочник.ПравилаОбработкиДанных.Форма.ФормаЭлемента",
		ПоляПравилОбработкиДанных()));
	ИсточникПредопределенных = ИсточникСостава(
		"ПравилаКонвертацииПредопределенныхДанных",
		"Правило конвертации предопределенных данных",
		"",
		ПоляПравилПредопределенныхДанных());
	ИсточникПредопределенных.ЧитатьТипКонвертации = Истина;
	Источники.Добавить(ИсточникПредопределенных);
	ИсточникСвойств = ИсточникСостава(
		"ПравилаКонвертацииСвойств",
		"Правило конвертации свойства",
		"Справочник.ПравилаКонвертацииСвойств.Форма.ФормаЭлемента",
		ПоляПравилКонвертацииСвойств());
	ИсточникСвойств.ЧерезВладельцаПравила = Истина;
	Источники.Добавить(ИсточникСвойств);
	ИсточникАлгоритмов = ИсточникСостава(
		"Алгоритмы",
		"Алгоритм",
		"Справочник.Алгоритмы.Форма.ФормаЭлемента",
		ПоляАлгоритма());
	Источники.Добавить(ИсточникАлгоритмов);
	ИсточникЗапросов = ИсточникСостава(
		"Запросы",
		"Запрос",
		"Справочник.Запросы.Форма.ФормаЭлемента",
		ПоляЗапроса());
	ИсточникЗапросов.ПропускатьГруппы = Истина;
	Источники.Добавить(ИсточникЗапросов);
	Возврат Источники;
	
КонецФункции

Функция ИсточникКонвертации()
	
	Источник = ИсточникСостава(
		"Конвертации",
		"Конвертация",
		"Справочник.Конвертации.Форма.ФормаЭлемента",
		ПоляКонвертации());
	Источник.ЭтоКонвертация = Истина;
	Возврат Источник;
	
КонецФункции

Функция ИсточникСостава(ИмяСправочника, Вид, ИмяФормы, Поля)
	
	Источник = Новый Структура;
	Источник.Вставить("ИмяСправочника", ИмяСправочника);
	Источник.Вставить("Вид", Вид);
	Источник.Вставить("ИмяФормы", ИмяФормы);
	Источник.Вставить("Поля", Поля);
	Источник.Вставить("ЭтоКонвертация", Ложь);
	Источник.Вставить("ЧерезВладельцаПравила", Ложь);
	Источник.Вставить("ПропускатьГруппы", Ложь);
	Источник.Вставить("ЧитатьТипКонвертации", Ложь);
	Возврат Источник;
	
КонецФункции

Функция ПоляКонвертации()
	
	Поля = Новый Массив;
	ДобавитьПоле(Поля, "АлгоритмПередВыгрузкойДанных", "Алгоритм перед выгрузкой данных");
	ДобавитьПоле(Поля, "АлгоритмПередВыгрузкойОбъекта", "Алгоритм перед выгрузкой объекта");
	ДобавитьПоле(Поля, "АлгоритмПередЗагрузкойДанных", "Алгоритм перед загрузкой данных");
	ДобавитьПоле(Поля, "АлгоритмПередЗагрузкойОбъекта", "Алгоритм перед загрузкой объекта");
	ДобавитьПоле(Поля, "АлгоритмПередКонвертацией", "Алгоритм перед конвертацией");
	ДобавитьПоле(Поля, "АлгоритмПередКонвертациейОбъекта", "Алгоритм перед конвертацией объекта");
	ДобавитьПоле(Поля, "АлгоритмПередОбработкойУдаления", "Алгоритм перед обработкой удаления");
	ДобавитьПоле(Поля, "АлгоритмПередОтложеннымЗаполнением", "Алгоритм перед отложенным заполнением");
	ДобавитьПоле(Поля, "АлгоритмПередОтправкойИнформацииОбУдалении", "Алгоритм перед отправкой информации об удалении");
	ДобавитьПоле(Поля, "АлгоритмПередПолучениемИзмененныхОбъектов", "Алгоритм перед получением измененных объектов");
	ДобавитьПоле(Поля, "АлгоритмПослеВыгрузкиДанных", "Алгоритм после выгрузки данных");
	ДобавитьПоле(Поля, "АлгоритмПослеВыгрузкиОбъекта", "Алгоритм после выгрузки объекта");
	ДобавитьПоле(Поля, "АлгоритмПослеЗагрузкиДанных", "Алгоритм после загрузки данных");
	ДобавитьПоле(Поля, "АлгоритмПослеЗагрузкиОбъекта", "Алгоритм после загрузки объекта");
	ДобавитьПоле(Поля, "АлгоритмПослеЗагрузкиПараметров", "Алгоритм после загрузки параметров");
