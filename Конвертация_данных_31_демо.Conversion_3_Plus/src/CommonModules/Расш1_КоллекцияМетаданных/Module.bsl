#Область ПрограммныйИнтерфейс

// Есть ли в справочнике Объекты загруженная структура конфигурации релиза.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОписаниеМетаданных(Релиз) Экспорт
	
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Объекты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Объекты КАК Объекты
	|ГДЕ
	|	Объекты.Владелец = &Владелец
	|	И НЕ Объекты.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("Владелец", Релиз);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Релиз конвертации, если в справочнике Объекты нет загруженной структуры.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  СправочникСсылка.Релизы - релиз без загруженной структуры; Неопределено, если описание есть.
//
Функция РелизКонвертацииЕслиНетОписания(Конвертация) Экспорт
	
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Релиз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Конвертация, "Конфигурация");
	Если Не ЗначениеЗаполнено(Релиз) Или ЕстьОписаниеМетаданных(Релиз) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Релиз;
	
КонецФункции

// Список объектов метаданных.
//
// Параметры:
//  ТипОбъектов		 - Строка - имя коллекции.
//  АдресОбновления	 - Строка - адрес для обновления в консоле VSC.
//  Релиз			 - СправочникСсылка - релиз конфигурации.
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьСписокОбъектовМетаданных(ТипОбъектов, АдресОбновления, Релиз) Экспорт
	
	ИмяКоллекцииКлюч = НРег(СокрЛП(ТипОбъектов));
	ИменаКоллекцииМетаданныхJSON = Расш1_МодульПовтИсп.НовыеИменаКоллекцииМетаданныхJSON();
	ИмяКоллекции = ИменаКоллекцииМетаданныхJSON[ИмяКоллекцииКлюч];
	Если ИмяКоллекции = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СписокОбъектов = Расш1_МодульПовтИсп.ОписаниеКоллекцииМетаданных(Релиз, ИмяКоллекцииКлюч);
	Если СписокОбъектов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	АдресОбновления = СтрШаблон("%1.items", ИмяКоллекции);
	Возврат ПолучитьОписаниеМетаданныхJSON(СписокОбъектов);
	
КонецФункции

// Описание объекта коллекции для консоли: имена реквизитов без типов и без
// полей табличных частей. Методы менеджера и объекта уже встроены в редактор.
//
// Параметры:
//  ТипОбъекта - Строка - путь вида "справочники.Имя".
//  АдресОбновления - Строка - исходящий path для updateMetadata (catalogs.items.Имя).
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Строка - JSON тела объекта {"properties":{...}}.
//
Функция ПолучитьОписаниеОбъектаМетаданных(ТипОбъекта, АдресОбновления, Релиз) Экспорт
	
	ПутьОбъекта = СтрРазделить(ТипОбъекта, ".");
	Если ПутьОбъекта.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяКоллекцииКлюч = НРег(СокрЛП(ПутьОбъекта[0]));
	ИменаКоллекцииМетаданныхJSON = Расш1_МодульПовтИсп.НовыеИменаКоллекцииМетаданныхJSON();
	ИмяКоллекцииJSON = ИменаКоллекцииМетаданныхJSON[ИмяКоллекцииКлюч];
	Если ИмяКоллекцииJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяОбъекта = ИмяОбъектаКоллекцииПоЗапросуКонсоли(Релиз, ИмяКоллекцииКлюч, СокрЛП(ПутьОбъекта[1]));
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	ОписаниеРеквизитов = Новый Структура;
	ЗаполнитьИменаСвойствОбъекта(Релиз, ИмяКоллекцииКлюч, ИмяОбъекта, ОписаниеРеквизитов);
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("properties", ОписаниеРеквизитов);
	АдресОбновления = СтрШаблон("%1.items.%2", ИмяКоллекцииJSON, ИмяОбъекта);
	
	Возврат ПолучитьОписаниеМетаданныхJSON(СтруктураОбъекта);
	
КонецФункции

// Получить описание json параметра ДанныеИБ.
//
// Параметры:
//  ОбъектВыборки - Строка - тип и наименования объекта выборки.
// 
// Возвращаемое значение:
//   - см. НовыйДанныеИБ
//
Функция ПолучитьОписаниеДанныеИБ(ОбъектВыборки) Экспорт
	
	ОписаниеВыборки = СтрРазделить(ОбъектВыборки, ".");
	ТипВыборки = ОписаниеВыборки[0];
	ПолноеНаименованиеОбъекта = ОписаниеВыборки[1];
	Если ТипВыборки = "СправочникСсылка" Тогда
		ИмяОбъекта = СтрШаблон("catalogs.%1.obj", ПолноеНаименованиеОбъекта);
	ИначеЕсли ТипВыборки = "ДокументСсылка" Тогда
		ИмяОбъекта = СтрШаблон("documents.%1.obj", ПолноеНаименованиеОбъекта);
	Иначе
		ВызватьИсключение "ПолучитьОписаниеДанныеИБ - не обработано условие";
	КонецЕсли;
	
	ДанныеИБ = НовыйДанныеИБ();
	ДанныеИБ.name = ПолноеНаименованиеОбъекта;
	ДанныеИБ.ref = ИмяОбъекта; 
	
	Возврат ДанныеИБ;
	
КонецФункции

// Описание параметра ДанныеXDTO: свойства объекта формата для customObjects.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - конвертация правила.
//  ИмяОбъектаФормата - Строка - наименование объекта формата.
//
// Возвращаемое значение:
//  Структура - описание объекта:
//   * name - Строка - имя объекта формата
//   * ref - Строка - classes.Структура
//   * properties - Структура - свойства объекта
//  Строка - пустая строка, если свойств нет.
//
Функция ПолучитьОписаниеДанныеXDTO(Конвертация, ИмяОбъектаФормата) Экспорт
	
	ИмяОбъекта = СокрЛП(ИмяОбъектаФормата);
	Если Не ЗначениеЗаполнено(Конвертация) Или ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиСвойств = Расш1_СвойстваФорматаОбъекта(Конвертация, ИмяОбъекта);
	Если СтрокиСвойств.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Свойства = Расш1_СвойстваУзлаФормата(СтрокиСвойств, ИмяОбъекта, "", Новый Соответствие);
	Если Свойства.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("name", ИмяОбъекта);
	Описание.Вставить("ref", "classes.Структура");
	Описание.Вставить("properties", Свойства);
	
	Возврат Описание;
	
КонецФункции

// Объекты формата правил, из обработчиков которых вызывается алгоритм.
// Список без повторов, по наименованию. Вызов из ПОД и конвертации объекта не дает.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  КодАлгоритма - Строка - код алгоритма, имя вызова.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Расш1_ОбъектыФорматаВызововАлгоритма(Конвертация, КодАлгоритма) Экспорт
	
	ОбъектыФормата = Новый Массив;
	КодВызова = НРег(СокрЛП(КодАлгоритма));
	Если Не ЗначениеЗаполнено(Конвертация) Или ПустаяСтрока(КодВызова) Тогда
		Возврат ОбъектыФормата;
	КонецЕсли;
	
	ТекстыВызовов = Расш1_ТекстыВызововАлгоритмов(Конвертация);
	Искомые = Новый Массив;
	Искомые.Добавить(КодВызова);
	Обработанные = Новый Соответствие;
	Найденные = Новый Соответствие;
	Индекс = 0;
	
	Пока Индекс < Искомые.Количество() Цикл
		
		КодНижний = Искомые[Индекс];
		Индекс = Индекс + 1;
		Если Обработанные.Получить(КодНижний) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(КодНижний, Истина);
		
		Для Каждого ТекстВызова Из ТекстыВызовов.Правила Цикл
			Если Не Расш1_ТекстСодержитВызов(ТекстВызова.Текст, КодНижний) Тогда
				Продолжить;
			КонецЕсли;
			ИмяОбъекта = СокрЛП(ТекстВызова.ОбъектФормата);
			КлючИмени = НРег(ИмяОбъекта);
			Если Не ПустаяСтрока(КлючИмени) И Найденные.Получить(КлючИмени) = Неопределено Тогда
				Найденные.Вставить(КлючИмени, ИмяОбъекта);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекстВызова Из ТекстыВызовов.Алгоритмы Цикл
			КодСтроки = НРег(СокрЛП(ТекстВызова.Код));
			Если КодСтроки = КодНижний Или ПустаяСтрока(КодСтроки) Тогда
				Продолжить;
			КонецЕсли;
			Если Обработанные.Получить(КодСтроки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Расш1_ТекстСодержитВызов(ТекстВызова.Текст, КодНижний) Тогда
				Искомые.Добавить(КодСтроки);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Список = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из Найденные Цикл
		Список.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Для Каждого Элемент Из Список Цикл
		ОбъектыФормата.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат ОбъектыФормата;
	
КонецФункции

// Получить описание json параметра обработчика "компоненты обмена".
//
// Параметры:
//  Направление	 - Строка - направление обмена.
// 
// Возвращаемое значение:
//   - Структура
//
Функция ПолучитьОписаниеКомпонентыОбмена(Направление) Экспорт
	
	КомпонентыОбменаИсходные = ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена(Направление);
	КомпонентыОбмена = ПолучитьСтруктуруСвойств(КомпонентыОбменаИсходные);
	Возврат КомпонентыОбмена;
	
КонецФункции

// Получить описание json параметра обработчика "использование ПКО".
//
// Параметры:
//  ИспользованиеПКО - Структура - первоначальная структура содержащая список ПКО и значение использования.
// 
// Возвращаемое значение:
//   - Структура
//
Функция ПолучитьОписаниеИспользованиеПКО(ИспользованиеПКО) Экспорт
	Возврат ПолучитьСтруктуруСвойств(ИспользованиеПКО);
КонецФункции

// Получить описание параметры конвертации.
//
// Параметры:
//  Конвертация	 - СправочникСсылка - конвертация.
// 
// Возвращаемое значение:
//   - Структура.
//
Функция ПолучитьОписаниеПараметрыКонвертации(Конвертация) Экспорт
	ПараметрыКонвертации = Справочники.Конвертации.ЗаполнитьПараметрыКонвертации(Конвертация);
