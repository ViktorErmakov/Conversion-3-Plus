// @strict-types

#Область ПрограммныйИнтерфейс

// Есть ли в справочнике Объекты загруженная структура конфигурации релиза.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОписаниеМетаданных(Релиз) Экспорт
	
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Объекты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Объекты КАК Объекты
	|ГДЕ
	|	Объекты.Владелец = &Владелец
	|	И НЕ Объекты.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("Владелец", Релиз);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Релиз конвертации, если в справочнике Объекты нет загруженной структуры.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  СправочникСсылка.Релизы - релиз без загруженной структуры; Неопределено, если описание есть.
//
Функция РелизКонвертацииЕслиНетОписания(Конвертация) Экспорт
	
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Релиз = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Конвертация, "Конфигурация");
	Если Не ЗначениеЗаполнено(Релиз) Или ЕстьОписаниеМетаданных(Релиз) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Релиз;
	
КонецФункции

// Список объектов метаданных.
//
// Параметры:
//  ТипОбъектов		 - Строка - имя коллекции.
//  АдресОбновления	 - Строка - адрес для обновления в консоле VSC.
//  Релиз			 - СправочникСсылка - релиз конфигурации.
// 
// Возвращаемое значение:
//   - Строка
//
Функция ПолучитьСписокОбъектовМетаданных(ТипОбъектов, АдресОбновления, Релиз) Экспорт
	
	ИмяКоллекцииКлюч = НРег(СокрЛП(ТипОбъектов));
	ИменаКоллекцииМетаданныхJSON = Расш1_КоллекцииМетаданныхПовтИсп.НовыеИменаКоллекцииМетаданныхJSON();
	ИмяКоллекции = ИменаКоллекцииМетаданныхJSON[ИмяКоллекцииКлюч];
	Если ИмяКоллекции = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СписокОбъектов = Расш1_КоллекцииМетаданныхПовтИсп.ОписаниеКоллекцииМетаданных(Релиз, ИмяКоллекцииКлюч);
	Если СписокОбъектов.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	АдресОбновления = СтрШаблон("%1.items", ИмяКоллекции);
	Возврат ПолучитьОписаниеМетаданныхJSON(СписокОбъектов);
	
КонецФункции

// Описание объекта коллекции для консоли: имена реквизитов без типов и без
// полей табличных частей. Методы менеджера и объекта уже встроены в редактор.
//
// Параметры:
//  ТипОбъекта - Строка - путь вида "справочники.Имя".
//  АдресОбновления - Строка - исходящий path для updateMetadata (catalogs.items.Имя).
//  Релиз - СправочникСсылка.Релизы
//
// Возвращаемое значение:
//  Строка - JSON тела объекта {"properties":{...}}.
//
Функция ПолучитьОписаниеОбъектаМетаданных(ТипОбъекта, АдресОбновления, Релиз) Экспорт
	
	ПутьОбъекта = СтрРазделить(ТипОбъекта, ".");
	ЧастейКоллекцияИИмя = 2;
	Если ПутьОбъекта.Количество() < ЧастейКоллекцияИИмя Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяКоллекцииКлюч = НРег(СокрЛП(ПутьОбъекта[0]));
	ИменаКоллекцииМетаданныхJSON = Расш1_КоллекцииМетаданныхПовтИсп.НовыеИменаКоллекцииМетаданныхJSON();
	ИмяКоллекцииJSON = ИменаКоллекцииМетаданныхJSON[ИмяКоллекцииКлюч];
	Если ИмяКоллекцииJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяОбъекта = ИмяОбъектаКоллекцииПоЗапросуКонсоли(Релиз, ИмяКоллекцииКлюч, СокрЛП(ПутьОбъекта[1]));
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	ОписаниеРеквизитов = Новый Структура;
	ЗаполнитьИменаСвойствОбъекта(Релиз, ИмяКоллекцииКлюч, ИмяОбъекта, ОписаниеРеквизитов);
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("properties", ОписаниеРеквизитов);
	АдресОбновления = СтрШаблон("%1.items.%2", ИмяКоллекцииJSON, ИмяОбъекта);
	
	Возврат ПолучитьОписаниеМетаданныхJSON(СтруктураОбъекта);
	
КонецФункции

// Получить описание json параметра ДанныеИБ.
//
// Параметры:
//  ОбъектВыборки - Строка - тип и наименования объекта выборки.
// 
// Возвращаемое значение:
//   - см. НовыйДанныеИБ
//
Функция ПолучитьОписаниеДанныеИБ(ОбъектВыборки) Экспорт
	
	ОписаниеВыборки = СтрРазделить(ОбъектВыборки, ".");
	ТипВыборки = ОписаниеВыборки[0];
	ПолноеНаименованиеОбъекта = ОписаниеВыборки[1];
	ИменаКоллекцийJSON = Расш1_КоллекцииМетаданныхПовтИсп.ИменаКоллекцийJSONПоТипуСсылки();
	ИмяКоллекцииJSON = ИменаКоллекцийJSON[ТипВыборки];
	Если ИмяКоллекцииJSON = Неопределено Тогда
		ВызватьИсключение "ПолучитьОписаниеДанныеИБ - не обработано условие";
	КонецЕсли;
	ИмяОбъекта = СтрШаблон("%1.%2.obj", ИмяКоллекцииJSON, ПолноеНаименованиеОбъекта);
	
	ДанныеИБ = НовыйДанныеИБ();
	ДанныеИБ.name = ПолноеНаименованиеОбъекта;
	ДанныеИБ.ref = ИмяОбъекта; 
	
	Возврат ДанныеИБ;
	
КонецФункции

// Описание параметра ДанныеXDTO: свойства объекта формата для customObjects.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - конвертация правила.
//  ИмяОбъектаФормата - Строка - наименование объекта формата.
//
// Возвращаемое значение:
//  - Строка - пустая строка, если свойств нет.
//  - Структура - описание объекта:
//   * name - Строка - имя объекта формата
//   * ref - Строка - classes.Структура
//   * properties - Структура - свойства объекта
//
Функция ПолучитьОписаниеДанныеXDTO(Конвертация, ИмяОбъектаФормата) Экспорт
	
	ИмяОбъекта = СокрЛП(ИмяОбъектаФормата);
	Если Не ЗначениеЗаполнено(Конвертация) Или ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиСвойств = Расш1_СвойстваФорматаОбъекта(Конвертация, ИмяОбъекта);
	Если СтрокиСвойств.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Свойства = Расш1_СвойстваУзлаФормата(СтрокиСвойств, ИмяОбъекта, "", Новый Соответствие);
	Если Свойства.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("name", ИмяОбъекта);
	Описание.Вставить("ref", "classes.Структура");
	Описание.Вставить("properties", Свойства);
	
	Возврат Описание;
	
КонецФункции

// Объекты формата правил, из обработчиков которых вызывается алгоритм.
// Список без повторов, по наименованию. Вызов из ПОД и конвертации объекта не дает.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  КодАлгоритма - Строка - код алгоритма, имя вызова.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Расш1_ОбъектыФорматаВызововАлгоритма(Конвертация, КодАлгоритма) Экспорт
	
	ОбъектыФормата = Новый Массив; // Массив из Строка
	КодБезПробелов = СокрЛП(КодАлгоритма);
	КодВызова = НРег(КодБезПробелов);
	Если Не ЗначениеЗаполнено(Конвертация) Или ПустаяСтрока(КодВызова) Тогда
		Возврат ОбъектыФормата;
	КонецЕсли;
	
	ТекстыВызовов = Расш1_ТекстыВызововАлгоритмов(Конвертация);
	Искомые = Новый Массив; // Массив из Строка
	Искомые.Добавить(КодВызова);
	Обработанные = Новый Соответствие;
	Найденные = Новый Соответствие;
	Индекс = 0;
	
	Пока Индекс < Искомые.Количество() Цикл
		
		КодНижний = Искомые[Индекс];
		Индекс = Индекс + 1;
		Если Обработанные.Получить(КодНижний) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(КодНижний, Истина);
		
		Расш1_ДобавитьОбъектыПравилСВызовом(ТекстыВызовов.Правила, КодНижний, Найденные);
		Расш1_ДобавитьАлгоритмыСВызовом(ТекстыВызовов.Алгоритмы, КодНижний, Обработанные, Искомые);
		
	КонецЦикла;
	
	Список = Новый СписокЗначений; // СписокЗначений из Строка
	Для Каждого КлючИЗначение Из Найденные Цикл
		ИмяОбъектаФормата = КлючИЗначение.Значение; // Строка
		Список.Добавить(ИмяОбъектаФормата);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Для Каждого Элемент Из Список Цикл
		ИмяОбъектаФормата = Элемент.Значение; // Строка
		ОбъектыФормата.Добавить(ИмяОбъектаФормата);
	КонецЦикла;
	
	Возврат ОбъектыФормата;
	
КонецФункции

// Получить описание json параметра обработчика "компоненты обмена".
//
// Параметры:
//  Направление	 - Строка - направление обмена.
// 
// Возвращаемое значение:
//  Структура - описание свойств для подсказок:
//   * name - Строка - имя свойства, если задано.
//   * ref - Строка - classes.Структура.
//   * properties - Структура - описание вложенных свойств.
//
Функция ПолучитьОписаниеКомпонентыОбмена(Направление) Экспорт
	
	КомпонентыОбменаИсходные = ОбменДаннымиXDTOСервер.ИнициализироватьКомпонентыОбмена(Направление);
	КомпонентыОбмена = ПолучитьСтруктуруСвойств(КомпонентыОбменаИсходные);
	Возврат КомпонентыОбмена;
	
КонецФункции

// Получить описание json параметра обработчика "использование ПКО".
//
// Параметры:
//  ИспользованиеПКО - Структура - первоначальная структура содержащая список ПКО и значение использования.
// 
// Возвращаемое значение:
//  Структура - описание свойств для подсказок:
//   * name - Строка - имя свойства, если задано.
//   * ref - Строка - classes.Структура.
//   * properties - Структура - описание вложенных свойств.
//
Функция ПолучитьОписаниеИспользованиеПКО(ИспользованиеПКО) Экспорт
	Возврат ПолучитьСтруктуруСвойств(ИспользованиеПКО);
КонецФункции

// Описание параметров конвертации для подсказок консоли кода.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации - конвертация, чьи параметры описываются.
//
// Возвращаемое значение:
//  Структура - описание свойств параметров конвертации в формате подсказок:
//   * name - Строка - имя свойства, если задано.
//   * ref - Строка - classes.Структура.
//   * properties - Структура - описание свойств параметров.
//
Функция ПолучитьОписаниеПараметрыКонвертации(Конвертация) Экспорт
	ПараметрыКонвертации = Расш1_ПараметрыКонвертации(Конвертация);
	Возврат ПолучитьСтруктуруСвойств(ПараметрыКонвертации);
КонецФункции

// Имя объекта коллекции в том регистре, в каком оно лежит в справочнике Объекты.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//  ИмяКоллекции - Строка - ключ коллекции, например справочники.
//  ИмяИзКонсоли - Строка - имя из события консоли, без учета регистра.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяОбъектаМетаданных(Релиз, ИмяКоллекции, ИмяИзКонсоли) Экспорт
	
	Возврат ИмяОбъектаКоллекцииПоЗапросуКонсоли(Релиз, ИмяКоллекции, ИмяИзКонсоли);
	
КонецФункции

// JSON customObjects страницы обработчика XML.
// Имя Параметры заполняется структурой параметров конвертации.
// Имена из ИменаОбъекта получают описание справочника или документа.
//
// Параметры:
//  ИменаПараметров - Строка - имена через запятую.
//  Конвертация - СправочникСсылка.Конвертации
//  ОписаниеОбъекта - Строка, СправочникСсылка.Объекты - вид и имя, например СправочникСсылка.Номенклатура.
//                    Не строка даёт пустое описание объекта.
//  ИменаОбъекта - Строка - имена параметров, для которых подставляется описание объекта.
//
// Возвращаемое значение:
//  Строка
//
Функция ОписаниеПараметровСтраницыJSON(ИменаПараметров, Конвертация, ОписаниеОбъекта, ИменаОбъекта) Экспорт
	
	ПользовательскиеОбъекты = Новый Структура;
	ИменаСОписанием = Новый Соответствие;
	СписокИменОбъекта = СтрРазделить(ИменаОбъекта, ",", Ложь);
	Для Каждого ИмяОбъекта Из СписокИменОбъекта Цикл
		ИмяБезПробелов = СокрЛП(ИмяОбъекта);
		ИменаСОписанием.Вставить(ИмяБезПробелов, Истина);
	КонецЦикла;
	
	Имена = Новый Массив; // Массив из Строка
	СписокИменПараметров = СтрРазделить(ИменаПараметров, ",", Ложь);
	Для Каждого ИмяПараметра Из СписокИменПараметров Цикл
		Имя = СокрЛП(ИмяПараметра);
		Если Не ПустаяСтрока(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеПараметров = Новый Структура;
	ЕстьПараметры = (Имена.Найти("Параметры") <> Неопределено);
	Если ЕстьПараметры И ЗначениеЗаполнено(Конвертация) Тогда
		ОписаниеПараметров = ПолучитьОписаниеПараметрыКонвертации(Конвертация);
	КонецЕсли;
	
	ОписаниеСтраницы = "";
	Если ИменаСОписанием.Количество() > 0 Тогда
		ОписаниеСтраницы = ОписаниеОбъектаСтраницы(ОписаниеОбъекта);
	КонецЕсли;
	
	Для Каждого Имя Из Имена Цикл
		
		Если Имя = "Параметры" И ЗначениеЗаполнено(Конвертация) Тогда
			ПользовательскиеОбъекты.Вставить(Имя, ОписаниеПараметров);
		ИначеЕсли ИменаСОписанием.Получить(Имя) = Истина Тогда
			ПользовательскиеОбъекты.Вставить(Имя, ОписаниеСтраницы);
		Иначе
			ПользовательскиеОбъекты.Вставить(Имя, "");
		КонецЕсли;
		
	КонецЦикла;
	
	Описание = Новый Структура;
	Описание.Вставить("customObjects", ПользовательскиеОбъекты);
	
	Возврат ПолучитьОписаниеМетаданныхJSON(Описание);
	
КонецФункции

// Вид и имя объекта конфигурации для подсказки параметра обработчика.
// Справочник Объекты преобразуется в строку вида СправочникСсылка.Имя, ПланСчетовСсылка.Имя и т.п.
// Пустая ссылка и нессылочные виды (регистры, перечисления и т.п.) возвращают пустую строку.
//
// Параметры:
//  ОбъектКонфигурации - СправочникСсылка.Объекты
//
// Возвращаемое значение:
//  Строка
//
Функция Расш1_ОписаниеВидаОбъектаКонфигурации(ОбъектКонфигурации) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбъектКонфигурации) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Объекты.Имя КАК Имя,
	|	ЕСТЬNULL(Родители.Имя, """") КАК ИмяРодителя,
	|	ЕСТЬNULL(Родители.Наименование, """") КАК НаименованиеРодителя
	|ИЗ
	|	Справочник.Объекты КАК Объекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Родители
	|		ПО Объекты.Родитель = Родители.Ссылка
	|ГДЕ
	|	Объекты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ОбъектКонфигурации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	
	Поля = Новый Структура("Имя, ИмяРодителя, НаименованиеРодителя", "", "", "");
	ЗаполнитьЗначенияСвойств(Поля, Выборка);
	Если ПустаяСтрока(Поля.Имя) Тогда
		Возврат "";
	КонецЕсли;
	
	Вид = Расш1_ВидСсылкиОбъекта(Поля.ИмяРодителя, Поля.НаименованиеРодителя);
	Если ПустаяСтрока(Вид) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон("%1.%2", Вид, Поля.Имя);
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Преобразует структуру описания конфигурации в формат JSON.
//
// Параметры:
//  КоллекцияМетаданных	 - Структура, Соответствие из КлючИЗначение - коллекция метаданных.
// 
// Возвращаемое значение:
//   - Строка - в формате JSON.
//
Функция ПолучитьОписаниеМетаданныхJSON(КоллекцияМетаданных) Экспорт
	
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(Запись, КоллекцияМетаданных);
	Исключение
		Информация = ИнформацияОбОшибке();
		Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
		ШаблонТекста = НСтр("ru = 'Не удалось сохранить коллекцию метаданных: %1 %2'");
		Текст = СтрШаблон(ШаблонТекста, Символы.ПС, Подробности);
		ВызватьИсключение Текст;
	КонецПопытки;
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Дополняет JSON customObjects алгоритмами, запросами и параметрами конвертации.
// Функции и сигнатуры отдаются отдельно: их забирают updateCustomFunctions и setCustomSignatures.
//
// Параметры:
//  ОписаниеМетаданныхJSON - Строка - JSON, который уже кормит customObjects страницы.
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  Структура:
//   * ОписаниеJSON - Строка - тот же JSON customObjects, дополненный алгоритмами и запросами.
//   * ФункцииJSON - Строка - аргумент updateCustomFunctions.
//   * СигнатурыJSON - Строка - аргумент setCustomSignatures.
//
Функция Расш1_ДополнитьКонтекстОбработчика(ОписаниеМетаданныхJSON, Конвертация) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ОписаниеJSON", ОписаниеМетаданныхJSON);
	Результат.Вставить("ФункцииJSON", "");
	Результат.Вставить("СигнатурыJSON", "");
	
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Контекст = Расш1_СобратьКонтекстОбработчика(Конвертация);
	Результат.ФункцииJSON = Контекст.ФункцииJSON;
	Результат.СигнатурыJSON = Контекст.СигнатурыJSON;
	Результат.ОписаниеJSON = Расш1_ДополнитьОбъектыКонтекста(ОписаниеМетаданныхJSON, Контекст);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Расш1_ПараметрыКонвертации(Конвертация)
	
	ПараметрыКонвертации = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонвертацииПараметры.Параметр КАК Параметр
		|ИЗ
		|	Справочник.Конвертации.Параметры КАК КонвертацииПараметры
		|ГДЕ
		|	КонвертацииПараметры.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Конвертация);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Поля = Новый Структура("Параметр", "");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Поля, ВыборкаДетальныеЗаписи);
		ПараметрыКонвертации.Вставить(Поля.Параметр, "");
	КонецЦикла;
	
	Возврат ПараметрыКонвертации;
	
КонецФункции

// Параметры:
//  ИмяРодителя - Строка - имя коллекции в справочнике Объекты.
//  НаименованиеРодителя - Строка - наименование коллекции, если имя пустое.
//
// Возвращаемое значение:
//  Строка - имя типа ссылки (СправочникСсылка, ПланСчетовСсылка и т.п.) или пустая строка.
//
Функция Расш1_ВидСсылкиОбъекта(ИмяРодителя, НаименованиеРодителя)
	
	Ключ = НРег(СтрЗаменить(СокрЛП(Строка(ИмяРодителя)), " ", ""));
	Если ПустаяСтрока(Ключ) Тогда
		Ключ = НРег(СтрЗаменить(СокрЛП(Строка(НаименованиеРодителя)), " ", ""));
	КонецЕсли;
	
	ТипыСсылок = Расш1_КоллекцииМетаданныхПовтИсп.ТипыСсылокКоллекций();
	ТипСсылки = ТипыСсылок[Ключ];
	Если ТипСсылки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ТипСсылки;
	
КонецФункции

Функция ОписаниеОбъектаСтраницы(ОписаниеОбъекта)
	
	Если ТипЗнч(ОписаниеОбъекта) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиОписания = СтрРазделить(ОписаниеОбъекта, ".");
	ЧастейТипИИмя = 2;
	Если ЧастиОписания.Количество() < ЧастейТипИИмя Тогда
		Возврат "";
	КонецЕсли;
	
	ИменаКоллекцийJSON = Расш1_КоллекцииМетаданныхПовтИсп.ИменаКоллекцийJSONПоТипуСсылки();
	ИмяКоллекцииJSON = ИменаКоллекцийJSON[ЧастиОписания[0]];
	Если ИмяКоллекцииJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПолучитьОписаниеДанныеИБ(ОписаниеОбъекта);
	
КонецФункции

Функция ПолучитьСтруктуруСвойств(ИсходнаяСтруктура, ИмяСвойства = "", КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	ОписаниеСтруктуры = Новый Структура;
	СвойстваСтруктуры = Новый Структура;
	
	Для Каждого Свойство Из ИсходнаяСтруктура Цикл
		ДобавитьОписаниеСвойстваСтруктуры(СвойстваСтруктуры, Свойство, КодЯзыка);
	КонецЦикла;
	
	Если Не ПустаяСтрока(ИмяСвойства) Тогда
		ОписаниеСтруктуры.Вставить("name", ИмяСвойства);
	КонецЕсли;
	
	ОписаниеСтруктуры.Вставить("ref", "classes.Структура");
	ОписаниеСтруктуры.Вставить("properties", СвойстваСтруктуры);
	
	Возврат ОписаниеСтруктуры;
	
КонецФункции

Процедура ДобавитьОписаниеСвойстваСтруктуры(СвойстваСтруктуры, Свойство, КодЯзыка)
	
	Тип = ТипЗнч(Свойство.Значение);
	
	Если Тип = Тип("Структура") Тогда
		// Вложенной структуре нужно имя свойства.
		СвойстваВложеннойСтруктуры = ПолучитьСтруктуруСвойств(Свойство.Значение, Свойство.Ключ, КодЯзыка);
		СвойстваСтруктуры.Вставить(Свойство.Ключ, СвойстваВложеннойСтруктуры);
		Возврат;
	КонецЕсли;
	
	Если Свойство.Значение = Неопределено Тогда
		ЗаполнитьСтруктуруСвойства(СвойстваСтруктуры, Свойство.Ключ, "", "", КодЯзыка);
		Возврат;
	КонецЕсли;
	
	ИмяТипа = Строка(Тип);
	ЭтоПримитив = Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Булево");
	Если ЭтоПримитив Тогда
		ЗаполнитьСтруктуруСвойства(СвойстваСтруктуры, Свойство.Ключ, ИмяТипа, "", КодЯзыка);
		Возврат;
	КонецЕсли;
	
	Если Тип = Тип("Массив") Тогда
		ЗаполнитьСтруктуруСвойства(СвойстваСтруктуры, Свойство.Ключ, ИмяТипа, "classes.Массив", КодЯзыка);
		Возврат;
	КонецЕсли;
	
	Если Тип = Тип("Соответствие") Тогда
		ЗаполнитьСтруктуруСвойства(СвойстваСтруктуры, Свойство.Ключ, ИмяТипа, "classes.Соответствие", КодЯзыка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСтруктуруСвойства(СвойстваКомпонентыОбмена, Ключ, Тип = "", ИмяКласса = "", КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	ПодписьТипа = Расш1_ПодписьТипа(Тип, КодЯзыка);
	СтруктураСвойства = Новый Структура;
	СтруктураСвойства.Вставить("name", ПодписьТипа);
	
	Если Не ПустаяСтрока(ИмяКласса) Тогда
		СтруктураСвойства.Вставить("ref", ИмяКласса);
	КонецЕсли;
	
	СвойстваКомпонентыОбмена.Вставить(Ключ, СтруктураСвойства);
	
КонецПроцедуры

// Имена реквизитов и табличных частей объекта. Без типов и без полей ТЧ.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы - релиз конфигурации.
//  ИмяКоллекцииКлюч - Строка - имя коллекции метаданных в нижнем регистре.
//  ИмяОбъекта - Строка - имя объекта метаданных.
//  ОписаниеРеквизитов - Структура - куда добавляются имена с синонимами.
//
Процедура ЗаполнитьИменаСвойствОбъекта(Релиз, ИмяКоллекцииКлюч, ИмяОбъекта, ОписаниеРеквизитов)
	
	Если ИмяКоллекцииКлюч = "перечисления" Или ИмяКоллекцииКлюч = "enums" Тогда
		ЗаполнитьИменаЗначенийПеречисления(Релиз, ИмяОбъекта, ОписаниеРеквизитов);
		Возврат;
	КонецЕсли;
	
	ВидыСвойств = ВидыСвойствКоллекции(ИмяКоллекцииКлюч);
	Если ВидыСвойств.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свойства.Наименование КАК Наименование,
	|	Свойства.Синоним КАК Синоним,
	|	Свойства.Вид КАК Вид
	|ИЗ
	|	Справочник.Свойства КАК Свойства
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Объекты
	|		ПО Свойства.Владелец = Объекты.Ссылка
	|ГДЕ
	|	Объекты.Владелец = &Релиз
	|	И Объекты.Имя = &Имя
	|	И Свойства.Родитель = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка)
	|	И Свойства.Вид В (&ВидыСвойств)";
	Запрос.УстановитьПараметр("Релиз", Релиз);
	Запрос.УстановитьПараметр("Имя", ИмяОбъекта);
	Запрос.УстановитьПараметр("ВидыСвойств", ВидыСвойств);
	
	ПрефиксТабличнойЧасти = Расш1_ТекстПодсказки("ТЧ");
	ВидТабличнаяЧасть = Перечисления.ВидыСвойств.ТабличнаяЧасть;
	ПустойВид = Перечисления.ВидыСвойств.ПустаяСсылка();
	Поля = Новый Структура("Наименование, Синоним, Вид", "", "", ПустойВид);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Поля, Выборка);
		Если ПустаяСтрока(Поля.Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		Синоним = Поля.Синоним;
		Если Поля.Вид = ВидТабличнаяЧасть Тогда
			Синоним = СтрШаблон("%1 %2", ПрефиксТабличнойЧасти, Синоним);
		КонецЕсли;
		Если ПустаяСтрока(Синоним) Тогда
			Синоним = Поля.Наименование;
		КонецЕсли;
		
		ОписаниеСвойства = Новый Структура("name", Синоним);
		ОписаниеРеквизитов.Вставить(Поля.Наименование, ОписаниеСвойства);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИменаЗначенийПеречисления(Релиз, ИмяОбъекта, ОписаниеРеквизитов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияОбъектов.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Значения КАК ЗначенияОбъектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Объекты КАК Объекты
	|		ПО ЗначенияОбъектов.Владелец = Объекты.Ссылка
	|ГДЕ
	|	Объекты.Владелец = &Релиз
	|	И Объекты.Имя = &Имя";
	Запрос.УстановитьПараметр("Релиз", Релиз);
	Запрос.УстановитьПараметр("Имя", ИмяОбъекта);
	
	Поля = Новый Структура("Наименование", "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Поля, Выборка);
		Если ПустаяСтрока(Поля.Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеЗначения = Новый Структура("name", Поля.Наименование);
		ОписаниеРеквизитов.Вставить(Поля.Наименование, ОписаниеЗначения);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВидыСвойствКоллекции(ИмяКоллекцииКлюч)
	
	ВидыСвойств = Новый Массив; // Массив из ПеречислениеСсылка.ВидыСвойств
	
	Если Расш1_КоллекцииМетаданныхПовтИсп.ОбъектМетаданныхИмеетТЧ(ИмяКоллекцииКлюч) Тогда
		ВидыСвойств.Добавить(Перечисления.ВидыСвойств.Реквизит);
		ВидыСвойств.Добавить(Перечисления.ВидыСвойств.ТабличнаяЧасть);
		Возврат ВидыСвойств;
	КонецЕсли;
	
	Если Расш1_КоллекцииМетаданныхПовтИсп.ОбъектМетаданныхИмеетИзмерения(ИмяКоллекцииКлюч) Тогда
		ВидыСвойств.Добавить(Перечисления.ВидыСвойств.Измерение);
		ВидыСвойств.Добавить(Перечисления.ВидыСвойств.Ресурс);
		ВидыСвойств.Добавить(Перечисления.ВидыСвойств.Реквизит);
	КонецЕсли;
	
	Возврат ВидыСвойств;
	
КонецФункции

// Точное имя объекта коллекции по запросу консоли (без учета регистра).
// Имя берётся из кэша дерева справочника Объекты.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы
//  ИмяКоллекцииКлюч - Строка
//  ИмяИзКонсоли - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяОбъектаКоллекцииПоЗапросуКонсоли(Релиз, ИмяКоллекцииКлюч, ИмяИзКонсоли)
	
	ИмяЗапроса = СокрЛП(ИмяИзКонсоли);
	Если ПустаяСтрока(ИмяЗапроса) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяВРег = ВРег(ИмяЗапроса);
	ОписаниеКоллекции = Расш1_КоллекцииМетаданныхПовтИсп.ОписаниеКоллекцииМетаданных(Релиз, ИмяКоллекцииКлюч);
	Для Каждого КлючИЗначение Из ОписаниеКоллекции Цикл
		Если ВРег(КлючИЗначение.Ключ) = ИмяВРег Тогда
			Возврат КлючИЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Свойства объекта формата и связанных с ним объектов по версиям формата конвертации.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//  ИмяОбъекта - Строка - имя объекта формата.
//
// Возвращаемое значение:
//  см. Расш1_СвойстваБезДублейВерсий
//
Функция Расш1_СвойстваФорматаОбъекта(Конвертация, ИмяОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("КлючевыеСвойства", Перечисления.ТипыОбщихРеквизитов.КлючевыеСвойства);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЧВерсииФормата.ВерсияФормата КАК ВерсияФормата
	|ПОМЕСТИТЬ ВерсииФормата
	|ИЗ
	|	Справочник.Конвертации.ВерсииФормата КАК ТЧВерсииФормата
	|ГДЕ
	|	ТЧВерсииФормата.Ссылка = &Конвертация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Взаимосвязи.Расширение КАК ВерсияФормата
	|ПОМЕСТИТЬ ВерсииИзРасширений
	|ИЗ
	|	РегистрСведений.ВзаимосвязиВерсийФорматовИРасширений КАК Взаимосвязи
	|ГДЕ
	|	Взаимосвязи.ВерсияФорматаОбмена В
	|			(ВЫБРАТЬ
	|				ВерсииФормата.ВерсияФормата КАК ВерсияФормата
	|			ИЗ
	|				ВерсииФормата КАК ВерсииФормата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВерсииФормата.ВерсияФормата КАК ВерсияФормата
	|ПОМЕСТИТЬ ДопустимыеВерсии
	|ИЗ
	|	ВерсииФормата КАК ВерсииФормата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВерсииИзРасширений.ВерсияФормата КАК ВерсияФормата
	|ИЗ
	|	ВерсииИзРасширений КАК ВерсииИзРасширений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(СвойстваФормата.ОбъектХранительСвойств КАК СТРОКА(1000)) КАК Имя
	|ПОМЕСТИТЬ ИменаСвязанныхОбъектов
	|ИЗ
	|	Справочник.СвойстваФормата КАК СвойстваФормата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФормата КАК ОбъектыФормата
	|		ПО СвойстваФормата.Владелец = ОбъектыФормата.Ссылка
	|ГДЕ
	|	ОбъектыФормата.Наименование = &ИмяОбъекта
	|	И НЕ ОбъектыФормата.ПометкаУдаления
	|	И НЕ СвойстваФормата.ПометкаУдаления
	|	И СвойстваФормата.ЭтоГруппа
	|	И СвойстваФормата.ОбъектХранительСвойств <> """"
	|	И ОбъектыФормата.Владелец В
	|			(ВЫБРАТЬ
	|				ДопустимыеВерсии.ВерсияФормата КАК ВерсияФормата
	|			ИЗ
	|				ДопустимыеВерсии КАК ДопустимыеВерсии)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(СвойстваФормата.Тип КАК СТРОКА(1000)) КАК Имя
	|ИЗ
	|	Справочник.СвойстваФормата КАК СвойстваФормата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФормата КАК ОбъектыФормата
	|		ПО СвойстваФормата.Владелец = ОбъектыФормата.Ссылка
	|ГДЕ
	|	ОбъектыФормата.Наименование = &ИмяОбъекта
	|	И НЕ ОбъектыФормата.ПометкаУдаления
	|	И НЕ СвойстваФормата.ПометкаУдаления
	|	И СвойстваФормата.ЭтоГруппа
	|	И СвойстваФормата.ТипОбщегоСвойства = &КлючевыеСвойства
	|	И ВЫРАЗИТЬ(СвойстваФормата.Тип КАК СТРОКА(1000)) <> """"
	|	И ОбъектыФормата.Владелец В
	|			(ВЫБРАТЬ
	|				ДопустимыеВерсии.ВерсияФормата КАК ВерсияФормата
	|			ИЗ
	|				ДопустимыеВерсии КАК ДопустимыеВерсии)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ИмяОбъекта КАК Имя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбъектыФормата.Наименование КАК ИмяОбъекта,
	|	СвойстваФормата.Наименование КАК ИмяСвойства,
	|	ЕСТЬNULL(РодителиСвойств.Наименование, """") КАК ИмяРодителя,
	|	СвойстваФормата.ЭтоГруппа КАК ЭтоГруппа,
	|	СвойстваФормата.ТипОбщегоСвойства КАК ТипОбщегоСвойства,
	|	СвойстваФормата.ОбъектХранительСвойств КАК ОбъектХранительСвойств,
	|	ВЫРАЗИТЬ(СвойстваФормата.Тип КАК СТРОКА(1000)) КАК Тип,
	|	ЕСТЬNULL(СвойстваФормата.Порядок, 0) КАК Порядок,
	|	ВЫБОР
	|		КОГДА ОбъектыФормата.Владелец В
	|				(ВЫБРАТЬ
	|					ВерсииИзРасширений.ВерсияФормата КАК ВерсияФормата
	|				ИЗ
	|					ВерсииИзРасширений КАК ВерсииИзРасширений)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Расширение
	|ИЗ
	|	Справочник.ОбъектыФормата КАК ОбъектыФормата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СвойстваФормата КАК СвойстваФормата
	|		ПО СвойстваФормата.Владелец = ОбъектыФормата.Ссылка
	|			И НЕ СвойстваФормата.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СвойстваФормата КАК РодителиСвойств
	|		ПО СвойстваФормата.Родитель = РодителиСвойств.Ссылка
	|ГДЕ
	|	НЕ ОбъектыФормата.ПометкаУдаления
	|	И ОбъектыФормата.Владелец В
	|			(ВЫБРАТЬ
	|				ДопустимыеВерсии.ВерсияФормата КАК ВерсияФормата
	|			ИЗ
	|				ДопустимыеВерсии КАК ДопустимыеВерсии)
	|	И ОбъектыФормата.Наименование В
	|			(ВЫБРАТЬ
	|				ИменаСвязанныхОбъектов.Имя КАК Имя
	|			ИЗ
	|				ИменаСвязанныхОбъектов КАК ИменаСвязанныхОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	ИмяСвойства";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Возврат Расш1_СвойстваБезДублейВерсий(Таблица);
	
КонецФункции

// Параметры:
//  Таблица - ТаблицаЗначений - свойства формата из запроса:
//   * ИмяОбъекта - Строка
//   * ИмяСвойства - Строка
//   * ИмяРодителя - Строка
//   * ЭтоГруппа - Булево
//   * ТипОбщегоСвойства - ПеречислениеСсылка.ТипыОбщихРеквизитов
//   * ОбъектХранительСвойств - Строка
//   * Тип - Строка
//   * Порядок - Число
//   * Расширение - Булево
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений - строки таблицы без дублей версий:
//   * ИмяОбъекта - Строка
//   * ИмяСвойства - Строка
//   * ИмяРодителя - Строка
//   * ЭтоГруппа - Булево
//   * ТипОбщегоСвойства - ПеречислениеСсылка.ТипыОбщихРеквизитов
//   * ОбъектХранительСвойств - Строка
//   * Тип - Строка
//   * Порядок - Число
//   * Расширение - Булево
//
Функция Расш1_СвойстваБезДублейВерсий(Таблица)
	
	Оставленные = Новый Массив; // Массив из СтрокаТаблицыЗначений
	ОставленныеИзРасширения = Новый Массив; // Массив из Булево
	Индекс = Новый Соответствие;
	Для Каждого СтрокаСвойства Из Таблица Цикл
		ИмяОбъекта = СокрЛП(СтрокаСвойства.ИмяОбъекта);
		ИмяРодителя = СокрЛП(СтрокаСвойства.ИмяРодителя);
		ИмяСвойства = СокрЛП(СтрокаСвойства.ИмяСвойства);
		ПризнакГруппы = XMLСтрока(СтрокаСвойства.ЭтоГруппа);
		Ключ = СтрШаблон("%1|%2|%3|%4", ИмяОбъекта, ИмяРодителя, ИмяСвойства, ПризнакГруппы);
		Ключ = НРег(Ключ);
		Номер = Индекс.Получить(Ключ);
		Если Номер = Неопределено Тогда
			Индекс.Вставить(Ключ, Оставленные.Количество());
			Оставленные.Добавить(СтрокаСвойства);
			ОставленныеИзРасширения.Добавить(СтрокаСвойства.Расширение);
			Продолжить;
		КонецЕсли;
		// Дубль из расширения заменяет строку основного формата, прочие дубли отбрасываются.
		Если СтрокаСвойства.Расширение И Не ОставленныеИзРасширения[Номер] Тогда
			Оставленные[Номер] = СтрокаСвойства;
			ОставленныеИзРасширения[Номер] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Оставленные;
	
КонецФункции

// Параметры:
//  Строки - см. Расш1_СвойстваБезДублейВерсий
//  ИмяОбъекта - Строка - имя объекта формата.
//  ИмяРодителя - Строка - имя группы свойств, пустая строка для корня.
//  Посещенные - Соответствие из КлючИЗначение:
//   * Ключ - Строка - ключ узла.
//   * Значение - Булево - признак обхода.
//  КодЯзыка - Строка - код языка подсказок.
//
// Возвращаемое значение:
//  Структура - описания свойств узла по именам.
//
Функция Расш1_СвойстваУзлаФормата(Строки, ИмяОбъекта, ИмяРодителя, Посещенные, КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	КлючУзла = СтрШаблон("%1|%2", НРег(ИмяОбъекта), НРег(ИмяРодителя));
	Если Посещенные.Получить(КлючУзла) <> Неопределено Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Посещенные.Вставить(КлючУзла, Истина);
	
	Свойства = Новый Структура;
	ИмяОбъектаНижнее = НРег(ИмяОбъекта);
	ИмяРодителяНижнее = НРег(ИмяРодителя);
	
	Для Каждого СтрокаСвойства Из Строки Цикл
		
		Если НРег(СокрЛП(СтрокаСвойства.ИмяОбъекта)) <> ИмяОбъектаНижнее Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(СокрЛП(СтрокаСвойства.ИмяРодителя)) <> ИмяРодителяНижнее Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = СокрЛП(СтрокаСвойства.ИмяСвойства);
		Если Не Расш1_ИмяДопустимоДляСтруктуры(Имя) Или Расш1_СтруктураСодержитКлюч(Свойства, Имя) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаСвойства.ЭтоГруппа Тогда
			Узел = Расш1_ОписаниеГруппыФормата(Строки, ИмяОбъекта, СтрокаСвойства, Посещенные, КодЯзыка);
		Иначе
			ТипСвойства = СокрЛП(СтрокаСвойства.Тип);
			Узел = Расш1_ОписаниеЛистаФормата(Имя, ТипСвойства, КодЯзыка);
		КонецЕсли;
		Свойства.Вставить(Имя, Узел);
		
	КонецЦикла;
	
	Посещенные.Удалить(КлючУзла);
	Возврат Свойства;
	
КонецФункции

// Параметры:
//  Строки - см. Расш1_СвойстваБезДублейВерсий
//  ИмяОбъекта - Строка - имя объекта формата.
//  СтрокаСвойства - СтрокаТаблицыЗначений - свойство-группа:
//   * ИмяСвойства - Строка
//   * ОбъектХранительСвойств - Строка
//   * Тип - Строка
//   * ТипОбщегоСвойства - ПеречислениеСсылка.ТипыОбщихРеквизитов
//  Посещенные - см. Расш1_СвойстваУзлаФормата.Посещенные
//  КодЯзыка - Строка - код языка подсказок.
//
// Возвращаемое значение:
//  см. Расш1_ОписаниеУзлаФормата
//
Функция Расш1_ОписаниеГруппыФормата(Строки, ИмяОбъекта, СтрокаСвойства, Посещенные, КодЯзыка)
	
	Имя = СокрЛП(СтрокаСвойства.ИмяСвойства);
	Вложенные = Расш1_СвойстваУзлаФормата(Строки, ИмяОбъекта, Имя, Посещенные, КодЯзыка);
	Хранитель = СокрЛП(СтрокаСвойства.ОбъектХранительСвойств);
	Если Вложенные.Количество() = 0 И Не ПустаяСтрока(Хранитель) Тогда
		Вложенные = Расш1_СвойстваУзлаФормата(Строки, Хранитель, "", Посещенные, КодЯзыка);
	КонецЕсли;
	ТипГруппы = СокрЛП(СтрокаСвойства.Тип);
	ЭтоКлючевыеСвойства = СтрокаСвойства.ТипОбщегоСвойства = Перечисления.ТипыОбщихРеквизитов.КлючевыеСвойства;
	Если Вложенные.Количество() = 0 И ЭтоКлючевыеСвойства И Не ПустаяСтрока(ТипГруппы) Тогда
		Вложенные = Расш1_СвойстваУзлаФормата(Строки, ТипГруппы, "", Посещенные, КодЯзыка);
	КонецЕсли;
	ЭтоТабличнаяЧасть = Расш1_ГруппаФорматаТабличнаяЧасть(СтрокаСвойства);
	Узел = Расш1_ОписаниеУзлаФормата(Имя, ЭтоТабличнаяЧасть, Вложенные, КодЯзыка);
	Возврат Узел;
	
КонецФункции

// Параметры:
//  Правила - Массив из Структура - тексты обработчиков ПКО:
//   * ОбъектФормата - Строка
//   * Текст - Строка
//  КодНижний - Строка - имя алгоритма в нижнем регистре.
//  Найденные - Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя объекта формата в нижнем регистре.
//   * Значение - Строка - имя объекта формата.
//
Процедура Расш1_ДобавитьОбъектыПравилСВызовом(Правила, КодНижний, Найденные)
	
	Для Каждого ТекстВызова Из Правила Цикл
		Если Не Расш1_ТекстСодержитВызов(ТекстВызова.Текст, КодНижний) Тогда
			Продолжить;
		КонецЕсли;
		ИмяОбъекта = СокрЛП(ТекстВызова.ОбъектФормата);
		КлючИмени = НРег(ИмяОбъекта);
		Если Не ПустаяСтрока(КлючИмени) И Найденные.Получить(КлючИмени) = Неопределено Тогда
			Найденные.Вставить(КлючИмени, ИмяОбъекта);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  Алгоритмы - Массив из Структура - тексты алгоритмов:
//   * Код - Строка
//   * Текст - Строка
//  КодНижний - Строка - имя алгоритма в нижнем регистре.
//  Обработанные - Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя алгоритма в нижнем регистре.
//   * Значение - Булево - признак обработки.
//  Искомые - Массив из Строка - очередь имен алгоритмов для поиска.
//
Процедура Расш1_ДобавитьАлгоритмыСВызовом(Алгоритмы, КодНижний, Обработанные, Искомые)
	
	Для Каждого ТекстВызова Из Алгоритмы Цикл
		КодСтроки = СокрЛП(ТекстВызова.Код);
		КодСтроки = НРег(КодСтроки);
		Если КодСтроки = КодНижний Или ПустаяСтрока(КодСтроки) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(КодСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Расш1_ТекстСодержитВызов(ТекстВызова.Текст, КодНижний) Тогда
			Искомые.Добавить(КодСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  СтрокаСвойства - СтрокаТаблицыЗначений - свойство-группа:
//   * ТипОбщегоСвойства - ПеречислениеСсылка.ТипыОбщихРеквизитов
//
// Возвращаемое значение:
//  Булево - Истина, если группа описывает табличную часть.
//
Функция Расш1_ГруппаФорматаТабличнаяЧасть(СтрокаСвойства)
	
	Возврат Не ЗначениеЗаполнено(СтрокаСвойства.ТипОбщегоСвойства)
		Или СтрокаСвойства.ТипОбщегоСвойства = Перечисления.ТипыОбщихРеквизитов.ОбщаяТабличнаяЧасть;
	
КонецФункции

// Параметры:
//  Имя - Строка - имя свойства-группы.
//  ЭтоТабличнаяЧасть - Булево - группа описывает табличную часть.
//  Свойства - Структура - вложенные свойства узла.
//  КодЯзыка - Строка - код языка подсказок.
//
// Возвращаемое значение:
//  Структура - описание узла для подсказок:
//   * name - Строка - подпись типа.
//   * ref - Строка - класс консоли.
//   * description - Строка - имя свойства.
//   * properties - Структура - вложенные свойства.
//
Функция Расш1_ОписаниеУзлаФормата(Имя, ЭтоТабличнаяЧасть, Свойства, КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	Узел = Новый Структура;
	Если ЭтоТабличнаяЧасть Тогда
		Подпись = Расш1_ТекстПодсказки("ТабличнаяЧасть", КодЯзыка);
		Узел.Вставить("name", Подпись);
		Узел.Вставить("ref", "classes.Массив");
		Узел.Вставить("description", Имя);
	Иначе
		Подпись = Расш1_ПодписьТипа("Структура", КодЯзыка);
		Узел.Вставить("name", Подпись);
		Узел.Вставить("ref", "classes.Структура");
		Узел.Вставить("description", Имя);
	КонецЕсли;
	Узел.Вставить("properties", Свойства);
	
	Возврат Узел;
	
КонецФункции

Функция Расш1_ОписаниеЛистаФормата(Имя, Тип, КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	Лист = Новый Структура;
	ПодписьТипа = Расш1_ПодписьТипа(СокрЛП(Тип), КодЯзыка);
	Если ПустаяСтрока(ПодписьТипа) Тогда
		Лист.Вставить("name", Имя);
	Иначе
		Лист.Вставить("name", ПодписьТипа);
		Лист.Вставить("description", Имя);
	КонецЕсли;
	
	Возврат Лист;
	
КонецФункции

Функция Расш1_ИмяДопустимоДляСтруктуры(Имя)
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Ключ структуры: первый символ - буква или "_", остальные - буквы, цифры или "_".
	Длина = СтрДлина(Имя);
	Для Индекс = 1 По Длина Цикл
		Символ = Сред(Имя, Индекс, 1);
		ЭтоБуква = ВРег(Символ) <> НРег(Символ);
		ЭтоЦифра = СтрНайти("0123456789", Символ) > 0;
		Если Символ = "_" Или ЭтоБуква Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоЦифра И Индекс > 1 Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция Расш1_СтруктураСодержитКлюч(Свойства, Имя)
	
	Для Каждого КлючИЗначение Из Свойства Цикл
		Если КлючИЗначение.Ключ = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Тексты обработчиков ПКО и алгоритмов конвертации для поиска вызовов.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
// Возвращаемое значение:
//  Структура:
//   * Правила - Массив из Структура:
//    ** ОбъектФормата - Строка
//    ** Текст - Строка
//   * Алгоритмы - Массив из Структура:
//    ** Код - Строка
//    ** Текст - Строка
//
Функция Расш1_ТекстыВызововАлгоритмов(Конвертация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.ОбъектФормата КАК ОбъектФормата,
	|	ПКО.АлгоритмПриОтправкеДанных КАК АлгоритмПриОтправкеДанных,
	|	ПКО.АлгоритмПередПолучениемДанных КАК АлгоритмПередПолучениемДанных,
	|	ПКО.АлгоритмПриПолученииДанных КАК АлгоритмПриПолученииДанных,
	|	ПКО.АлгоритмПослеЗагрузкиВсехДанных КАК АлгоритмПослеЗагрузкиВсехДанных
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК Состав
	|		ПО Состав.ЭлементКонвертации = ПКО.Ссылка
	|ГДЕ
	|	Состав.Владелец = &Конвертация
	|	И НЕ Состав.Отключить
	|	И НЕ Состав.ПометкаУдаления
	|	И НЕ ПКО.ПометкаУдаления
	|	И ПКО.ОбъектФормата <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Алгоритмы.Код КАК Код,
	|	Алгоритмы.Алгоритм КАК Алгоритм
	|ИЗ
	|	Справочник.Алгоритмы КАК Алгоритмы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК Состав
	|		ПО Состав.ЭлементКонвертации = Алгоритмы.Ссылка
	|ГДЕ
	|	Состав.Владелец = &Конвертация
	|	И НЕ Состав.Отключить
	|	И НЕ Состав.ПометкаУдаления
	|	И НЕ Алгоритмы.ПометкаУдаления";
	
	Результаты = Запрос.ВыполнитьПакет();
	Правила = Новый Массив; // Массив из Структура
	ПоляПравила = Новый Структура;
	ПоляПравила.Вставить("ОбъектФормата", "");
	ПоляПравила.Вставить("АлгоритмПриОтправкеДанных", "");
	ПоляПравила.Вставить("АлгоритмПередПолучениемДанных", "");
	ПоляПравила.Вставить("АлгоритмПриПолученииДанных", "");
	ПоляПравила.Вставить("АлгоритмПослеЗагрузкиВсехДанных", "");
	ВыборкаПравил = Результаты[0].Выбрать();
	Пока ВыборкаПравил.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПоляПравила, ВыборкаПравил);
		ОбъектФормата = ПоляПравила.ОбъектФормата;
		Расш1_ДобавитьТекстВызова(Правила, ОбъектФормата, ПоляПравила.АлгоритмПриОтправкеДанных);
		Расш1_ДобавитьТекстВызова(Правила, ОбъектФормата, ПоляПравила.АлгоритмПередПолучениемДанных);
		Расш1_ДобавитьТекстВызова(Правила, ОбъектФормата, ПоляПравила.АлгоритмПриПолученииДанных);
		Расш1_ДобавитьТекстВызова(Правила, ОбъектФормата, ПоляПравила.АлгоритмПослеЗагрузкиВсехДанных);
	КонецЦикла;
	
	Алгоритмы = Новый Массив; // Массив из Структура
	ПоляАлгоритма = Новый Структура("Код, Алгоритм", "", "");
	ВыборкаАлгоритмов = Результаты[1].Выбрать();
	Пока ВыборкаАлгоритмов.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПоляАлгоритма, ВыборкаАлгоритмов);
		ТекстВызова = Новый Структура;
		ТекстВызова.Вставить("Код", ПоляАлгоритма.Код);
		ТекстВызова.Вставить("Текст", ПоляАлгоритма.Алгоритм);
		Алгоритмы.Добавить(ТекстВызова);
	КонецЦикла;
	
	Тексты = Новый Структура;
	Тексты.Вставить("Правила", Правила);
	Тексты.Вставить("Алгоритмы", Алгоритмы);
	
	Возврат Тексты;
	
КонецФункции

// Параметры:
//  Правила - Массив из Структура - тексты обработчиков ПКО.
//  ОбъектФормата - Строка - объект формата ПКО.
//  Текст - Строка - текст обработчика.
//
Процедура Расш1_ДобавитьТекстВызова(Правила, ОбъектФормата, Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВызова = Новый Структура;
	ТекстВызова.Вставить("ОбъектФормата", ОбъектФормата);
	ТекстВызова.Вставить("Текст", Текст);
	Правила.Добавить(ТекстВызова);
	
КонецПроцедуры

// Параметры:
//  Текст - Строка - текст обработчика или алгоритма.
//  ИмяНижнийРегистр - Строка - имя вызываемого алгоритма в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если в тексте есть вызов алгоритма.
//
Функция Расш1_ТекстСодержитВызов(Текст, ИмяНижнийРегистр)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстНижний = НРег(Текст);
	ИмяВызова = СтрШаблон("%1(", ИмяНижнийРегистр);
	ДлинаИмени = СтрДлина(ИмяНижнийРегистр);
	Позиция = СтрНайти(ТекстНижний, ИмяВызова);
	
	Пока Позиция > 0 Цикл
		Если Позиция = 1 Тогда
			Возврат Истина;
		КонецЕсли;
		ПредыдущийСимвол = Сред(ТекстНижний, Позиция - 1, 1);
		Если Не Расш1_ЭтоСимволИдентификатора(ПредыдущийСимвол) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(ТекстНижний, ИмяВызова, , Позиция + ДлинаИмени);
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция Расш1_ЭтоСимволИдентификатора(Символ)
	
	Если Расш1_ЭтоБукваИдентификатора(Символ) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Не ПустаяСтрока(Символ) И СтрНайти("0123456789", Символ) > 0;
	
КонецФункции

Функция Расш1_СобратьКонтекстОбработчика(Конвертация)
	
	Функции = Новый Структура;
	Сигнатуры = Новый Структура;
	СвойстваАлгоритмов = Новый Структура;
	СвойстваЗапросов = Новый Структура;
	КодЯзыка = Расш1_КодЯзыкаПодсказок();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.Текст = Расш1_ТекстЗапросаКонтекста();
	Результаты = Запрос.ВыполнитьПакет();
	
	Выборка = Результаты[0].Выбрать();
	Расш1_ДобавитьАлгоритмыКонтекста(Выборка, Функции, Сигнатуры, СвойстваАлгоритмов, КодЯзыка);
	
	Выборка = Результаты[1].Выбрать();
	Расш1_ДобавитьЗапросыКонтекста(Выборка, Функции, Сигнатуры, СвойстваЗапросов, КодЯзыка);
	
	ОберткаФункций = Новый Структура;
	ОберткаФункций.Вставить("customFunctions", Функции);
	
	ФункцииJSON = ПолучитьОписаниеМетаданныхJSON(ОберткаФункций);
	СигнатурыJSON = ПолучитьОписаниеМетаданныхJSON(Сигнатуры);
	ОбъектАлгоритмов = Расш1_ОбъектКоллекцииКонтекста("Алгоритмы", СвойстваАлгоритмов);
	ОбъектЗапросов = Расш1_ОбъектКоллекцииКонтекста("Запросы", СвойстваЗапросов);
	ОписаниеПараметров = ПолучитьОписаниеПараметрыКонвертации(Конвертация);
	
	Контекст = Новый Структура;
	Контекст.Вставить("ФункцииJSON", ФункцииJSON);
	Контекст.Вставить("СигнатурыJSON", СигнатурыJSON);
	Контекст.Вставить("СвойстваАлгоритмов", СвойстваАлгоритмов);
	Контекст.Вставить("СвойстваЗапросов", СвойстваЗапросов);
	Контекст.Вставить("ОбъектАлгоритмов", ОбъектАлгоритмов);
	Контекст.Вставить("ОбъектЗапросов", ОбъектЗапросов);
	Контекст.Вставить("ОписаниеПараметров", ОписаниеПараметров);
	
	Возврат Контекст;
	
КонецФункции

// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - алгоритмы конвертации.
//  Функции - Структура - описания функций для updateCustomFunctions.
//  Сигнатуры - Структура - сигнатуры для setCustomSignatures.
//  СвойстваАлгоритмов - Структура - свойства объекта Алгоритмы.
//  КодЯзыка - Строка - код языка подсказок.
//
Процедура Расш1_ДобавитьАлгоритмыКонтекста(Выборка, Функции, Сигнатуры, СвойстваАлгоритмов, КодЯзыка)
	
	Поля = Новый Структура("Код, Параметры, ЭтоФункция", "", "", Ложь);
	Поля.Вставить("Комментарий", "");
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Поля, Выборка);
		Имя = СокрЛП(Поля.Код);
		Если Не Расш1_ИмяДопустимоДляСтруктуры(Имя) Или Функции.Свойство(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Параметры = Расш1_ПараметрыАлгоритма(Поля.Параметры);
		Описание = СокрЛП(Поля.Комментарий);
		Если ПустаяСтрока(Описание) Тогда
			КлючПодсказки = ?(Поля.ЭтоФункция, "Функция", "Процедура");
			Описание = Расш1_ТекстПодсказки(КлючПодсказки, КодЯзыка);
		КонецЕсли;
		Расш1_ДобавитьФункциюКонтекста(
			Функции, Сигнатуры, СвойстваАлгоритмов, Имя, Описание, Параметры, "");
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - запросы конвертации.
//  Функции - Структура - описания функций для updateCustomFunctions.
//  Сигнатуры - Структура - сигнатуры для setCustomSignatures.
//  СвойстваЗапросов - Структура - свойства объекта Запросы.
//  КодЯзыка - Строка - код языка подсказок.
//
Процедура Расш1_ДобавитьЗапросыКонтекста(Выборка, Функции, Сигнатуры, СвойстваЗапросов, КодЯзыка)
	
	Поля = Новый Структура("Код, ТекстЗапроса, Комментарий", "", "", "");
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Поля, Выборка);
		Имя = СокрЛП(Поля.Код);
		Если Не Расш1_ИмяДопустимоДляСтруктуры(Имя) Или СвойстваЗапросов.Свойство(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Параметры = Расш1_ПараметрыЗапроса(Поля.ТекстЗапроса, КодЯзыка);
		Описание = СокрЛП(Поля.Комментарий);
		Если ПустаяСтрока(Описание) Тогда
			Описание = Расш1_ТекстПодсказки("Запрос", КодЯзыка);
		КонецЕсли;
		Если Функции.Свойство(Имя) Тогда
			Расш1_ДобавитьСвойствоКоллекции(
				СвойстваЗапросов, Имя, Описание, Параметры, "classes.Запрос");
		Иначе
			Расш1_ДобавитьФункциюКонтекста(
				Функции, Сигнатуры, СвойстваЗапросов, Имя, Описание, Параметры, "classes.Запрос");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция Расш1_ТекстЗапросаКонтекста()
	
	Возврат
	"ВЫБРАТЬ
	|	Алгоритмы.Код КАК Код,
	|	Алгоритмы.Параметры КАК Параметры,
	|	Алгоритмы.ЭтоФункция КАК ЭтоФункция,
	|	Алгоритмы.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.Алгоритмы КАК Алгоритмы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК Состав
	|		ПО Состав.ЭлементКонвертации = Алгоритмы.Ссылка
	|ГДЕ
	|	Состав.Владелец = &Конвертация
	|	И НЕ Состав.Отключить
	|	И НЕ Состав.ПометкаУдаления
	|	И НЕ Алгоритмы.ПометкаУдаления
	|	И НЕ Алгоритмы.Копия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код
	|;
	|
	|ВЫБРАТЬ
	|	Запросы.Код КАК Код,
	|	Запросы.ТекстЗапроса КАК ТекстЗапроса,
	|	Запросы.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.Запросы КАК Запросы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК Состав
	|		ПО Состав.ЭлементКонвертации = Запросы.Ссылка
	|ГДЕ
	|	Состав.Владелец = &Конвертация
	|	И НЕ Состав.Отключить
	|	И НЕ Состав.ПометкаУдаления
	|	И НЕ Запросы.ПометкаУдаления
	|	И НЕ Запросы.ЭтоГруппа
	|	И НЕ Запросы.Копия
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
КонецФункции

// Параметры:
//  Функции - Структура - описания функций для updateCustomFunctions.
//  Сигнатуры - Структура - сигнатуры для setCustomSignatures.
//  Свойства - Структура - свойства объекта коллекции контекста.
//  Имя - Строка - имя функции.
//  Описание - Строка - текст подсказки.
//  Параметры - см. Расш1_ПараметрыАлгоритма
//  СсылкаТипа - Строка - класс консоли для результата.
//
Процедура Расш1_ДобавитьФункциюКонтекста(
		Функции, Сигнатуры, Свойства, Имя, Описание, Параметры, СсылкаТипа)
	
	СтрокаПараметров = Расш1_СтрокаПараметров(Параметры);
	ПараметрыСигнатуры = Новый Структура;
	ПараметрыПодсказки = Новый Массив; // Массив из Структура
	Для Каждого Параметр Из Параметры Цикл
		ДокументацияПараметра = Параметр.Документация;
		Если Не ПараметрыСигнатуры.Свойство(Параметр.Имя) Тогда
			ПараметрыСигнатуры.Вставить(Параметр.Имя, ДокументацияПараметра);
		КонецЕсли;
		ОписаниеПараметра = Новый Структура;
		ОписаниеПараметра.Вставить("label", Параметр.Подпись);
		ОписаниеПараметра.Вставить("documentation", ДокументацияПараметра);
		ПараметрыПодсказки.Добавить(ОписаниеПараметра);
	КонецЦикла;
	
	Вариант = Новый Структура;
	Вариант.Вставить("СтрокаПараметров", СтрокаПараметров);
	Вариант.Вставить("Параметры", ПараметрыСигнатуры);
	СигнатураФункции = Новый Структура;
	СигнатураФункции.Вставить("default", Вариант);
	
	ФункцияКонтекста = Новый Структура;
	ФункцияКонтекста.Вставить("name", Имя);
	ФункцияКонтекста.Вставить("name_en", Имя);
	ФункцияКонтекста.Вставить("description", Описание);
	ФункцияКонтекста.Вставить("signature", СигнатураФункции);
	Если Не ПустаяСтрока(СсылкаТипа) Тогда
		ФункцияКонтекста.Вставить("ref", СсылкаТипа);
	КонецЕсли;
	Функции.Вставить(Имя, ФункцияКонтекста);
	
	ЭлементСигнатуры = Новый Структура;
	ЭлементСигнатуры.Вставить("label", СтрокаПараметров);
	ЭлементСигнатуры.Вставить("documentation", Описание);
	ЭлементСигнатуры.Вставить("parameters", ПараметрыПодсказки);
	Варианты = Новый Массив; // Массив из Структура
	Варианты.Добавить(ЭлементСигнатуры);
	Сигнатуры.Вставить(Имя, Варианты);
	
	Расш1_ДобавитьСвойствоКоллекции(Свойства, Имя, Описание, Параметры, СсылкаТипа);
	
КонецПроцедуры

// Параметры:
//  Свойства - Структура - свойства объекта коллекции контекста.
//  Имя - Строка - имя свойства.
//  Описание - Строка - текст подсказки.
//  Параметры - см. Расш1_ПараметрыАлгоритма
//  СсылкаТипа - Строка - класс консоли для значения.
//
Процедура Расш1_ДобавитьСвойствоКоллекции(Свойства, Имя, Описание, Параметры, СсылкаТипа)
	
	Если Свойства.Свойство(Имя) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеСвойства = Описание;
	Если Параметры.Количество() > 0 Тогда
		СтрокаПараметров = Расш1_СтрокаПараметров(Параметры);
		ОписаниеСвойства = СтрШаблон("%1 %2", Описание, СтрокаПараметров);
	КонецЕсли;
	
	Свойство = Новый Структура;
	Свойство.Вставить("name", Имя);
	Свойство.Вставить("description", ОписаниеСвойства);
	Если Не ПустаяСтрока(СсылкаТипа) Тогда
		Свойство.Вставить("ref", СсылкаТипа);
	КонецЕсли;
	Свойства.Вставить(Имя, Свойство);
	
КонецПроцедуры

Функция Расш1_ОбъектКоллекцииКонтекста(ИмяКоллекции, Свойства)
	
	ОбъектКоллекции = Новый Структура;
	ОбъектКоллекции.Вставить("name", ИмяКоллекции);
	ОбъектКоллекции.Вставить("properties", Свойства);
	
	Возврат ОбъектКоллекции;
	
КонецФункции

// Параметры:
//  Параметры - см. Расш1_ПараметрыАлгоритма
//
// Возвращаемое значение:
//  Строка - подписи параметров в скобках.
//
Функция Расш1_СтрокаПараметров(Параметры)
	
	Подписи = Новый Массив; // Массив из Строка
	Для Каждого Параметр Из Параметры Цикл
		Подписи.Добавить(Параметр.Подпись);
	КонецЦикла;
	
	ПереченьПодписей = СтрСоединить(Подписи, ", ");
	Возврат СтрШаблон("(%1)", ПереченьПодписей);
	
КонецФункции

// Параметры:
//  СтрокаПараметров - Строка - параметры алгоритма через запятую.
//
// Возвращаемое значение:
//  Массив из Структура - параметры для подсказок:
//   * Имя - Строка - имя параметра.
//   * Подпись - Строка - объявление параметра.
//   * Документация - Строка - описание параметра.
//
Функция Расш1_ПараметрыАлгоритма(СтрокаПараметров)
	
	Параметры = Новый Массив; // Массив из Структура
	ТекстПараметров = Строка(СтрокаПараметров);
	Части = СтрРазделить(ТекстПараметров, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Фрагмент = СокрЛП(Часть);
		Если ПустаяСтрока(Фрагмент) Тогда
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(Фрагмент, "=");
		Если Позиция = 0 Тогда
			Объявление = Фрагмент;
		Иначе
			Объявление = Лев(Фрагмент, Позиция - 1);
		КонецЕсли;
		Имя = Расш1_ИмяПараметраБезЗнач(Объявление);
		Если Не Расш1_ИмяДопустимоДляСтруктуры(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Параметр = Новый Структура("Имя, Подпись, Документация", Имя, Фрагмент, "");
		Параметры.Добавить(Параметр);
	КонецЦикла;
	
	Возврат Параметры;
	
КонецФункции

// Из объявления параметра вида "Знач Имя" или "Val Name" возвращает только имя без пробелов.
//
// Параметры:
//  Объявление - Строка - объявление параметра без значения по умолчанию.
//
// Возвращаемое значение:
//  Строка - имя параметра или пустая строка.
//
Функция Расш1_ИмяПараметраБезЗнач(Объявление)
	
	Разделители = СтрШаблон(" %1%2%3", Символы.Таб, Символы.ПС, Символы.ВК);
	Слова = СтрРазделить(Объявление, Разделители, Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ПервоеСлово = НРег(Слова[0]);
	ЭтоЗнач = ПервоеСлово = "знач" Или ПервоеСлово = "val";
	Если ЭтоЗнач И Слова.Количество() > 1 Тогда
		Слова.Удалить(0);
	КонецЕсли;
	
	Возврат СтрСоединить(Слова);
	
КонецФункции

// Параметры:
//  ТекстЗапроса - Строка - текст запроса конвертации.
//  КодЯзыка - Строка - код языка подсказок.
//
// Возвращаемое значение:
//  см. Расш1_ПараметрыАлгоритма
//
Функция Расш1_ПараметрыЗапроса(ТекстЗапроса, КодЯзыка = "")
	
	Параметры = Новый Массив; // Массив из Структура
	УжеЕсть = Новый Соответствие;
	Документация = Расш1_ТекстПодсказки("ПараметрЗапроса", КодЯзыка);
	Текст = Строка(ТекстЗапроса);
	Длина = СтрДлина(Текст);
	Индекс = 1;
	ВСтроке = Ложь;
	
	Пока Индекс <= Длина Цикл
		Символ = Сред(Текст, Индекс, 1);
		Следующий = Сред(Текст, Индекс + 1, 1);
		Если Символ = """" Тогда
			ВСтроке = Не ВСтроке;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = "/" И Следующий = "/" Тогда
			ПозицияКонца = СтрНайти(Текст, Символы.ПС, , Индекс);
			Если ПозицияКонца = 0 Тогда
				Прервать;
			КонецЕсли;
			Индекс = ПозицияКонца + 1;
			Продолжить;
		КонецЕсли;
		Если Символ = "&" И Следующий <> "&" Тогда
			Имя = Расш1_ПрочитатьИдентификатор(Текст, Индекс + 1);
			Расш1_ДобавитьПараметрЗапроса(Параметры, УжеЕсть, Имя, Документация);
			ДлинаИмени = СтрДлина(Имя);
			Индекс = Индекс + 1 + ДлинаИмени;
			Продолжить;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат Параметры;
	
КонецФункции

// Параметры:
//  Параметры - см. Расш1_ПараметрыАлгоритма
//  УжеЕсть - Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя параметра в нижнем регистре.
//   * Значение - Булево - признак добавления.
//  Имя - Строка - имя параметра запроса.
//  Документация - Строка - описание параметра.
//
Процедура Расш1_ДобавитьПараметрЗапроса(Параметры, УжеЕсть, Имя, Документация)
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;
	Ключ = НРег(Имя);
	Если УжеЕсть.Получить(Ключ) <> Неопределено Или Не Расш1_ИмяДопустимоДляСтруктуры(Имя) Тогда
		Возврат;
	КонецЕсли;
	УжеЕсть.Вставить(Ключ, Истина);
	Параметр = Новый Структура("Имя, Подпись, Документация", Имя, Имя, Документация);
	Параметры.Добавить(Параметр);
	
КонецПроцедуры

Функция Расш1_ПрочитатьИдентификатор(Текст, Начало)
	
	Если Начало > СтрДлина(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Первый = Сред(Текст, Начало, 1);
	Если Не Расш1_ЭтоБукваИдентификатора(Первый) Тогда
		Возврат "";
	КонецЕсли;
	
	Конец = Начало;
	Длина = СтрДлина(Текст);
	Пока Конец <= Длина Цикл
		Если Не Расш1_ЭтоСимволИдентификатора(Сред(Текст, Конец, 1)) Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	
	Возврат Сред(Текст, Начало, Конец - Начало);
	
КонецФункции

Функция Расш1_ЭтоБукваИдентификатора(Символ)
	
	Если ПустаяСтрока(Символ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЛатинскиеБуквы = "_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
	КириллическиеБуквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Возврат СтрНайти(ЛатинскиеБуквы, Символ) > 0
		Или СтрНайти(КириллическиеБуквы, Символ) > 0;
	
КонецФункции

// Параметры:
//  ОписаниеМетаданныхJSON - Строка - JSON customObjects страницы.
//  Контекст - Структура - контекст обработчика:
//   * СвойстваАлгоритмов - Структура - свойства объекта Алгоритмы.
//   * СвойстваЗапросов - Структура - свойства объекта Запросы.
//   * ОбъектАлгоритмов - Структура - описание объекта Алгоритмы.
//   * ОбъектЗапросов - Структура - описание объекта Запросы.
//   * ОписаниеПараметров - Структура - описание параметров конвертации.
//
// Возвращаемое значение:
//  Строка - дополненный JSON или исходный при ошибке.
//
Функция Расш1_ДополнитьОбъектыКонтекста(ОписаниеМетаданныхJSON, Контекст)
	
	Данные = Расш1_ПрочитатьJSONСоответствие(ОписаниеМетаданныхJSON);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ОписаниеМетаданныхJSON;
	КонецЕсли;
	
	ЗначениеОбъектов = Расш1_ЗначениеПоИмени(Данные, "customObjects");
	Если ТипЗнч(ЗначениеОбъектов) <> Тип("Соответствие") Тогда
		Возврат ОписаниеМетаданныхJSON;
	КонецЕсли;
	ПользовательскиеОбъекты = ЗначениеОбъектов; // Соответствие из КлючИЗначение
	
	Если Расш1_ЗначениеПоИмени(ПользовательскиеОбъекты, "Алгоритмы") = Неопределено
		И Контекст.СвойстваАлгоритмов.Количество() > 0 Тогда
		ПользовательскиеОбъекты.Вставить("Алгоритмы", Контекст.ОбъектАлгоритмов);
	КонецЕсли;
	Если Расш1_ЗначениеПоИмени(ПользовательскиеОбъекты, "Запросы") = Неопределено
		И Контекст.СвойстваЗапросов.Количество() > 0 Тогда
		ПользовательскиеОбъекты.Вставить("Запросы", Контекст.ОбъектЗапросов);
	КонецЕсли;
	
	Расш1_ПодставитьПараметрыВКомпоненты(ПользовательскиеОбъекты, Контекст.ОписаниеПараметров);
	
	Попытка
		Возврат ПолучитьОписаниеМетаданныхJSON(Данные);
	Исключение
		// Подсказки по метаданным релиза не должны теряться из-за ошибки в объектах контекста.
		Информация = ИнформацияОбОшибке();
		Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
		ИмяСобытия = Расш1_ИмяСобытияОписанияМетаданных();
		Расш1_ЖурналРегистрации.ДобавитьЗапись(ИмяСобытия, "Ошибка", Подробности);
		Возврат ОписаниеМетаданныхJSON;
	КонецПопытки;
	
КонецФункции

// Параметры:
//  ПользовательскиеОбъекты - Соответствие из КлючИЗначение - customObjects из JSON страницы.
//  ОписаниеПараметров - Структура - описание параметров конвертации для подсказок.
//
Процедура Расш1_ПодставитьПараметрыВКомпоненты(ПользовательскиеОбъекты, ОписаниеПараметров)
	
	ТипСтруктура = Тип("Структура");
	ТипСоответствие = Тип("Соответствие");
	ИмяСвойств = "properties";
	ИмяУзлаПараметров = "ПараметрыКонвертации";
	
	Если ТипЗнч(ОписаниеПараметров) <> ТипСтруктура Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеСвойств = Неопределено;
	Если Не ОписаниеПараметров.Свойство(ИмяСвойств, ЗначениеСвойств) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ЗначениеСвойств) <> ТипСтруктура Тогда
		Возврат;
	КонецЕсли;
	СвойстваПараметров = ЗначениеСвойств; // Структура
	Если СвойстваПараметров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Компоненты = Расш1_ЗначениеПоИмени(ПользовательскиеОбъекты, "КомпонентыОбмена");
	Свойства = Расш1_ЗначениеПоИмени(Компоненты, ИмяСвойств);
	ТипСвойств = ТипЗнч(Свойства);
	Если ТипСвойств <> ТипСоответствие И ТипСвойств <> ТипСтруктура Тогда
		Возврат;
	КонецЕсли;
	
	Узел = Расш1_ЗначениеПоИмени(Свойства, ИмяУзлаПараметров);
	СвойстваУзла = Расш1_ЗначениеПоИмени(Узел, ИмяСвойств);
	ТипСвойствУзла = ТипЗнч(СвойстваУзла);
	Если (ТипСвойствУзла = ТипСоответствие Или ТипСвойствУзла = ТипСтруктура)
		И СвойстваУзла.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОписаниеПараметров.Свойство("name") Тогда
		// Ключа name нет: он добавляется, а не заменяется.
		// @skip-check structure-key-modification
		ОписаниеПараметров.Вставить("name", ИмяУзлаПараметров);
	КонецЕсли;
	Расш1_ВставитьПоИмени(Свойства, ИмяУзлаПараметров, ОписаниеПараметров);
	
КонецПроцедуры

// Параметры:
//  ТекстJSON - Строка - JSON описания метаданных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение, Неопределено - прочитанный JSON или Неопределено при ошибке.
//
Функция Расш1_ПрочитатьJSONСоответствие(ТекстJSON)
	
	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина); // Соответствие из КлючИЗначение
		Чтение.Закрыть();
	Исключение
		Чтение.Закрыть();
		Информация = ИнформацияОбОшибке();
		Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
		ИмяСобытия = Расш1_ИмяСобытияОписанияМетаданных();
		Расш1_ЖурналРегистрации.ДобавитьЗапись(ИмяСобытия, "Ошибка", Подробности);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Данные;
	
КонецФункции

Функция Расш1_ИмяСобытияОписанияМетаданных()
	
	КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
	Возврат НСтр("ru = 'Conversion 3 Plus.Описание метаданных'", КодЯзыка);
	
КонецФункции

// Значение коллекции по имени без учета регистра.
//
// Параметры:
//  Коллекция - Структура, Произвольный, Соответствие из КлючИЗначение - узел JSON.
//  Имя - Строка - имя свойства.
//
// Возвращаемое значение:
//  Произвольный - значение свойства или Неопределено.
//
Функция Расш1_ЗначениеПоИмени(Коллекция, Имя)
	
	Если ТипЗнч(Коллекция) <> Тип("Соответствие") И ТипЗнч(Коллекция) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяНижнее = НРег(Имя);
	Для Каждого КлючИЗначение Из Коллекция Цикл
		Если НРег(Строка(КлючИЗначение.Ключ)) = ИмяНижнее Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Вставить значение по имени без учета регистра, сохраняя существующий ключ.
//
// Параметры:
//  Коллекция - Структура, Произвольный, Соответствие из КлючИЗначение - узел JSON.
//  Имя - Строка - имя свойства.
//  Значение - Произвольный - значение свойства.
//
Процедура Расш1_ВставитьПоИмени(Коллекция, Имя, Значение)
	
	Если ТипЗнч(Коллекция) <> Тип("Соответствие") И ТипЗнч(Коллекция) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяНижнее = НРег(Имя);
	Для Каждого КлючИЗначение Из Коллекция Цикл
		Если НРег(Строка(КлючИЗначение.Ключ)) = ИмяНижнее Тогда
			Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Коллекция.Вставить(Имя, Значение);
	
КонецПроцедуры

// Код языка подсказок редактора: ru или en.
//
// Возвращаемое значение:
//  Строка
//
Функция Расш1_КодЯзыкаПодсказок()
	
	Настройки = ХранилищеОбщихНастроек.Загрузить(
		Расш1_КонсольКодаКлиентСервер.КлючОбъектаНастроек(),
		Расш1_КонсольКодаКлиентСервер.КлючНастройкиРедактора());
	Настройки = Расш1_КонсольКодаКлиентСервер.ДополнитьНастройкиРедактора(Настройки);
	КодЯзыка = НРег(СокрЛП(Строка(Настройки.ЯзыкПодсказок)));
	Если КодЯзыка <> "en" Тогда
		КодЯзыка = "ru";
	КонецЕсли;
	
	Возврат КодЯзыка;
	
КонецФункции

// Строка подсказки на языке редактора.
// Русский текст в НСтр. Английский рядом: в конфигурации нет языка en, НСтр его не принимает.
//
// Параметры:
//  Ключ - Строка - ТЧ, ТабличнаяЧасть, Функция, Процедура, Запрос, ПараметрЗапроса.
//  КодЯзыка - Строка - ru или en. Пустая строка: прочитать настройку.
//
// Возвращаемое значение:
//  Строка
//
Функция Расш1_ТекстПодсказки(Ключ, КодЯзыка = "")
	
	Если ПустаяСтрока(КодЯзыка) Тогда
		КодЯзыка = Расш1_КодЯзыкаПодсказок();
	КонецЕсли;
	
	Если КодЯзыка = "en" Тогда
		Возврат Расш1_ТекстПодсказкиАнглийский(Ключ);
	КонецЕсли;
	
	Возврат Расш1_ТекстПодсказкиРусский(Ключ);
	
КонецФункции

Функция Расш1_ТекстПодсказкиАнглийский(Ключ)
	
	Если Ключ = "ТЧ" Тогда
		Возврат "TS:";
	ИначеЕсли Ключ = "ТабличнаяЧасть" Тогда
		Возврат "Tabular section";
	ИначеЕсли Ключ = "Функция" Тогда
		Возврат "Function";
	ИначеЕсли Ключ = "Процедура" Тогда
		Возврат "Procedure";
	ИначеЕсли Ключ = "Запрос" Тогда
		Возврат "Query";
	ИначеЕсли Ключ = "ПараметрЗапроса" Тогда
		Возврат "Query parameter";
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция Расш1_ТекстПодсказкиРусский(Ключ)
	
	Если Ключ = "ТЧ" Тогда
		Возврат НСтр("ru = 'ТЧ:'");
	ИначеЕсли Ключ = "ТабличнаяЧасть" Тогда
		Возврат НСтр("ru = 'Табличная часть'");
	ИначеЕсли Ключ = "Функция" Тогда
		Возврат НСтр("ru = 'Функция'");
	ИначеЕсли Ключ = "Процедура" Тогда
		Возврат НСтр("ru = 'Процедура'");
	ИначеЕсли Ключ = "Запрос" Тогда
		Возврат НСтр("ru = 'Запрос'");
	ИначеЕсли Ключ = "ПараметрЗапроса" Тогда
		Возврат НСтр("ru = 'Параметр запроса'");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Подпись типа в JSON подсказок. При en русское представление типа заменяется английским.
//
// Параметры:
//  ПредставлениеТипа - Строка
//  КодЯзыка - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция Расш1_ПодписьТипа(ПредставлениеТипа, КодЯзыка)
	
	Если КодЯзыка <> "en" Или ПустаяСтрока(ПредставлениеТипа) Тогда
		Возврат ПредставлениеТипа;
	КонецЕсли;
	
	Подписи = Новый Соответствие;
	Подписи.Вставить("Строка", "String");
	Подписи.Вставить("Число", "Number");
	Подписи.Вставить("Булево", "Boolean");
	Подписи.Вставить("Дата", "Date");
	Подписи.Вставить("Массив", "Array");
	Подписи.Вставить("Соответствие", "Map");
	Подписи.Вставить("Структура", "Structure");
	Подписи.Вставить("Таблица значений", "Value table");
	
	АнглийскаяПодпись = Подписи.Получить(ПредставлениеТипа);
	Если АнглийскаяПодпись = Неопределено Тогда
		Возврат ПредставлениеТипа;
	КонецЕсли;
	
	Возврат Строка(АнглийскаяПодпись);
	
КонецФункции

// Новый данные ИБ.
// 
// Возвращаемое значение:
//  Структура - Новый данные ИБ:
// * name - Строка 
// * ref - Строка
// 
Функция НовыйДанныеИБ()
	
	ДанныеИБ = Новый Структура;
	ДанныеИБ.Вставить("name", "");
	ДанныеИБ.Вставить("ref", "");
	Возврат ДанныеИБ;
	
КонецФункции

#КонецОбласти
