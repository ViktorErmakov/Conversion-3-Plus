#Область ПрограммныйИнтерфейс

// Показать алгоритм страницы в хосте: сброс предыдущего текста, загрузка нового, панель.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяСтраницы - Строка
//
Процедура ПоказатьАлгоритм(Форма, ИмяСтраницы) Экспорт
	
	Описание = Расш1_КонсольКодаКлиентСервер.НайтиОписаниеАлгоритма(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
		ИмяСтраницы);
	Если ПустаяСтрока(Описание.ИмяСтраницы) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ИмяТекущегоПути = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма();
	ИмяОткрытых = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц();
	ИмяСформирована = Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста);
	
	ХостСформирован = Форма[ИмяСформирована];
	ПредыдущийПуть = Форма[ИмяТекущегоПути];
	
	Если ХостСформирован И Не ПустаяСтрока(ПредыдущийПуть) Тогда
		ИмяПредыдущейСтраницы = ИмяСтраницыПоПути(
			Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
			ПредыдущийПуть);
		Если Расш1_КонсольКодаКлиентСервер.НужноЗаписатьТекстАлгоритма(
			ХостСформирован,
			Расш1_КонсольКодаКлиентСервер.ИмяЕстьВСписке(Форма[ИмяОткрытых], ИмяПредыдущейСтраницы)) Тогда
			УстановитьЗначениеПоПути(Форма, ПредыдущийПуть, Текст(Форма, ИмяХоста));
		КонецЕсли;
	КонецЕсли;
	
	Форма[ИмяТекущегоПути] = Описание.ПутьКДанным;
	НазначитьHTMLХосту(Форма);
	ПрименитьОпцииПанели(Форма, Описание);
	
	Если Не ХостСформирован Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьТекст(Форма, ИмяХоста, ЗначениеПоПути(Форма, Описание.ПутьКДанным));
	УстановитьТолькоПросмотр(Форма, ИмяХоста, Описание.ТолькоПросмотр);
	Форма[ИмяОткрытых] = Расш1_КонсольКодаКлиентСервер.ДобавитьИмяВСписок(Форма[ИмяОткрытых], ИмяСтраницы);
	
КонецПроцедуры

// Назначить полю хоста текст HTML-макета из кэша сеанса (лениво).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура НазначитьHTMLХосту(Форма) Экспорт
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Форма.Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(Форма[ИмяХоста]) Тогда
		Возврат;
	КонецЕсли;
	
	Форма[ИмяХоста] = Расш1_КонсольКодаКлиентПовтИсп.ТекстHTMLМакетаКонсоли();
	
КонецПроцедуры

// Назначить полю консоли текст HTML-макета (совместимость: хост).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаАлгоритма - Строка - не используется, сохранён для совместимости вызовов.
//
Процедура НазначитьРеквизитуКонсолиАдрес(Форма, ИмяЭлементаАлгоритма) Экспорт
	
	НазначитьHTMLХосту(Форма);
	
КонецПроцедуры

// Инициализировать редактор после формирования HTML-документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ПолеФормы - поле HTML консоли.
//
Процедура ИнициализироватьКонсоль(Форма, Элемент) Экспорт
	
	КонсольКода = ПредставлениеКонсоли(Форма, Элемент.Имя);
	ИнициализацияРедактора(КонсольКода, ТекстАлгоритма(Форма, Элемент.Имя));
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(Элемент.Имя)] = Истина;
	
	ИмяСтраницы = ИмяСтраницыПоПути(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()]);
	ИмяОткрытых = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц();
	Форма[ИмяОткрытых] = Расш1_КонсольКодаКлиентСервер.ДобавитьИмяВСписок(Форма[ИмяОткрытых], ИмяСтраницы);
	
	Описание = Расш1_КонсольКодаКлиентСервер.НайтиОписаниеАлгоритма(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
		ИмяСтраницы);
	Если Не ПустаяСтрока(Описание.ИмяСтраницы) Тогда
		УстановитьТолькоПросмотр(Форма, Элемент.Имя, Описание.ТолькоПросмотр);
		ПрименитьОпцииПанели(Форма, Описание);
	КонецЕсли;
	
КонецПроцедуры

// Обработать событие HTML-поля консоли (eventData1C).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДанныеСобытия - ФиксированнаяСтруктура
//  ЭлементФормы - ПолеФормы
//
Процедура ПриНажатии(Форма, ДанныеСобытия, ЭлементФормы) Экспорт
	
	ОбработатьСобытие(Форма, ДанныеСобытия, ЭлементФормы);
	
КонецПроцедуры

// Диспетчер событий bsl_console.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДанныеСобытия - ФиксированнаяСтруктура
//  ЭлементФормы - ПолеФормы
//
Процедура ОбработатьСобытие(Форма, ДанныеСобытия, ЭлементФормы) Экспорт
	
	Событие = ДанныеСобытия.Event.eventData1C;
	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = Событие.event;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияИзменениеСодержимого() Тогда
		Форма.Модифицированность = Истина;
	ИначеЕсли ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПолучениеМетаданных() Тогда
		ОбработкаСобытияПолученияМетаданных(Событие, ЭлементФормы, Форма["Конвертация"]);
	КонецЕсли;
	
КонецПроцедуры

// Выполнить команду панели консоли. Для команд направления возвращает Ложь.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Булево - Истина, если команда обработана фасадом.
//
Функция ВыполнитьКоманду(Форма, Команда) Экспорт
	
	ИмяКоманды = Команда.Имя;
	ПрефиксТемы = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыСменитьТему();
	ПрефиксЗамены = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыЗаменитьВхождения();
	
	Если СтрНачинаетсяС(ИмяКоманды, ПрефиксТемы) Тогда
		СменитьТему(Форма, Сред(ИмяКоманды, СтрДлина(ПрефиксТемы) + 1));
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(ИмяКоманды, ПрефиксЗамены) Тогда
		ЗаменитьВсеВхождения(Форма, Сред(ИмяКоманды, СтрДлина(ПрефиксЗамены) + 1));
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Признак команды направления обмена.
//
// Параметры:
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКомандаНаправления(Команда) Экспорт
	
	ИмяКоманды = Команда.Имя;
	Возврат СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка())
		Или СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение());
	
КонецФункции

// Текст редактора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция Текст(Форма, ИмяЭлементаHTML) Экспорт
	
	Возврат ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).getText();
	
КонецФункции

// Установить текст редактора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  НовыйТекст - Строка
//
Процедура УстановитьТекст(Форма, ИмяЭлементаHTML, НовыйТекст) Экспорт
	
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).updateText(НовыйТекст);
	
КонецПроцедуры

// Сменить тему консоли через API setTheme.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//
Процедура СменитьТему(Форма, ИмяЭлементаHTML) Экспорт
	
	ИмяПризнака = Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСветлаяТема(ИмяЭлементаHTML);
	СветлаяТема = Не Форма[ИмяПризнака];
	Форма[ИмяПризнака] = СветлаяТема;
	
	ИмяКнопки = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыСменитьТему() + ИмяЭлементаHTML;
	Если СветлаяТема Тогда
		Тема = "bsl-white";
		Форма.Элементы[ИмяКнопки].Заголовок = "Темная";
		Форма.Элементы[ИмяКнопки].ЦветФона = WebЦвета.Черный;
		Форма.Элементы[ИмяКнопки].ЦветТекста = WebЦвета.Белый;
	Иначе
		Тема = "bsl-dark";
		Форма.Элементы[ИмяКнопки].Заголовок = "Светлая";
		Форма.Элементы[ИмяКнопки].ЦветФона = Новый Цвет();
		Форма.Элементы[ИмяКнопки].ЦветТекста = Новый Цвет();
	КонецЕсли;
	
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).setTheme(Тема);
	
КонецПроцедуры

// Заменить все вхождения выделенного слова.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//
Процедура ЗаменитьВсеВхождения(Форма, ИмяЭлементаHTML) Экспорт
	
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).editor.trigger("", "editor.action.changeAll");
	
КонецПроцедуры

// Обновить метаданные консоли. Подсказки по EVENT_GET_METADATA не открывать.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  ОписаниеМетаданныхJSON - Строка
//
Процедура ОбновитьМетаданные(Форма, ИмяЭлементаHTML, ОписаниеМетаданныхJSON) Экспорт
	
	Если ПустаяСтрока(ИмяЭлементаHTML) Или ПустаяСтрока(Форма[ИмяЭлементаHTML]) Тогда
		Возврат;
	КонецЕсли;
	Если Не Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяЭлементаHTML)] Тогда
		Возврат;
	КонецЕсли;
	
	АдресОбновления = "";
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяЭлементаHTML);
	РезультатОбновления = КонсольКода.updateMetadata(ОписаниеМетаданныхJSON, АдресОбновления);
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления, Ложь);
	
КонецПроцедуры

// Включить или выключить режим только просмотра.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  ТолькоПросмотр - Булево
//
Процедура УстановитьТолькоПросмотр(Форма, ИмяЭлементаHTML, ТолькоПросмотр) Экспорт
	
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).setReadOnly(ТолькоПросмотр);
	
КонецПроцедуры

// Хост сформирован и получил текст HTML.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Булево
//
Функция ВсеКонсолиСформированы(Форма) Экспорт
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Форма.Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Форма[ИмяХоста]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста)];
	
КонецФункции

// Записать текст текущего редактора в текущий путь данных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ЗаписатьТекстыКонсолейВОбъект(Форма) Экспорт
	
	Если Не ВсеКонсолиСформированы(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ТекущийПуть = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()];
	ИмяСтраницы = ИмяСтраницыПоПути(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
		ТекущийПуть);
	
	Если Не Расш1_КонсольКодаКлиентСервер.НужноЗаписатьТекстАлгоритма(
		Истина,
		Расш1_КонсольКодаКлиентСервер.ИмяЕстьВСписке(
			Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц()],
			ИмяСтраницы)) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеПоПути(Форма, ТекущийПуть, Текст(Форма, ИмяХоста));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеКонсоли(Форма, ИмяЭлементаHTML)
	
	Возврат Форма.Элементы[ИмяЭлементаHTML].Документ.defaultView;
	
КонецФункции

Процедура ИнициализацияРедактора(КонсольКода, ТекстАлгоритма)
	
	Инфо = Новый СистемнаяИнформация();
	КонсольКода.init(Инфо.ВерсияПриложения);
	КонсольКода.eraseText();
	КонсольКода.setText(ТекстАлгоритма);
	КонсольКода.setOption("generateModificationEvent", Истина);
	КонсольКода.clearMetadata();
	
КонецПроцедуры

Функция ТекстАлгоритма(Форма, ИмяЭлементаHTML)
	
	ТекущийПуть = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()];
	Если Не ПустаяСтрока(ТекущийПуть) Тогда
		Возврат ЗначениеПоПути(Форма, ТекущийПуть);
	КонецЕсли;
	
	Возврат ЗначениеПоПути(Форма, ПутьАлгоритма(Форма, ИмяЭлементаHTML));
	
КонецФункции

Функция ПутьАлгоритма(Форма, ИмяЭлементаHTML)
	
	Карта = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКартыКонсолей()];
	Для Каждого Пара Из СтрРазделить(Карта, ";", Ложь) Цикл
		Части = СтрРазделить(Пара, "=");
		Если Части.Количество() = 2 И Части[0] = ИмяЭлементаHTML Тогда
			Возврат Части[1];
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ИмяСтраницыПоПути(Реестр, Путь)
	
	Для Каждого Описание Из Расш1_КонсольКодаКлиентСервер.РазобратьРеестр(Реестр) Цикл
		Если Описание.ПутьКДанным = Путь Тогда
			Возврат Описание.ИмяСтраницы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ЗначениеПоПути(Форма, Путь)
	
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Расш1_КонсольКодаКлиентСервер.ЧастиПутиДанных(Путь);
	Если Части.ЭтоРеквизитОбъекта Тогда
		Возврат Форма.Объект[Части.ИмяРеквизита];
	КонецЕсли;
	
	Возврат Форма[Части.ИмяРеквизита];
	
КонецФункции

Процедура УстановитьЗначениеПоПути(Форма, Путь, Значение)
	
	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	
	Части = Расш1_КонсольКодаКлиентСервер.ЧастиПутиДанных(Путь);
	Если Части.ЭтоРеквизитОбъекта Тогда
		Форма.Объект[Части.ИмяРеквизита] = Значение;
	Иначе
		Форма[Части.ИмяРеквизита] = Значение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьОпцииПанели(Форма, Описание)
	
	ИмяПанели = Расш1_КонсольКодаКлиентСервер.ИмяПанелиКомандХоста();
	ИмяГруппы = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
	Панель = Форма.Элементы.Найти(ИмяПанели);
	ГруппаНаправления = Форма.Элементы.Найти(ИмяГруппы);
	Если Панель = Неопределено Или ГруппаНаправления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Описание.СкрытьПанельКоманд Тогда
		Панель.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Панель.Видимость = Истина;
	ГруппаНаправления.Видимость = Описание.ПоказыватьНаправление;
	ГруппаНаправления.Доступность = ПустаяСтрока(Описание.АвтоНаправление);
	
	Если Не ПустаяСтрока(Описание.АвтоНаправление) Тогда
		УстановитьЗаголовокНаправления(Форма, Описание.АвтоНаправление);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗаголовокНаправления(Форма, Направление)
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ИмяКнопки = Направление + ИмяХоста;
	Кнопка = Форма.Элементы.Найти(ИмяКнопки);
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Кнопка.Родитель.Заголовок = Направление;
	Кнопка.Родитель.Картинка = Кнопка.Картинка;
	
КонецПроцедуры

Процедура ОбработкаСобытияПолученияМетаданных(Событие, ЭлементФормы, Конвертация)
	
	АдресОбновления = "";
	ПараметрыЗапроса = Событие.params;
	
	ОписаниеМетаданныхJSON = Расш1_КонсольКодаВызовСервера.ПолучитьОписаниеОбъектаМетаданныхJSON(
		ПараметрыЗапроса, АдресОбновления, Конвертация);
	
	Если Не ЗначениеЗаполнено(ОписаниеМетаданныхJSON) Тогда
		Возврат;
	КонецЕсли;
	
	КонсольКода = ЭлементФормы.Документ.defaultView;
	РезультатОбновления = КонсольКода.updateMetadata(ОписаниеМетаданныхJSON, АдресОбновления);
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления, Истина);
	
КонецПроцедуры

Процедура ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления, ОткрытьПодсказки)
	
	Если ТипЗнч(РезультатОбновления) = Тип("Булево") Тогда
		Если ОткрытьПодсказки Тогда
			КонсольКода.triggerSuggestions();
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОбновления.errorDescription);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
