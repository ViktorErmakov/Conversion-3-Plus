// @strict-types

#Область ПрограммныйИнтерфейс

// Показать алгоритм страницы в хосте: сохранить предыдущий текст, подставить новый, разрешить правку.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяСтраницы - Строка
//
Процедура ПоказатьАлгоритм(Форма, ИмяСтраницы) Экспорт
	
	Если Форма.Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Описание = Расш1_КонсольКодаКлиентСервер.НайтиОписаниеАлгоритма(
		Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()],
		ИмяСтраницы);
	Если ПустаяСтрока(Описание.ИмяСтраницы) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ИмяТекущегоПути = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма();
	ИмяОткрытых = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц();
	ИмяСформирована = Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста);
	
	ХостСформирован = Форма[ИмяСформирована]; // Булево
	ПредыдущийПуть = Форма[ИмяТекущегоПути]; // Строка
	
	Если ХостСформирован И Не ПустаяСтрока(ПредыдущийПуть) Тогда
		ИмяРеестра = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов();
		Реестр = Форма[ИмяРеестра]; // Строка
		ИмяПредыдущейСтраницы = ИмяСтраницыПоПути(Реестр, ПредыдущийПуть);
		ОткрытыеСтраницы = Форма[ИмяОткрытых]; // Строка
		СтраницаОткрывалась = Расш1_КонсольКодаКлиентСервер.ИмяЕстьВСписке(ОткрытыеСтраницы, ИмяПредыдущейСтраницы);
		Если Расш1_КонсольКодаКлиентСервер.НужноЗаписатьТекстАлгоритма(ХостСформирован, СтраницаОткрывалась) Тогда
			ТекстКонсоли = Текст(Форма, ИмяХоста);
			УстановитьЗначениеПоПути(Форма, ПредыдущийПуть, ТекстКонсоли);
		КонецЕсли;
	КонецЕсли;
	
	Форма[ИмяТекущегоПути] = Описание.ПутьКДанным;
	НазначитьHTMLХосту(Форма);
	ПрименитьОпцииПанели(Форма, Описание);
	
	Если Не ХостСформирован Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Описание.РежимЯзыка) Тогда
		// @skip-check dynamic-access-method-not-found
		ПредставлениеКонсоли(Форма, ИмяХоста).setLanguageMode(Описание.РежимЯзыка);
	КонецЕсли;
	
	ТекстСтраницы = ЗначениеПоПути(Форма, Описание.ПутьКДанным);
	ИсходныйТекст = ИсходныйТекстАлгоритма(Форма, Описание.ПутьКДанным, ТекстСтраницы);
	ПодставитьТекстАлгоритма(Форма, ИмяХоста, ТекстСтраницы, Описание.ТолькоПросмотр);
	УстановитьИсходныйТекст(Форма, ИмяХоста, ИсходныйТекст);
	Форма[ИмяОткрытых] = Расш1_КонсольКодаКлиентСервер.ДобавитьИмяВСписок(Форма[ИмяОткрытых], ИмяСтраницы);
	
КонецПроцедуры

// Назначить полю хоста текст HTML-макета из кэша сеанса (лениво).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура НазначитьHTMLХосту(Форма) Экспорт
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Форма.Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстHTML = Форма[ИмяХоста]; // Строка
	Если Не ПустаяСтрока(ТекстHTML) Тогда
		Возврат;
	КонецЕсли;
	
	Форма[ИмяХоста] = Расш1_КонсольКодаКлиентПовтИсп.ТекстHTMLМакетаКонсоли();
	
КонецПроцедуры

// Инициализировать редактор после формирования HTML-документа.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ПолеФормы - поле HTML консоли.
//
Процедура ИнициализироватьКонсоль(Форма, Элемент) Экспорт
	
	КонсольКода = ПредставлениеКонсоли(Форма, Элемент.Имя);
	ИнициализацияРедактора(КонсольКода);
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(Элемент.Имя)] = Истина;
	
	ИмяРеестра = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов();
	Реестр = Форма[ИмяРеестра]; // Строка
	ИмяТекущегоПути = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма();
	ТекущийПуть = Форма[ИмяТекущегоПути]; // Строка
	ИмяСтраницы = ИмяСтраницыПоПути(Реестр, ТекущийПуть);
	ИмяОткрытых = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц();
	ОткрытыеСтраницы = Форма[ИмяОткрытых]; // Строка
	Форма[ИмяОткрытых] = Расш1_КонсольКодаКлиентСервер.ДобавитьИмяВСписок(ОткрытыеСтраницы, ИмяСтраницы);
	
	Описание = Расш1_КонсольКодаКлиентСервер.НайтиОписаниеАлгоритма(Реестр, ИмяСтраницы);
	ТолькоПросмотр = Истина;
	Если Не ПустаяСтрока(Описание.ИмяСтраницы) Тогда
		ТолькоПросмотр = Описание.ТолькоПросмотр;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Описание.РежимЯзыка) Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.setLanguageMode(Описание.РежимЯзыка);
	КонецЕсли;
	
	ПутьТекста = ТекущийПутьТекстаАлгоритма(Форма, Элемент.Имя);
	ТекстСтраницы = ЗначениеПоПути(Форма, ПутьТекста);
	ИсходныйТекст = ИсходныйТекстАлгоритма(Форма, ПутьТекста, ТекстСтраницы);
	ПодставитьТекстАлгоритма(Форма, Элемент.Имя, ТекстСтраницы, ТолькоПросмотр);
	УстановитьИсходныйТекст(Форма, Элемент.Имя, ИсходныйТекст);
	
	Если Не ПустаяСтрока(Описание.ИмяСтраницы) Тогда
		ПрименитьОпцииПанели(Форма, Описание);
	КонецЕсли;
	
	ПоказатьИменаОбщихМодулей(Форма, КонсольКода);
	
КонецПроцедуры

// Обработать событие HTML-поля консоли (eventData1C).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДанныеСобытия - ФиксированнаяСтруктура
//  ЭлементФормы - ПолеФормы
//
Процедура ПриНажатии(Форма, ДанныеСобытия, ЭлементФормы) Экспорт
	
	ОбработатьСобытие(Форма, ДанныеСобытия, ЭлементФормы);
	
КонецПроцедуры

// Диспетчер событий bsl_console.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДанныеСобытия - ФиксированнаяСтруктура
//  ЭлементФормы - ПолеФормы
//
Процедура ОбработатьСобытие(Форма, ДанныеСобытия, ЭлементФормы) Экспорт
	
	События = СнимокСобытийКонсоли(ДанныеСобытия, ЭлементФормы);
	Для Каждого Событие Из События Цикл
		ОбработатьОдноСобытиеКонсоли(Форма, Событие, ЭлементФормы);
	КонецЦикла;
	
КонецПроцедуры

// Выполнить команду панели консоли. Для команд направления возвращает Ложь.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Булево - Истина, если команда обработана фасадом.
//
Функция ВыполнитьКоманду(Форма, Команда) Экспорт
	
	ИмяКоманды = Команда.Имя;
	ИмяЭлементаКонвертации = "Конвертация";
	ПрефиксЗамены = Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыЗаменитьВхождения();
	
	Если СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыНастроек()) Тогда
		ОткрытьНастройкиКонсоли(Форма[ИмяЭлементаКонвертации], Форма);
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПоиска()) Тогда
		ОткрытьГлобальныйПоиск(Форма);
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(ИмяКоманды, ПрефиксЗамены) Тогда
		ЗаменитьВсеВхождения(Форма, Сред(ИмяКоманды, СтрДлина(ПрефиксЗамены) + 1));
		Возврат Истина;
	ИначеЕсли ЭтоКомандаЗакладок(ИмяКоманды) Тогда
		ВыполнитьКомандуЗакладок(Форма, ИмяКоманды);
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Признак команды направления обмена.
//
// Параметры:
//  Команда - КомандаФормы
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоКомандаНаправления(Команда) Экспорт
	
	ИмяКоманды = Команда.Имя;
	Возврат СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыОтправка())
		Или СтрНачинаетсяС(ИмяКоманды, Расш1_КонсольКодаКлиентСервер.ПрефиксКомандыПолучение());
	
КонецФункции

// Записать направление обмена (для КомпонентыОбмена и customObjects).
// Релиз метаданных конфигурации не меняется.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Направление - Строка - Отправка или Получение.
//
Процедура УстановитьНаправление(Форма, Направление) Экспорт
	
	Если ПустаяСтрока(Направление) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаНаправления) Тогда
		Форма[ИмяРеквизитаНаправления] = Направление;
	КонецЕсли;
	
	УстановитьЗаголовокНаправления(Форма, Направление);
	
КонецПроцедуры

// Текст редактора.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция Текст(Форма, ИмяЭлементаHTML) Экспорт
	
	// @skip-check dynamic-access-method-not-found
	Возврат ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).getText();
	
КонецФункции

// Полностью заменить текст редактора (updateText, игнорирует режим только просмотра).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  НовыйТекст - Строка
//
Процедура УстановитьТекст(Форма, ИмяЭлементаHTML, НовыйТекст) Экспорт
	
	// @skip-check dynamic-access-method-not-found
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).updateText(НовыйТекст);
	
КонецПроцедуры

// Заменить все вхождения выделенного слова.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//
Процедура ЗаменитьВсеВхождения(Форма, ИмяЭлементаHTML) Экспорт
	
	// @skip-check property-return-type, dynamic-access-method-not-found
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).editor.trigger("", "editor.action.changeAll");
	
КонецПроцедуры

// Обновить метаданные консоли и контекст обработчика.
// Подсказки по EVENT_GET_METADATA не открывать.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  ОписаниеМетаданныхJSON - Строка - JSON customObjects страницы.
//
Процедура ОбновитьМетаданные(Форма, ИмяЭлементаHTML, ОписаниеМетаданныхJSON) Экспорт
	
	Если ПустаяСтрока(ИмяЭлементаHTML) Тогда
		Возврат;
	КонецЕсли;
	ТекстHTML = Форма[ИмяЭлементаHTML]; // Строка
	Если ПустаяСтрока(ТекстHTML) Тогда
		Возврат;
	КонецЕсли;
	Если Не Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяЭлементаHTML)] Тогда
		Возврат;
	КонецЕсли;
	
	Конвертация = КонвертацияФормы(Форма);
	ОписаниеJSON = ОписаниеМетаданныхJSON;
	ФункцииJSON = "";
	СигнатурыJSON = "";
	Если ЗначениеЗаполнено(Конвертация) Тогда
		Контекст = Расш1_КонсольКодаВызовСервера.Расш1_ДополнитьКонтекстОбработчика(
			ОписаниеМетаданныхJSON, Конвертация);
		ОписаниеJSON = Контекст.ОписаниеJSON;
		ФункцииJSON = Контекст.ФункцииJSON;
		СигнатурыJSON = Контекст.СигнатурыJSON;
	КонецЕсли;
	
	АдресОбновления = "";
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяЭлементаHTML);
	// @skip-check dynamic-access-method-not-found
	РезультатОбновления = КонсольКода.updateMetadata(ОписаниеJSON, АдресОбновления); // Произвольный
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления);
	ПоказатьИменаОбщихМодулей(Форма, КонсольКода);
	Расш1_ОбновитьФункцииКонтекста(КонсольКода, ФункцииJSON, СигнатурыJSON);
	
КонецПроцедуры

// Включить или выключить режим только просмотра через API консоли (setReadOnly), без свойств поля 1С.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяЭлементаHTML - Строка
//  ТолькоПросмотр - Булево
//
Процедура УстановитьТолькоПросмотр(Форма, ИмяЭлементаHTML, ТолькоПросмотр) Экспорт
	
	// @skip-check dynamic-access-method-not-found
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).setReadOnly(ТолькоПросмотр);
	
КонецПроцедуры

// Хост сформирован и получил текст HTML.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Булево
//
Функция ВсеКонсолиСформированы(Форма) Экспорт
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Форма.Элементы.Найти(ИмяХоста) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекстHTML = Форма[ИмяХоста]; // Строка
	Если ПустаяСтрока(ТекстHTML) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста)];
	
КонецФункции

// Записать текст текущего редактора в текущий путь данных.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ЗаписатьТекстыКонсолейВОбъект(Форма) Экспорт
	
	Если Форма.Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ВсеКонсолиСформированы(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ТекущийПуть = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()]; // Строка
	ИмяРеестра = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов();
	Реестр = Форма[ИмяРеестра]; // Строка
	ИмяСтраницы = ИмяСтраницыПоПути(Реестр, ТекущийПуть);
	
	ОткрытыеСтраницы = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОткрытыхСтраниц()]; // Строка
	СтраницаОткрывалась = Расш1_КонсольКодаКлиентСервер.ИмяЕстьВСписке(ОткрытыеСтраницы, ИмяСтраницы);
	Если Не Расш1_КонсольКодаКлиентСервер.НужноЗаписатьТекстАлгоритма(Истина, СтраницаОткрывалась) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеПоПути(Форма, ТекущийПуть, Текст(Форма, ИмяХоста));
	
КонецПроцедуры

// Открыть общую форму настроек консоли кода.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации, Неопределено - текущая конвертация формы.
//  ФормаВладелец - ФормаКлиентскогоПриложения, Неопределено - форма редактора, с которой открыты настройки.
//
Процедура ОткрытьНастройкиКонсоли(Конвертация = Неопределено, ФормаВладелец = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Конвертация) Тогда
		ПараметрыФормы.Вставить("Конвертация", Конвертация);
	КонецЕсли;
	
	ОткрытьФорму(
		Расш1_КонсольКодаКлиентСервер.ИмяФормыНастроекКонсоли(),
		ПараметрыФормы,
		ФормаВладелец);
	
КонецПроцедуры

// Открыть типовую форму загрузки структуры конфигурации из XML/ЕDT.
//
// Параметры:
//  Релиз - СправочникСсылка.Релизы, Неопределено - релиз для параметра парКонфигурация.
//
Процедура ОткрытьЗагрузкуСтруктурыКонфигурации(Релиз = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Релиз) Тогда
		ПараметрыФормы.Вставить("парКонфигурация", Релиз);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияЗагрузкиСтруктуры", Расш1_КонсольКодаКлиент);
	ОткрытьФорму("Обработка.ЗагрузкаСтруктурыКонфигурацииИзФайловXML.Форма",
		ПараметрыФормы, , , , , Оповещение);
	
КонецПроцедуры

// Применить сохраненные настройки ко всем сформированным консолям формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ПрименитьНастройкиКФорме(Форма) Экспорт
	
	Если Не ВсеКонсолиСформированы(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ПрименитьНастройкиРедактора(ПредставлениеКонсоли(Форма, ИмяХоста));
	
КонецПроцедуры

// Обработать оповещение об изменении настроек консоли.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяСобытия - Строка
//
// Возвращаемое значение:
//  Булево - Истина, если сменился язык подсказок и описание метаданных консоли сброшено.
//
Функция ОбработкаОповещенияНастроек(Форма, ИмяСобытия) Экспорт
	
	Если Форма.Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли()) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИмяСобытия <> Расш1_КонсольКодаКлиентСервер.ИмяСобытияНастройкиИзменены() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПрименитьНастройкиКФорме(Форма);
	
	Возврат Расш1_СброситьМетаданныеКонсоли(Форма);
	
КонецФункции

// Если у конвертации нет загруженных объектов метаданных, предложить открыть загрузку XML/EDT.
//
// Параметры:
//  Конвертация - СправочникСсылка.Конвертации
//
Процедура ПроверитьОписаниеМетаданныхПриОткрытии(Конвертация) Экспорт
	
	Если Не Расш1_КонсольКодаВызовСервера.КонсольВключена() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат;
	КонецЕсли;
	
	Релиз = Расш1_КонсольКодаВызовСервера.РелизКонвертацииЕслиНетОписания(Конвертация);
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Для подсказок консоли кода нет загруженной структуры конфигурации.
						|Открыть загрузку из файлов XML/EDT?'");
	Оповещение = Новый ОписаниеОповещения(
		"ПроверитьОписаниеМетаданныхПослеВопроса",
		Расш1_КонсольКодаКлиент,
		Релиз);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Показать страницу поля, фраза которого записана в реквизитах формы.
// Фразу выделяет ВыделитьФразуПоиска после формирования консоли.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма объекта, на которую переходят из поиска.
//
Процедура ПерейтиКВхождению(Форма) Экспорт
	
	Если Форма.Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска()]; // Строка
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСтраницы = ИмяСтраницыПоля(Форма, ИмяПоля);
	Если ПустаяСтрока(ИмяСтраницы) Тогда
		ОчиститьРеквизитыПоиска(Форма);
		Возврат;
	КонецЕсли;
	
	АктивироватьСтраницыПерехода(Форма, ИмяСтраницы);
	ПоказатьАлгоритм(Форма, ИмяСтраницы);
	
КонецПроцедуры

// Записать фразу поиска из оповещения в реквизиты уже открытой формы и перейти к полю.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Параметр - Структура - Ссылка, ФразаПоиска, ИмяПоляПоиска, НомерСтрокиПоиска.
//
Процедура ЗаписатьПараметрыПоискаИзОповещения(Форма, Параметр) Экспорт
	
	Если Форма.Элементы.Найти(Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли()) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Неопределено;
	ПоляОбъекта = ПоляОбъектаФормы(Форма);
	Если Не Параметр.Свойство("Ссылка", Ссылка) Или ПоляОбъекта.Ссылка <> Ссылка Тогда
		Возврат;
	КонецЕсли;
	
	ФразаПоиска = "";
	ИмяПоляПоиска = "";
	НомерСтрокиПоиска = 0;
	Параметр.Свойство("ФразаПоиска", ФразаПоиска);
	Параметр.Свойство("ИмяПоляПоиска", ИмяПоляПоиска);
	Параметр.Свойство("НомерСтрокиПоиска", НомерСтрокиПоиска);
	
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаФразыПоиска()] = ФразаПоиска;
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска()] = ИмяПоляПоиска;
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНомераСтрокиПоиска()] = НомерСтрокиПоиска;
	ПерейтиКВхождению(Форма);
	ВыделитьФразуПоиска(Форма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открыть поиск подстроки в текстах выбранной конвертации.
// Форму алгоритма узнаём по имени формы. С неё в строку поиска подставляется код,
// сам алгоритм из результата исключается.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой открыта консоль.
//
Процедура ОткрытьГлобальныйПоиск(Форма)
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Конвертация = Форма[ИмяРеквизитаКонвертации]; // СправочникСсылка.Конвертации
	Если Не ЗначениеЗаполнено(Конвертация) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Конвертация", Конвертация);
	Если Форма.ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаАлгоритма() Тогда
		ПоляОбъекта = ПоляОбъектаФормы(Форма);
		Если ЗначениеЗаполнено(ПоляОбъекта.Ссылка) Тогда
			ПараметрыФормы.Вставить("СтрокаПоиска", ПоляОбъекта.Код);
			ПараметрыФормы.Вставить("ИсключитьСсылку", ПоляОбъекта.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	ОткрытьФорму(
		Расш1_КонсольКодаКлиентСервер.ИмяФормыГлобальногоПоиска(),
		ПараметрыФормы,
		Форма);
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяЭлементаHTML - Строка - имя поля HTML консоли.
//
// Возвращаемое значение:
//  Произвольный - defaultView документа HTML-поля, API редактора bsl_console.
//
Функция ПредставлениеКонсоли(Форма, ИмяЭлементаHTML)
	
	// @skip-check property-return-type
	Возврат Форма.Элементы[ИмяЭлементаHTML].Документ.defaultView;
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма объекта.
//
// Возвращаемое значение:
//  ДанныеФормыСтруктура - реквизит формы Объект.
//
Функция ОбъектФормы(Форма)
	
	ИмяРеквизитаОбъекта = "Объект";
	Возврат Форма[ИмяРеквизитаОбъекта];
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма объекта.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - ЛюбаяСсылка, Неопределено - ссылка объекта формы.
//   * Код - Строка - код объекта, если есть.
//   * ОбъектФормата - Строка - объект формата правила, если есть.
//
Функция ПоляОбъектаФормы(Форма)
	
	Поля = Новый Структура("Ссылка, Код, ОбъектФормата", Неопределено, "", "");
	Объект = ОбъектФормы(Форма);
	ЗаполнитьЗначенияСвойств(Поля, Объект);
	Возврат Поля;
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  Событие - см. СнимокСобытияКонсоли
//  ЭлементФормы - ПолеФормы - поле HTML консоли.
//
Процедура ОбработатьОдноСобытиеКонсоли(Форма, Событие, ЭлементФормы)
	
	ИмяСобытия = Событие.event;
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияИзменениеСодержимого() Тогда
		Форма.Модифицированность = Истина;
		Возврат;
	КонецЕсли;
	
	Конвертация = КонвертацияФормы(Форма);
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПолучениеМетаданных() Тогда
		Направление = НаправлениеФормы(Форма);
		ОбработкаСобытияПолученияМетаданных(Событие, ЭлементФормы, Конвертация, Направление);
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = Расш1_КонсольКодаКлиентСервер.ИмяСобытияПолучениеОпределения() Тогда
		ОбработатьСобытиеПолученияОпределения(Событие, Конвертация, Форма);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  ДанныеСобытия - ФиксированнаяСтруктура - данные события поля HTML.
//  ЭлементФормы - ПолеФормы - поле HTML консоли.
//
// Возвращаемое значение:
//  Массив из см. СнимокСобытияКонсоли
//
Функция СнимокСобытийКонсоли(ДанныеСобытия, ЭлементФормы)
	
	События = Новый Массив; // Массив из см. СнимокСобытияКонсоли
	
	// @skip-check property-return-type
	СобытиеHTML = ДанныеСобытия.Event.eventData1C; // Произвольный
	
	Если ЗначениеЗаполнено(СобытиеHTML) Тогда
		
		Снимок = СнимокСобытияКонсоли(СобытиеHTML);
		События.Добавить(Снимок);
		
		ДочитатьОчередьСобытийКонсоли(События, ЭлементФормы);
		
	КонецЕсли;
	
	Возврат События;
	
КонецФункции

// Параметры:
//  СобытиеHTML - Произвольный - объект события JavaScript (event, params).
//
// Возвращаемое значение:
//  Структура:
//   * event - Строка - имя события редактора.
//   * params - см. ПараметрыСобытияКонсоли
//
Функция СнимокСобытияКонсоли(СобытиеHTML)
	
	// @skip-check property-return-type
	ИмяСобытия = СобытиеHTML.event; // Строка
	// @skip-check property-return-type
	ПараметрыHTML = СобытиеHTML.params; // Произвольный
	Параметры = ПараметрыСобытияКонсоли(ПараметрыHTML);
	
	Результат = Новый Структура;
	Результат.Вставить("event", ИмяСобытия);
	Результат.Вставить("params", Параметры);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  События - Массив из см. СнимокСобытияКонсоли
//  ЭлементФормы - ПолеФормы - поле HTML консоли.
//
Процедура ДочитатьОчередьСобытийКонсоли(События, ЭлементФормы)
	
	// @skip-check property-return-type
	КонсольКода = ЭлементФормы.Документ.defaultView; // Произвольный
	// @skip-check property-return-type
	Очередь = КонсольКода.events_queue; // Произвольный
	// @skip-check property-return-type
	Количество = Очередь.length; // Число
	
	СобытийЗаПроход = 20;
	ОсталосьСобытий = Мин(Количество, СобытийЗаПроход);
	
	Пока ОсталосьСобытий > 0 Цикл
		
		// @skip-check dynamic-access-method-not-found
		СобытиеHTML = Очередь.shift(); // Произвольный
		
		Снимок = СнимокСобытияКонсоли(СобытиеHTML);
		Если Снимок <> Неопределено Тогда
			События.Добавить(Снимок);
		КонецЕсли;
		ОсталосьСобытий = ОсталосьСобытий - 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
Процедура ИнициализацияРедактора(КонсольКода)
	
	Инфо = Новый СистемнаяИнформация();
	// @skip-check dynamic-access-method-not-found
	КонсольКода.init(Инфо.ВерсияПриложения);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setReadOnly(Истина);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("generateModificationEvent", Истина);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("generateDefinitionEvent", Истина);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("disableDefinitionMessage", Истина);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.clearMetadata();
	ПрименитьНастройкиРедактора(КонсольКода);
	
КонецПроцедуры

// Подставить текст алгоритма в редактор и включить правку, если алгоритм не только для просмотра.
// updateText игнорирует режим только просмотра консоли.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяЭлементаHTML - Строка - имя поля HTML консоли.
//  ТекстАлгоритма - Строка - текст для редактора.
//  ТолькоПросмотр - Булево - алгоритм доступен только для просмотра.
//
Процедура ПодставитьТекстАлгоритма(Форма, ИмяЭлементаHTML, ТекстАлгоритма, ТолькоПросмотр)
	
	УстановитьТолькоПросмотр(Форма, ИмяЭлементаHTML, Истина);
	УстановитьТекст(Форма, ИмяЭлементаHTML, ТекстАлгоритма);
	УстановитьТолькоПросмотр(Форма, ИмяЭлементаHTML, ТолькоПросмотр);
	
КонецПроцедуры

Функция ТекущийПутьТекстаАлгоритма(Форма, ИмяЭлементаHTML)
	
	ТекущийПуть = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()]; // Строка
	Если Не ПустаяСтрока(ТекущийПуть) Тогда
		Возврат ТекущийПуть;
	КонецЕсли;
	
	Возврат ПутьАлгоритма(Форма, ИмяЭлементаHTML);
	
КонецФункции

// Исходный текст страницы запоминается при первом показе: дальше в объекте лежит уже изменённый текст.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  Путь - Строка - путь к реквизиту с текстом алгоритма.
//  ТекущийТекст - Строка, Произвольный - текст реквизита на момент показа.
//
// Возвращаемое значение:
//  Строка - исходный текст алгоритма.
//
Функция ИсходныйТекстАлгоритма(Форма, Путь, ТекущийТекст)
	
	ИсходныеТексты = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИсходныхТекстов()]; // СписокЗначений из Строка
	Для Каждого Элемент Из ИсходныеТексты Цикл
		Если Элемент.Представление = Путь Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ИсходныйТекст = ?(ТипЗнч(ТекущийТекст) = Тип("Строка"), ТекущийТекст, "");
	ИсходныеТексты.Добавить(ИсходныйТекст, Путь);
	Возврат ИсходныйТекст;
	
КонецФункции

// setOriginalText вызывать после updateText: иначе виджет изменений сравнит с предыдущей страницей.
// Пустой исходный текст передаётся явно, чтобы подсветка не выключалась.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяЭлементаHTML - Строка - имя поля HTML консоли.
//  ИсходныйТекст - Строка - текст для сравнения с текущим.
//
Процедура УстановитьИсходныйТекст(Форма, ИмяЭлементаHTML, ИсходныйТекст)
	
	// @skip-check dynamic-access-method-not-found
	ПредставлениеКонсоли(Форма, ИмяЭлементаHTML).setOriginalText(ИсходныйТекст, Истина);
	
КонецПроцедуры

Функция ПутьАлгоритма(Форма, ИмяЭлементаHTML)
	
	Карта = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКартыКонсолей()]; // Строка
	ЧастейВПаре = 2;
	Для Каждого Пара Из СтрРазделить(Карта, ";", Ложь) Цикл
		Части = СтрРазделить(Пара, "=");
		Если Части.Количество() = ЧастейВПаре И Части[0] = ИмяЭлементаHTML Тогда
			Возврат Части[1];
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Параметры:
//  Реестр - Строка - реестр алгоритмов формы.
//  Путь - Строка - путь к данным алгоритма.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСтраницыПоПути(Реестр, Путь)
	
	Для Каждого Описание Из Расш1_КонсольКодаКлиентСервер.РазобратьРеестр(Реестр) Цикл
		Если Описание.ПутьКДанным = Путь Тогда
			Возврат Описание.ИмяСтраницы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ЗначениеПоПути(Форма, Путь)
	
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Расш1_КонсольКодаКлиентСервер.ЧастиПутиДанных(Путь);
	Если Части.ЭтоРеквизитОбъекта Тогда
		Объект = ОбъектФормы(Форма);
		Возврат Объект[Части.ИмяРеквизита];
	КонецЕсли;
	
	Возврат Форма[Части.ИмяРеквизита];
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  Путь - Строка - путь к данным алгоритма.
//  Значение - Строка - текст редактора.
//
Процедура УстановитьЗначениеПоПути(Форма, Путь, Значение)
	
	Если ПустаяСтрока(Путь) Тогда
		Возврат;
	КонецЕсли;
	
	Части = Расш1_КонсольКодаКлиентСервер.ЧастиПутиДанных(Путь);
	ТекстДляЗаписи = Расш1_КонсольКодаКлиентСервер.ТекстСПереносамиWindows(Значение);
	
	Если Части.ЭтоРеквизитОбъекта Тогда
		Объект = ОбъектФормы(Форма);
		Объект[Части.ИмяРеквизита] = ТекстДляЗаписи;
	Иначе
		Форма[Части.ИмяРеквизита] = ТекстДляЗаписи;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрименитьОпцииПанели(Форма, Описание)
	
	ИмяПанели = Расш1_КонсольКодаКлиентСервер.ИмяПанелиКомандХоста();
	ИмяГруппы = Расш1_КонсольКодаКлиентСервер.ИмяГруппыНаправленияХоста();
	Панель = Форма.Элементы.Найти(ИмяПанели);
	ГруппаНаправления = Форма.Элементы.Найти(ИмяГруппы);
	Если Панель = Неопределено Или ГруппаНаправления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидимостьПанели = Не Описание.СкрытьПанельКоманд;
	УстановитьВидимостьЕслиИзменилась(Панель, ВидимостьПанели);
	Если Не ВидимостьПанели Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВидимостьЕслиИзменилась(ГруппаНаправления, Описание.ПоказыватьНаправление);
	ГруппаНаправления.Доступность = ПустаяСтрока(Описание.АвтоНаправление);
	
	Если Не ПустаяСтрока(Описание.АвтоНаправление) Тогда
		УстановитьНаправление(Форма, Описание.АвтоНаправление);
	ИначеЕсли ПустаяСтрока(НаправлениеФормы(Форма)) Тогда
		ПоказатьНеобходимостьВыбораНаправления(Форма, ГруппаНаправления);
	Иначе
		СкрытьПодсказкуВыбораНаправления(Форма, ГруппаНаправления);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьВидимостьЕслиИзменилась(Элемент, Видимость)
	
	Если Элемент.Видимость <> Видимость Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗаголовокНаправления(Форма, Направление)
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	ИмяКнопки = СтрШаблон("%1%2", Направление, ИмяХоста);
	Кнопка = Форма.Элементы.Найти(ИмяКнопки); // КнопкаФормы, Неопределено
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаНаправления = Кнопка.Родитель; // ГруппаФормы
	ГруппаНаправления.Заголовок = Направление;
	// Свойство картинки группы формы платформа не типизирует.
	// @skip-check property-return-type
	ГруппаНаправления.Картинка = Кнопка.Картинка;
	СкрытьПодсказкуВыбораНаправления(Форма, ГруппаНаправления);
	
КонецПроцедуры

Процедура ПоказатьНеобходимостьВыбораНаправления(Форма, ГруппаНаправления)
	
	ГруппаНаправления.Заголовок = НСтр("ru = 'Выберите направление'");
	ГруппаНаправления.Картинка = Новый Картинка;
	
КонецПроцедуры

Процедура СкрытьПодсказкуВыбораНаправления(Форма, ГруппаНаправления)
	
	ГруппаНаправления.Подсказка = НСтр("ru = 'Направление обмена'");
	
КонецПроцедуры

// Параметры:
//  Событие - см. СнимокСобытияКонсоли
//  ЭлементФормы - ПолеФормы - поле HTML консоли.
//  Конвертация - СправочникСсылка.Конвертации, Неопределено - конвертация формы.
//  Направление - Строка - Отправка, Получение или пустая строка.
//
Процедура ОбработкаСобытияПолученияМетаданных(Событие, ЭлементФормы, Конвертация, Направление = "")
	
	// @skip-check property-return-type
	КонсольКода = ЭлементФормы.Документ.defaultView; // Произвольный
	ПараметрыСобытия = Событие.params;
	ПутьМетаданных = ПараметрыСобытия.ПутьМетаданных;
	Триггер = ПараметрыСобытия.Триггер;
	ИдентификаторСниппета = ПараметрыСобытия.ИдентификаторСниппета;
	
	Если ПустаяСтрока(ПутьМетаданных) Тогда
		СброситьКэшЗапросаМетаданных(КонсольКода, "");
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(НРег(ПутьМетаданных), "module.") Тогда
		ОбработатьЗапросТекстаМодуля(
			КонсольКода, ПутьМетаданных, Конвертация, Направление, Триггер, ИдентификаторСниппета);
		Возврат;
	КонецЕсли;
	
	АдресОбновления = "";
	РезультатСервера = Расш1_КонсольКодаВызовСервера.ПолучитьОписаниеОбъектаМетаданныхJSON(
		ПутьМетаданных, АдресОбновления, Конвертация, Направление);
	
	ОписаниеМетаданныхJSON = РезультатСервера.ОписаниеJSON;
	АдресОбновления = РезультатСервера.АдресОбновления;
	
	Если Не ЭтоJSONОписанияМетаданных(ОписаниеМетаданныхJSON) Тогда
		СброситьКэшЗапросаМетаданных(КонсольКода, ПутьМетаданных);
		Возврат;
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	РезультатОбновления = КонсольКода.updateMetadata(ОписаниеМетаданныхJSON, АдресОбновления); // Произвольный
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления, Триггер, ИдентификаторСниппета);
	
КонецПроцедуры

// Параметры:
//  ПараметрыСобытия - Произвольный - params события JavaScript, строка или Неопределено.
//
// Возвращаемое значение:
//  Структура:
//   * ПутьМетаданных - Строка
//   * Триггер - Строка
//   * ИдентификаторСниппета - Строка
//   * Слово - Строка
//   * Класс - Строка
//
Функция ПараметрыСобытияКонсоли(ПараметрыСобытия)
	
	Результат = Новый Структура;
	Результат.Вставить("ПутьМетаданных", "");
	Результат.Вставить("Триггер", "suggestion");
	Результат.Вставить("ИдентификаторСниппета", "");
	Результат.Вставить("Слово", "");
	Результат.Вставить("Класс", "");
	
	Если ПараметрыСобытия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыСобытия) = Тип("Строка") Тогда
		Результат.ПутьМетаданных = ПараметрыСобытия;
		Возврат Результат;
	КонецЕсли;
	
	// Набор полей зависит от события редактора: отсутствие поля проверяется JS-методом hasOwnProperty.
	// @skip-check dynamic-access-method-not-found
	Если ПараметрыСобытия.hasOwnProperty("metadata") Тогда
		// @skip-check property-return-type
		Значение = ПараметрыСобытия.metadata; // Произвольный
		Результат.ПутьМетаданных = Строка(Значение);
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	Если ПараметрыСобытия.hasOwnProperty("trigger") Тогда
		// @skip-check property-return-type
		Значение = ПараметрыСобытия.trigger; // Произвольный
		Триггер = Строка(Значение);
		Если Не ПустаяСтрока(Триггер) Тогда
			Результат.Триггер = Триггер;
		КонецЕсли;
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	Если Результат.Триггер = "snippet" И ПараметрыСобытия.hasOwnProperty("snippet_guid") Тогда
		// @skip-check property-return-type
		Значение = ПараметрыСобытия.snippet_guid; // Произвольный
		Результат.ИдентификаторСниппета = Строка(Значение);
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	Если ПараметрыСобытия.hasOwnProperty("word") Тогда
		// @skip-check property-return-type
		Значение = ПараметрыСобытия.word; // Произвольный
		Результат.Слово = Строка(Значение);
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	Если ПараметрыСобытия.hasOwnProperty("class") Тогда
		// @skip-check property-return-type
		Значение = ПараметрыСобытия.class; // Произвольный
		Результат.Класс = Строка(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Событие - см. СнимокСобытияКонсоли
//  Конвертация - СправочникСсылка.Конвертации, Неопределено - конвертация формы.
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//
Процедура ОбработатьСобытиеПолученияОпределения(Событие, Конвертация, Форма)
	
	ПараметрыСобытия = Событие.params;
	Класс = НРег(СокрЛП(ПараметрыСобытия.Класс));
	Имя = СокрЛП(ПараметрыСобытия.Слово);
	ЭтоЗапрос = (Класс = "запросы");
	ЭтоАлгоритм = (Класс = "алгоритмы");
	МожноНайтиОпределение = Не ПустаяСтрока(Имя)
		И ЗначениеЗаполнено(Конвертация)
		И (ЭтоЗапрос Или ЭтоАлгоритм);
	Если Не МожноНайтиОпределение Тогда
		Возврат;
	КонецЕсли;
	
	Ссылка = Расш1_КонсольКодаВызовСервера.СсылкаАлгоритмаИлиЗапроса(Конвертация, ЭтоЗапрос, Имя);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаАлгоритма();
	Если ЭтоЗапрос Тогда
		ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаЗапроса();
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", Ссылка);
	ПараметрыФормы.Вставить("Конвертация", Конвертация);
	Если ЭтоАлгоритм Тогда
		ОбъектФормата = Расш1_ОбъектФорматаФормы(Форма);
		Если Не ПустаяСтрока(ОбъектФормата) Тогда
			ПараметрыФормы.Вставить(Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата(), ОбъектФормата);
		КонецЕсли;
	КонецЕсли;
	ОткрытьФорму(ИмяФормы, ПараметрыФормы);
	
КонецПроцедуры

Функция Расш1_ОбъектФорматаФормы(Форма)
	
	ПоляОбъекта = ПоляОбъектаФормы(Форма);
	ИмяОбъекта = СокрЛП(ПоляОбъекта.ОбъектФормата);
	Если Не ПустаяСтрока(ИмяОбъекта) Тогда
		Возврат ИмяОбъекта;
	КонецЕсли;
	
	ИмяРеквизита = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаОбъектаФормата();
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = Форма[ИмяРеквизита]; // Строка
	Возврат СокрЛП(Значение);
	
КонецФункции

Функция ЭтоJSONОписанияМетаданных(ОписаниеМетаданныхJSON)
	
	Если Не ЗначениеЗаполнено(ОписаниеМетаданныхJSON) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстJSON = СокрЛП(ОписаниеМетаданныхJSON);
	Возврат ТекстJSON <> "{}" И ТекстJSON <> "[]";
	
КонецФункции

// Сбрасывает загруженные метаданные консоли после записи настроек.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Булево - Истина, если метаданные сброшены и страницу нужно заполнить заново.
//
Функция Расш1_СброситьМетаданныеКонсоли(Форма)
	
	Если Не ВсеКонсолиСформированы(Форма) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяХоста);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.clearMetadata();
	СброситьКэшЗапросаМетаданных(КонсольКода, "");
	
	Возврат Истина;
	
КонецФункции

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  ПутьМетаданных - Строка - путь запроса; пустая строка сбрасывает весь кэш.
//
Процедура СброситьКэшЗапросаМетаданных(КонсольКода, ПутьМетаданных)
	
	// @skip-check property-return-type
	ЗапросыМетаданных = КонсольКода.metadataRequests; // Произвольный
	Если ПустаяСтрока(ПутьМетаданных) Тогда
		// @skip-check dynamic-access-method-not-found
		ЗапросыМетаданных.clear();
		Возврат;
	КонецЕсли;
	
	КлючЗапроса = НРег(ПутьМетаданных);
	// @skip-check dynamic-access-method-not-found
	ЗапросыМетаданных.delete(КлючЗапроса);
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  ФункцииJSON - Строка - JSON функций контекста обработчика.
//  СигнатурыJSON - Строка - JSON сигнатур функций контекста.
//
Процедура Расш1_ОбновитьФункцииКонтекста(КонсольКода, ФункцииJSON, СигнатурыJSON)
	
	Если Не ПустаяСтрока(ФункцииJSON) Тогда
		// @skip-check dynamic-access-method-not-found
		РезультатФункций = КонсольКода.updateCustomFunctions(ФункцииJSON); // Произвольный
		ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатФункций);
	КонецЕсли;
	Если Не ПустаяСтрока(СигнатурыJSON) Тогда
		// @skip-check dynamic-access-method-not-found
		РезультатСигнатур = КонсольКода.setCustomSignatures(СигнатурыJSON); // Произвольный
		ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатСигнатур);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  РезультатОбновления - Произвольный - результат вызова API редактора: Булево или объект ошибки.
//  Триггер - Строка - suggestion, snippet или пустая строка.
//  ИдентификаторСниппета - Строка - GUID сниппета для триггера snippet.
//
Процедура ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления,
		Триггер = "", ИдентификаторСниппета = "")
	
	Если ТипЗнч(РезультатОбновления) <> Тип("Булево") Тогда
		ОписаниеОшибкиОбновления = ОписаниеОшибкиОбновленияМетаданных(РезультатОбновления);
		Если Не ПустаяСтрока(ОписаниеОшибкиОбновления) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ОписаниеОшибкиОбновления);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Триггер = "snippet" И Не ПустаяСтрока(ИдентификаторСниппета) Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.updateSnippetByGUID(ИдентификаторСниппета);
	КонецЕсли;
	Если Триггер = "suggestion" Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.triggerSuggestions();
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  ПутьМетаданных - Строка - путь события вида module.Имя.
//  Конвертация - СправочникСсылка.Конвертации, Неопределено - конвертация формы.
//  Направление - Строка - Отправка, Получение или пустая строка.
//  Триггер - Строка - suggestion или snippet.
//  ИдентификаторСниппета - Строка - GUID сниппета.
//
Процедура ОбработатьЗапросТекстаМодуля(КонсольКода, ПутьМетаданных, Конвертация, Направление,
		Триггер, ИдентификаторСниппета)
	
	ОписаниеМодуля = Расш1_КонсольКодаВызовСервера.ПолучитьТекстМодуля(ПутьМетаданных, Конвертация, Направление);
	Если ПустаяСтрока(ОписаниеМодуля.Текст) Тогда
		СброситьКэшЗапросаМетаданных(КонсольКода, ПутьМетаданных);
		Возврат;
	КонецЕсли;
	
	Если ОписаниеМодуля.ЭтоОбщийМодуль Тогда
		// @skip-check dynamic-access-method-not-found, variable-value-type
		РезультатРазбора = КонсольКода.parseCommonModule(
			ОписаниеМодуля.ИмяМодуля, ОписаниеМодуля.Текст, ОписаниеМодуля.Глобальный);
	Иначе
		ТекстМодуля = ОписаниеМодуля.Текст;
		АдресОбновления = ОписаниеМодуля.АдресОбновления;
		// @skip-check dynamic-access-method-not-found
		РезультатРазбора = КонсольКода.parseMetadataModule(ТекстМодуля, АдресОбновления); // Произвольный
	КонецЕсли;
	
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатРазбора, Триггер, ИдентификаторСниппета);
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
Процедура ПоказатьИменаОбщихМодулей(Форма, КонсольКода)
	
	ОписаниеJSON = Расш1_КонсольКодаВызовСервера.ПолучитьИменаОбщихМодулейJSON(
		КонвертацияФормы(Форма), НаправлениеФормы(Форма));
	Если ПустаяСтрока(ОписаниеJSON) Тогда
		Возврат;
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	РезультатОбновления = КонсольКода.updateMetadata(ОписаниеJSON, "commonModules.items"); // Произвольный
	ОбработатьРезультатОбновленияМетаданных(КонсольКода, РезультатОбновления);
	
КонецПроцедуры

// Параметры:
//  РезультатОбновления - Произвольный - результат вызова API редактора.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
Функция ОписаниеОшибкиОбновленияМетаданных(РезультатОбновления)
	
	ТипРезультата = ТипЗнч(РезультатОбновления);
	ЭтоПримитив = ТипРезультата = Тип("Неопределено")
		Или ТипРезультата = Тип("Null")
		Или ТипРезультата = Тип("Булево")
		Или ТипРезультата = Тип("Строка")
		Или ТипРезультата = Тип("Число")
		Или ТипРезультата = Тип("Дата");
	Если ЭтоПримитив Тогда
		Возврат "";
	КонецЕсли;
	// @skip-check dynamic-access-method-not-found
	Если Не РезультатОбновления.hasOwnProperty("errorDescription") Тогда
		Возврат "";
	КонецЕсли;
	
	// @skip-check property-return-type
	ОписаниеОшибкиОбновления = РезультатОбновления.errorDescription; // Произвольный
	Возврат Строка(ОписаниеОшибкиОбновления);
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//
// Возвращаемое значение:
//  СправочникСсылка.Конвертации, Неопределено - Неопределено, если на форме нет реквизита.
//
Функция КонвертацияФормы(Форма)
	
	ИмяРеквизитаКонвертации = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаКонвертации();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаКонвертации) Тогда
		Возврат Форма[ИмяРеквизитаКонвертации];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//
// Возвращаемое значение:
//  Строка - Отправка, Получение или пустая строка.
//
Функция НаправлениеФормы(Форма)
	
	ИмяРеквизитаНаправления = Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНаправления();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаНаправления) Тогда
		Возврат Форма[ИмяРеквизитаНаправления];
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
Процедура ПрименитьНастройкиРедактора(КонсольКода)
	
	Настройки = Расш1_КонсольКодаВызовСервера.ПрочитатьНастройкиРедактора();
	ИмяТемы = Расш1_КонсольКодаКлиентСервер.ИмяТемыAPI(Настройки.Тема);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setTheme(ИмяТемы);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.minimap(Ложь);
	
	Если Настройки.РазмерШрифта > 0 Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.setFontSize(Настройки.РазмерШрифта);
	КонецЕсли;
	Если Не ПустаяСтрока(Настройки.СемействоШрифтов) Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.setFontFamily(Настройки.СемействоШрифтов);
	КонецЕсли;
	ИмяНасыщенности = Расш1_КонсольКодаКлиентСервер.ИмяНасыщенностиAPI(Настройки.НасыщенностьШрифта);
	Если Не ПустаяСтрока(ИмяНасыщенности) Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.setFontWeight(ИмяНасыщенности);
	КонецЕсли;
	Если Настройки.ВысотаСтроки > 0 Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.setLineHeight(Настройки.ВысотаСтроки);
	КонецЕсли;
	
	// @skip-check dynamic-access-method-not-found
	КонсольКода.minimap(Настройки.КартаКода);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.wordWrap(Настройки.ПереносСтрок);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.enableQuickSuggestions(Настройки.БыстрыеПодсказки);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.switchLang(Настройки.ЯзыкПодсказок);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setContextMode("Server");
	// @skip-check dynamic-access-method-not-found
	КонсольКода.renderWhitespace(Настройки.ОтображатьПробелы);
	
	Если Настройки.НомераСтрок Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.showLineNumbers();
	Иначе
		// @skip-check dynamic-access-method-not-found
		КонсольКода.hideLineNumbers();
	КонецЕсли;
	Если Настройки.СтрокаСостояния Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.showStatusBar();
	Иначе
		// @skip-check dynamic-access-method-not-found
		КонсольКода.hideStatusBar();
	КонецЕсли;
	
	ОтключитьСворачивание = Не Настройки.Сворачивание;
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("disableFolding", ОтключитьСворачивание);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("highlightInnerQuotes", Настройки.ПодсветкаКавычек);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setOption("autoResizeEditorLayout", Настройки.АвтоРазмер);
	
КонецПроцедуры

// Продолжение проверки описания метаданных после вопроса пользователю.
//
// Параметры:
//  Результат - КодВозвратаДиалога
//  Релиз - СправочникСсылка.Релизы
//
Процедура ПроверитьОписаниеМетаданныхПослеВопроса(Результат, Релиз) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОткрытьЗагрузкуСтруктурыКонфигурации(Релиз);
	КонецЕсли;
	
КонецПроцедуры

// Сброс кэша списков коллекций после закрытия типовой загрузки XML/EDT.
//
// Параметры:
//  Результат - Произвольный
//  ДополнительныеПараметры - Неопределено
//
Процедура ПослеЗакрытияЗагрузкиСтруктуры(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Процедура ОчиститьРеквизитыПоиска(Форма)
	
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаФразыПоиска()] = "";
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска()] = "";
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНомераСтрокиПоиска()] = 0;
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяПоля - Строка - имя поля с текстом алгоритма.
//
// Возвращаемое значение:
//  Строка - имя страницы или пустая строка.
//
Функция ИмяСтраницыПоля(Форма, ИмяПоля)
	
	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;
	
	СуффиксПути = СтрШаблон(".%1", ИмяПоля);
	Реестр = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаРеестраАлгоритмов()]; // Строка
	Для Каждого Описание Из Расш1_КонсольКодаКлиентСервер.РазобратьРеестр(Реестр) Цикл
		Если Описание.ПутьКДанным = ИмяПоля Или СтрЗаканчиваетсяНа(Описание.ПутьКДанным, СуффиксПути) Тогда
			Возврат Описание.ИмяСтраницы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура АктивироватьСтраницыПерехода(Форма, ИмяСтраницы)
	
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаПропускаВыделенияПоиска()] = Истина;
	УстановитьСтраницыПерехода(Форма, ИмяСтраницы);
	Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаПропускаВыделенияПоиска()] = Ложь;
	
КонецПроцедуры

// Ветки взаимно исключаются по имени формы. Форма без переключения страниц пропускается.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяСтраницы - Строка - имя страницы обработчика, на которую нужно перейти.
//
Процедура УстановитьСтраницыПерехода(Форма, ИмяСтраницы)
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаКонвертации() Тогда
		УстановитьСтраницыКонвертации(Форма, ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	Если ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаПравилаКонвертацииОбъектов() Тогда
		УстановитьСтраницыПравилаКонвертацииОбъектов(Форма, ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	Если ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаПравилаОбработкиДанных() Тогда
		УстановитьСтраницыПравилаОбработкиДанных(Форма, ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	Если ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаПравилПредопределенныхДанныхXML() Тогда
		УстановитьТекущуюСтраницу(Форма, "Страницы", "ОбработчикиСобытий");
		УстановитьТекущуюСтраницу(Форма, "ОбработчикиXML", ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	ЭтоФормаСвойств = ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыЭлементаПравилаКонвертацииСвойств()
		Или ИмяФормы = Расш1_КонсольКодаКлиентСервер.ИмяФормыГруппыПравилаКонвертацииСвойств();
	Если ЭтоФормаСвойств Тогда
		УстановитьТекущуюСтраницу(Форма, "ГруппаXML", "Обработчики");
		УстановитьТекущуюСтраницу(Форма, "СтраницыОбработчики", ИмяСтраницы);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСтраницыКонвертации(Форма, ИмяСтраницы)
	
	ИмяРеквизитаТипа = "КонвертацияXDTO";
	КонвертацияXDTO = Форма[ИмяРеквизитаТипа]; // Булево
	Если КонвертацияXDTO Тогда
		УстановитьТекущуюСтраницу(Форма, "Страницы", "СтраницаКонвертацияXDTO");
		УстановитьТекущуюСтраницу(Форма, "ГруппаДанныеКонвертацииXDTO", "СтраницаОбработчики");
		УстановитьТекущуюСтраницу(Форма, "СтраницыОбработчики", ИмяСтраницы);
	Иначе
		УстановитьТекущуюСтраницу(Форма, "Страницы", "СтраницаКонвертацияXML");
		УстановитьТекущуюСтраницу(Форма, "ОбработчикиXML", ИмяСтраницы);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСтраницыПравилаКонвертацииОбъектов(Форма, ИмяСтраницы)
	
	ИмяРеквизитаТипа = "ЭтоКонвертацияXDTO";
	ЭтоКонвертацияXDTO = Форма[ИмяРеквизитаТипа]; // Булево
	Если ЭтоКонвертацияXDTO Тогда
		УстановитьТекущуюСтраницу(Форма, "Страницы", "Страница_ОбработчикиXDTO");
		УстановитьТекущуюСтраницу(Форма, "ОбработчикиXDTO", ИмяСтраницы);
	Иначе
		УстановитьТекущуюСтраницу(Форма, "Страницы", "Страница_ОбработчикиXML");
		УстановитьТекущуюСтраницу(Форма, "ОбработчикиXML", ИмяСтраницы);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСтраницыПравилаОбработкиДанных(Форма, ИмяСтраницы)
	
	ИмяРеквизитаТипа = "КонвертацияXDTO";
	КонвертацияXDTO = Форма[ИмяРеквизитаТипа]; // Булево
	Если КонвертацияXDTO Тогда
		УстановитьТекущуюСтраницу(Форма, "Страницы", "ОбработчикиСобытийXDTO");
		УстановитьТекущуюСтраницу(Форма, "СтраницыОбработчикиXDTO", ИмяСтраницы);
	Иначе
		УстановитьТекущуюСтраницу(Форма, "Страницы", "ОбработчикиСобытийXML");
		УстановитьТекущуюСтраницу(Форма, "СтраницыОбработчикиXML", ИмяСтраницы);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьТекущуюСтраницу(Форма, ИмяГруппы, ИмяСтраницы)
	
	ГруппаСтраниц = Форма.Элементы.Найти(ИмяГруппы);
	Страница = Форма.Элементы.Найти(ИмяСтраницы);
	Если ГруппаСтраниц = Неопределено Или Страница = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Свойство группы страниц платформа не типизирует.
	// @skip-check property-return-type
	ГруппаСтраниц.ТекущаяСтраница = Страница;
	
КонецПроцедуры

Процедура ВыделитьПереходКВхождению(Форма)
	
	Если Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаПропускаВыделенияПоиска()] Тогда
		Возврат;
	КонецЕсли;
	
	Фраза = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаФразыПоиска()]; // Строка
	ИмяПоля = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаИмениПоляПоиска()]; // Строка
	Если ПустаяСтрока(Фраза) Или ПустаяСтрока(ИмяПоля) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийПуть = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаТекущегоПутиАлгоритма()]; // Строка
	Если ТекущийПуть <> ИмяПоля И Не СтрЗаканчиваетсяНа(ТекущийПуть, СтрШаблон(".%1", ИмяПоля)) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяХоста = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Не Форма[Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяХоста)] Тогда
		Возврат;
	КонецЕсли;
	
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяХоста);
	// @skip-check dynamic-access-method-not-found
	ТекстКонсоли = КонсольКода.getText(); // Строка
	ТекстРедактора = СтрЗаменить(ТекстКонсоли, Символы.ВК, "");
	НачальнаяСтрока = Форма[Расш1_КонсольКодаКлиентСервер.ИмяРеквизитаНомераСтрокиПоиска()]; // Число
	Если НачальнаяСтрока < 1 Тогда
		НачальнаяСтрока = 1;
	КонецЕсли;
	
	ПозицияНачала = ПозицияНачалаСтрокиТекста(ТекстРедактора, НачальнаяСтрока);
	ПозицияВХвосте = СтрНайти(НРег(Сред(ТекстРедактора, ПозицияНачала)), НРег(Фраза));
	Если ПозицияВХвосте = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Позиция = ПозицияНачала + ПозицияВХвосте - 1;
	НомерСтроки = СтрЧислоВхождений(Лев(ТекстРедактора, Позиция - 1), Символы.ПС) + 1;
	НачалоСтроки = 1;
	ПозицияРазрыва = СтрНайти(ТекстРедактора, Символы.ПС, НаправлениеПоиска.СКонца, Позиция);
	Если ПозицияРазрыва > 0 Тогда
		НачалоСтроки = ПозицияРазрыва + 1;
	КонецЕсли;
	
	Колонка = Позиция - НачалоСтроки + 1;
	// @skip-check dynamic-access-method-not-found
	КонсольКода.revealLineInCenter(НомерСтроки);
	// @skip-check dynamic-access-method-not-found
	КонсольКода.setSelection(НомерСтроки, Колонка, НомерСтроки, Колонка + СтрДлина(Фраза));
	ОчиститьРеквизитыПоиска(Форма);
	
КонецПроцедуры

// Выделить фразу поиска после формирования консоли.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ВыделитьФразуПоиска(Форма) Экспорт
	
	ВыделитьПереходКВхождению(Форма);
	
КонецПроцедуры

Функция ПозицияНачалаСтрокиТекста(Текст, НомерСтроки)
	
	Если НомерСтроки <= 1 Тогда
		Возврат 1;
	КонецЕсли;
	
	Позиция = 0;
	ОсталосьСтрок = НомерСтроки - 1;
	Пока ОсталосьСтрок > 0 Цикл
		Позиция = СтрНайти(Текст, Символы.ПС, , Позиция + 1);
		Если Позиция = 0 Тогда
			Возврат СтрДлина(Текст) + 1;
		КонецЕсли;
		ОсталосьСтрок = ОсталосьСтрок - 1;
	КонецЦикла;
	
	Возврат Позиция + 1;
	
КонецФункции

Процедура ВыполнитьКомандуЗакладок(Форма, ИмяКоманды)
	
	ИмяЭлемента = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Не КонсольСформирована(Форма, ИмяЭлемента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Консоль кода ещё не открыта'"));
		Возврат;
	КонецЕсли;
	
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяЭлемента);
	
	Если ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаУстановить() Тогда
		ПереключитьЗакладкуТекущейСтроки(КонсольКода);
	ИначеЕсли ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаСледующая() Тогда
		ПерейтиКЗакладке(КонсольКода, Истина);
	ИначеЕсли ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаПредыдущая() Тогда
		ПерейтиКЗакладке(КонсольКода, Ложь);
	ИначеЕсли ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаСписок() Тогда
		ПоказатьСписокЗакладок(Форма, КонсольКода);
	Иначе
		ВызватьИсключение "ВыполнитьКомандуЗакладок - не обработано условие";
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоКомандаЗакладок(ИмяКоманды)
	
	Возврат ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаУстановить()
		Или ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаСледующая()
		Или ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаПредыдущая()
		Или ИмяКоманды = Расш1_КонсольКодаКлиентСервер.ИмяКомандыЗакладкаСписок();
	
КонецФункции

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  ИмяЭлементаHTML - Строка - имя поля HTML консоли.
//
// Возвращаемое значение:
//  Булево - Истина, если документ консоли сформирован.
//
Функция КонсольСформирована(Форма, ИмяЭлементаHTML)
	
	ИмяПризнака = Расш1_КонсольКодаКлиентСервер.ИмяПризнакаСформирована(ИмяЭлементаHTML);
	Сформирована = Форма[ИмяПризнака]; // Булево
	Возврат Сформирована;
	
КонецФункции

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
Процедура ПереключитьЗакладкуТекущейСтроки(КонсольКода)
	
	// @skip-check dynamic-access-method-not-found
	ТекущаяСтрока = КонсольКода.getCurrentLine(); // Число
	НомерСтроки = НомерСтрокиЗакладки(ТекущаяСтрока);
	// @skip-check dynamic-access-method-not-found
	КоличествоСтрок = КонсольКода.getLineCount(); // Число
	Если НомерСтроки >= КоличествоСтрок Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'На последней строке закладку меняйте сочетанием Alt+F2'"));
		Возврат;
	КонецЕсли;
	
	Номера = НомераЗакладок(КонсольКода);
	Если Номера.Найти(НомерСтроки) = Неопределено Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.addBookmark(НомерСтроки);
	Иначе
		// @skip-check dynamic-access-method-not-found
		КонсольКода.removeBookmark(НомерСтроки);
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  Следующая - Булево - Истина для следующей закладки, Ложь для предыдущей.
//
Процедура ПерейтиКЗакладке(КонсольКода, Следующая)
	
	Номера = НомераЗакладок(КонсольКода);
	Если Номера.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Закладок нет'"));
		Возврат;
	КонецЕсли;
	
	Если Следующая Тогда
		// @skip-check dynamic-access-method-not-found
		КонсольКода.goNextBookmark();
	Иначе
		// @skip-check dynamic-access-method-not-found
		КонсольКода.goPreviousBookmark();
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
Процедура ПоказатьСписокЗакладок(Форма, КонсольКода)
	
	Номера = НомераЗакладок(КонсольКода);
	Если Номера.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Закладок нет'"));
		Возврат;
	КонецЕсли;
	
	ЗадержкаПоказаСписка = 0.1;
	Форма.ПодключитьОбработчикОжидания("Расш1_Подключаемый_ПоказатьЗакладки", ЗадержкаПоказаСписка, Истина);
	
КонецПроцедуры

// Читает закладки открытой консоли и показывает их списком.
// Вызывается после закрытия подменю командной панели.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью.
//
Асинх Процедура ПоказатьСписокЗакладокСейчас(Форма) Экспорт
	
	ИмяЭлемента = Расш1_КонсольКодаКлиентСервер.ИмяЭлементаХостаКонсоли();
	Если Не КонсольСформирована(Форма, ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;
	
	КонсольКода = ПредставлениеКонсоли(Форма, ИмяЭлемента);
	Номера = НомераЗакладок(КонсольКода);
	Если Номера.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокЗакладок = Новый СписокЗначений; // СписокЗначений из Число
	Для Каждого НомерСтроки Из Номера Цикл
		Представление = ПредставлениеЗакладки(КонсольКода, НомерСтроки);
		СписокЗакладок.Добавить(НомерСтроки, Представление);
	КонецЦикла;
	
	ЭлементКонсоли = Форма.Элементы[ИмяЭлемента];
	ВыбранныйЭлемент = Ждать Форма.ВыбратьИзСпискаАсинх(СписокЗакладок, ЭлементКонсоли);
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяСтрока = ВыбранныйЭлемент.Значение;
	// @skip-check dynamic-access-method-not-found
	КонсольКода.revealLineInCenter(ВыбраннаяСтрока);
	
КонецПроцедуры

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//  НомерСтроки - Число - номер строки закладки.
//
// Возвращаемое значение:
//  Строка - номер и начало текста строки.
//
Функция ПредставлениеЗакладки(КонсольКода, НомерСтроки)
	
	// @skip-check dynamic-access-method-not-found
	Фрагмент = КонсольКода.getLineContent(НомерСтроки); // Строка
	Фрагмент = СтрЗаменить(Фрагмент, Символы.Таб, " ");
	Фрагмент = СтрЗаменить(Фрагмент, Символы.ПС, " ");
	Фрагмент = СтрЗаменить(Фрагмент, Символы.ВК, "");
	Фрагмент = СокрЛП(Фрагмент);
	МаксимальнаяДлинаФрагмента = 80;
	Если СтрДлина(Фрагмент) > МаксимальнаяДлинаФрагмента Тогда
		НачалоФрагмента = Лев(Фрагмент, МаксимальнаяДлинаФрагмента);
		Фрагмент = СтрШаблон("%1...", НачалоФрагмента);
	КонецЕсли;
	
	Номер = Формат(НомерСтроки, "ЧГ=0");
	Если ПустаяСтрока(Фрагмент) Тогда
		Возврат Номер;
	КонецЕсли;
	
	Возврат СтрШаблон(НСтр("ru = '%1: %2'"), Номер, Фрагмент);
	
КонецФункции

// Параметры:
//  КонсольКода - Произвольный - defaultView документа HTML-поля консоли.
//
// Возвращаемое значение:
//  Массив из Число - номера строк с закладками.
//
Функция НомераЗакладок(КонсольКода)
	
	Номера = Новый Массив; // Массив из Число
	// @skip-check dynamic-access-method-not-found
	Закладки = КонсольКода.getBookmarks(); // Произвольный
	Если Закладки = Неопределено Тогда
		Возврат Номера;
	КонецЕсли;
	
	// getBookmarks возвращает массив JavaScript (ВнешнийОбъект): индексация из 1С недоступна,
	// поэтому массив сводится в строку вида "3,10,25" штатным методом join.
	// @skip-check dynamic-access-method-not-found
	СтрокаНомеров = Закладки.join(","); // Строка
	Части = СтрРазделить(СтрокаНомеров, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Номер = НомерСтрокиЗакладки(Часть);
		Если Номер > 0 Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Номера;
	
КонецФункции

// Параметры:
//  Значение - Число, Строка - номер строки или его текстовое представление.
//
// Возвращаемое значение:
//  Число - номер строки; 0, если значение не распознано.
//
Функция НомерСтрокиЗакладки(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Описание = Строка(Значение);
	Описание = СокрЛП(Описание);
	Если ПустаяСтрока(Описание) Тогда
		Возврат 0;
	КонецЕсли;
	Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Описание) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Число(Описание);
	
КонецФункции

#КонецОбласти
