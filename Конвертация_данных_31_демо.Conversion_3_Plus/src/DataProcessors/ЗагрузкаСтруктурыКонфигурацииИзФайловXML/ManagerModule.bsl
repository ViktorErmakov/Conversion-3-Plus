// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

// До типовой загрузки читает тексты модулей из помещенных файлов.
//
// Параметры:
//  ОбщиеПеременные - см. Расш1_ПропуститьЧтениеМодулей.ОбщиеПеременные
//  АдресВременногоХранилища - Строка - адрес результата типовой загрузки.
//
&Перед("ВыполнитьЗагрузкуМетаданных")
Процедура Расш1_ВыполнитьЗагрузкуМетаданных(ОбщиеПеременные, АдресВременногоХранилища)
	
	Если Расш1_ПропуститьЧтениеМодулей(ОбщиеПеременные) Тогда
		Возврат;
	КонецЕсли;
	
	ПомещенныеФайлы = ОбщиеПеременные.ПомещенныеФайлы;
	ТекстыМодулей = Расш1_ТекстыМодулейИзФайлов(ПомещенныеФайлы);
	ОбщиеПеременные.Вставить("Расш1_ТекстыМодулей", ТекстыМодулей);
	
КонецПроцедуры

// После типовой загрузки записывает прочитанные тексты модулей релиза.
//
// Параметры:
//  ОбщиеПеременные - см. Расш1_ПропуститьЧтениеМодулей.ОбщиеПеременные
//  АдресВременногоХранилища - Строка - адрес результата типовой загрузки.
//
&После("ВыполнитьЗагрузкуМетаданных")
Процедура Расш1_ВыполнитьЗагрузкуМетаданныхПосле(ОбщиеПеременные, АдресВременногоХранилища)
	
	Если Расш1_ПропуститьЧтениеМодулей(ОбщиеПеременные) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщиеПеременные.Свойство("Отказ") И ОбщиеПеременные.Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекстыМодулей = Неопределено; // см. Расш1_ТекстыМодулейИзФайлов
	Если Не ОбщиеПеременные.Свойство("Расш1_ТекстыМодулей", ТекстыМодулей) Тогда
		Возврат;
	КонецЕсли;
	
	Релиз = ОбщиеПеременные.Конфигурация;
	Если Не ЗначениеЗаполнено(Релиз) Тогда
		Возврат;
	КонецЕсли;
	
	Расш1_ЗаписатьТекстыМодулей(Релиз, ТекстыМодулей);
	
КонецПроцедуры

// Параметры:
//  ОбщиеПеременные - Структура - параметры типовой загрузки:
//   * ПомещенныеФайлы - см. Расш1_ТекстыМодулейИзФайлов.ПомещенныеФайлы
//   * ТолькоОбновитьПланыОбмена - Булево - загружаются только планы обмена.
//   * Отказ - Булево - типовая загрузка не выполнена.
//   * Конфигурация - СправочникСсылка.Релизы - загруженный релиз.
//
// Возвращаемое значение:
//  Булево - тексты модулей читать не нужно.
//
Функция Расш1_ПропуститьЧтениеМодулей(ОбщиеПеременные)
	
	Если Не ОбщиеПеременные.Свойство("ПомещенныеФайлы") Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТолькоОбновитьПланыОбмена = Ложь;
	Если Не ОбщиеПеременные.Свойство("ТолькоОбновитьПланыОбмена", ТолькоОбновитьПланыОбмена) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ТолькоОбновитьПланыОбмена;
	
КонецФункции

// Параметры:
//  ПомещенныеФайлы - Массив из Структура - файлы выгрузки конфигурации:
//   * ПолноеИмя - Строка - путь файла в выгрузке.
//   * Хранение - Строка - имя файла для чтения.
//   * ЭтоРасширение - Булево - файл расширения, свойство необязательно.
//
// Возвращаемое значение:
//  Массив из Структура - тексты модулей:
//   * Вид - ПеречислениеСсылка.Расш1_ВидыМодулей - вид модуля.
//   * Ключ - Строка - имя объекта модуля.
//   * Идентификатор - Строка - вид и ключ в нижнем регистре.
//   * Текст - Строка - текст модуля.
//   * Глобальный - Булево - глобальный общий модуль.
//
Функция Расш1_ТекстыМодулейИзФайлов(ПомещенныеФайлы)
	
	ГлобальныеМодули = Расш1_ГлобальныеОбщиеМодули(ПомещенныеФайлы);
	МодулиКонфигурации = Новый Соответствие;
	МодулиРасширения = Новый Соответствие;
	
	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		
		ОписаниеМодуля = Расш1_ОписаниеМодуляПоИмениФайла(ПомещенныйФайл.ПолноеИмя);
		Если ОписаниеМодуля = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстМодуля = Расш1_ПрочитатьТекстФайла(ПомещенныйФайл.Хранение);
		Если ПустаяСтрока(ТекстМодуля) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючГлобальногоМодуля = НРег(ОписаниеМодуля.Ключ);
		Глобальный = ГлобальныеМодули.Получить(КлючГлобальногоМодуля) = Истина;
		ОписаниеМодуля.Вставить("Текст", ТекстМодуля);
		ОписаниеМодуля.Вставить("Глобальный", Глобальный);
		
		Если Расш1_ЭтоФайлРасширения(ПомещенныйФайл) Тогда
			МодулиРасширения.Вставить(ОписаниеМодуля.Идентификатор, ОписаниеМодуля);
		Иначе
			МодулиКонфигурации.Вставить(ОписаниеМодуля.Идентификатор, ОписаниеМодуля);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого МодульРасширения Из МодулиРасширения Цикл
		МодулиКонфигурации.Вставить(МодульРасширения.Ключ, МодульРасширения.Значение);
	КонецЦикла;
	
	ТекстыМодулей = Новый Массив; // Массив из Структура
	Для Каждого МодульКонфигурации Из МодулиКонфигурации Цикл
		ОписаниеМодуляКонфигурации = МодульКонфигурации.Значение; // Структура
		ТекстыМодулей.Добавить(ОписаниеМодуляКонфигурации);
	КонецЦикла;
	
	Возврат ТекстыМодулей;
	
КонецФункции

// Параметры:
//  ПомещенныеФайлы - см. Расш1_ТекстыМодулейИзФайлов.ПомещенныеФайлы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - имя общего модуля в нижнем регистре.
//   * Значение - Булево - модуль глобальный.
//
Функция Расш1_ГлобальныеОбщиеМодули(ПомещенныеФайлы)
	
	ГлобальныеМодули = Новый Соответствие;
	
	Для Каждого ПомещенныйФайл Из ПомещенныеФайлы Цикл
		
		ИмяМодуля = Расш1_ИмяОбщегоМодуляИзОписания(ПомещенныйФайл.ПолноеИмя);
		Если ПустаяСтрока(ИмяМодуля) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОписания = Расш1_ПрочитатьТекстФайла(ПомещенныйФайл.Хранение);
		ТекстОписанияНРег = НРег(ТекстОписания);
		Если СтрНайти(ТекстОписанияНРег, "<global>true") = 0
			И СтрНайти(ТекстОписанияНРег, "global=""true""") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ГлобальныеМодули.Вставить(ИмяМодуля, Истина);
		
	КонецЦикла;
	
	Возврат ГлобальныеМодули;
	
КонецФункции

// Параметры:
//  ПолноеИмя - Строка - путь файла в выгрузке.
//
// Возвращаемое значение:
//  Строка - имя общего модуля в нижнем регистре или пустая строка.
//
Функция Расш1_ИмяОбщегоМодуляИзОписания(ПолноеИмя)
	
	ЧастиПути = Расш1_ЧастиПутиФайла(ПолноеИмя);
	ИндексФайла = ЧастиПути.Количество() - 1;
	ИндексРодителя = ИндексФайла - 1;
	ИндексКаталогаНадРодителем = ИндексРодителя - 1;
	Если ИндексРодителя < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяФайла = ЧастиПути[ИндексФайла];
	ИмяФайлаНРег = НРег(ИмяФайла);
	ДлинаРасширения = 4;
	ДлинаИмени = СтрДлина(ИмяФайлаНРег) - ДлинаРасширения;
	ИмяБезРасширения = Лев(ИмяФайлаНРег, ДлинаИмени);
	КаталогиОбщихМодулей = СтрРазделить("commonmodules,общиемодули", ",");
	
	Если СтрЗаканчиваетсяНа(ИмяФайлаНРег, ".xml") Тогда
		ИмяКаталога = НРег(ЧастиПути[ИндексРодителя]);
		Если КаталогиОбщихМодулей.Найти(ИмяКаталога) = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат ИмяБезРасширения;
	КонецЕсли;
	
	Если Не СтрЗаканчиваетсяНа(ИмяФайлаНРег, ".mdo") Или ИндексКаталогаНадРодителем < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяКаталогаОбъекта = НРег(ЧастиПути[ИндексРодителя]);
	Если ИмяБезРасширения <> ИмяКаталогаОбъекта Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяКаталога = НРег(ЧастиПути[ИндексКаталогаНадРодителем]);
	Если КаталогиОбщихМодулей.Найти(ИмяКаталога) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ИмяБезРасширения;
	
КонецФункции

// Параметры:
//  ПолноеИмя - Строка - путь файла в выгрузке.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание модуля или Неопределено, если файл не модуль:
//   * Вид - ПеречислениеСсылка.Расш1_ВидыМодулей - вид модуля.
//   * Ключ - Строка - имя объекта модуля.
//   * Идентификатор - Строка - вид и ключ в нижнем регистре.
//
Функция Расш1_ОписаниеМодуляПоИмениФайла(ПолноеИмя)
	
	ЧастиПути = Расш1_ЧастиПутиФайла(ПолноеИмя);
	ИндексФайла = ЧастиПути.Количество() - 1;
	ИндексКаталогаОбъекта = ИндексФайла - 1;
	ИндексКаталогаКоллекции = ИндексКаталогаОбъекта - 1;
	Если ИндексКаталогаКоллекции < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайла = НРег(ЧастиПути[ИндексФайла]);
	ВидМодуля = Расш1_ВидМодуляПоИмениФайла(ИмяФайла);
	Если ВидМодуля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексКаталога = Расш1_ИндексКаталогаКоллекции(ЧастиПути, ВидМодуля);
	Если ИндексКаталога < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИндексОбъекта = ИндексКаталога + 1;
	ИндексКорняМодуля = ИндексОбъекта + 1;
	ИмяОбъекта = ЧастиПути[ИндексОбъекта];
	Если Не Расш1_ЭтоКореньМодуля(ЧастиПути, ИндексКорняМодуля, ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВидМодуля = Перечисления.Расш1_ВидыМодулей.ОбщийМодуль Тогда
		Ключ = ИмяОбъекта;
	Иначе
		ИмяКоллекции = Расш1_ИмяКоллекцииПоКаталогу(ЧастиПути[ИндексКаталога]);
		Если ПустаяСтрока(ИмяКоллекции) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Ключ = СтрШаблон("%1.%2", ИмяКоллекции, ИмяОбъекта);
	КонецЕсли;
	
	МаксимальнаяДлинаКлюча = 150;
	Если СтрДлина(Ключ) > МаксимальнаяДлинаКлюча Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеМодуля = Новый Структура;
	ОписаниеМодуля.Вставить("Вид", ВидМодуля);
	ОписаниеМодуля.Вставить("Ключ", Ключ);
	ОписаниеМодуля.Вставить("Идентификатор", СтрШаблон("%1|%2", Строка(ВидМодуля), НРег(Ключ)));
	
	Возврат ОписаниеМодуля;
	
КонецФункции

Функция Расш1_ВидМодуляПоИмениФайла(ИмяФайла)
	
	Если ИмяФайла = "module.bsl" Тогда
		Возврат Перечисления.Расш1_ВидыМодулей.ОбщийМодуль;
	ИначеЕсли ИмяФайла = "managermodule.bsl" Тогда
		Возврат Перечисления.Расш1_ВидыМодулей.МодульМенеджера;
	ИначеЕсли ИмяФайла = "objectmodule.bsl" Тогда
		Возврат Перечисления.Расш1_ВидыМодулей.МодульОбъекта;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция Расш1_ИндексКаталогаКоллекции(ЧастиПути, ВидМодуля)
	
	ИндексФайла = ЧастиПути.Количество() - 1;
	ИндексКаталогаОбъекта = ИндексФайла - 1;
	ПоследнийИндексКоллекции = ИндексКаталогаОбъекта - 1;
	Для Индекс = 0 По ПоследнийИндексКоллекции Цикл
		
		ИмяКаталога = НРег(ЧастиПути[Индекс]);
		ЭтоОбщиеМодули = ИмяКаталога = "commonmodules" Или ИмяКаталога = "общиемодули";
		Если ВидМодуля = Перечисления.Расш1_ВидыМодулей.ОбщийМодуль Тогда
			Если ЭтоОбщиеМодули Тогда
				Возврат Индекс;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ЭтоОбщиеМодули Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяКоллекции = Расш1_ИмяКоллекцииПоКаталогу(ЧастиПути[Индекс]);
		Если Не ПустаяСтрока(ИмяКоллекции) Тогда
			Возврат Индекс;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

Функция Расш1_ЭтоКореньМодуля(ЧастиПути, ИндексНачала, ИмяФайла)
	
	Остаток = Новый Массив; // Массив из Строка
	Для Индекс = ИндексНачала По ЧастиПути.Количество() - 1 Цикл
		Остаток.Добавить(НРег(ЧастиПути[Индекс]));
	КонецЦикла;
	
	ПутьОстатка = СтрСоединить(Остаток, "/");
	Если ИмяФайла = "module.bsl" Тогда
		Возврат ПутьОстатка = "module.bsl" Или ПутьОстатка = "ext/module.bsl";
	КонецЕсли;
	
	Возврат ПутьОстатка = ИмяФайла Или ПутьОстатка = СтрШаблон("ext/%1", ИмяФайла);
	
КонецФункции

Функция Расш1_ИмяКоллекцииПоКаталогу(ИмяКаталога)
	
	ИменаКоллекций = Расш1_ИменаКоллекцийПоКаталогам();
	ИмяКоллекции = ИменаКоллекций[НРег(ИмяКаталога)];
	Если ИмяКоллекции = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ИмяКоллекции;
	
КонецФункции

Функция Расш1_ИменаКоллекцийПоКаталогам()
	
	ИменаКоллекций = Новый Соответствие;
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "catalogs", "справочники");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "documents", "документы");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "informationregisters", "регистрысведений");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "accumulationregisters", "регистрынакопления");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "accountingregisters", "регистрыбухгалтерии");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "calculationregisters", "регистрырасчета");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "dataprocessors", "обработки");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "reports", "отчеты");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "enums", "перечисления");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "chartsofaccounts", "планысчетов");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "businessprocesses", "бизнеспроцессы");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "tasks", "задачи");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "exchangeplans", "планыобмена");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "chartsofcharacteristictypes", "планывидовхарактеристик");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "chartsofcalculationtypes", "планывидоврасчета");
	Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, "constants", "константы");
	
	Возврат ИменаКоллекций;
	
КонецФункции

// Имя коллекции доступно и по английскому, и по русскому имени каталога выгрузки.
//
// Параметры:
//  ИменаКоллекций - Соответствие из КлючИЗначение - имя каталога и имя коллекции в нижнем регистре.
//  ИмяКаталога - Строка - английское имя каталога в нижнем регистре.
//  ИмяКоллекции - Строка - русское имя коллекции в нижнем регистре.
//
Процедура Расш1_ДобавитьИмяКоллекции(ИменаКоллекций, ИмяКаталога, ИмяКоллекции)
	
	ИменаКоллекций.Вставить(ИмяКаталога, ИмяКоллекции);
	ИменаКоллекций.Вставить(ИмяКоллекции, ИмяКоллекции);
	
КонецПроцедуры

// Параметры:
//  ПолноеИмя - Строка - путь файла в выгрузке.
//
// Возвращаемое значение:
//  Массив из Строка - непустые части пути.
//
Функция Расш1_ЧастиПутиФайла(ПолноеИмя)
	
	Путь = СтрЗаменить(ПолноеИмя, "\", "/");
	Возврат СтрРазделить(Путь, "/", Ложь);
	
КонецФункции

// Параметры:
//  ПомещенныйФайл - Структура - элемент см. Расш1_ТекстыМодулейИзФайлов.ПомещенныеФайлы:
//   * ЭтоРасширение - Булево - файл расширения, свойство необязательно.
//
// Возвращаемое значение:
//  Булево - файл из выгрузки расширения.
//
Функция Расш1_ЭтоФайлРасширения(ПомещенныйФайл)
	
	ЭтоРасширение = Ложь;
	Если Не ПомещенныйФайл.Свойство("ЭтоРасширение", ЭтоРасширение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЭтоРасширение;
	
КонецФункции

// Параметры:
//  ИмяФайла - Строка - имя файла для чтения.
//
// Возвращаемое значение:
//  Строка - текст файла или пустая строка.
//
Функция Расш1_ПрочитатьТекстФайла(ИмяФайла)
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = "";
	Попытка
		Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		// Файл модуля необязателен для загрузки структуры: ошибка фиксируется, загрузка продолжается.
		Информация = ИнформацияОбОшибке();
		Подробности = ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
		КодЯзыка = ОбщегоНазначения.КодОсновногоЯзыка();
		ИмяСобытия = НСтр("ru = 'Conversion 3 Plus.Загрузка текстов модулей'", КодЯзыка);
		ШаблонТекста = НСтр("ru = 'Не удалось прочитать файл %1: %2'");
		Комментарий = СтрШаблон(ШаблонТекста, ИмяФайла, Подробности);
		Расш1_ЖурналРегистрации.ДобавитьЗапись(ИмяСобытия, "Ошибка", Комментарий);
		Возврат "";
	КонецПопытки;
	
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Параметры:
//  Релиз - СправочникСсылка.Релизы - загруженный релиз.
//  ТекстыМодулей - см. Расш1_ТекстыМодулейИзФайлов
//
Процедура Расш1_ЗаписатьТекстыМодулей(Релиз, ТекстыМодулей)
	
	НаборЗаписей = РегистрыСведений.Расш1_ТекстыМодулей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Релиз.Установить(Релиз);
	
	Для Каждого ОписаниеМодуля Из ТекстыМодулей Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Релиз = Релиз;
		Запись.Вид = ОписаниеМодуля.Вид;
		Запись.Ключ = ОписаниеМодуля.Ключ;
		Запись.Текст = ОписаниеМодуля.Текст;
		Запись.Глобальный = ОписаниеМодуля.Глобальный;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
