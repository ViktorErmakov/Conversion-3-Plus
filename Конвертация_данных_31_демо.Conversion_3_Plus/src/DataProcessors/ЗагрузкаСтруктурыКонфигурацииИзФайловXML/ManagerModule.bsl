Функция Расш1_ЧастиПутиФайла(ПолноеИмя)
	
	Путь = СтрЗаменить(ПолноеИмя, "\", "/");
	Возврат СтрРазделить(Путь, "/", Ложь);
	
КонецФункции

Функция Расш1_ЭтоФайлРасширения(ПомещенныйФайл)
	
	Возврат ПомещенныйФайл.Свойство("ЭтоРасширение") И ПомещенныйФайл.ЭтоРасширение = Истина;
	
КонецФункции

Функция Расш1_ПрочитатьТекстФайла(ИмяФайла)
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = "";
	Попытка
		Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Процедура Расш1_ЗаписатьТекстыМодулей(Релиз, ТекстыМодулей)
	
	НаборЗаписей = РегистрыСведений.Расш1_ТекстыМодулей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Релиз.Установить(Релиз);
	
	Для Каждого ОписаниеМодуля Из ТекстыМодулей Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Релиз = Релиз;
		Запись.Вид = ОписаниеМодуля.Вид;
		Запись.Ключ = ОписаниеМодуля.Ключ;
		Запись.Текст = ОписаниеМодуля.Текст;
		Запись.Глобальный = ОписаниеМодуля.Глобальный;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
